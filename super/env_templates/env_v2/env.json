{
  "task": "matmul",
  "perf_desc": "high",
  "perf_type": "fused_score",
  "description": "512×512 float32 矩阵乘性能优化（v2 多维融合分示范 env）",
  "objective": {
    "constraints": [
      {"name": "max_error", "op": "<=", "value": 0.001}
    ],
    "metrics": [
      {"name": "speedup", "weight": 1.0}
    ],
    "fusion": "weighted_avg"
  },
  "agent_hyperparams": {
    "adjust_fact": {"model": null, "thinking": null},
    "adjust_perspective": {"model": null, "thinking": "high"},
    "adjust_contradiction": {"model": null, "thinking": "medium"},
    "adjust_judge": {"model": null, "thinking": "low"},
    "adjust_reversal": {"model": null, "thinking": "medium"},
    "adjust_space": {"model": null, "thinking": "low"},
    "adjust_env": {"model": null, "thinking": "low"}
  },
  "env_slots": 1,
  "verify_levels": {
    "E2E": {
      "cmd": "gates/gate_check.py",
      "budget": "分钟级（部署+预热+端到端）",
      "caller": "框架调度器终验（每实验必跑）"
    },
    "L3": {
      "cmd": "skills/benchmark.py --candidate <path> --level L3",
      "budget": "分钟级（全量基准 K 次中位）",
      "caller": "agent 快速自证"
    },
    "L1": {
      "cmd": "skills/verify.py --candidate <path> --level L1",
      "budget": "秒级（单规模正确性）",
      "caller": "agent 低成本排除无效解"
    }
  },
  "tolerance": {
    "correctness": {
      "max_error": 0.001
    },
    "soft_gate": {
      "relative_band": 0.05
    }
  },
  "bench": {
    "size": 512,
    "dtype": "float32",
    "warmup": 1,
    "k": 3,
    "timeout_s": 60
  },
  "correctness": {
    "size": 64,
    "timeout_s": 30
  },
  "gates": {
    "correctness_timeout_s": 120,
    "bench_timeout_s": 600,
    "gate_check_timeout_s": 900
  }
}
