{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_018EenxJy9aUN93Cu92p942n","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/sunquan/rick/internal/parser\"\n11\t)\n12\t\n13\t// LoadLoopsContext reads all *.md files in loopsDir, extracts name/trigger from\n14\t// YAML frontmatter, and returns a formatted loops list for prompt injection.\n15\tfunc LoadLoopsContext(loopsDir string) string {\n16\t\theader := \"## 可用的项目 Loops\\n\\n\"\n17\t\tplaceholder := header + \"（暂无项目 Loop 记录）\\n\"\n18\t\n19\t\tentries, err := os.ReadDir(loopsDir)\n20\t\tif err != nil {\n21\t\t\treturn placeholder\n22\t\t}\n23\t\n24\t\tvar items []string\n25\t\tfor _, e := range entries {\n26\t\t\tif e.IsDir() || filepath.Ext(e.Name()) != \".md\" {\n27\t\t\t\tcontinue\n28\t\t\t}\n29\t\t\tdata, err := os.ReadFile(filepath.Join(loopsDir, e.Name()))\n30\t\t\tif err != nil {\n31\t\t\t\tlog.Printf(\"warn: LoadLoopsContext: failed to read %s: %v\", e.Name(), err)\n32\t\t\t\tcontinue\n33\t\t\t}\n34\t\t\tname, trigger := parseFrontmatterNameTrigger(string(data))\n35\t\t\tif trigger == \"\" {\n36\t\t\t\tlog.Printf(\"warn: LoadLoopsContext: no trigger in %s, skipping\", e.Name())\n37\t\t\t\tcontinue\n38\t\t\t}\n39\t\t\titems = append(items, fmt.Sprintf(\"- **%s**：%s\", name, trigger))\n40\t\t}\n41\t\n42\t\tif len(items) == 0 {\n43\t\t\treturn placeholder\n44\t\t}\n45\t\treturn header + strings.Join(items, \"\\n\") + \"\\n\"\n46\t}\n47\t\n48\t// parseFrontmatterNameTrigger extracts name and trigger from YAML frontmatter.\n49\tfunc parseFrontmatterNameTrigger(content string) (name, trigger string) {\n50\t\tif !strings.HasPrefix(content, \"---\") {\n51\t\t\treturn \"\", \"\"\n52\t\t}\n53\t\trest := content[3:]\n54\t\tend := strings.Index(rest, \"\\n---\")\n55\t\tif end < 0 {\n56\t\t\treturn \"\", \"\"\n57\t\t}\n58\t\tblock := rest[:end]\n59\t\tfor _, line := range strings.Split(block, \"\\n\") {\n60\t\t\tline = strings.TrimSpace(line)\n61\t\t\tif k, v, ok := strings.Cut(line, \":\"); ok {\n62\t\t\t\tk = strings.TrimSpace(k)\n63\t\t\t\tv = strings.TrimSpace(v)\n64\t\t\t\tswitch k {\n65\t\t\t\tcase \"name\":\n66\t\t\t\t\tname = v\n67\t\t\t\tcase \"trigger\":\n68\t\t\t\t\ttrigger = v\n69\t\t\t\t}\n70\t\t\t}\n71\t\t}\n72\t\treturn name, trigger\n73\t}\n74\t\n75\tfunc formatOKRContent(okrInfo *parser.ContextInfo) string {\n76\t\tif okrInfo == nil || (len(okrInfo.Objectives) == 0 && len(okrInfo.KeyResults) == 0) {\n77\t\t\treturn \"暂无项目 OKR 信息\"\n78\t\t}\n79\t\tvar b strings.Builder\n80\t\tif len(okrInfo.Objectives) > 0 {\n81\t\t\tb.WriteString(\"**Objectives**:\\n\")\n82\t\t\tfor _, obj := range okrInfo.Objectives {\n83\t\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", obj))\n84\t\t\t}\n85\t\t\tb.WriteString(\"\\n\")\n86\t\t}\n87\t\tif len(okrInfo.KeyResults) > 0 {\n88\t\t\tb.WriteString(\"**Key Results**:\\n\")\n89\t\t\tfor _, kr := range okrInfo.KeyResults {\n90\t\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", kr))\n91\t\t\t}\n92\t\t}\n93\t\treturn b.String()\n94\t}\n95\t\n96\tfunc formatSPECContent(specInfo *parser.ContextInfo) string {\n97\t\tif specInfo == nil || len(specInfo.Specifications) == 0 {\n98\t\t\treturn \"暂无项目 SPEC 信息\"\n99\t\t}\n100\t\tvar b strings.Builder\n101\t\tb.WriteString(\"**Specifications**:\\n\")\n102\t\tfor _, spec := range specInfo.Specifications {\n103\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", spec))\n104\t\t}\n105\t\treturn b.String()\n106\t}\n107\t\n108\tfunc formatCompletedWork(history []string) string {\n109\t\tif len(history) == 0 {\n110\t\t\treturn \"这是项目的第一阶段规划\"\n111\t\t}\n112\t\tvar b strings.Builder\n113\t\tb.WriteString(\"**已完成的工作:**\\n\")\n114\t\tfor _, item := range history {\n115\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", item))\n116\t\t}\n117\t\treturn b.String()\n118\t}\n119\t"}]},"parent_tool_use_id":null,"session_id":"df500e26-a476-4776-8d44-875f313ccbd7","uuid":"3b84d91c-d4c8-417c-ba22-35ad9b125f0a","timestamp":"2026-06-30T16:05:36.198Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/prompt/context_helpers.go","content":"package prompt\n\nimport (\n\t\"fmt\"\n\t\"log\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/sunquan/rick/internal/parser\"\n)\n\n// LoadLoopsContext reads all *.md files in loopsDir, extracts name/trigger from\n// YAML frontmatter, and returns a formatted loops list for prompt injection.\nfunc LoadLoopsContext(loopsDir string) string {\n\theader := \"## 可用的项目 Loops\\n\\n\"\n\tplaceholder := header + \"（暂无项目 Loop 记录）\\n\"\n\n\tentries, err := os.ReadDir(loopsDir)\n\tif err != nil {\n\t\treturn placeholder\n\t}\n\n\tvar items []string\n\tfor _, e := range entries {\n\t\tif e.IsDir() || filepath.Ext(e.Name()) != \".md\" {\n\t\t\tcontinue\n\t\t}\n\t\tdata, err := os.ReadFile(filepath.Join(loopsDir, e.Name()))\n\t\tif err != nil {\n\t\t\tlog.Printf(\"warn: LoadLoopsContext: failed to read %s: %v\", e.Name(), err)\n\t\t\tcontinue\n\t\t}\n\t\tname, trigger := parseFrontmatterNameTrigger(string(data))\n\t\tif trigger == \"\" {\n\t\t\tlog.Printf(\"warn: LoadLoopsContext: no trigger in %s, skipping\", e.Name())\n\t\t\tcontinue\n\t\t}\n\t\titems = append(items, fmt.Sprintf(\"- **%s**：%s\", name, trigger))\n\t}\n\n\tif len(items) == 0 {\n\t\treturn placeholder\n\t}\n\treturn header + strings.Join(items, \"\\n\") + \"\\n\"\n}\n\n// parseFrontmatterNameTrigger extracts name and trigger from YAML frontmatter.\nfunc parseFrontmatterNameTrigger(content string) (name, trigger string) {\n\tif !strings.HasPrefix(content, \"---\") {\n\t\treturn \"\", \"\"\n\t}\n\trest := content[3:]\n\tend := strings.Index(rest, \"\\n---\")\n\tif end < 0 {\n\t\treturn \"\", \"\"\n\t}\n\tblock := rest[:end]\n\tfor _, line := range strings.Split(block, \"\\n\") {\n\t\tline = strings.TrimSpace(line)\n\t\tif k, v, ok := strings.Cut(line, \":\"); ok {\n\t\t\tk = strings.TrimSpace(k)\n\t\t\tv = strings.TrimSpace(v)\n\t\t\tswitch k {\n\t\t\tcase \"name\":\n\t\t\t\tname = v\n\t\t\tcase \"trigger\":\n\t\t\t\ttrigger = v\n\t\t\t}\n\t\t}\n\t}\n\treturn name, trigger\n}\n\nfunc formatOKRContent(okrInfo *parser.ContextInfo) string {\n\tif okrInfo == nil || (len(okrInfo.Objectives) == 0 && len(okrInfo.KeyResults) == 0) {\n\t\treturn \"暂无项目 OKR 信息\"\n\t}\n\tvar b strings.Builder\n\tif len(okrInfo.Objectives) > 0 {\n\t\tb.WriteString(\"**Objectives**:\\n\")\n\t\tfor _, obj := range okrInfo.Objectives {\n\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", obj))\n\t\t}\n\t\tb.WriteString(\"\\n\")\n\t}\n\tif len(okrInfo.KeyResults) > 0 {\n\t\tb.WriteString(\"**Key Results**:\\n\")\n\t\tfor _, kr := range okrInfo.KeyResults {\n\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", kr))\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc formatSPECContent(specInfo *parser.ContextInfo) string {\n\tif specInfo == nil || len(specInfo.Specifications) == 0 {\n\t\treturn \"暂无项目 SPEC 信息\"\n\t}\n\tvar b strings.Builder\n\tb.WriteString(\"**Specifications**:\\n\")\n\tfor _, spec := range specInfo.Specifications {\n\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", spec))\n\t}\n\treturn b.String()\n}\n\nfunc formatCompletedWork(history []string) string {\n\tif len(history) == 0 {\n\t\treturn \"这是项目的第一阶段规划\"\n\t}\n\tvar b strings.Builder\n\tb.WriteString(\"**已完成的工作:**\\n\")\n\tfor _, item := range history {\n\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", item))\n\t}\n\treturn b.String()\n}\n","numLines":119,"startLine":1,"totalLines":119}}}
