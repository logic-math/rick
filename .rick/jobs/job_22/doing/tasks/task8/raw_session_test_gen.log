n nil\n60\t\t\t\t\t}\n61\t\t\t\t\tlastErr = checkErr\n62\t\n63\t\t\t\t\tif attempt == maxAutoFixAttempts {\n64\t\t\t\t\t\tbreak\n65\t\t\t\t\t}\n66\t\n67\t\t\t\t\tclaudePath, findErr := findClaudeBinary()\n68\t\t\t\t\tif findErr != nil {\n69\t\t\t\t\t\tbreak\n70\t\t\t\t\t}\n71\t\n72\t\t\t\t\tpromptFile, writeErr := writeLearningCheckFixPrompt(learningDir, checkErr)\n73\t\t\t\t\tif writeErr != nil {\n74\t\t\t\t\t\tbreak\n75\t\t\t\t\t}\n76\t\t\t\t\tdefer os.Remove(promptFile)\n77\t\n78\t\t\t\t\tif fixErr := runAutoFix(claudePath, promptFile); fixErr != nil {\n79\t\t\t\t\t\tbreak\n80\t\t\t\t\t}\n81\t\t\t\t}\n82\t\n83\t\t\t\tfmt.Fprintf(os.Stderr, \"❌ learning check failed: %v\\n\", lastErr)\n84\t\t\t\tos.Exit(1)\n85\t\t\t\treturn nil\n86\t\t\t},\n87\t\t}\n88\t\n89\t\tcmd.Flags().BoolVar(&autoFix, \"auto-fix\", false, \"Attempt to auto-fix errors using Claude\")\n90\t\treturn cmd\n91\t}\n92\t\n93\t// runLearningCheck checks that SUMMARY.md exists in the learning directory.\n94\tfunc runLearningCheck(learningDir string) error {\n95\t\tsummaryPath := filepath.Join(learningDir, \"SUMMARY.md\")\n96\t\tif _, err := os.Stat(summaryPath); os.IsNotExist(err) {\n97\t\t\treturn fmt.Errorf(\"SUMMARY.md not found in %s\", learningDir)\n98\t\t}\n99\t\tsummaryContent, err := os.ReadFile(summaryPath)\n100\t\tif err != nil {\n101\t\t\treturn fmt.Errorf(\"failed to read SUMMARY.md: %w\", err)\n102\t\t}\n103\t\tif len(strings.TrimSpace(string(summaryContent))) == 0 || !strings.Contains(string(summaryContent), \"# Job\") {\n104\t\t\treturn fmt.Errorf(\"SUMMARY.md exists but is empty or missing required '# Job' heading\")\n105\t\t}\n106\t\n107\t\tfmt.Printf(\"✅ learning check passed\\n\")\n108\t\treturn nil\n109\t}\n110\t\n111\t// writeLearningCheckFixPrompt writes a prompt file asking claude to fix SUMMARY.md.\n112\tfunc writeLearningCheckFixPrompt(learningDir string, checkErr error) (string, error) {\n113\t\ttmpFile, err := os.CreateTemp(\"\", \"rick-learning-check-fix-*.md\")\n114\t\tif 