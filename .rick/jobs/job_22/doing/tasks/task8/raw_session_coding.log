ck(dir)\n213\t\tif err == nil {\n214\t\t\tt.Fatal(\"expected error for unresolved bug\")\n215\t\t}\n216\t\tif !containsStr(err.Error(), \"进行中\") {\n217\t\t\tt.Errorf(\"expected '进行中' in error, got: %v\", err)\n218\t\t}\n219\t}\n220\t\n221\tfunc TestRunDoingCheck_DebugBugMissingStatus(t *testing.T) {\n222\t\tdir := t.TempDir()\n223\t\tmakeTasksJSON(t, dir, []executor.TaskState{\n224\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n225\t\t})\n226\t\tdebugDir := filepath.Join(dir, \"debug\")\n227\t\tif err := os.MkdirAll(debugDir, 0755); err != nil {\n228\t\t\tt.Fatal(err)\n229\t\t}\n230\t\tcontent := \"## 阶段一记录\\n没有 frontmatter\"\n231\t\tif err := os.WriteFile(filepath.Join(debugDir, \"bug1-no-frontmatter.md\"), []byte(content), 0644); err != nil {\n232\t\t\tt.Fatal(err)\n233\t\t}\n234\t\terr := runDoingCheck(dir)\n235\t\tif err == nil {\n236\t\t\tt.Fatal(\"expected error for bug file missing status frontmatter\")\n237\t\t}\n238\t\tif !containsStr(err.Error(), \"status:\") {\n239\t\t\tt.Errorf(\"expected 'status:' in error, got: %v\", err)\n240\t\t}\n241\t}\n242\t\n243\tfunc TestRunDoingCheck_DebugBugResolved(t *testing.T) {\n244\t\tdir := t.TempDir()\n245\t\tmakeTasksJSON(t, dir, []executor.TaskState{\n246\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n247\t\t})\n248\t\tdebugDir := filepath.Join(dir, \"debug\")\n249\t\tif err := os.MkdirAll(debugDir, 0755); err != nil {\n250\t\t\tt.Fatal(err)\n251\t\t}\n252\t\tcontent := \"---\\nsummary: \\\"fixed\\\"\\nstatus: \\\"✅ 已解决\\\"\\n---\\n\\n## Phase 1: 构建反馈回路\\n\\n（复现步骤）\\n\\n## Phase 2: 复现最小化\\n\\n（最小单元）\\n\\n## Phase 3: 可证伪假设\\n\\n（假设列表）\\n\\n## Phase 4: 插桩观察\\n\\n（观测结果）\\n\\n## Phase 5: 修复回归\\n\\n（修复完成）\\n\\n## Phase 6: 清理事后分析\\n\\n（清理完成）\\n\\n## 结论\\n\\n修复完成。\\n\"\n253\t\tif err := os.WriteFile(filepath.Join(debugDir, \"bug1-fixed.md\"), []byte(content), 0644); err != nil {\n254\t\t\tt.Fatal(err)\n255\t\t}\n256\t\tif err := runDoingCheck(dir); err != nil {\n257\t\t\tt.Errorf(\"expected no error for resolved bug, got: %v\", err)\n258\t\t}\n259\t}\n260\t\n261\t// ─── Learning Check Tests ─────────────────────────────────────────────────────\n262\t\n263\tfunc TestRunLearningCheck_NoSummary(t *testing.T) {\n264\t\tdir := t.TempDir()\n265\t\terr := runLearningCheck(dir)\n266\t\tif err == nil {\n267\t\t\tt.Fatal(\"expected error for missing SUMMARY.md\")\n268\t\t}\n269\t\tif !containsStr(err.Error(), \"SUMMARY.md\") {\n270\t\t\tt.Errorf(\"expected SUMMARY.md in error, got: %v\", err)\n271\t\t}\n272\t}\n273\t\n274\tfunc TestRunLearningCheck_EmptySummary(t *testing.T) {\n275\t\tdir := t.TempDir()\n276\t\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"   \"), 0644); err != nil {\n277\t\t\tt.Fatal(err)\n278\t\t}\n279\t\terr := runLearningCheck(dir)\n280\t\tif err == nil {\n281\t\t\tt.Fatal(\"expected error for empty SUMMARY.md\")\n282\t\t}\n283\t\tif !containsStr(err.Error(), \"empty\") && !containsStr(err.Error(), \"# Job\") {\n284\t\t\tt.Errorf(\"expected empty/# Job in error, got: %v\", err)\n285\t\t}\n286\t}\n287\t\n288\tfunc TestRunLearningCheck_MissingJobHeading(t *testing.T) {\n289\t\tdir := t.TempDir()\n290\t\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Summary\\nsome content without job heading\"), 0644); err != nil {\n291\t\t\tt.Fatal(err)\n292\t\t}\n293\t\terr := runLearningCheck(dir)\n294\t\tif err == nil {\n295\t\t\tt.Fatal(\"expected error for SUMMARY.md missing '# Job' heading\")\n296\t\t}\n297\t\tif !containsStr(err.Error(), \"# Job\") {\n298\t\t\tt.Errorf(\"expected '# Job' in error, got: %v\", err)\n299\t\t}\n300\t}\n301\t\n302\t\n303\tfunc TestRunLearningCheck_Valid(t *testing.T) {\n304\t\tdir := t.TempDir()\n305\t\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n306\t\t\tt.Fatal(err)\n307\t\t}\n308\t\tif err := runLearningCheck(dir); err != nil {\n309\t\t\tt.Errorf(\"expected no error for valid learning dir, got: %v\", err)\n310\t\t}\n311\t}\n312\t\n313\tfunc TestRunLearningCheck_ValidWithSkill(t *testing.T) {\n314\t\tdir := t.TempDir()\n315\t\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n316\t\t\tt.Fatal(err)\n317\t\t}\n318\t\ttoolsDir := filepath.Join(dir, \"tools\")\n319\t\tif err := os.MkdirAll(toolsDir, 0755); err != nil {\n320\t\t\tt.Fatal(err)\n321\t\t}\n322\t\tgoodPy := \"def hello():\\n    return 'world'\\n\"\n323\t\tif err := os.WriteFile(filepath.Join(toolsDir, \"good.py\"), []byte(goodPy), 0644); err != nil {\n324\t\t\tt.Fatal(err)\n325\t\t}\n326\t\tif err := runLearningCheck(dir); err != nil {\n327\t\t\tt.Errorf(\"expected no error for valid skill, got: %v\", err)\n328\t\t}\n329\t}\n330\t\n331\tfunc TestRunLearningCheck_ValidOKR(t *testing.T) {\n332\t\tdir := t.TempDir()\n333\t\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n334\t\t\tt.Fatal(err)\n335\t\t}\n336\t\tokr := \"## O1: 目标\\n### 关键结果\\n1. KR1\\n\"\n337\t\tif err := os.WriteFile(filepath.Join(dir, \"OKR.md\"), []byte(okr), 0644); err != nil {\n338\t\t\tt.Fatal(err)\n339\t\t}\n340\t\tif err := runLearningCheck(dir); err != nil {\n341\t\t\tt.Errorf(\"expected no error for valid OKR, got: %v\", err)\n342\t\t}\n343\t}\n344\t\n345\tfunc TestRunLearningCheck_ValidSPEC(t *testing.T) {\n346\t\tdir := t.TempDir()\n347\t\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n348\t\t\tt.Fatal(err)\n349\t\t}\n350\t\tspec := \"## 调试环境\\ngo run\\n## 架构设计\\nModular\\n## 编译与运行方法\\ngo build\\n## 观测方法\\nlogs\\n## 控制方法\\nconfig\\n## 技能列表\\n| 名称 | 触发词 | 路径 |\\n\"\n351\t\tif err := os.WriteFile(filepath.Join(dir, \"SPEC.md\"), []byte(spec), 0644); err != nil {\n352\t\t\tt.Fatal(err)\n353\t\t}\n354\t\tif err := runLearningCheck(dir); err != nil {\n355\t\t\tt.Errorf(\"expected no error for valid SPEC, got: %v\", err)\n356\t\t}\n357\t}\n358\t\n359\t// ─── Tools Command Tests ──────────────────────────────────────────────────────\n360\t\n361\tfunc TestNewToolsCmd(t *testing.T) {\n362\t\tcmd := NewToolsCmd()\n363\t\tif cmd == nil {\n364\t\t\tt.Fatal(\"NewToolsCmd returned nil\")\n365\t\t}\n366\t\tif cmd.Use != \"tools\" {\n367\t\t\tt.Errorf(\"expected Use='tools', got '%s'\", cmd.Use)\n368\t\t}\n369\t}\n370\t\n371\tfunc TestNewPlanCheckCmd(t *testing.T) {\n372\t\tcmd := NewPlanCheckCmd()\n373\t\tif cmd == nil {\n374\t\t\tt.Fatal(\"NewPlanCheckCmd returned nil\")\n375\t\t}\n376\t\tif cmd.Use != \"plan_check <job_id>\" {\n377\t\t\tt.Errorf(\"unexpected Use: %s\", cmd.Use)\n378\t\t}\n379\t}\n380\t\n381\tfunc TestNewDoingCheckCmd(t *testing.T) {\n382\t\tcmd := NewDoingCheckCmd()\n383\t\tif cmd == nil {\n384\t\t\tt.Fatal(\"NewDoingCheckCmd returned nil\")\n385\t\t}\n386\t\tif cmd.Use != \"doing_check <job_id>\" {\n387\t\t\tt.Errorf(\"unexpected Use: %s\", cmd.Use)\n388\t\t}\n389\t}\n390\t\n391\tfunc TestNewLearningCheckCmd(t *testing.T) {\n392\t\tcmd := NewLearningCheckCmd()\n393\t\tif cmd == nil {\n394\t\t\tt.Fatal(\"NewLearningCheckCmd returned nil\")\n395\t\t}\n396\t\tif cmd.Use != \"learning_check <job_id>\" {\n397\t\t\tt.Errorf(\"unexpected Use: %s\", cmd.Use)\n398\t\t}\n399\t}\n400\t\n401\tfunc TestToolsSubcommands(t *testing.T) {\n402\t\tcmd := NewToolsCmd()\n403\t\tsubNames := make(map[string]bool)\n404\t\tfor _, sub := range cmd.Commands() {\n405\t\t\tsubNames[sub.Name()] = true\n406\t\t}\n407\t\texpected := []string{\"plan_check\", \"doing_check\", \"learning_check\", \"dream_check\"}\n408\t\tfor _, name := range expected {\n409\t\t\tif !subNames[name] {\n410\t\t\t\tt.Errorf(\"missing subcommand: %s\", name)\n411\t\t\t}\n412\t\t}\n413\t}\n414\t\n415\t\n416\t// ─── Workspace-dependent tests ────────────────────────────────────────────────\n417\t\n418\t// withTempWorkspace changes the working directory to a temp dir with a .rick structure,\n419\t// calls f, then restores the original working directory.\n420\tfunc withTempWorkspace(t *testing.T, f func(dir string)) {\n421\t\tt.Helper()\n422\t\torig, err := os.Getwd()\n423\t\tif err != nil {\n424\t\t\tt.Fatal(err)\n425\t\t}\n426\t\tdir := t.TempDir()\n427\t\tif err := os.Chdir(dir); err != nil {\n428\t\t\tt.Fatal(err)\n429\t\t}\n430\t\tt.Cleanup(func() {\n431\t\t\t_ = os.Chdir(orig)\n432\t\t})\n433\t\tif err := os.MkdirAll(filepath.Join(dir, \".rick\"), 0755); err != nil {\n434\t\t\tt.Fatal(err)\n435\t\t}\n436\t\tf(dir)\n437\t}\n438\t\n439\tfunc TestRunDoingDryRun_EmptyJobID(t *testing.T) {\n440\t\t// Empty job ID should not error\n441\t\tif err := runDoingDryRun(\"\"); err != nil {\n442\t\t\tt.Errorf(\"expected no error for empty job ID, got: %v\", err)\n443\t\t}\n444\t}\n445\t\n446\tfunc TestRunDoingDryRun_NoPlanDir(t *testing.T) {\n447\t\twithTempWorkspace(t, func(dir string) {\n448\t\t\t// job_test has no plan dir\n449\t\t\tif err := runDoingDryRun(\"job_test\"); err != nil {\n450\t\t\t\tt.Errorf(\"expected no error (dry-run ignores missing plan), got: %v\", err)\n451\t\t\t}\n452\t\t})\n453\t}\n454\t\n455\tfunc TestRunDoingDryRun_WithPlan(t *testing.T) {\n456\t\twithTempWorkspace(t, func(dir string) {\n457\t\t\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n458\t\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n459\t\t\t\tt.Fatal(err)\n460\t\t\t}\n461\t\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n462\t\t\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n463\t\t\t\tt.Fatal(err)\n464\t\t\t}\n465\t\t\t// Should not error even if prompt generation has issues\n466\t\t\tif err := runDoingDryRun(\"job_test\"); err != nil {\n467\t\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n468\t\t\t}\n469\t\t})\n470\t}\n471\t\n472\tfunc TestRunPlanCheck_WithWorkspace(t *testing.T) {\n473\t\twithTempWorkspace(t, func(dir string) {\n474\t\t\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n475\t\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n476\t\t\t\tt.Fatal(err)\n477\t\t\t}\n478\t\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n479\t\t\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n480\t\t\t\tt.Fatal(err)\n481\t\t\t}\n482\t\t\tokrContent := \"# Job OKR\\n## O1: 目标\\n- KR1: 完成核心功能实现并通过测试\\n\"\n483\t\t\tif err := os.WriteFile(filepath.Join(planDir, \"OKR.md\"), []byte(okrContent), 0644); err != nil {\n484\t\t\t\tt.Fatal(err)\n485\t\t\t}\n486\t\t\t// Write meaningful SPEC.md so the project-level check passes\n487\t\t\tspecPath := filepath.Join(dir, \".rick\", \"SPEC.md\")\n488\t\t\tspecContent := \"# SPEC\\n## 架构设计\\n本项目采用 Go 标准库实现，无外部依赖。\\n## 编译与运行方法\\n```\\ngo build ./...\\n```\\n\"\n489\t\t\tif err := os.WriteFile(specPath, []byte(specContent), 0644); err != nil {\n490\t\t\t\tt.Fatal(err)\n491\t\t\t}\n492\t\t\tif err := runPlanCheck(planDir); err != nil {\n493\t\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n494\t\t\t}\n495\t\t})\n496\t}\n497\t\n498\tfunc TestRunDoingCheck_WithWorkspace(t *testing.T) {\n499\t\twithTempWorkspace(t, func(dir string) {\n500\t\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n501\t\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n502\t\t\t\tt.Fatal(err)\n503\t\t\t}\n504\t\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n505\t\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n506\t\t\t})\n507\t\t\tif err := os.WriteFile(filepath.Join(doingDir, \"debug.md\"), []byte(\"## task1: did work\\nsome content\"), 0644); err != nil {\n508\t\t\t\tt.Fatal(err)\n509\t\t\t}\n510\t\t\tif err := runDoingCheck(doingDir); err != nil {\n511\t\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n512\t\t\t}\n513\t\t})\n514\t}\n515\t\n516\tfunc TestRunLearningCheck_WithWorkspace(t *testing.T) {\n517\t\twithTempWorkspace(t, func(dir string) {\n518\t\t\tlearningDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"learning\")\n519\t\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n520\t\t\t\tt.Fatal(err)\n521\t\t\t}\n522\t\t\tif err := os.WriteFile(filepath.Join(learningDir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n523\t\t\t\tt.Fatal(err)\n524\t\t\t}\n525\t\t\tif err := runLearningCheck(learningDir); err != nil {\n526\t\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n527\t\t\t}\n528\t\t})\n529\t}\n530\t\n531\t// ─── Git helper tests ─────────────────────────────────────────────────────────\n532\t\n533\tfunc setupGitRepo(t *testing.T) string {\n534\t\tt.Helper()\n535\t\tdir := t.TempDir()\n536\t\torig, err := os.Getwd()\n537\t\tif err != nil {\n538\t\t\tt.Fatal(err)\n539\t\t}\n540\t\tif err := os.Chdir(dir); err != nil {\n541\t\t\tt.Fatal(err)\n542\t\t}\n543\t\tt.Cleanup(func() { _ = os.Chdir(orig) })\n544\t\n545\t\t// Initialize git repo\n546\t\tcmds := [][]string{\n547\t\t\t{\"git\", \"init\"},\n548\t\t\t{\"git\", \"config\", \"user.email\", \"test@test.com\"},\n549\t\t\t{\"git\", \"config\", \"user.name\", \"Test\"},\n550\t\t}\n551\t\tfor _, args := range cmds {\n552\t\t\tcmd := exec.Command(args[0], args[1:]...)\n553\t\t\tcmd.Dir = dir\n554\t\t\tif err := cmd.Run(); err != nil {\n555\t\t\t\tt.Fatalf(\"git setup failed: %v\", err)\n556\t\t\t}\n557\t\t}\n558\t\t// Create initial commit\n559\t\tif err := os.WriteFile(filepath.Join(dir, \"README.md\"), []byte(\"test\"), 0644); err != nil {\n560\t\t\tt.Fatal(err)\n561\t\t}\n562\t\tfor _, args := range [][]string{\n563\t\t\t{\"git\", \"add\", \".\"},\n564\t\t\t{\"git\", \"commit\", \"-m\", \"init\"},\n565\t\t} {\n566\t\t\tcmd := exec.Command(args[0], args[1:]...)\n567\t\t\tcmd.Dir = dir\n568\t\t\tif err := cmd.Run(); err != nil {\n569\t\t\t\tt.Fatalf(\"git commit failed: %v\", err)\n570\t\t\t}\n571\t\t}\n572\t\treturn dir\n573\t}\n574\t\n575\tfunc TestFindClaudeBinary(t *testing.T) {\n576\t\t// Just verify the function runs without panic\n577\t\tpath, err := findClaudeBinary()\n578\t\tif err != nil {\n579\t\t\tt.Logf(\"findClaudeBinary returned error (claude not in PATH): %v\", err)\n580\t\t} else if path == \"\" {\n581\t\t\tt.Error(\"expected non-empty path when claude is found\")\n582\t\t}\n583\t}\n584\t\n585\tfunc TestRunAutoFix_MockBinary(t *testing.T) {\n586\t\ttmpDir := t.TempDir()\n587\t\tmockScript := \"#!/bin/sh\\nexit 0\\n\"\n588\t\tmockPath := filepath.Join(tmpDir, \"mock_claude\")\n589\t\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n590\t\t\tt.Fatal(err)\n591\t\t}\n592\t\tpromptFile := filepath.Join(tmpDir, \"prompt.md\")\n593\t\tif err := os.WriteFile(promptFile, []byte(\"# prompt\"), 0644); err != nil {\n594\t\t\tt.Fatal(err)\n595\t\t}\n596\t\tif err := runAutoFix(mockPath, promptFile); err != nil {\n597\t\t\tt.Errorf(\"expected no error with mock binary, got: %v\", err)\n598\t\t}\n599\t}\n600\t\n601\tfunc TestRunAutoFix_FailingBinary(t *testing.T) {\n602\t\ttmpDir := t.TempDir()\n603\t\tmockScript := \"#!/bin/sh\\nexit 1\\n\"\n604\t\tmockPath := filepath.Join(tmpDir, \"mock_claude_fail\")\n605\t\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n606\t\t\tt.Fatal(err)\n607\t\t}\n608\t\tpromptFile := filepath.Join(tmpDir, \"prompt.md\")\n609\t\tif err := os.WriteFile(promptFile, []byte(\"# prompt\"), 0644); err != nil {\n610\t\t\tt.Fatal(err)\n611\t\t}\n612\t\tif err := runAutoFix(mockPath, promptFile); err == nil {\n613\t\t\tt.Error(\"expected error with failing binary\")\n614\t\t}\n615\t}\n616\t\n617\t// ─── collectExecutionData tests ───────────────────────────────────────────────\n618\t\n619\tfunc TestCollectExecutionData_NoDoingDir(t *testing.T) {\n620\t\twithTempWorkspace(t, func(dir string) {\n621\t\t\t_, err := collectExecutionData(\"job_test\")\n622\t\t\tif err == nil {\n623\t\t\t\tt.Fatal(\"expected error for missing doing dir\")\n624\t\t\t}\n625\t\t})\n626\t}\n627\t\n628\tfunc TestCollectExecutionData_WithData(t *testing.T) {\n629\t\twithTempWorkspace(t, func(dir string) {\n630\t\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n631\t\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n632\t\t\t\tt.Fatal(err)\n633\t\t\t}\n634\t\t\t// Create debug.md\n635\t\t\tif err := os.WriteFile(filepath.Join(doingDir, \"debug.md\"), []byte(\"## task1: did work\\nsome content\"), 0644); err != nil {\n636\t\t\t\tt.Fatal(err)\n637\t\t\t}\n638\t\t\t// Create tasks.json\n639\t\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n640\t\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc\"},\n641\t\t\t})\n642\t\t\tdata, err := collectExecutionData(\"job_test\")\n643\t\t\tif err != nil {\n644\t\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n645\t\t\t}\n646\t\t\tif data == nil {\n647\t\t\t\tt.Fatal(\"expected non-nil data\")\n648\t\t\t}\n649\t\t\tif data.JobID != \"job_test\" {\n650\t\t\t\tt.Errorf(\"expected job_id=job_test, got %s\", data.JobID)\n651\t\t\t}\n652\t\t})\n653\t}\n654\t\n655\tfunc TestCollectExecutionData_NoDebugMD(t *testing.T) {\n656\t\twithTempWorkspace(t, func(dir string) {\n657\t\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n658\t\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n659\t\t\t\tt.Fatal(err)\n660\t\t\t}\n661\t\t\t// Create tasks.json but no debug.md\n662\t\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n663\t\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc\"},\n664\t\t\t})\n665\t\t\tdata, err := collectExecutionData(\"job_test\")\n666\t\t\tif err != nil {\n667\t\t\t\tt.Errorf(\"expected no error even without debug.md, got: %v\", err)\n668\t\t\t}\n669\t\t\tif data != nil && data.DebugContent != \"\" {\n670\t\t\t\tt.Logf(\"debug content unexpectedly set: %s\", data.DebugContent)\n671\t\t\t}\n672\t\t})\n673\t}\n674\t\n675\t// ─── commitDoingResults tests ─────────────────────────────────────────────────\n676\t\n677\tfunc TestCommitDoingResults_NoChanges(t *testing.T) {\n678\t\tsetupGitRepo(t)\n679\t\tresult := &executor.ExecutionJobResult{\n680\t\t\tJobID:           \"job_test\",\n681\t\t\tStatus:          \"completed\",\n682\t\t\tTotalTasks:      1,\n683\t\t\tSuccessfulTasks: 1,\n684\t\t}\n685\t\t// No changes to commit - should succeed silently\n686\t\terr := commitDoingResults(\"job_test\", result)\n687\t\tif err != nil {\n688\t\t\tt.Errorf(\"expected no error for no-changes case, got: %v\", err)\n689\t\t}\n690\t}\n691\t\n692\tfunc TestCommitDoingResults_PartialStatus(t *testing.T) {\n693\t\tdir := setupGitRepo(t)\n694\t\t// Create a new file to commit\n695\t\tif err := os.WriteFile(filepath.Join(dir, \"new_file.txt\"), []byte(\"content\"), 0644); err != nil {\n696\t\t\tt.Fatal(err)\n697\t\t}\n698\t\tresult := &executor.ExecutionJobResult{\n699\t\t\tJobID:           \"job_test\",\n700\t\t\tStatus:          \"partial\",\n701\t\t\tTotalTasks:      2,\n702\t\t\tSuccessfulTasks: 1,\n703\t\t\tFailedTasks:     1,\n704\t\t}\n705\t\terr := commitDoingResults(\"job_test\", result)\n706\t\tif err != nil {\n707\t\t\tt.Logf(\"commitDoingResults partial error (acceptable): %v\", err)\n708\t\t}\n709\t}\n710\t\n711\tfunc TestCommitDoingResults_FailedStatus(t *testing.T) {\n712\t\tsetupGitRepo(t)\n713\t\tresult := &executor.ExecutionJobResult{\n714\t\t\tJobID:       \"job_test\",\n715\t\t\tStatus:      \"failed\",\n716\t\t\tTotalTasks:  1,\n717\t\t\tFailedTasks: 1,\n718\t\t}\n719\t\terr := commitDoingResults(\"job_test\", result)\n720\t\tif err != nil {\n721\t\t\tt.Logf(\"commitDoingResults failed status error (acceptable): %v\", err)\n722\t\t}\n723\t}\n724\t\n725\t// ─── ensureGitUserConfigured tests ───────────────────────────────────────────\n726\t\n727\tfunc TestEnsureGitUserConfigured(t *testing.T) {\n728\t\tdir := setupGitRepo(t)\n729\t\terr := ensureGitUserConfigured(dir)\n730\t\tif err != nil {\n731\t\t\tt.Logf(\"ensureGitUserConfigured error (acceptable in test env): %v\", err)\n732\t\t}\n733\t}\n734\t\n735\t// ─── Command RunE tests ───────────────────────────────────────────────────────\n736\t\n737\tfunc TestNewPlanCheckCmd_RunE_NoArgs(t *testing.T) {\n738\t\tcmd := NewPlanCheckCmd()\n739\t\tcmd.SetArgs([]string{})\n740\t\terr := cmd.Execute()\n741\t\t// Should fail because no job_id arg\n742\t\tif err == nil {\n743\t\t\tt.Log(\"expected error for missing job_id\")\n744\t\t}\n745\t}\n746\t\n747\tfunc TestNewDoingCheckCmd_RunE_NoArgs(t *testing.T) {\n748\t\tcmd := NewDoingCheckCmd()\n749\t\tcmd.SetArgs([]string{})\n750\t\terr := cmd.Execute()\n751\t\tif err == nil {\n752\t\t\tt.Log(\"expected error for missing job_id\")\n753\t\t}\n754\t}\n755\t\n756\tfunc TestNewLearningCheckCmd_RunE_NoArgs(t *testing.T) {\n757\t\tcmd := NewLearningCheckCmd()\n758\t\tcmd.SetArgs([]string{})\n759\t\terr := cmd.Execute()\n760\t\tif err == nil {\n761\t\t\tt.Log(\"expected error for missing job_id\")\n762\t\t}\n763\t}\n764\t\n765\tfunc TestNewPlanCheckCmd_RunE_WithWorkspace(t *testing.T) {\n766\t\twithTempWorkspace(t, func(dir string) {\n767\t\t\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n768\t\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n769\t\t\t\tt.Fatal(err)\n770\t\t\t}\n771\t\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n772\t\t\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n773\t\t\t\tt.Fatal(err)\n774\t\t\t}\n775\t\t\tif err := os.WriteFile(filepath.Join(planDir, \"OKR.md\"), []byte(\"# Job OKR\\n## O1: 目标\\n\"), 0644); err != nil {\n776\t\t\t\tt.Fatal(err)\n777\t\t\t}\n778\t\t\tcmd := NewPlanCheckCmd()\n779\t\t\tcmd.SetArgs([]string{\"job_test\"})\n780\t\t\tif err := cmd.Execute(); err != nil {\n781\t\t\t\tt.Logf(\"plan_check RunE error: %v\", err)\n782\t\t\t}\n783\t\t})\n784\t}\n785\t\n786\tfunc TestNewDoingCheckCmd_RunE_WithWorkspace(t *testing.T) {\n787\t\twithTempWorkspace(t, func(dir string) {\n788\t\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n789\t\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n790\t\t\t\tt.Fatal(err)\n791\t\t\t}\n792\t\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n793\t\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc\"},\n794\t\t\t})\n795\t\t\tif err := os.WriteFile(filepath.Join(doingDir, \"debug.md\"), []byte(\"## task1: did work\\nsome content\"), 0644); err != nil {\n796\t\t\t\tt.Fatal(err)\n797\t\t\t}\n798\t\t\tcmd := NewDoingCheckCmd()\n799\t\t\tcmd.SetArgs([]string{\"job_test\"})\n800\t\t\tif err := cmd.Execute(); err != nil {\n801\t\t\t\tt.Logf(\"doing_check RunE error: %v\", err)\n802\t\t\t}\n803\t\t})\n804\t}\n805\t\n806\tfunc TestNewLearningCheckCmd_RunE_WithWorkspace(t *testing.T) {\n807\t\twithTempWorkspace(t, func(dir string) {\n808\t\t\tlearningDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"learning\")\n809\t\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n810\t\t\t\tt.Fatal(err)\n811\t\t\t}\n812\t\t\tif err := os.WriteFile(filepath.Join(learningDir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n813\t\t\t\tt.Fatal(err)\n814\t\t\t}\n815\t\t\tcmd := NewLearningCheckCmd()\n816\t\t\tcmd.SetArgs([]string{\"job_test\"})\n817\t\t\tif err := cmd.Execute(); err != nil {\n818\t\t\t\tt.Logf(\"learning_check RunE error: %v\", err)\n819\t\t\t}\n820\t\t})\n821\t}\n822\t\n823\tfunc TestEnsureGitUserConfigured_WithConfig(t *testing.T) {\n824\t\tdir := setupGitRepo(t)\n825\t\t// Unset git user to force configuration\n826\t\texec.Command(\"git\", \"config\", \"--unset\", \"user.name\").Run()\n827\t\texec.Command(\"git\", \"config\", \"--unset\", \"user.email\").Run()\n828\t\terr := ensureGitUserConfigured(dir)\n829\t\tif err != nil {\n830\t\t\tt.Logf(\"ensureGitUserConfigured error (acceptable): %v\", err)\n831\t\t}\n832\t}\n833\t"}]},"parent_tool_use_id":null,"session_id":"b4e5744b-7a86-4df3-b235-675d51bea5ed","uuid":"8dfa5763-48a9-4749-80e4-f4efcd5373af","timestamp":"2026-06-30T14:49:18.242Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/cmd/tools_test.go","content":"package cmd\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/sunquan/rick/internal/executor\"\n)\n\nfunc containsStr(s, substr string) bool {\n\treturn strings.Contains(s, substr)\n}\n\n// ─── Plan Check Tests ────────────────────────────────────────────────────────\n\nfunc TestRunPlanCheck_NoDir(t *testing.T) {\n\terr := runPlanCheck(\"/nonexistent/path/plan\")\n\tif err == nil {\n\t\tt.Fatal(\"expected error for nonexistent plan dir\")\n\t}\n}\n\nfunc TestRunPlanCheck_NoTasks(t *testing.T) {\n\tdir := t.TempDir()\n\terr := runPlanCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for empty plan dir\")\n\t}\n}\n\nfunc TestRunPlanCheck_MissingSection(t *testing.T) {\n\tdir := t.TempDir()\n\t// Missing '# 关键结果'\n\tcontent := \"# 依赖关系\\n无\\n# 任务名称\\nTest\\n# 任务目标\\nGoal\\n# 测试方法\\nTest\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runPlanCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing section\")\n\t}\n\tif !containsStr(err.Error(), \"关键结果\") {\n\t\tt.Errorf(\"expected error to mention 关键结果, got: %v\", err)\n\t}\n}\n\nfunc TestRunPlanCheck_MissingDepFile(t *testing.T) {\n\tdir := t.TempDir()\n\tcontent := \"# 依赖关系\\ntask99\\n# 任务名称\\nTest\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runPlanCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing dependency\")\n\t}\n\tif !containsStr(err.Error(), \"task99\") {\n\t\tt.Errorf(\"expected error to mention task99, got: %v\", err)\n\t}\n}\n\nfunc TestRunPlanCheck_CircularDep(t *testing.T) {\n\tdir := t.TempDir()\n\ttask1 := \"# 依赖关系\\ntask2\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\ttask2 := \"# 依赖关系\\ntask1\\n# 任务名称\\nTask2\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"task2.md\"), []byte(task2), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runPlanCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for circular dependency\")\n\t}\n\tif !containsStr(err.Error(), \"cycle\") && !containsStr(err.Error(), \"circular\") {\n\t\tt.Errorf(\"expected cycle error, got: %v\", err)\n\t}\n}\n\nfunc TestRunPlanCheck_Valid(t *testing.T) {\n\tdir := t.TempDir()\n\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\ttask2 := \"# 依赖关系\\ntask1\\n# 任务名称\\nTask2\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"task2.md\"), []byte(task2), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// OKR.md is required with meaningful content\n\tokrContent := \"# Job OKR\\n## O1: 目标\\n- KR1: 完成核心功能实现并通过测试\\n- KR2: 代码覆盖率达到 80% 以上\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"OKR.md\"), []byte(okrContent), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runPlanCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for valid plan, got: %v\", err)\n\t}\n}\n\nfunc TestRunPlanCheck_MissingOKR(t *testing.T) {\n\tdir := t.TempDir()\n\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// No OKR.md\n\terr := runPlanCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing OKR.md\")\n\t}\n\tif !containsStr(err.Error(), \"OKR.md\") {\n\t\tt.Errorf(\"expected OKR.md in error, got: %v\", err)\n\t}\n}\n\n// ─── Doing Check Tests ───────────────────────────────────────────────────────\n\nfunc makeTasksJSON(t *testing.T, dir string, tasks []executor.TaskState) {\n\tt.Helper()\n\tnow := time.Now()\n\tdata := map[string]interface{}{\n\t\t\"version\":    \"1.0\",\n\t\t\"created_at\": now,\n\t\t\"updated_at\": now,\n\t\t\"tasks\":      tasks,\n\t}\n\tb, err := json.Marshal(data)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(dir, \"tasks.json\"), b, 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestRunDoingCheck_NoTasksJSON(t *testing.T) {\n\tdir := t.TempDir()\n\terr := runDoingCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing tasks.json\")\n\t}\n}\n\nfunc TestRunDoingCheck_ZombieTask(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"running\"},\n\t})\n\terr := runDoingCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for zombie task\")\n\t}\n\tif !containsStr(err.Error(), \"running\") {\n\t\tt.Errorf(\"expected 'running' in error, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingCheck_MissingCommitHash(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"\"},\n\t})\n\terr := runDoingCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing commit_hash\")\n\t}\n\tif !containsStr(err.Error(), \"commit_hash\") {\n\t\tt.Errorf(\"expected commit_hash in error, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingCheck_Valid(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n\t\t{TaskID: \"task2\", TaskName: \"T2\", Status: \"success\", CommitHash: \"def456\"},\n\t})\n\tif err := runDoingCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for valid doing dir, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingCheck_FailedTaskNoCommit(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"failed\", CommitHash: \"\"},\n\t})\n\tif err := runDoingCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for failed task without commit_hash, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingCheck_DebugBugUnresolved(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n\t})\n\tdebugDir := filepath.Join(dir, \"debug\")\n\tif err := os.MkdirAll(debugDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcontent := \"---\\nsummary: \\\"some bug\\\"\\nstatus: \\\"🔄 进行中\\\"\\n---\\n## 阶段一记录\\n...\"\n\tif err := os.WriteFile(filepath.Join(debugDir, \"bug1-some-bug.md\"), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runDoingCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for unresolved bug\")\n\t}\n\tif !containsStr(err.Error(), \"进行中\") {\n\t\tt.Errorf(\"expected '进行中' in error, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingCheck_DebugBugMissingStatus(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n\t})\n\tdebugDir := filepath.Join(dir, \"debug\")\n\tif err := os.MkdirAll(debugDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcontent := \"## 阶段一记录\\n没有 frontmatter\"\n\tif err := os.WriteFile(filepath.Join(debugDir, \"bug1-no-frontmatter.md\"), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runDoingCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for bug file missing status frontmatter\")\n\t}\n\tif !containsStr(err.Error(), \"status:\") {\n\t\tt.Errorf(\"expected 'status:' in error, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingCheck_DebugBugResolved(t *testing.T) {\n\tdir := t.TempDir()\n\tmakeTasksJSON(t, dir, []executor.TaskState{\n\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n\t})\n\tdebugDir := filepath.Join(dir, \"debug\")\n\tif err := os.MkdirAll(debugDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcontent := \"---\\nsummary: \\\"fixed\\\"\\nstatus: \\\"✅ 已解决\\\"\\n---\\n\\n## Phase 1: 构建反馈回路\\n\\n（复现步骤）\\n\\n## Phase 2: 复现最小化\\n\\n（最小单元）\\n\\n## Phase 3: 可证伪假设\\n\\n（假设列表）\\n\\n## Phase 4: 插桩观察\\n\\n（观测结果）\\n\\n## Phase 5: 修复回归\\n\\n（修复完成）\\n\\n## Phase 6: 清理事后分析\\n\\n（清理完成）\\n\\n## 结论\\n\\n修复完成。\\n\"\n\tif err := os.WriteFile(filepath.Join(debugDir, \"bug1-fixed.md\"), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runDoingCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for resolved bug, got: %v\", err)\n\t}\n}\n\n// ─── Learning Check Tests ─────────────────────────────────────────────────────\n\nfunc TestRunLearningCheck_NoSummary(t *testing.T) {\n\tdir := t.TempDir()\n\terr := runLearningCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing SUMMARY.md\")\n\t}\n\tif !containsStr(err.Error(), \"SUMMARY.md\") {\n\t\tt.Errorf(\"expected SUMMARY.md in error, got: %v\", err)\n\t}\n}\n\nfunc TestRunLearningCheck_EmptySummary(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"   \"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runLearningCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for empty SUMMARY.md\")\n\t}\n\tif !containsStr(err.Error(), \"empty\") && !containsStr(err.Error(), \"# Job\") {\n\t\tt.Errorf(\"expected empty/# Job in error, got: %v\", err)\n\t}\n}\n\nfunc TestRunLearningCheck_MissingJobHeading(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Summary\\nsome content without job heading\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr := runLearningCheck(dir)\n\tif err == nil {\n\t\tt.Fatal(\"expected error for SUMMARY.md missing '# Job' heading\")\n\t}\n\tif !containsStr(err.Error(), \"# Job\") {\n\t\tt.Errorf(\"expected '# Job' in error, got: %v\", err)\n\t}\n}\n\n\nfunc TestRunLearningCheck_Valid(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runLearningCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for valid learning dir, got: %v\", err)\n\t}\n}\n\nfunc TestRunLearningCheck_ValidWithSkill(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttoolsDir := filepath.Join(dir, \"tools\")\n\tif err := os.MkdirAll(toolsDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgoodPy := \"def hello():\\n    return 'world'\\n\"\n\tif err := os.WriteFile(filepath.Join(toolsDir, \"good.py\"), []byte(goodPy), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runLearningCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for valid skill, got: %v\", err)\n\t}\n}\n\nfunc TestRunLearningCheck_ValidOKR(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tokr := \"## O1: 目标\\n### 关键结果\\n1. KR1\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"OKR.md\"), []byte(okr), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runLearningCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for valid OKR, got: %v\", err)\n\t}\n}\n\nfunc TestRunLearningCheck_ValidSPEC(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tspec := \"## 调试环境\\ngo run\\n## 架构设计\\nModular\\n## 编译与运行方法\\ngo build\\n## 观测方法\\nlogs\\n## 控制方法\\nconfig\\n## 技能列表\\n| 名称 | 触发词 | 路径 |\\n\"\n\tif err := os.WriteFile(filepath.Join(dir, \"SPEC.md\"), []byte(spec), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runLearningCheck(dir); err != nil {\n\t\tt.Errorf(\"expected no error for valid SPEC, got: %v\", err)\n\t}\n}\n\n// ─── Tools Command Tests ──────────────────────────────────────────────────────\n\nfunc TestNewToolsCmd(t *testing.T) {\n\tcmd := NewToolsCmd()\n\tif cmd == nil {\n\t\tt.Fatal(\"NewToolsCmd returned nil\")\n\t}\n\tif cmd.Use != \"tools\" {\n\t\tt.Errorf(\"expected Use='tools', got '%s'\", cmd.Use)\n\t}\n}\n\nfunc TestNewPlanCheckCmd(t *testing.T) {\n\tcmd := NewPlanCheckCmd()\n\tif cmd == nil {\n\t\tt.Fatal(\"NewPlanCheckCmd returned nil\")\n\t}\n\tif cmd.Use != \"plan_check <job_id>\" {\n\t\tt.Errorf(\"unexpected Use: %s\", cmd.Use)\n\t}\n}\n\nfunc TestNewDoingCheckCmd(t *testing.T) {\n\tcmd := NewDoingCheckCmd()\n\tif cmd == nil {\n\t\tt.Fatal(\"NewDoingCheckCmd returned nil\")\n\t}\n\tif cmd.Use != \"doing_check <job_id>\" {\n\t\tt.Errorf(\"unexpected Use: %s\", cmd.Use)\n\t}\n}\n\nfunc TestNewLearningCheckCmd(t *testing.T) {\n\tcmd := NewLearningCheckCmd()\n\tif cmd == nil {\n\t\tt.Fatal(\"NewLearningCheckCmd returned nil\")\n\t}\n\tif cmd.Use != \"learning_check <job_id>\" {\n\t\tt.Errorf(\"unexpected Use: %s\", cmd.Use)\n\t}\n}\n\nfunc TestToolsSubcommands(t *testing.T) {\n\tcmd := NewToolsCmd()\n\tsubNames := make(map[string]bool)\n\tfor _, sub := range cmd.Commands() {\n\t\tsubNames[sub.Name()] = true\n\t}\n\texpected := []string{\"plan_check\", \"doing_check\", \"learning_check\", \"dream_check\"}\n\tfor _, name := range expected {\n\t\tif !subNames[name] {\n\t\t\tt.Errorf(\"missing subcommand: %s\", name)\n\t\t}\n\t}\n}\n\n\n// ─── Workspace-dependent tests ────────────────────────────────────────────────\n\n// withTempWorkspace changes the working directory to a temp dir with a .rick structure,\n// calls f, then restores the original working directory.\nfunc withTempWorkspace(t *testing.T, f func(dir string)) {\n\tt.Helper()\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() {\n\t\t_ = os.Chdir(orig)\n\t})\n\tif err := os.MkdirAll(filepath.Join(dir, \".rick\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf(dir)\n}\n\nfunc TestRunDoingDryRun_EmptyJobID(t *testing.T) {\n\t// Empty job ID should not error\n\tif err := runDoingDryRun(\"\"); err != nil {\n\t\tt.Errorf(\"expected no error for empty job ID, got: %v\", err)\n\t}\n}\n\nfunc TestRunDoingDryRun_NoPlanDir(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\t// job_test has no plan dir\n\t\tif err := runDoingDryRun(\"job_test\"); err != nil {\n\t\t\tt.Errorf(\"expected no error (dry-run ignores missing plan), got: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestRunDoingDryRun_WithPlan(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\t\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t// Should not error even if prompt generation has issues\n\t\tif err := runDoingDryRun(\"job_test\"); err != nil {\n\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestRunPlanCheck_WithWorkspace(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\t\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tokrContent := \"# Job OKR\\n## O1: 目标\\n- KR1: 完成核心功能实现并通过测试\\n\"\n\t\tif err := os.WriteFile(filepath.Join(planDir, \"OKR.md\"), []byte(okrContent), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t// Write meaningful SPEC.md so the project-level check passes\n\t\tspecPath := filepath.Join(dir, \".rick\", \"SPEC.md\")\n\t\tspecContent := \"# SPEC\\n## 架构设计\\n本项目采用 Go 标准库实现，无外部依赖。\\n## 编译与运行方法\\n```\\ngo build ./...\\n```\\n\"\n\t\tif err := os.WriteFile(specPath, []byte(specContent), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := runPlanCheck(planDir); err != nil {\n\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestRunDoingCheck_WithWorkspace(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc123\"},\n\t\t})\n\t\tif err := os.WriteFile(filepath.Join(doingDir, \"debug.md\"), []byte(\"## task1: did work\\nsome content\"), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := runDoingCheck(doingDir); err != nil {\n\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestRunLearningCheck_WithWorkspace(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tlearningDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"learning\")\n\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(learningDir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := runLearningCheck(learningDir); err != nil {\n\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n\t\t}\n\t})\n}\n\n// ─── Git helper tests ─────────────────────────────────────────────────────────\n\nfunc setupGitRepo(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { _ = os.Chdir(orig) })\n\n\t// Initialize git repo\n\tcmds := [][]string{\n\t\t{\"git\", \"init\"},\n\t\t{\"git\", \"config\", \"user.email\", \"test@test.com\"},\n\t\t{\"git\", \"config\", \"user.name\", \"Test\"},\n\t}\n\tfor _, args := range cmds {\n\t\tcmd := exec.Command(args[0], args[1:]...)\n\t\tcmd.Dir = dir\n\t\tif err := cmd.Run(); err != nil {\n\t\t\tt.Fatalf(\"git setup failed: %v\", err)\n\t\t}\n\t}\n\t// Create initial commit\n\tif err := os.WriteFile(filepath.Join(dir, \"README.md\"), []byte(\"test\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, args := range [][]string{\n\t\t{\"git\", \"add\", \".\"},\n\t\t{\"git\", \"commit\", \"-m\", \"init\"},\n\t} {\n\t\tcmd := exec.Command(args[0], args[1:]...)\n\t\tcmd.Dir = dir\n\t\tif err := cmd.Run(); err != nil {\n\t\t\tt.Fatalf(\"git commit failed: %v\", err)\n\t\t}\n\t}\n\treturn dir\n}\n\nfunc TestFindClaudeBinary(t *testing.T) {\n\t// Just verify the function runs without panic\n\tpath, err := findClaudeBinary()\n\tif err != nil {\n\t\tt.Logf(\"findClaudeBinary returned error (claude not in PATH): %v\", err)\n\t} else if path == \"\" {\n\t\tt.Error(\"expected non-empty path when claude is found\")\n\t}\n}\n\nfunc TestRunAutoFix_MockBinary(t *testing.T) {\n\ttmpDir := t.TempDir()\n\tmockScript := \"#!/bin/sh\\nexit 0\\n\"\n\tmockPath := filepath.Join(tmpDir, \"mock_claude\")\n\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpromptFile := filepath.Join(tmpDir, \"prompt.md\")\n\tif err := os.WriteFile(promptFile, []byte(\"# prompt\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runAutoFix(mockPath, promptFile); err != nil {\n\t\tt.Errorf(\"expected no error with mock binary, got: %v\", err)\n\t}\n}\n\nfunc TestRunAutoFix_FailingBinary(t *testing.T) {\n\ttmpDir := t.TempDir()\n\tmockScript := \"#!/bin/sh\\nexit 1\\n\"\n\tmockPath := filepath.Join(tmpDir, \"mock_claude_fail\")\n\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpromptFile := filepath.Join(tmpDir, \"prompt.md\")\n\tif err := os.WriteFile(promptFile, []byte(\"# prompt\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := runAutoFix(mockPath, promptFile); err == nil {\n\t\tt.Error(\"expected error with failing binary\")\n\t}\n}\n\n// ─── collectExecutionData tests ───────────────────────────────────────────────\n\nfunc TestCollectExecutionData_NoDoingDir(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\t_, err := collectExecutionData(\"job_test\")\n\t\tif err == nil {\n\t\t\tt.Fatal(\"expected error for missing doing dir\")\n\t\t}\n\t})\n}\n\nfunc TestCollectExecutionData_WithData(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t// Create debug.md\n\t\tif err := os.WriteFile(filepath.Join(doingDir, \"debug.md\"), []byte(\"## task1: did work\\nsome content\"), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t// Create tasks.json\n\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc\"},\n\t\t})\n\t\tdata, err := collectExecutionData(\"job_test\")\n\t\tif err != nil {\n\t\t\tt.Errorf(\"expected no error, got: %v\", err)\n\t\t}\n\t\tif data == nil {\n\t\t\tt.Fatal(\"expected non-nil data\")\n\t\t}\n\t\tif data.JobID != \"job_test\" {\n\t\t\tt.Errorf(\"expected job_id=job_test, got %s\", data.JobID)\n\t\t}\n\t})\n}\n\nfunc TestCollectExecutionData_NoDebugMD(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t// Create tasks.json but no debug.md\n\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc\"},\n\t\t})\n\t\tdata, err := collectExecutionData(\"job_test\")\n\t\tif err != nil {\n\t\t\tt.Errorf(\"expected no error even without debug.md, got: %v\", err)\n\t\t}\n\t\tif data != nil && data.DebugContent != \"\" {\n\t\t\tt.Logf(\"debug content unexpectedly set: %s\", data.DebugContent)\n\t\t}\n\t})\n}\n\n// ─── commitDoingResults tests ─────────────────────────────────────────────────\n\nfunc TestCommitDoingResults_NoChanges(t *testing.T) {\n\tsetupGitRepo(t)\n\tresult := &executor.ExecutionJobResult{\n\t\tJobID:           \"job_test\",\n\t\tStatus:          \"completed\",\n\t\tTotalTasks:      1,\n\t\tSuccessfulTasks: 1,\n\t}\n\t// No changes to commit - should succeed silently\n\terr := commitDoingResults(\"job_test\", result)\n\tif err != nil {\n\t\tt.Errorf(\"expected no error for no-changes case, got: %v\", err)\n\t}\n}\n\nfunc TestCommitDoingResults_PartialStatus(t *testing.T) {\n\tdir := setupGitRepo(t)\n\t// Create a new file to commit\n\tif err := os.WriteFile(filepath.Join(dir, \"new_file.txt\"), []byte(\"content\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult := &executor.ExecutionJobResult{\n\t\tJobID:           \"job_test\",\n\t\tStatus:          \"partial\",\n\t\tTotalTasks:      2,\n\t\tSuccessfulTasks: 1,\n\t\tFailedTasks:     1,\n\t}\n\terr := commitDoingResults(\"job_test\", result)\n\tif err != nil {\n\t\tt.Logf(\"commitDoingResults partial error (acceptable): %v\", err)\n\t}\n}\n\nfunc TestCommitDoingResults_FailedStatus(t *testing.T) {\n\tsetupGitRepo(t)\n\tresult := &executor.ExecutionJobResult{\n\t\tJobID:       \"job_test\",\n\t\tStatus:      \"failed\",\n\t\tTotalTasks:  1,\n\t\tFailedTasks: 1,\n\t}\n\terr := commitDoingResults(\"job_test\", result)\n\tif err != nil {\n\t\tt.Logf(\"commitDoingResults failed status error (acceptable): %v\", err)\n\t}\n}\n\n// ─── ensureGitUserConfigured tests ───────────────────────────────────────────\n\nfunc TestEnsureGitUserConfigured(t *testing.T) {\n\tdir := setupGitRepo(t)\n\terr := ensureGitUserConfigured(dir)\n\tif err != nil {\n\t\tt.Logf(\"ensureGitUserConfigured error (acceptable in test env): %v\", err)\n\t}\n}\n\n// ─── Command RunE tests ───────────────────────────────────────────────────────\n\nfunc TestNewPlanCheckCmd_RunE_NoArgs(t *testing.T) {\n\tcmd := NewPlanCheckCmd()\n\tcmd.SetArgs([]string{})\n\terr := cmd.Execute()\n\t// Should fail because no job_id arg\n\tif err == nil {\n\t\tt.Log(\"expected error for missing job_id\")\n\t}\n}\n\nfunc TestNewDoingCheckCmd_RunE_NoArgs(t *testing.T) {\n\tcmd := NewDoingCheckCmd()\n\tcmd.SetArgs([]string{})\n\terr := cmd.Execute()\n\tif err == nil {\n\t\tt.Log(\"expected error for missing job_id\")\n\t}\n}\n\nfunc TestNewLearningCheckCmd_RunE_NoArgs(t *testing.T) {\n\tcmd := NewLearningCheckCmd()\n\tcmd.SetArgs([]string{})\n\terr := cmd.Execute()\n\tif err == nil {\n\t\tt.Log(\"expected error for missing job_id\")\n\t}\n}\n\nfunc TestNewPlanCheckCmd_RunE_WithWorkspace(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\t\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(planDir, \"OKR.md\"), []byte(\"# Job OKR\\n## O1: 目标\\n\"), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tcmd := NewPlanCheckCmd()\n\t\tcmd.SetArgs([]string{\"job_test\"})\n\t\tif err := cmd.Execute(); err != nil {\n\t\t\tt.Logf(\"plan_check RunE error: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestNewDoingCheckCmd_RunE_WithWorkspace(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"doing\")\n\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tmakeTasksJSON(t, doingDir, []executor.TaskState{\n\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"success\", CommitHash: \"abc\"},\n\t\t})\n\t\tif err := os.WriteFile(filepath.Join(doingDir, \"debug.md\"), []byte(\"## task1: did work\\nsome content\"), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tcmd := NewDoingCheckCmd()\n\t\tcmd.SetArgs([]string{\"job_test\"})\n\t\tif err := cmd.Execute(); err != nil {\n\t\t\tt.Logf(\"doing_check RunE error: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestNewLearningCheckCmd_RunE_WithWorkspace(t *testing.T) {\n\twithTempWorkspace(t, func(dir string) {\n\t\tlearningDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"learning\")\n\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(learningDir, \"SUMMARY.md\"), []byte(\"# Job Summary\\nsome content\"), 0644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tcmd := NewLearningCheckCmd()\n\t\tcmd.SetArgs([]string{\"job_test\"})\n\t\tif err := cmd.Execute(); err != nil {\n\t\t\tt.Logf(\"learning_check RunE error: %v\", err)\n\t\t}\n\t})\n}\n\nfunc TestEnsureGitUserConfigured_WithConfig(t *testing.T) {\n\tdir := setupGitRepo(t)\n\t// Unset git user to force configuration\n\texec.Command(\"git\", \"config\", \"--unset\", \"user.name\").Run()\n\texec.Command(\"git\", \"config\", \"--unset\", \"user.email\").Run()\n\terr := ensureGitUserConfigured(dir)\n\tif err != nil {\n\t\tt.Logf(\"ensureGitUserConfigured error (acceptable): %v\", err)\n\t}\n}\n","numLines":833,"startLine":1,"totalLines":833}}}
