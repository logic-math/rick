{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01FNRea7FTv8UeqoisDaH8Wo","type":"tool_result","content":"1\tpackage cmd\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"os/exec\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/sunquan/rick/internal/executor\"\n13\t)\n14\t\n15\tfunc containsStr(s, substr string) bool {\n16\t\treturn strings.Contains(s, substr)\n17\t}\n18\t\n19\t// ─── Plan Check Tests ────────────────────────────────────────────────────────\n20\t\n21\tfunc TestRunPlanCheck_NoDir(t *testing.T) {\n22\t\terr := runPlanCheck(\"/nonexistent/path/plan\")\n23\t\tif err == nil {\n24\t\t\tt.Fatal(\"expected error for nonexistent plan dir\")\n25\t\t}\n26\t}\n27\t\n28\tfunc TestRunPlanCheck_NoTasks(t *testing.T) {\n29\t\tdir := t.TempDir()\n30\t\terr := runPlanCheck(dir)\n31\t\tif err == nil {\n32\t\t\tt.Fatal(\"expected error for empty plan dir\")\n33\t\t}\n34\t}\n35\t\n36\tfunc TestRunPlanCheck_MissingSection(t *testing.T) {\n37\t\tdir := t.TempDir()\n38\t\t// Missing '# 关键结果'\n39\t\tcontent := \"# 依赖关系\\n无\\n# 任务名称\\nTest\\n# 任务目标\\nGoal\\n# 测试方法\\nTest\\n\"\n40\t\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(content), 0644); err != nil {\n41\t\t\tt.Fatal(err)\n42\t\t}\n43\t\terr := runPlanCheck(dir)\n44\t\tif err == nil {\n45\t\t\tt.Fatal(\"expected error for missing section\")\n46\t\t}\n47\t\tif !containsStr(err.Error(), \"关键结果\") {\n48\t\t\tt.Errorf(\"expected error to mention 关键结果, got: %v\", err)\n49\t\t}\n50\t}\n51\t\n52\tfunc TestRunPlanCheck_MissingDepFile(t *testing.T) {\n53\t\tdir := t.TempDir()\n54\t\tcontent := \"# 依赖关系\\ntask99\\n# 任务名称\\nTest\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n55\t\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(content), 0644); err != nil {\n56\t\t\tt.Fatal(err)\n57\t\t}\n58\t\terr := runPlanCheck(dir)\n59\t\tif err == nil {\n60\t\t\tt.Fatal(\"expected error for missing dependency\")\n61\t\t}\n62\t\tif !containsStr(err.Error(), \"task99\") {\n63\t\t\tt.Errorf(\"expected error to mention task99, got: %v\", err)\n64\t\t}\n65\t}\n66\t\n67\tfunc TestRunPlanCheck_CircularDep(t *testing.T) {\n68\t\tdir := t.TempDir()\n69\t\ttask1 := \"# 依赖关系\\ntask2\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n70\t\ttask2 := \"# 依赖关系\\ntask1\\n# 任务名称\\nTask2\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n71\t\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(task1), 0644); err != nil {\n72\t\t\tt.Fatal(err)\n73\t\t}\n74\t\tif err := os.WriteFile(filepath.Join(dir, \"task2.md\"), []byte(task2), 0644); err != nil {\n75\t\t\tt.Fatal(err)\n76\t\t}\n77\t\terr := runPlanCheck(dir)\n78\t\tif err == nil {\n79\t\t\tt.Fatal(\"expected error for circular dependency\")\n80\t\t}\n81\t\tif !containsStr(err.Error(), \"cycle\") && !containsStr(err.Error(), \"circular\") {\n82\t\t\tt.Errorf(\"expected cycle error, got: %v\", err)\n83\t\t}\n84\t}\n85\t\n86\tfunc TestRunPlanCheck_Valid(t *testing.T) {\n87\t\tdir := t.TempDir()\n88\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n89\t\ttask2 := \"# 依赖关系\\ntask1\\n# 任务名称\\nTask2\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n90\t\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(task1), 0644); err != nil {\n91\t\t\tt.Fatal(err)\n92\t\t}\n93\t\tif err := os.WriteFile(filepath.Join(dir, \"task2.md\"), []byte(task2), 0644); err != nil {\n94\t\t\tt.Fatal(err)\n95\t\t}\n96\t\t// OKR.md is required with meaningful content\n97\t\tokrContent := \"# Job OKR\\n## O1: 目标\\n- KR1: 完成核心功能实现并通过测试\\n- KR2: 代码覆盖率达到 80% 以上\\n\"\n98\t\tif err := os.WriteFile(filepath.Join(dir, \"OKR.md\"), []byte(okrContent), 0644); err != nil {\n99\t\t\tt.Fatal(err)\n100\t\t}\n101\t\tif err := runPlanCheck(dir); err != nil {\n102\t\t\tt.Errorf(\"expected no error for valid plan, got: %v\", err)\n103\t\t}\n104\t}\n105\t\n106\tfunc TestRunPlanCheck_MissingOKR(t *testing.T) {\n107\t\tdir := t.TempDir()\n108\t\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n109\t\tif err := os.WriteFile(filepath.Join(dir, \"task1.md\"), []byte(task1), 0644); err != nil {\n110\t\t\tt.Fatal(err)\n111\t\t}\n112\t\t// No OKR.md\n113\t\terr := runPlanCheck(dir)\n114\t\tif err == nil {\n115\t\t\tt.Fatal(\"expected error for missing OKR.md\")\n116\t\t}\n117\t\tif !containsStr(err.Error(), \"OKR.md\") {\n118\t\t\tt.Errorf(\"expected OKR.md in error, got: %v\", err)\n119\t\t}\n120\t}\n121\t\n122\t// ─── Doing Check Tests ───────────────────────────────────────────────────────\n123\t\n124\tfunc makeTasksJSON(t *testing.T, dir string, tasks []executor.TaskState) {\n125\t\tt.Helper()\n126\t\tnow := time.Now()\n127\t\tdata := map[string]interface{}{\n128\t\t\t\"version\":    \"1.0\",\n129\t\t\t\"created_at\": now,\n130\t\t\t\"updated_at\": now,\n131\t\t\t\"tasks\":      tasks,\n132\t\t}\n133\t\tb, err := json.Marshal(data)\n134\t\tif err != nil {\n135\t\t\tt.Fatal(err)\n136\t\t}\n137\t\tif err := os.WriteFile(filepath.Join(dir, \"tasks.json\"), b, 0644); err != nil {\n138\t\t\tt.Fatal(err)\n139\t\t}\n140\t}\n141\t\n142\tfunc TestRunDoingCheck_NoTasksJSON(t *testing.T) {\n143\t\tdir := t.TempDir()\n144\t\terr := runDoingCheck(dir)\n145\t\tif err == nil {\n146\t\t\tt.Fatal(\"expected error for missing tasks.json\")\n147\t\t}\n148\t}\n149\t\n150\tfunc TestRunDoingCheck_ZombieTask(t *testing.T) {\n151\t\tdir := t.TempDir()\n152\t\tmakeTasksJSON(t, dir, []executor.TaskState{\n153\t\t\t{TaskID: \"task1\", TaskName: \"T1\", Status: \"running\"},\n154\t\t})\n155\t\terr := runDoingCheck(dir)\n156\t\tif err == nil {\n157\t\t\tt.Fatal(\"expected error for zombie task\")\n158\t\t}\n159\t\tif !containsStr(err.Error(), \"running\") {\n160\t\t\tt.Errorf(\"expected 'running' in error, got: %v\", err)\n161\t\t}\n162\t}\n163\t\n164\tfunc TestRunDoingCheck_MissingCommitHash(t *testing.T) {\n165\t\tdir :=