{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01Vxg755kH52fhcGehuKmLZ2","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t\n9\t\t\"github.com/sunquan/rick/internal/parser\"\n10\t)\n11\t\n12\t// TestIntegration_RFC001 covers all assertions for job_9 task1~task4 changes.\n13\t// Each sub-test maps to a specific key result from the task specification.\n14\tfunc TestIntegration_RFC001(t *testing.T) {\n15\t\tpm := NewPromptManager(\"\")\n16\t\tcm := NewContextManager(\"job_9\")\n17\t\n18\t\ttask := &parser.Task{\n19\t\t\tID:           \"task1\",\n20\t\t\tName:         \"RFC001 Test Task\",\n21\t\t\tDependencies: []string{},\n22\t\t\tGoal:         \"Verify RFC001 changes\",\n23\t\t\tKeyResults:   []string{\"KR1\", \"KR2\"},\n24\t\t\tTestMethod:   \"Run tests\",\n25\t\t}\n26\t\tcm.LoadTask(task)\n27\t\n28\t\t// ─── task1: learning input refactor ──────────────────────────────────────\n29\t\n30\t\tt.Run(\"task1/learning_prompt_contains_task_name\", func(t *testing.T) {\n31\t\t\ttmpl, err := pm.LoadTemplate(\"learning\")\n32\t\t\tif err != nil {\n33\t\t\t\tt.Fatalf(\"load learning template: %v\", err)\n34\t\t\t}\n35\t\t\tif !strings.Contains(tmpl.Content, \"{{task_md_files}}\") {\n36\t\t\t\tt.Error(\"learning template must contain {{task_md_files}} variable\")\n37\t\t\t}\n38\t\t\tif !strings.Contains(tmpl.Content, \"{{okr_content}}\") {\n39\t\t\t\tt.Error(\"learning template must contain {{okr_content}} variable\")\n40\t\t\t}\n41\t\t})\n42\t\n43\t\tt.Run(\"task1/learning_prompt_no_hardcoded_stub_strings\", func(t *testing.T) {\n44\t\t\t// The old learning_prompt.go had four stub functions that returned\n45\t\t\t// hardcoded Chinese placeholder text. Verify they are gone.\n46\t\t\ttmpl, err := pm.LoadTemplate(\"learning\")\n47\t\t\tif err != nil {\n48\t\t\t\tt.Fatalf(\"load learning template: %v\", err)\n49\t\t\t}\n50\t\t\tforbidden := []string{\n51\t\t\t\t\"本周期内新增\",\n52\t\t\t\t\"本周期内的代码改进\",\n53\t\t\t}\n54\t\t\tfor _, s := range forbidden {\n55\t\t\t\tif strings.Contains(tmpl.Content, s) {\n56\t\t\t\t\tt.Errorf(\"learning template must not contain hardcoded stub string %q\", s)\n57\t\t\t\t}\n58\t\t\t}\n59\t\t})\n60\t\n61\t\tt.Run(\"task1/learning_template_no_git_show\", func(t *testing.T) {\n62\t\t\ttmpl, err := pm.LoadTemplate(\"learning\")\n63\t\t\tif err != nil {\n64\t\t\t\tt.Fatalf(\"load learning template: %v\", err)\n65\t\t\t}\n66\t\t\tif strings.Contains(tmpl.Content, \"git show\") {\n67\t\t\t\tt.Error(\"learning template must not contain 'git show' instruction\")\n68\t\t\t}\n69\t\t})\n70\t\n71\t\tt.Run(\"task1/buildLearningPrompt_contains_task_md_content\", func(t *testing.T) {\n72\t\t\t// Now task*.md are injected as paths, not content.\n73\t\t\t// Verify the task file path appears in the prompt.\n74\t\t\ttmpDir := t.TempDir()\n75\t\t\tplanDir := filepath.Join(tmpDir, \"plan\")\n76\t\t\tif err := os.MkdirAll(planDir, 0755); err != nil {\n77\t\t\t\tt.Fatal(err)\n78\t\t\t}\n79\t\t\ttaskFile := filepath.Join(planDir, \"task1.md\")\n80\t\t\tif err := os.WriteFile(taskFile, []byte(\"# 任务名称\\n实现登录接口\\n\"), 0644); err != nil {\n81\t\t\t\tt.Fatal(err)\n82\t\t\t}\n83\t\n84\t\t\tprompt, err := buildLearningPromptForTest(t, \"job_test\", taskFile, \"\", tmpDir)\n85\t\t\tif err != nil {\n86\t\t\t\tt.Fatalf(\"buildLearningPromptForTest: %v\", err)\n87\t\t\t}\n88\t\t\tif !strings.Contains(prompt, \"task1.md\") {\n89\t\t\t\tt.Error(\"learning prompt must contain task file path\")\n90\t\t\t}\n91\t\t})\n92\t\n93\t\tt.Run(\"task1/buildLearningPrompt_contains_okr_content\", func(t *testing.T) {\n94\t\t\tokrContent := \"# Job OKR\\n## O1: 实现用户认证\\n- KR1: 完成登录接口\"\n95\t\t\tprompt, err := buildLearningPromptForTest(t, \"job_test\", \"\", okrContent, t.TempDir())\n96\t\t\tif err != nil {\n97\t\t\t\tt.Fatalf(\"buildLearningPromptForTest: %v\", err)\n98\t\t\t}\n99\t\t\tif !strings.Contains(prompt, \"实现用户认证\") {\n100\t\t\t\tt.Error(\"learning prompt must contain OKR content when OKR.md exists\")\n101\t\t\t}\n102\t\t})\n103\t\n104\t\t// ─── task2: skills index ──────────────────────────────────────────────────\n105\t\n106\t\tt.Run(\"task2/plan_prompt_skills_from_spec_not_index\", func(t *testing.T) {\n107\t\t\t// skills are now expected in SPEC.md (via spec_content), not injected from index.md\n108\t\t\ttmpDir := t.TempDir()\n109\t\t\tspecContent := \"# SPEC\\n## 技能列表\\n| 名称 | 触发词 | 路径 |\\n|------|--------|------|\\n| my_skill | debug | .rick/wiki/my_skill.md |\\n\"\n110\t\t\tif err := os.WriteFile(filepath.Join(tmpDir, \"SPEC.md\"), []byte(specContent), 0644); err != nil {\n111\t\t\t\tt.Fatal(err)\n112\t\t\t}\n113\t\n114\t\t\tpromptContent, err := GeneratePlanPrompt(\"需求描述\", \"/tmp/plan\", tmpDir)\n115\t\t\tif err != nil {\n116\t\t\t\tt.Fatalf(\"GeneratePlanPrompt: %v\", err)\n117\t\t\t}\n118\t\t\tif !strings.Contains(promptContent, \"技能列表\") {\n119\t\t\t\tt.Error(\"plan prompt must contain skills from SPEC.md spec_content\")\n120\t\t\t}\n121\t\t})\n122\t\n123\t\t// ─── task3: tools injection ───────────────────────────────────────────────\n124\t\n125\t\tt.Run(\"task3/plan_prompt_no_tools_injection\", func(t *testing.T) {\n126\t\t\t// tools are no longer injected directly into plan prompt (moved to SPEC.md 控制方法)\n127\t\t\ttmpDir := t.TempDir()\n128\t\t\ttoolsDir := filepath.Join(tmpDir, \"tools\")\n129\t\t\tif err := os.MkdirAll(toolsDir, 0755); err != nil {\n130\t\t\t\tt.Fatal(err)\n131\t\t\t}\n132\t\t\tif err := os.WriteFile(filepath.Join(toolsDir, \"plan_tool.py\"), []byte(\"# Description: 规划工具\\nprint('plan')\\n\"), 0644); err != nil {\n133\t\t\t\tt.Fatal(err)\n134\t\t\t}\n135\t\n136\t\t\torig, _ := os.Getwd()\n137\t\t\tif err := os.Chdir(tmpDir); err != nil {\n138\t\t\t\tt.Fatal(err)\n139\t\t\t}\n140\t\t\tdefer os.Chdir(orig)\n141\t\n142\t\t\tpromptContent, err := GeneratePlanPrompt(\"需求\", \"/tmp/plan\", \"\")\n143\t\t\tif err != nil {\n144\t\t\t\tt.Fatalf(\"GeneratePlanPrompt: %v\", err)\n145\t\t\t}\n146\t\t\t// tools are no longer auto-injected into plan prompt\n147\t\t\tif strings.Contains(promptContent, \"{{tools_list}}\") {\n148\t\t\t\tt.Error(\"plan prompt must not contain unreplaced {{tools_list}} variable\")\n149\t\t\t}\n150\t\t})\n151\t\n152\t\tt.Run(\"task3/doing_prompt_no_tools_section_when_no_tools\", func(t *testing.T) {\n153\t\t\ttmpDir := t.TempDir()\n154\t\t\t// No tools/ directory\n155\t\n156\t\t\torig, _ := os.Getwd()\n157\t\t\tif err := os.Chdir(tmpDir); err != nil {\n158\t\t\t\tt.Fatal(err)\n159\t\t\t}\n160\t\t\tdefer os.Chdir(orig)\n161\t\n162\t\t\tpromptFile, _, err := GenerateDoingPromptFile(task, 0, cm, pm, t.TempDir())\n163\t\t\tif err != nil {\n164\t\t\t\tt.Fatalf(\"GenerateDoingPromptFile: %v\", err)\n165\t\t\t}\n166\t\n167\t\t\tdata, err := os.ReadFile(promptFile)\n168\t\t\tif err != nil {\n169\t\t\t\tt.Fatal(err)\n170\t\t\t}\n171\t\t\tif strings.Contains(string(data), \"可用的项目 Tools\") {\n172\t\t\t\tt.Error(\"doing prompt must not contain tools section when tools/ does not exist\")\n173\t\t\t}\n174\t\t})\n175\t\n176\t\tt.Run(\"task3/plan_prompt_no_tools_section_when_no_tools\", func(t *testing.T) {\n177\t\t\ttmpDir := t.TempDir()\n178\t\n179\t\t\torig, _ := os.Getwd()\n180\t\t\tif err := os.Chdir(tmpDir); err != nil {\n181\t\t\t\tt.Fatal(err)\n182\t\t\t}\n183\t\t\tdefer os.Chdir(orig)\n184\t\n185\t\t\tpromptContent, err := GeneratePlanPrompt(\"需求\", \"/tmp/plan\", \"\")\n186\t\t\tif err != nil {\n187\t\t\t\tt.Fatalf(\"GeneratePlanPrompt: %v\", err)\n188\t\t\t}\n189\t\t\t// tools_list variable should be replaced with empty string\n190\t\t\tif strings.Contains(promptContent, \"{{tools_list}}\") {\n191\t\t\t\tt.Error(\"plan prompt must not contain unreplaced {{tools_list}} variable\")\n192\t\t\t}\n193\t\t})\n194\t\n195\t\t// ─── task4: job-level OKR ─────────────────────────────────────────────────\n196\t\n197\t\tt.Run(\"task4/plan_prompt_no_global_okr_content\", func(t *testing.T) {\n198\t\t\t// plan template should