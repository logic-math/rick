r the prompt\n246\tfunc formatKeyResults(keyResults []string) string {\n247\t\tif len(keyResults) == 0 {\n248\t\t\treturn \"暂无关键结果\"\n249\t\t}\n250\t\n251\t\tvar content strings.Builder\n252\t\tfor i, kr := range keyResults {\n253\t\t\tcontent.WriteString(fmt.Sprintf(\"%d. %s\\n\", i+1, kr))\n254\t\t}\n255\t\n256\t\treturn content.String()\n257\t}\n258\t\n259\t// formatProjectArchitecture formats project architecture information\n260\tfunc formatProjectArchitecture() string {\n261\t\treturn `Rick 项目采用模块化架构设计：\n262\t\n263\t**核心模块**:\n264\t- infrastructure: 基础设施模块（Go 项目初始化、CLI、工作空间、配置、日志）\n265\t- parser: 内容解析模块（Markdown、task.md、debug.md、OKR/SPEC 解析）\n266\t- dag_executor: DAG 执行模块（DAG 构建、拓扑排序、任务执行、重试机制）\n267\t- prompt_manager: 提示词管理模块（模板、构建、上下文、各阶段提示词生成）\n268\t- cli_commands: 命令处理模块（init、plan、doing、learning 命令）\n269\t\n270\t**关键设计**:\n271\t- 使用 Go 标准库为主，最小化外部依赖\n272\t- 提示词管理是核心创新，支持多阶段提示词生成\n273\t- 任务执行采用 DAG 拓扑排序，支持并行和串行执行\n274\t- 失败重试机制，超过限制后需人工干预`\n275\t}\n276\t\n277\t// formatCompletedTasks formats completed tasks for the prompt\n278\tfunc formatCompletedTasks(history []string) string {\n279\t\tif len(history) == 0 {\n280\t\t\treturn \"暂无已完成的任务\"\n281\t\t}\n282\t\n283\t\tvar content strings.Builder\n284\t\tfor _, item := range history {\n285\t\t\tcontent.WriteString(fmt.Sprintf(\"- %s\\n\", item))\n286\t\t}\n287\t\n288\t\treturn content.String()\n289\t}\n290\t\n291\t// formatTaskDependencies formats task dependencies for the prompt\n292\tfunc formatTaskDependencies(dependencies []string) string {\n293\t\tif len(dependencies) == 0 {\n294\t\t\treturn \"该任务无依赖关系\"\n295\t\t}\n296\t\n297\t\tvar content strings.Builder\n298\t\tcontent.WriteString(\"该任务依赖以下任务的完成：\\n\")\n299\t\tfor _, dep := range dependencies {\n300\t\t\tcontent.WriteString(fmt.Sprintf(\"- %s\\n\", dep))\n301\t\t}\n302\t\n303\t\treturn content.String()\n304\t}\n305\t\n306\t// formatDebugContext formats debug information for retry prompts\n307\tfunc formatDebugContext(debugInfo *parser.DebugInfo) string {\