{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016p42BPpiWRFYxtBNT5AdQo","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t)\n10\t\n11\t// GenerateDreamPrompt generates the dream prompt content with placeholder paths (for dry-run).\n12\tfunc GenerateDreamPrompt(jobIDs []string, rickDir string) (string, error) {\n13\t\tmgr := NewPromptManager()\n14\t\ttmpl, err := mgr.LoadTemplate(\"dream\")\n15\t\tif err != nil {\n16\t\t\treturn \"\", fmt.Errorf(\"failed to load dream template: %w\", err)\n17\t\t}\n18\t\tbuilder := NewPromptBuilder(tmpl)\n19\t\tbuilder.SetVariable(\"pending_jobs\", formatPendingJobs(jobIDs))\n20\t\tbuilder.SetVariable(\"run_logs\", loadRunLogs(rickDir))\n21\t\tbuilder.SetVariable(\"loops_context\", LoadLoopsContext(filepath.Join(rickDir, \"loops\")))\n22\t\tbuilder.SetVariable(\"loops_dir\", \"<loops_dir>\")\n23\t\tbuilder.SetVariable(\"skills_dir\", \"<skills_dir>\")\n24\t\tbuilder.SetVariable(\"sense_skill_path\", \"<tmp>/rick-dream-skill-sense-*.md\")\n25\t\tbuilder.SetVariable(\"evolve_skills_skill_path\", \"<tmp>/rick-dream-skill-evolve-*.md\")\n26\t\tbuilder.SetVariable(\"source_context_consistency_skill_path\", \"<tmp>/rick-dream-skill-source-context-consistency-*.md\")\n27\t\tbuilder.SetVariable(\"refactor_rfc_skill_path\", \"<tmp>/rick-dream-skill-refactor-rfc-*.md\")\n28\t\tbuilder.SetVariable(\"rick_bin_path\", \"<rick>\")\n29\t\tcontent, err := builder.Build()\n30\t\tif err != nil {\n31\t\t\treturn \"\", fmt.Errorf(\"failed to build dream prompt: %w\", err)\n32\t\t}\n33\t\tactPathContent := loadActPaths(jobIDs, rickDir)\n34\t\tif actPathContent != \"\" {\n35\t\t\tcontent += \"\\n\\n## 行为轨迹文件路径（按需读取）\\n\\n\" + actPathContent\n36\t\t}\n37\t\treturn content, nil\n38\t}\n39\t\n40\t// GenerateDreamPromptFile generates the dream phase prompt and saves it to .rick/dream/prompts/.\n41\t// jobIDs is the list of jobs to process; rickDir is the .rick directory path.\n42\t// All files are persistent; no cleanup needed.\n43\tfunc GenerateDreamPromptFile(jobIDs []string, rickDir string) (string, []string, error) {\n44\t\tmgr := NewPromptManager()\n45\t\n46\t\ttmpl, err := mgr.LoadTemplate(\"dream\")\n47\t\tif err != nil {\n48\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load dream template: %w\", err)\n49\t\t}\n50\t\n51\t\tdreamDir := filepath.Join(rickDir, \"dream\")\n52\t\tpromptsDir, err := EnsurePromptsDir(dreamDir)\n53\t\tif err != nil {\n54\t\t\treturn \"\", nil, fmt.Errorf(\"failed to create dream prompts dir: %w\", err)\n55\t\t}\n56\t\n57\t\tsenseFile, err := WriteSkillFile(promptsDir, \"skill_sense.md\", \"sense\")\n58\t\tif err != nil {\n59\t\t\treturn \"\", nil, err\n60\t\t}\n61\t\tevolveFile, err := WriteSkillFile(promptsDir, \"skill_evolve_skills.md\", \"evolve-skills\")\n62\t\tif err != nil {\n63\t\t\treturn \"\", nil, err\n64\t\t}\n65\t\tsourceContextFile, err := WriteSkillFile(promptsDir, \"skill_source_context_consistency.md\", \"source-context-consistency\")\n66\t\tif err != nil {\n67\t\t\treturn \"\", nil, err\n68\t\t}\n69\t\trefactorRFCFile, err := WriteSkillFile(promptsDir, \"skill_refactor_rfc.md\", \"refactor-rfc\")\n70\t\tif err != nil {\n71\t\t\treturn \"\", nil, err\n72\t\t}\n73\t\n74\t\tloopsDir := filepath.Join(rickDir, \"loops\")\n75\t\tskillsDir := filepath.Join(rickDir, \"skills\")\n76\t\tbuilder := NewPromptBuilder(tmpl)\n77\t\tbuilder.SetVariable(\"pending_jobs\", formatPendingJobs(jobIDs))\n78\t\tbuilder.SetVariable(\"run_logs\", loadRunLogs(rickDir))\n79\t\tbuilder.SetVariable(\"loops_context\", LoadLoopsContext(loopsDir))\n80\t\tbuilder.SetVariable(\"loops_dir\", loopsDir)\n81\t\tbuilder.SetVariable(\"skills_dir\", skillsDir)\n82\t\tbuilder.SetVariable(\"sense_skill_path\", senseFile)\n83\t\tbuilder.SetVariable(\"evolve_skills_skill_path\", evolveFile)\n84\t\tbuilder.SetVariable(\"source_context_consistency_skill_path\", sourceContextFile)\n85\t\tbuilder.SetVariable(\"refactor_rfc_skill_path\", refactorRFCFile)\n86\t\tprojectRoot, _ := os.Getwd()\n87\t\tbuilder.SetVariable(\"rick_bin_path\", filepath.Join(projectRoot, \"bin\", \"rick\"))\n88\t\n89\t\tcontent, err := builder.Build()\n90\t\tif err != nil {\n91\t\t\treturn \"\", nil, fmt.Errorf(\"failed to build dream prompt: %w\", err)\n92\t\t}\n93\t\n94\t\t// Append act-path context for each job\n95\t\tactPathContent := loadActPaths(jobIDs, rickDir)\n96\t\tif actPathContent != \"\" {\n97\t\t\tcontent += \"\\n\\n## 行为轨迹文件路径（按需读取）\\n\\n\" + actPathContent\n98\t\t}\n99\t\n100\t\tpromptFile := filepath.Join(promptsDir, \"dream_prompt.md\")\n101\t\tif err := os.WriteFile(promptFile, []byte(content), 0644); err != nil {\n102\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write dream prompt: %w\", err)\n103\t\t}\n104\t\n105\t\treturn promptFile, nil, nil\n106\t}\n107\t\n108\t\n109\tfunc formatPendingJobs(jobIDs []string) string {\n110\t\tif len(jobIDs) == 0 {\n111\t\t\treturn \"（无待处理 jobs）\"\n112\t\t}\n113\t\tvar sb strings.Builder\n114\t\tfor _, id := range jobIDs {\n115\t\t\tsb.WriteString(\"- \" + id + \"\\n\")\n116\t\t}\n117\t\treturn sb.String()\n118\t}\n119\t\n120\tfunc loadRunLogs(rickDir string) string {\n121\t\tif rickDir == \"\" {\n122\t\t\treturn \"（无历史 dream 记录）\"\n123\t\t}\n124\t\tdreamDir := filepath.Join(rickDir, \"dream\")\n125\t\tentries, err := os.ReadDir(dreamDir)\n126\t\tif err != nil {\n127\t\t\treturn \"（无历史 dream 记录）\"\n128\t\t}\n129\t\n130\t\tvar logs []string\n131\t\tfor _, e := range entries {\n132\t\t\tname := e.Name()\n133\t\t\tif !e.IsDir() && strings.HasPrefix(name, \"dream_run_\") && strings.HasSuffix(name, \"_log.md\") {\n134\t\t\t\tlogs = append(logs, name)\n135\t\t\t}\n136\t\t}\n137\t\tif len(logs) == 0 {\n138\t\t\treturn \"（无历史 dream 记录）\"\n139\t\t}\n140\t\tsort.Strings(logs)\n141\t\n142\t\tvar sb strings.Builder\n143\t\tfor _, name := range logs {\n144\t\t\tcontent, err := os.ReadFile(filepath.Join(dreamDir, name))\n145\t\t\tif err != nil {\n146\t\t\t\tcontinue\n147\t\t\t}\n148\t\t\tsb.WriteString(\"### \" + name + \"\\n\\n\")\n149\t\t\tsb.Write(content)\n150\t\t\tsb.WriteString(\"\\n\\n\")\n151\t\t}\n152\t\treturn sb.String()\n153\t}\n154\t\n155\tfunc loadActPaths(jobIDs []string, rickDir string) string {\n156\t\tif len(jobIDs) == 0 || rickDir == \"\" {\n157\t\t\treturn \"\"\n158\t\t}\n159\t\tvar sb strings.Builder\n160\t\tfor _, jobID := range jobIDs {\n161\t\t\tdoingTasksDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\", \"tasks\")\n162\t\t\tentries, err := os.ReadDir(doingTasksDir)\n163\t\t\tif err != nil {\n164\t\t\t\tcontinue\n165\t\t\t}\n166\t\t\tfor _, e := range entries {\n167\t\t\t\tif !e.IsDir() {\n168\t\t\t\t\tcontinue\n169\t\t\t\t}\n170\t\t\t\tactPath := filepath.Join(doingTasksDir, e.Name(), \"act-path.md\")\n171\t\t\t\tif _, err := os.Stat(actPath); err == nil {\n172\t\t\t\t\tsb.WriteString(fmt.Sprintf(\"- `%s`\\n\", actPath))\n173\t\t\t\t}\n174\t\t\t}\n175\t\t}\n176\t\treturn sb.String()\n177\t}\n178\t"}]},"parent_tool_use_id":"toolu_vrtx_01QfLEQMRaKVfa8MtgMcUJFP","session_id":"fe33ebbd-6c4b-48e1-9176-4bc600974da7","uuid":"533e236d-b467-4e01-b0fc-46904191337d","timestamp":"2026-07-01T02:54:28.053Z"}
