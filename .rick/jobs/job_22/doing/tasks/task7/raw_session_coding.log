mptsDir, \"easy_learning_prompt.md\")\n177\t\tif err := builder.SaveToFile(promptFile); err != nil {\n178\t\t\treturn \"\", fmt.Errorf(\"failed to save easy learning prompt: %w\", err)\n179\t\t}\n180\t\n181\t\treturn promptFile, nil\n182\t}\n183\t\n184\t// buildEasyTaskResults formats the task execution table for easy mode (single easy_session task).\n185\tfunc buildEasyTaskResults(doingDir string) string {\n186\t\theader := \"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\n|---------|---------|------|-------------|----------|\\n\"\n187\t\tdata, err := os.ReadFile(filepath.Join(doingDir, \"tasks.json\"))\n188\t\tif err != nil {\n189\t\t\treturn header + \"| easy_session | Easy Mode Session | unknown | N/A | 1 |\\n\"\n190\t\t}\n191\t\t// Simple extraction: tasks.json has one task with status \"success\"\n192\t\tstatus := \"success\"\n193\t\tif strings.Contains(string(data), `\"status\": \"failed\"`) {\n194\t\t\tstatus = \"failed\"\n195\t\t}\n196\t\treturn header + fmt.Sprintf(\"| easy_session | Easy Mode Session | %s | N/A | 1 |\\n\", status)\n197\t}\n198\t\n199\t// buildCtxSection renders the easy_ctx.md template with ctxPath and localRickDir.\n200\t// Returns empty string when ctxPath is empty (no inheritance).\n201\tfunc buildCtxSection(ctxPath, localRickDir string) string {\n202\t\tif ctxPath == \"\" {\n203\t\t\treturn \"\"\n204\t\t}\n205\t\tmgr := NewPromptManager()\n206\t\ttmpl, err := mgr.LoadTemplate(\"easy_ctx\")\n207\t\tif err != nil {\n208\t\t\treturn \"\"\n209\t\t}\n210\t\tbuilder := NewPromptBuilder(tmpl)\n211\t\tbuilder.SetVariable(\"ctx_path\", ctxPath)\n212\t\tbuilder.SetVariable(\"local_rick_dir\", localRickDir)\n213\t\tcontent, err := builder.Build()\n214\t\tif err != nil {\n215\t\t\treturn \"\"\n216\t\t}\n217\t\treturn content\n218\t}\n219\t\n220\t// loadDebugContextLocal mirrors executor.LoadDebugContext without creating a circular import.\n221\t// Prefers bug*.md frontmatter summaries from doingDir/debug/; falls back to doingDir/debug.md.\n222\t// Returns \"\" when doingDir is empty or does not exist.\n223\t//\n224\t// TODO(2026-08): remove fallback to debug.md after full migration to debug/ dir format.\n225\tfunc loadDebugContextLocal(doingDir string) string {\n226\t\tif doingDir == \"\" {\n227\t\t\treturn \"\"\n228\t\t}\n229\t\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n230\t\t\treturn \"\"\n231\t\t}\n232\t\tdebugDir := filepath.Join(doingDir, \"debug\")\n233\t\tentries, err := os.ReadDir(debugDir)\n234\t\tif err == nil {\n235\t\t\tvar files []string\n236\t\t\tfor _, e := range entries {\n237\t\t\t\tname := e.Name()\n238\t\t\t\tif !e.IsDir() && strings.HasPrefix(name, \"bug\") && strings.HasSuffix(name, \".md\") {\n239\t\t\t\t\tfiles = append(files, name)\n240\t\t\t\t}\n241\t\t\t}\n242\t\t\tif len(files) > 0 {\n243\t\t\t\tsort.Strings(files)\n244\t\t\t\tvar sb strings.Builder\n245\t\t\t\tfor _, name := range files {\n246\t\t\t\t\tdata, err := os.ReadFile(filepath.Join(debugDir, name))\n247\t\t\t\t\tif err != nil {\n248\t\t\t\t\t\tcontinue\n249\t\t\t\t\t}\n250\t\t\t\t\tsummary, status := parser.ExtractBugFrontmatter(string(data))\n251\t\t\t\t\tsb.WriteString(fmt.Sprintf(\"- [%s] summary: %s | status: %s\\n\", name, summary, status))\n252\t\t\t\t}\n253\t\t\t\tif result := sb.String(); result != \"\" {\n254\t\t\t\t\treturn result\n255\t\t\t\t}\n256\t\t\t}\n257\t\t}\n258\t\t// TODO(2026-08): remove fallback after full migration\n259\t\tdata, err := os.ReadFile(filepath.Join(doingDir, \"debug.md\"))\n260\t\tif err != nil {\n261\t\t\treturn \"\"\n262\t\t}\n263\t\treturn string(data)\n264\t}\n265\t\n266\t// readFileOrDefault reads a file and returns its content, or the default string if absent.\n267\tfunc readFileOrDefault(path, defaultVal string) string {\n268\t\tdata, err := os.ReadFile(path)\n269\t\tif err != nil {\n270\t\t\treturn defaultVal\n271\t\t}\n272\t\tcontent := string(data)\n273\t\tif content == \"\" {\n274\t\t\treturn defaultVal\n275\t\t}\n276\t\treturn content\n277\t}\n278\t"}]},"parent_