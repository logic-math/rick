\t\tcontent += \"\\n\\n## 行为轨迹文件路径（按需读取）\\n\\n\" + actPathContent\n90\t\t}\n91\t\n92\t\tpromptFile := filepath.Join(promptsDir, \"dream_prompt.md\")\n93\t\tif err := os.WriteFile(promptFile, []byte(content), 0644); err != nil {\n94\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write dream prompt: %w\", err)\n95\t\t}\n96\t\n97\t\treturn promptFile, nil, nil\n98\t}\n99\t\n100\t\n101\tfunc formatPendingJobs(jobIDs []string) string {\n102\t\tif len(jobIDs) == 0 {\n103\t\t\treturn \"（无待处理 jobs）\"\n104\t\t}\n105\t\tvar sb strings.Builder\n106\t\tfor _, id := range jobIDs {\n107\t\t\tsb.WriteString(\"- \" + id + \"\\n\")\n108\t\t}\n109\t\treturn sb.String()\n110\t}\n111\t\n112\tfunc loadRunLogs(rickDir string) string {\n113\t\tif rickDir == \"\" {\n114\t\t\treturn \"（无历史 dream 记录）\"\n115\t\t}\n116\t\tdreamDir := filepath.Join(rickDir, \"dream\")\n117\t\tentries, err := os.ReadDir(dreamDir)\n118\t\tif err != nil {\n119\t\t\treturn \"（无历史 dream 记录）\"\n120\t\t}\n121\t\n122\t\tvar logs []string\n123\t\tfor _, e := range entries {\n124\t\t\tname := e.Name()\n125\t\t\tif !e.IsDir() && strings.HasPrefix(name, \"dream_run_\") && strings.HasSuffix(name, \"_log.md\") {\n126\t\t\t\tlogs = append(logs, name)\n127\t\t\t}\n128\t\t}\n129\t\tif len(logs) == 0 {\n130\t\t\treturn \"（无历史 dream 记录）\"\n131\t\t}\n132\t\tsort.Strings(logs)\n133\t\n134\t\tvar sb strings.Builder\n135\t\tfor _, name := range logs {\n136\t\t\tcontent, err := os.ReadFile(filepath.Join(dreamDir, name))\n137\t\t\tif err != nil {\n138\t\t\t\tcontinue\n139\t\t\t}\n140\t\t\tsb.WriteString(\"### \" + name + \"\\n\\n\")\n141\t\t\tsb.Write(content)\n142\t\t\tsb.WriteString(\"\\n\\n\")\n143\t\t}\n144\t\treturn sb.String()\n145\t}\n146\t\n147\tfunc loadActPaths(jobIDs []string, rickDir string) string {\n148\t\tif len(jobIDs) == 0 || rickDir == \"\" {\n149\t\t\treturn \"\"\n150\t\t}\n151\t\tvar sb strings.Builder\n152\t\tfor _, jobID := range jobIDs {\n153\t\t\tdoingTasksDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\",