{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_017Udo7r1dYPqqbYFC3gswJ1","type":"tool_result","content":"219\t// LoadCoreSkills reads embedded skill files by name and returns their concatenated content.\n220\t// Names like \"tdd/testing-anti-patterns\" map to templates/skills/tdd/testing-anti-patterns.md.\n221\t// All other names map to templates/skills/{name}.md.\n222\t// Missing files are logged as warnings and skipped — no panic.\n223\tfunc LoadCoreSkills(names []string) string {\n224\t\tvar parts []string\n225\t\tfor _, name := range names {\n226\t\t\tpath := \"templates/skills/\" + name + \".md\"\n227\t\t\tcontent, err := skillsFS.ReadFile(path)\n228\t\t\tif err != nil {\n229\t\t\t\tlog.Printf(\"warn: core skill not found: %s (%v)\", path, err)\n230\t\t\t\tcontinue\n231\t\t\t}\n232\t\t\tif len(content) > 0 {\n233\t\t\t\tparts = append(parts, string(content))\n234\t\t\t}\n235\t\t}\n236\t\treturn strings.Join(parts, \"\\n\\n---\\n\\n\")\n237\t}\n238\t\n239\t// WriteSkillTmpFile writes a core skill's content to a named tmp file and returns its path.\n240\t// Caller is responsible for cleanup via os.Remove.\n241\tfunc WriteSkillTmpFile(pattern string, skillName string) (string, error) {\n242\t\tcontent := LoadCoreSkills([]string{skillName})\n243\t\tf, err := os.CreateTemp(\"\", pattern)\n244\t\tif err != nil {\n245\t\t\treturn \"\", fmt.Errorf(\"failed to create skill tmp file: %w\", err)\n246\t\t}\n247\t\tdefer f.Close()\n248\t\tif _, err := f.WriteString(content); err != nil {\n249\t\t\tos.Remove(f.Name())\n250\t\t\treturn \"\", fmt.Errorf(\"failed to write skill tmp file: %w\", err)\n251\t\t}\n252\t\treturn f.Name(), nil\n253\t}\n254\t\n255\t// EnsurePromptsDir creates and returns the prompts/ subdirectory inside baseDir.\n256\tfunc EnsurePromptsDir(baseDir string) (string, error) {\n257\t\tdir := filepath.Join(baseDir, \"prompts\")\n258\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n259\t\t\treturn \"\", fmt.Errorf(\"failed to create prompts directory: %w\", err)\n260\t\t}\n261\t\treturn dir, nil\n262\t}\n263\t\n264\t// WriteSkillFile writes an embedded skill to dir/filename (persistent, no cleanup needed).\n265\tfunc WriteSkillFile(dir, filename, skillName string) (string, error) {\n266\t\treturn WriteSkillFileWithVars(dir, filename, skillName, nil)\n267\t}\n268\t\n269\t// WriteSkillFileWithVars writes an embedded skill with {{key}} variable substitution.\n270\tfunc WriteSkillFileWithVars(dir, filename, skillName string, vars map[string]string) (string, error) {\n271\t\tcontent := LoadCoreSkills([]string{skillName})\n272\t\tif content == \"\" {\n273\t\t\treturn \"\", fmt.Errorf(\"embedded skill %q not found\", skillName)\n274\t\t}\n275\t\tfor k, v := range vars {\n276\t\t\tcontent = strings.ReplaceAll(content, \"{{\"+k+\"}}\", v)\n277\t\t}\n278\t\tpath := filepath.Join(dir, filename)"}]},"parent_tool_use_id":null,"session_id":"53357a68-1509-474c-93ae-02b822195cda","uuid":"153e09ff-6390-4df7-b9f9-45ffd0b64645","timestamp":"2026-07-01T03:14:44.046Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/prompt/manager.go","content":"// LoadCoreSkills reads embedded skill files by name and returns their concatenated content.\n// Names like \"tdd/testing-anti-patterns\" map to templates/skills/tdd/testing-anti-patterns.md.\n// All other names map to templates/skills/{name}.md.\n// Missing files are logged as warnings and skipped — no panic.\nfunc LoadCoreSkills(names []string) string {\n\tvar parts []string\n\tfor _, name := range names {\n\t\tpath := \"templates/skills/\" + name + \".md\"\n\t\tcontent, err := skillsFS.ReadFile(path)\n\t\tif err != nil {\n\t\t\tlog.Printf(\"warn: core skill not found: %s (%v)\", path, err)\n\t\t\tcontinue\n\t\t}\n\t\tif len(content) > 0 {\n\t\t\tparts = append(parts, string(content))\n\t\t}\n\t}\n\treturn strings.Join(parts, \"\\n\\n---\\n\\n\")\n}\n\n// WriteSkillTmpFile writes a core skill's content to a named tmp file and returns its path.\n// Caller is responsible for cleanup via os.Remove.\nfunc WriteSkillTmpFile(pattern string, skillName string) (string, error) {\n\tcontent := LoadCoreSkills([]string{skillName})\n\tf, err := os.CreateTemp(\"\", pattern)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to create skill tmp file: %w\", err)\n\t}\n\tdefer f.Close()\n\tif _, err := f.WriteString(content); err != nil {\n\t\tos.Remove(f.Name())\n\t\treturn \"\", fmt.Errorf(\"failed to write skill tmp file: %w\", err)\n\t}\n\treturn f.Name(), nil\n}\n\n// EnsurePromptsDir creates and returns the prompts/ subdirectory inside baseDir.\nfunc EnsurePromptsDir(baseDir string) (string, error) {\n\tdir := filepath.Join(baseDir, \"prompts\")\n\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to create prompts directory: %w\", err)\n\t}\n\treturn dir, nil\n}\n\n// WriteSkillFile writes an embedded skill to dir/filename (persistent, no cleanup needed).\nfunc WriteSkillFile(dir, filename, skillName string) (string, error) {\n\treturn WriteSkillFileWithVars(dir, filename, skillName, nil)\n}\n\n// WriteSkillFileWithVars writes an embedded skill with {{key}} variable substitution.\nfunc WriteSkillFileWithVars(dir, filename, skillName string, vars map[string]string) (string, error) {\n\tcontent := LoadCoreSkills([]string{skillName})\n\tif content == \"\" {\n\t\treturn \"\", fmt.Errorf(\"embedded skill %q not found\", skillName)\n\t}\n\tfor k, v := range vars {\n\t\tcontent = strings.ReplaceAll(content, \"{{\"+k+\"}}\", v)\n\t}\n\tpath := filepath.Join(dir, filename)","numLines":60,"startLine":219,"totalLines":284}}}
