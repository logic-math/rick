_path 变量\"),\n49\t        (r\"summary|status\", \"frontmatter summary/status 字段\"),\n50\t    ]\n51\t    for pattern, desc in preserved_patterns:\n52\t        if not re.search(pattern, content):\n53\t            errors.append(f\"保留内容缺失: {desc}\")\n54\t\n55\t    # Test 5: ## Phase [1-6] 章节标题恰好 6 个\n56\t    heading_matches = re.findall(r\"^## Phase [1-6]\", content, re.MULTILINE)\n57\t    if len(heading_matches) != 6:\n58\t        errors.append(f\"'## Phase [1-6]' 章节标题数量应为 6，实际: {len(heading_matches)}\")\n59\t\n60\t    # Test 6: 二进制构建验证\n61\t    build_script = os.path.join(project_root, \"scripts\", \"build.sh\")\n62\t    rick_bin = os.path.join(project_root, \"bin\", \"rick\")\n63\t    try:\n64\t        result = subprocess.run(\n65\t            [\"bash\", build_script],\n66\t            cwd=project_root,\n67\t            capture_output=True,\n68\t            text=True,\n69\t            timeout=120,\n70\t        )\n71\t        if result.returncode != 0:\n72\t            errors.append(f\"build.sh 失败 (exit {result.returncode}): {result.stderr[:300]}\")\n73\t        else:\n74\t            ver_result = subprocess.run(\n75\t                [rick_bin, \"--version\"],\n76\t                cwd=project_root,\n77\t                capture_output=True,\n78\t                text=True,\n79\t                timeout=10,\n80\t            )\n81\t            if ver_result.returncode != 0:\n82\t                errors.append(f\"rick --version 失败: {ver_result.stderr[:200]}\")\n83\t    except subprocess.TimeoutExpired:\n84\t        errors.append(\"build.sh 超时\")\n85\t    except Exception as e:\n86\t        errors.append(f\"构建过程异常: {str(e)}\")\n87\t\n88\t    # Test 7: 单元测试 TestEmbedded\n89\t    try:\n90\t        test_result = subprocess.run(\n91\t            [\"go\", \"test\", \"./internal/prompt/...\", \"-run\", \"TestEmbedded\", \"-v\"],\n92\t            cwd=project_root,\n93\t            capture_output=True,\n94\t            text=True,\n95\t            timeout=60,\n96\t        )\n97\t        if test_result.returncode != 0:\n98\t            errors.append(f\"TestEmbedded 单元测试失败: {test_result.stdout[-300:]}{test_result.stderr[-200:]}\")\n99\t    except subprocess.TimeoutExpired:\n100\t        errors.append(\"go test TestEmbedded 超时\")\n101\t    except Exception as e:\n102\t        errors.append(f\"go test 异常: {str(e)}\")\n103\t\n104\t    result = {\n105\t        \"pass\": len(errors) == 0,\n106\t        \"errors\": errors,\n107\t    }\n108\t    print(json.dumps(result, ensure_ascii=False))\n109\t    sys.exit(0 if result[\"pass\"] else 1)\n110\t\n111\tif __name__ == \"__main__\":\n112\t    main()\n113\t"}]},"parent_tool_use_id":null,"session_id":"b872cc3a-c3fe-4236-8a84-44a94c0d6d8c","uuid":"1b0571a6-22be-448b-b301-6880ef4cdd6c","timestamp":"2026-06-30T12:45:23.787Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/.rick/jobs/job_22/doing/tests/task2.py","content":"#!/usr/bin/env python3\nimport json\nimport sys\nimport os\nimport subprocess\nimport re\n\ndef get_project_root():\n    # 6 dirnames up from this file: tests/ → doing/ → job_22/ → jobs/ → .rick/ → project root\n    path = os.path.abspath(__file__)\n    for _ in range(6):\n        path = os.path.dirname(path)\n    return path\n\ndef main():\n    errors = []\n    project_root = get_project_root()\n    debug_skill = os.path.join(project_root, \"internal\", \"prompt\", \"templates\", \"skills\", \"debug_skill.md\")\n\n    # Test 1: debug_skill.md 存在\n    if not os.path.exists(debug_skill):\n        errors.append(f\"debug_skill.md 不存在: {debug_skill}\")\n        print(json.dumps({\"pass\": False, \"errors\": errors}, ensure_ascii=False))\n        sys.exit(1)\n\n    try:\n        with open(debug_skill, \"r\", encoding=\"utf-8\") as f:\n            content = f.read()\n    except Exception as e:\n        errors.append(f\"读取 debug_skill.md 失败: {str(e)}\")\n        print(json.dumps({\"pass\": False, \"errors\": errors}, ensure_ascii=False))\n        sys.exit(1)\n\n    # Test 2: Phase 1-6 全部存在（正文 \"Phase [1-6]\"，至少 6 处）\n    phase_matches = re.findall(r\"Phase [1-6]\", content)\n    if len(phase_matches) < 6:\n        errors.append(f\"Phase 1-6 出现次数不足 6，实际: {len(phase_matches)}\")\n\n    # Test 3: 旧阶段名已消失\n    old_names = [\"源码推理法\", \"增量调试法\", \"科学实验法\"]\n    for name in old_names:\n        if name in content:\n            errors.append(f\"旧阶段名仍存在: {name}\")\n\n    # Test 4: 保留内容验证（review debug agent 协议、sense 路径、frontmatter 字段）\n    preserved_patterns = [\n        (r\"review debug agent\", \"review debug agent 协议\"),\n        (r\"sense_skill_path\", \"sense_skill_path 变量\"),\n        (r\"summary|status\", \"frontmatter summary/status 字段\"),\n    ]\n    for pattern, desc in preserved_patterns:\n        if not re.search(pattern, content):\n            errors.append(f\"保留内容缺失: {desc}\")\n\n    # Test 5: ## Phase [1-6] 章节标题恰好 6 个\n    heading_matches = re.findall(r\"^## Phase [1-6]\", content, re.MULTILINE)\n    if len(heading_matches) != 6:\n        errors.append(f\"'## Phase [1-6]' 章节标题数量应为 6，实际: {len(heading_matches)}\")\n\n    # Test 6: 二进制构建验证\n    build_script = os.path.join(project_root, \"scripts\", \"build.sh\")\n    rick_bin = os.path.join(project_root, \"bin\", \"rick\")\n    try:\n        result = subprocess.run(\n            [\"bash\", build_script],\n            cwd=project_root,\n            capture_output=True,\n            text=True,\n            timeout=120,\n        )\n        if result.returncode != 0:\n            errors.append(f\"build.sh 失败 (exit {result.returncode}): {result.stderr[:300]}\")\n        else:\n            ver_result = subprocess.run(\n                [rick_bin, \"--version\"],\n                cwd=project_root,\n                capture_output=True,\n                text=True,\n                timeout=10,\n            )\n            if ver_result.returncode != 0:\n                errors.append(f\"rick --version 失败: {ver_result.stderr[:200]}\")\n    except subprocess.TimeoutExpired:\n        errors.append(\"build.sh 超时\")\n    except Exception as e:\n        errors.append(f\"构建过程异常: {str(e)}\")\n\n    # Test 7: 单元测试 TestEmbedded\n    try:\n        test_result = subprocess.run(\n            [\"go\", \"test\", \"./internal/prompt/...\", \"-run\", \"TestEmbedded\", \"-v\"],\n            cwd=project_root,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n        if test_result.returncode != 0:\n            errors.append(f\"TestEmbedded 单元测试失败: {test_result.stdout[-300:]}{test_result.stderr[-200:]}\")\n    except subprocess.TimeoutExpired:\n        errors.append(\"go test TestEmbedded 超时\")\n    except Exception as e:\n        errors.append(f\"go test 异常: {str(e)}\")\n\n    result = {\n        \"pass\": len(errors) == 0,\n        \"errors\": errors,\n    }\n    print(json.dumps(result, ensure_ascii=False))\n    sys.exit(0 if result[\"pass\"] else 1)\n\nif __name__ == \"__main__\":\n    main()\n","numLines":113,"startLine":1,"totalLines":113}}}
