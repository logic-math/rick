{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_015tnVN9KW273S12HbLEv2XU","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/sunquan/rick/internal/parser\"\n11\t)\n12\t\n13\t// GenerateEasyPromptFile generates the easy mode interactive prompt.\n14\t// Persisted to doingDir/prompts/ so it survives session exits.\n15\t// ctxPath is optional; when non-empty the prompt includes ctx-inheritance instructions.\n16\t// Returns mainFile (easy_prompt.md), skill tmp files, error.\n17\tfunc GenerateEasyPromptFile(jobID, requirement, rickDir, ctxPath string) (string, []string, error) {\n18\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n19\t\n20\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n21\t\tif err != nil {\n22\t\t\treturn \"\", nil, fmt.Errorf(\"failed to create prompts dir: %w\", err)\n23\t\t}\n24\t\ttddFile, err := WriteSkillFile(promptsDir, \"skill_tdd_zh.md\", \"tdd-zh\")\n25\t\tif err != nil {\n26\t\t\treturn \"\", nil, err\n27\t\t}\n28\t\tsenseFile, err := WriteSkillFile(promptsDir, \"skill_sense.md\", \"sense\")\n29\t\tif err != nil {\n30\t\t\treturn \"\", nil, err\n31\t\t}\n32\t\tdebugSkillFile, err := WriteSkillFileWithVars(promptsDir, \"skill_debug_skill.md\", \"debug_skill\", map[string]string{\n33\t\t\t\"sense_skill_path\": senseFile,\n34\t\t})\n35\t\tif err != nil {\n36\t\t\treturn \"\", nil, err\n37\t\t}\n38\t\tgrillingFile, err := WriteSkillFile(promptsDir, \"skill_grilling.md\", \"grilling\")\n39\t\tif err != nil {\n40\t\t\treturn \"\", nil, err\n41\t\t}\n42\t\tskillFiles := []string{tddFile, debugSkillFile, senseFile, grillingFile}\n43\t\n44\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"暂无 OKR\")\n45\t\tspecContent := readFileOrDefault(filepath.Join(rickDir, \"SPEC.md\"), \"暂无 SPEC\")\n46\t\tdebugContent := loadDebugContextLocal(doingDir)\n47\t\tif debugContent == \"\" {\n48\t\t\tdebugContent = \"暂无（首次会话）\"\n49\t\t}\n50\t\n51\t\tmgr := NewPromptManager()\n52\t\ttmpl, err := mgr.LoadTemplate(\"easy\")\n53\t\tif err != nil {\n54\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load easy template: %w\", err)\n55\t\t}\n56\t\n57\t\tprojectRoot, _ := os.Getwd()\n58\t\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n59\t\tlearningPromptPath := filepath.Join(promptsDir, \"easy_learning_prompt.md\")\n60\t\n61\t\tbuilder := NewPromptBuilder(tmpl)\n62\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n63\t\tbuilder.SetVariable(\"spec_content\", specContent)\n64\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n65\t\tbuilder.SetVariable(\"requirement\", requirement)\n66\t\tbuilder.SetVariable(\"doing_dir\", doingDir)\n67\t\tbuilder.SetVariable(\"tdd_skill_path\", tddFile)\n68\t\tbuilder.SetVariable(\"debug_skill_path\", debugSkillFile)\n69\t\tbuilder.SetVariable(\"sense_skill_path\", senseFile)\n70\t\tbuilder.SetVariable(\"grilling_skill_path\", grillingFile)\n71\t\tbuilder.SetVariable(\"learning_prompt_path\", learningPromptPath)\n72\t\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n73\t\tbuilder.SetVariable(\"job_id\", jobID)\n74\t\tbuilder.SetVariable(\"ctx_section\", buildCtxSection(ctxPath, rickDir))\n75\t\n76\t\tmainContent, err := builder.Build()\n77\t\tif err != nil {\n78\t\t\treturn \"\", nil, fmt.Errorf(\"failed to build easy prompt: %w\", err)\n79\t\t}\n80\t\n81\t\tmainFile := filepath.Join(promptsDir, \"easy_prompt.md\")\n82\t\tif err := os.WriteFile(mainFile, []byte(mainContent), 0644); err != nil {\n83\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write easy prompt: %w\", err)\n84\t\t}\n85\t\n86\t\treturn mainFile, skillFiles, nil\n87\t}\n88\t\n89\t// GenerateEasyPrompt generates the easy prompt content with placeholder paths (for dry-run).\n90\t// Does not create any directories or write any files.\n91\tfunc GenerateEasyPrompt(requirement, rickDir, ctxPath string) (string, error) {\n92\t\tif requirement == \"\" {\n93\t\t\trequirement = \"<requirement>\"\n94\t\t}\n95\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"暂无 OKR\")\n96\t\tspecContent := readFileOrDefault(filepath.Join(rickDir, \"SPEC.md\"), \"暂无 SPEC\")\n97\t\n98\t\tmgr := NewPromptManager()\n99\t\ttmpl, err := mgr.LoadTemplate(\"easy\")\n100\t\tif err != nil {\n101\t\t\treturn \"\", fmt.Errorf(\"failed to load easy template: %w\", err)\n102\t\t}\n103\t\n104\t\tprojectRoot, _ := os.Getwd()\n105\t\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n106\t\tdoingDir := filepath.Join(rickDir, \"jobs\", \"job_N\", \"doing\")\n107\t\tpromptsDir := filepath.Join(doingDir, \"prompts\")\n108\t\n109\t\tbuilder := NewPromptBuilder(tmpl)\n110\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n111\t\tbuilder.SetVariable(\"spec_content\", specContent)\n112\t\tbuilder.SetVariable(\"debug_content\", \"暂无（首次会话）\")\n113\t\tbuilder.SetVariable(\"requirement\", requirement)\n114\t\tbuilder.SetVariable(\"doing_dir\", doingDir)\n115\t\tbuilder.SetVariable(\"tdd_skill_path\", filepath.Join(promptsDir, \"skill_tdd_zh.md\"))\n116\t\tbuilder.SetVariable(\"debug_skill_path\", filepath.Join(promptsDir, \"skill_debug_skill.md\"))\n117\t\tbuilder.SetVariable(\"sense_skill_path\", filepath.Join(promptsDir, \"skill_sense.md\"))\n118\t\tbuilder.SetVariable(\"grilling_skill_path\", filepath.Join(promptsDir, \"skill_grilling.md\"))\n119\t\tbuilder.SetVariable(\"learning_prompt_path\", filepath.Join(promptsDir, \"easy_learning_prompt.md\"))\n120\t\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n121\t\tbuilder.SetVariable(\"job_id\", \"job_N\")\n122\t\tbuilder.SetVariable(\"ctx_section\", buildCtxSection(ctxPath, rickDir))\n123\t\n124\t\treturn builder.Build()\n125\t}\n126\t\n127\t// GenerateEasyLearningPromptFile generates the learning prompt after a session ends.\n128\t// Called after the easy session completes so doingDir is fully populated (debug/, tasks.json, etc.).\n129\t// Reuses the same learning.md template as the standard learning phase.\n130\t// Returns the path to the generated prompt file.\n131\tfunc GenerateEasyLearningPromptFile(jobID, rickDir string) (string, error) {\n132\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n133\t\tlearningDir := filepath.Join(rickDir, \"jobs\", jobID, \"learning\")\n134\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n135\t\t\treturn \"\", fmt.Errorf(\"failed to create learning dir: %w\", err)\n136\t\t}\n137\t\n138\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n139\t\tif err != nil {\n140\t\t\treturn \"\", fmt.Errorf(\"failed to create prompts dir: %w\", err)\n141\t\t}\n142\t\n143\t\tmgr := NewPromptManager()\n144\t\ttmpl, err := mgr.LoadTemplate(\"learning\")\n145\t\tif err != nil {\n146\t\t\treturn \"\", fmt.Errorf(\"failed to load learning template: %w\", err)\n147\t\t}\n148\t\n149\t\tbuilder := NewPromptBuilder(tmpl)\n150\t\tbuilder.SetVariable(\"job_id\", jobID)\n151\t\tbuilder.SetVariable(\"learning_dir\", learningDir)\n152\t\n153\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"（本 job 无 OKR.md）\")\n154\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n155\t\n156\t\tspecPath := filepath.Join(rickDir, \"SPEC.md\")\n157\t\tbuilder.SetVariable(\"spec_path\", specPath)\n158\t\tbuilder.SetVariable(\"wiki_dir\", filepath.Join(rickDir, \"wiki\"))\n159\t\tbuilder.SetVariable(\"tools_dir\", filepath.Join(rickDir, \"tools\"))\n160\t\n161\t\tdebugContent := loadDebugContextLocal(doingDir)\n162\t\tif debugContent == \"\" {\n163\t\t\tdebugContent = \"（本次 job 无 debug 记录）\"\n164\t\t}\n165\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n166\t\n167\t\t// easy mode has no task*.md files\n168\t\tbuilder.SetVariable(\"task_md_files\", \"  （easy 模式无 task*.md 文件）\")\n169\t\n170\t\t// easy mode has no per-task act-path.md\n171\t\tbuilder.SetVariable(\"act_path_files\", \"  （easy 模式无 act-path.md 文件）\")\n172\t\n173\t\t// tasks.json: easy session writ