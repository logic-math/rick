 = content[3:]\n    idx = rest.find('\\n---')\n    if idx == -1:\n        return None, content, 'missing closing ---'\n    fm_text = rest[:idx]\n    body = rest[idx+4:]  # after \\n---\n    fm = {}\n    for line in fm_text.splitlines():\n        line = line.strip()\n        if not line or line.startswith('#'):\n            continue\n        if ':' in line:\n            k, v = line.split(':', 1)\n            fm[k.strip()] = v.strip()\n    return fm, body, None\n```\n\nActually, let me be careful with the frontmatter body split. The body after closing `---` is `rest[idx+len('\\n---'):]`. `rest[idx+4:]` = after `\\n---`. But if there's `---\\n` at line end, idx points to `\\n` before `---`. Let me handle robustly.\n\nActually, I'll just split the content on lines and detect the two `---` lines.\n\n```python\ndef parse_frontmatter(content):\n    lines = content.split('\\n')\n    if not lines or lines[0].strip() != '---':\n        return None, None, 'missing opening ---'\n    end = None\n    for i in range(1, len(lines)):\n        if lines[i].strip() == '---':\n            end = i\n            break\n    if end is None:\n        return None, None, 'missing closing ---'\n    fm_lines = lines[1:end]\n    body = '\\n'.join(lines[end+1:])\n    fm = {}\n    for ln in fm_lines:\n        ln = ln.strip()\n        if not ln or ln.startswith('#'):\n            continue\n        if ':' in ln:\n            k, v = ln.split(':', 1)\n            fm[k.strip()] = v.strip()\n    return fm, body, None\n```\n\nThis returns (frontmatter dict, body, error). For `name: think`, fm['name'] = 'think'. For `tools: read, grep, find, ls`, fm['tools'] = 'read, grep, find, ls'.\n\n6. Check body non-empty (after frontmatter):\n```python\ndef body_nonblank_lines(body):\n    return [ln for ln in body.split('\\n') if ln.strip()]\n```\n\nThe exception test: `awk '/^---$/{n++} n>=2 && /[^[:space:]]/{print}'` counts lines after 2nd `---` that have non-space. Equivalent: number of non-blank lines in body ≥ 1.\n\n7. sha256 helper:\n```python\ndef sha256_file(path):\n    h = hashlib.sha256()\n    with open(path, 'rb') as f:\n        for chunk in iter(lambda: f.read(65536), b''):\n            h.update(chunk)\n    return h.hexdigest()\n```\n\nNow the test flow in `main()`:\n\n```python\ndef main():\n    errors = []\n    repo_root = find_repo_root(__file__)\n    go = shutil.which('go')\n    if not go:\n        ... return fail\n\n    # write deploy program\n    prog_dir = write_deploy_program(repo_root)\n\n    # ---- Normal path ----\n    agent_dir = tempfile.mkdtemp(prefix='rick_task9_agent_')\n    home = tempfile.mkdtemp(prefix='rick_task9_home_')\n    rc, out, err = run_deploy(go, prog_dir, agent_dir, home)\n    if rc != 0:\n        errors.append('DeployRickCustomizations (正常路径) failed exit=%d: %s' % (rc, tail(err or out)))\n    else:\n        for name, spec in AGENTS.items():\n            p = os.path.join(agent_dir, 'agents', name + '.md')\n            if not os.path.isfile(p):\n                errors.append('%s.md 未落盘: %s' % (name, p))\n            else:\n                content = read_text(p)\n                fm, body, ferr = parse_frontmatter(content)\n                if ferr:\n                    errors.append('%s.md frontmatter 解析失败: %s' % (name, ferr))\n                else:\n                    # name field\n                    if fm.get('name') != spec['name']:\n                        errors.append('%s.md frontmatter name=%r, want %r' % (name, fm.get('name'), spec['name']))\n                    # tools field\n                    if fm.get('tools') != spec['tools']:\n                        errors.append('%s.md frontmatter tools=%r, want %r' % (name, fm.get('tools'), spec['tools']))\n                    # description + defaultContext fields present\n                    for key in ('description', 'defaultContext'):\n                        if key not in fm:\n                            errors.append('%s.md frontmatter 缺 %s 字段' % (name, key))\n                    # rick-managed marker\n                    if 'rick-managed' not in fm:\n                        errors.append('%s.md frontmatter 缺 rick-managed 标记' % name)\n        # head -5 think.md contains name: think\n        think_path = os.path.join(agent_dir, 'agents', 'think.md')\n        if os.path.isfile(think_path):\n            head5 = first_n_lines(think_path, 5)\n            if 'name: think' not in head5:\n                errors.append(\"head -5 think.md 不含 `name: think`\")\n        # discovery: names from frontmatter == {think,research,exporter}\n        discovered = set()\n        for name in AGENTS:\n            p = os.path.join(agent_dir, 'agents', name + '.md')\n            if os.path.isfile(p):\n                fm, _, _ = parse_frontmatter(read_text(p))\n                if fm and fm.get('name') == name:\n                    discovered.add(name)\n        if discovered != {'think','research','exporter'}:\n            errors.append('agent 发现清单不完整: %s' % sorted(discovered))\n\n        # ---- Idempotent boundary (same agent_dir) ----\n        before = {n: sha256_file(...) for n in AGENTS if file exists}\n        rc2, out2, err2 = run_deploy(...)\n        if rc2 != 0: error\n        else:\n            after = {...}\n            if before != after: error (content changed, not idempotent)\n    ```\n\nWait, I need to be careful: the idempotent boundary test should run regardless of whether normal path succeeded partially. But if normal path failed to create files, the sha256 comparison would be trivially equal (empty). Better to structure: do idempotent check only if the 3 files exist after first deploy. I'll guard.\n\nActually, let me structure more linearly with clear phases, collecting errors. Let me write it so each phase is somewhat independent:\n\nPhase A (normal): fresh agent_dir_a, deploy, assert 3 files + frontmatter + discovery + head-5.\n\nPhase B (idempotent): reuse agent_dir_a (already has files), record sha, deploy again, compare.\n\nPhase C (overwrite seman