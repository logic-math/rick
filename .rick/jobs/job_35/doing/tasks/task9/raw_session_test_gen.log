R'] = agent_dir\nenv['HOME'] = home\nrc, out, err = run([go, 'run', '.'], cwd=prog_dir, timeout=240, env=env)\nreturn rc, out, err\n```\n\n5. Frontmatter parsing helper:\n```python\ndef parse_frontmatter(path):\n    try:\n        with open(path, encoding='utf-8') as f:\n            content = f.read()\n    except Exception as e:\n        return None, None, str(e)\n    if not content.startswith('---'):\n        return None, content, 'missing opening ---'\n    # find closing ---\n    rest = content[3:]\n    idx = rest.find('\\n---')\n    if idx == -1:\n        return None, content, 'missing closing ---'\n    fm_text = rest[:idx]\n    body = rest[idx+4:]  # after \\n---\n    fm = {}\n    for line in fm_text.splitlines():\n        line = line.strip()\n        if not line or line.startswith('#'):\n            continue\n        if ':' in line:\n            k, v = line.split(':', 1)\n            fm[k.strip()] = v.strip()\n    return fm, body, None\n```\n\nActually, let me be careful with the frontmatter body split. The body after closing `---` is `rest[idx+len('\\n---'):]`. `rest[idx+4:]` = after `\\n---`. But if there's `---\\n` at line end, idx points to `\\n` before `---`. Let me handle robustly.\n\nActually, I'll just split the content on lines and detect the two `---` lines.\n\n```python\ndef parse_frontmatter(content):\n    lines = content.split('\\n')\n    if not lines or lines[0].strip() != '---':\n        return None, None, 'missing opening ---'\n    end = None\n    for i in range(1, len(lines)):\n        if lines[i].strip() == '---':\n            end = i\n            break\n    if end is None:\n        return None, None, 'missing closing ---'\n    fm_lines = lines[1:end]\n    body = '\\n'.join(lines[end+1:])\n    fm = {}\n    for ln in fm_lines:\n        ln = ln.strip()\n        if not ln or ln.startswith('#'):\n            continue\n        if ':' in ln:\n            k, v = ln.split(':', 1)\n            fm[k.strip()] = v.strip()\n    return fm, body, None\n```\n\nThis returns (frontmatter dict, body, error). For `name: think`, fm['name'] = 'think'. For `tools: read, grep, find, ls`, fm['tools'] = 'read, grep, find, ls'.\n\n6. Check body non-empty (after frontmatter):\n```python\ndef body_nonblank_lines(body):\n    return [ln for ln in body.split('\\n') if ln.strip()]\n```\n\nThe exception test: `awk '/^---$/{n++} n>=2 && /[^[:space:]]/{print}'` counts lines after 2nd `---` that have non-space. Equivalent: number of non-blank lines in body ≥ 1.\n\n7. sha256 helper:\n```python\ndef sha256_file(path):\n    h = hashlib.sha256()\n    with open(path, 'rb') as f:\n        for chunk in iter(lambda: f.read(65536), b''):\n            h.update(chunk)\n    return h.hexdigest()\n```\n\nNow the test flow in `main()`:\n\n```python\ndef main():\n    errors = []\n    repo_root = find_repo_root(__file__)\n    go = shutil.which('go')\n    if not go:\n        ... return fail\n\n    # write deploy program\n    prog_dir = write_deploy_program(repo_root)\n\n    # ---- Normal path ----\n    agent_dir = tempfile.mkdtemp(prefix='rick_task9_agent_')\n    home = tempfile.mkdtemp(prefix='rick_task9_home_')\n    rc, out, err = run_deploy(go, prog_dir, agent_dir, home)\n    if rc != 0:\n        errors.append('DeployRickCustomizations (正常路径) failed exit=%d: %s' % (rc, tail(err or out)))\n    else:\n        for name, spec in AGENTS.items():\n            p = os.path.join(agent_dir, 'agents', name + '.md')\n            if not os.path.isfile(p):\n                errors.append('%s.md 未落盘: %s' % (name, p))\n            else:\n                content = read_text(p)\n                fm, body, ferr = parse_frontmatter(content)\n                if ferr:\n                    errors.append('%s.md frontmatter 解析失败: %s' % (name, ferr))\n                else:\n                    # name field\n                    if fm.get('name') != spec['name']:\n                        errors.append('%s.md frontmatter name=%r, want %r' % (name, fm.get('name'), spec['name']))\n       