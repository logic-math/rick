m).\nfunc writeFakeBin(t *testing.T, dir, name string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), []byte(\"#!/bin/sh\\nexit 0\\n\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// setupPiSettings writes the rick-managed settings.json (~/.rick/pi/agent)\n// with the given theme (or no theme if \"\"), pointing HOME at a temp dir.\nfunc setupPiSettings(t *testing.T, theme string) string {\n\tt.Helper()\n\thome := t.TempDir()\n\tagentDir := filepath.Join(home, \".rick\", \"pi\", \"agent\")\n\tif err := os.MkdirAll(agentDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ts := map[string]any{\"theme\": theme, \"packages\": []string{\"npm:pi-subagents\"}}\n\tif theme == \"\" {\n\t\tdelete(s, \"theme\")\n\t}\n\tdata, _ := json.MarshalIndent(s, \"\", \"  \")\n\tif err := os.WriteFile(filepath.Join(agentDir, \"settings.json\"), data, 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"HOME\", home)\n\treturn home\n}\n\n// setupLegacyPiSettings writes a legacy ~/.pi/agent/settings.json (pre-\n// isolation layout) for migration tests.\nfunc setupLegacyPiSettings(t *testing.T, theme string) string {\n\tt.Helper()\n\thome := t.TempDir()\n\tagentDir := filepath.Join(home, \".pi\", \"agent\")\n\tif err := os.MkdirAll(agentDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ts := map[string]any{\n\t\t\"theme\":    theme,\n\t\t\"packages\": []string{\"npm:pi-subagents\", \"npm:user-random-thing\"},\n\t}\n\tdata, _ := json.MarshalIndent(s, \"\", \"  \")\n\tif err := os.WriteFile(filepath.Join(agentDir, \"settings.json\"), data, 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"HOME\", home)\n\treturn home\n}\n\n// readManagedSettings reads the managed settings.json into a map.\nfunc readManagedSettings(t *testing.T) map[string]any {\n\tt.Helper()\n\tdata, err := os.ReadFile(PiSettingsPath())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n"}],"isError":false,"timestamp":1786908495801},{"role":"assistant","content":[{"type":"thinking","thinking":"`internal/prompt` imports `internal/parser` and `internal/workspace`. It does NOT import `internal/env`. So `internal/env` can import `internal/prompt` without a cycle. But wait, let me check whether `internal/parser` imports `internal/env`. Let me check.\n\nActually, let me first check if there's an existing cycle: `internal/prompt` → `internal/workspace`, and `internal/env` → `internal/workspace` + `internal/runtime`. And `internal/runtime` → ? Let me check.\n\nActually, more simply: can `internal/env` import `internal/prompt`? The prompt package imports `internal/parser` and `internal/workspace`. If `internal/parser` or `internal/workspace` imports `internal/env`, there'd be a cycle. Let me check.\n\nActually, let me think about a cleaner approach. Instead of importing `internal/prompt` from `internal/env` (which could introduce a subtle layering issue), I could:\n\nOption A: Add the agent frontmatter generation in env, using a new exported function in `internal/prompt` to fetch skill content.\n\nOption B: Use `go:embed` directly in env package for the 3 skill files. But the skill files are already embedded in `internal/prompt`. Re-embedding in env would duplicate content and cause drift.\n\nOption C: Add an exported function `LoadSkill(name string) string` in internal/prompt (or reuse `LoadCoreSkills`).\n\nThe cleanest is Option C: reuse `prompt.LoadCoreSkills([]string{name})`. But that concatenates with `\\n\\n---\\n\\n` if multiple names; with a single name, it just returns the single content. So `prompt.LoadCoreSkills([]string{\"think\"})` returns exactly the content of `templates/skills/think.md`.\n\nLet me verify there's no import cycle by checking `internal/parser` and `internal/workspace` imports.\n\nActually, let me just check quickly whether env → prompt creates a cycle by attempting a build later. But first, let me understand the full picture by reading the env extensions.go, check.go, settings.go, and the existing env_test.go to understand test patterns an