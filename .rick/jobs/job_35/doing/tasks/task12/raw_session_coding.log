test--\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-AI_CODING-test--/2026-08-12T12-16-26-712Z_0e010c05-aae8-4a10-852a-ea3f59c93c0c\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-INFER_RSI--\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-INFER_RSI--/2026-08-12T13-14-49-926Z_019ff61c-7cc6-7b15-a258-5ea3319d1da4\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-MLOPS--\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-MOFANG_SEARCH--\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-MOFANG_SEARCH--/2026-08-12T13-10-01-415Z_32ddfbd5-c94d-4991-8b74-82e8ee06c90d\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-MOFANG_SEARCH--/2026-08-14T12-08-51-289Z_6316937d-24bd-4dfc-b713-417b30ff62d5\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-PLATOIM--\n/home/hadoop-recsys/.rick/pi/agent/sessions/--workdir-sunquan20-PLATOIM--/2026-08-14T15-38-59-405Z_01a000ed-2fcd-7a57-910f-275512e977af\n/home/hadoop-recsys/.rick/pi/agent/themes\n/home/hadoop-recsys/.rick/pi/agent/web-search-cache\n=== agents ===\n\n\nCommand exited with code 2"}],"details":{},"isError":true,"timestamp":1786916450892},{"role":"toolResult","toolCallId":"call_01_XCQrj3ou1mE6fCdLXeac0094","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n# Description: rick-gates 门禁 helper — 确定性 doing 门禁校验。\n\n\"\"\"rick-gates 门禁 helper — 确定性 doing 门禁校验。\n\nrick 侧确定性脚本（非 pi extension hook，hook 仅作通知/记录）。runtime.Run 在解析到\nagent_settled（pi 会话结束）后直接调用本脚本校验 doing 门禁，exit 非 0 = 门禁失败。\n\n校验语义（与原 doing_check 三项语义对齐）：\n1. tasks.json 可解析 —— doing/tasks.json 是合法 JSON 且含 tasks 数组。\n2. zombie 检测 —— 无遗留 running 状态任务。\n3. commit_hash 存在 —— status=success 的任务必须有非空 commit_hash。\n\n用法：python3 helper.py <doing_dir>\n\"\"\"\n\nimport json\nimport os\nimport sys\n\n\ndef main(argv):\n    if len(argv) < 2:\n        print(\"usage: helper.py <doing_dir>\", file=sys.stderr)\n        return 2\n\n    doing_dir = argv[1]\n    tasks_json_path = os.path.join(doing_dir, \"tasks.json\")\n\n    # 1. tasks.json 可解析\n    try:\n        with open(tasks_json_path, \"r\", encoding=\"utf-8\") as f:\n            data = json.load(f)\n    except Exception as e:  # noqa: BLE001 - 门禁错误串需兼容任意解析失败\n        print(\"tasks.json 不可解析: %s\" % e, file=sys.stderr)\n        return 1\n\n    tasks = data.get(\"tasks\")\n    if not isinstance(tasks, list):\n        print(\"tasks.json 缺少 tasks 数组\", file=sys.stderr)\n        return 1\n\n    for task in tasks:\n        task_id = task.get(\"task_id\", \"?\")\n        status = task.get(\"status\", \"\")\n\n        # 2. zombie 检测\n        if status == \"running\":\n            print(\"zombie running: task %s 仍处于 running 状态\" % task_id, file=sys.stderr)\n            return 1\n\n        # 3. commit_hash 存在\n        if status == \"success\":\n            commit_hash = task.get(\"commit_hash\", \"\")\n            if not commit_hash:\n                print(\"missing commit_hash: task %s 状态为 success 但 commit_hash 为空\" % task_id, file=sys.stderr)\n                return 1\n\n    print(\"gate passed\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))\n"}],"isError":false,"timestamp":1786916450892}]}
