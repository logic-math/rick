"task2\",\n        \"task4\"\n      ],\n      \"attempts\": 0,\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated_at\": \"2026-08-17T00:59:46.783995764+08:00\"\n    },\n    {\n      \"task_id\": \"task6\",\n      \"task_name\": \"落地 handler 调度聚合层并让 cli 变薄（plan/doing/easy）\",\n      \"status\": \"pending\",\n      \"dependencies\": [\n        \"task3\",\n        \"task4\",\n        \"task5\"\n      ],\n      \"attempts\": 0,\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated_at\": \"2026-08-17T00:59:46.783995764+08:00\"\n    },\n    {\n      \"task_id\": \"task9\",\n      \"task_name\": \"注册 think/research/exporter 为 pi 自定义 agent（经 env 职责 3 落盘）\",\n      \"status\": \"pending\",\n      \"dependencies\": [\n        \"task3\",\n        \"task4\",\n        \"task5\"\n      ],\n      \"attempts\": 0,\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated_at\": \"2026-08-17T00:59:46.783995764+08:00\"\n    },\n    {\n      \"task_id\": \"task7\",\n      \"task_name\": \"完成 handler 覆盖 human-loop/ctrl/dream/learning 并让 cli 全量变薄\",\n      \"status\": \"pending\",\n      \"dependencies\": [\n        \"task6\"\n      ],\n      \"attempts\": 0,\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated_at\": \"2026-08-17T00:59:46.783995764+08:00\"\n    },\n    {\n      \"task_id\": \"task8\",\n      \"task_name\": \"做薄 cutover：下沉 doing 调度与门禁到 pi，并删除全部冗余 Go 包\",\n      \"status\": \"pending\",\n      \"dependencies\": [\n        \"task3\",\n        \"task4\",\n        \"task5\",\n        \"task6\",\n        \"task7\"\n      ],\n      \"attempts\": 0,\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated_at\": \"2026-08-17T00:59:46.783995764+08:00\"\n    },\n    {\n      \"task_id\": \"task10\",\n      \"task_name\": \"让 pibuilder 产出单文件内聚的 pi 定制化规范产物\",\n      \"status\": \"pending\",\n      \"dependencies\": [\n        \"task5\",\n        \"task8\