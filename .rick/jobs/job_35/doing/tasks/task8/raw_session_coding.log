gDir/debug/; falls back to doingDir/debug.md.\\n// Returns \\\"\\\" when doingDir is empty or does not exist.\\n//\\n// TODO(2026-08): remove fallback to debug.md after full migration to debug/ dir format.\\nfunc loadDebugContextLocal(doingDir string) string {\\n\\tif doingDir == \\\"\\\" {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tdebugDir := filepath.Join(doingDir, \\\"debug\\\")\\n\\tentries, err := os.ReadDir(debugDir)\\n\\tif err == nil {\\n\\t\\tvar files []string\\n\\t\\tfor _, e := range entries {\\n\\t\\t\\tname := e.Name()\\n\\t\\t\\tif !e.IsDir() && strings.HasPrefix(name, \\\"bug\\\") && strings.HasSuffix(name, \\\".md\\\") {\\n\\t\\t\\t\\tfiles = append(files, name)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif len(files) > 0 {\\n\\t\\t\\tsort.Strings(files)\\n\\t\\t\\tvar sb strings.Builder\\n\\t\\t\\tfor _, name := range files {\\n\\t\\t\\t\\tdata, err := os.ReadFile(filepath.Join(debugDir, name))\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\tcontinue\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tsummary, status := parser.ExtractBugFrontmatter(string(data))\\n\\t\\t\\t\\tsb.WriteString(fmt.Sprintf(\\\"- [%s] summary: %s | status: %s\\\\n\\\", name, summary, status))\\n\\t\\t\\t}\\n\\t\\t\\tif result := sb.String(); result != \\\"\\\" {\\n\\t\\t\\t\\treturn result\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\t// TODO(2026-08): remove fallback after full migration\\n\\tdata, err := os.ReadFile(filepath.Join(doingDir, \\\"debug.md\\\"))\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\treturn string(data)\\n}\\n\\n// readFileOrDefault reads a file and returns its content, or the default string if absent.\\nfunc readFileOrDefault(path, defaultVal string) string {\\n\\tdata, err := os.ReadFile(path)\\n\\tif err != nil {\\n\\t\\treturn defaultVal\\n\\t}\\n\\tcontent := string(data)\\n\\tif content == \\\"\\\" {\\n\\t\\treturn defaultVal\\n\\t}\\n\\treturn content\\n}\\n\",\"structuredPatch\":[{\"oldStart\":67,\"oldLines\":6,\"newStart\":67,\"newLines\":7,\"lines\":[\"   builder.SetVariable(\\\"tdd_skill_path\\\", tddFile)\",\"   builder.SetVariable(\\\"debug_skill_path\\\", debugSkillFile)\",\"   builder.SetVariable(\\\"sense_skill_path\\\", senseFile)\",\"+  builder.SetVariable(\\\"grilling_skill_path\\\", grillingFile)\",\"   builder.SetVariable(\\\"learning_prompt_path\\\", learningPromptPath)\",\"   builder.SetVariable(\\\"rick_bin_path\\\", rickBinPath)\",\"   builder.SetVariable(\\\"job_id\\\", jobID)\"]}],\"userModified\":false,\"replaceAll\":false}}\n.rick/draft/loops/loop_2/briefs/批判门禁-E-r1.md:136:- **风险**：human 自己指出\"全知全能 LLM 是悖论——LLM 不能创造自己不知道的事\"。但 human 自身论断\"rick 解决 G' 问题\"也含潜在自指悖论：rick 的做事方法（doing/learning/dream 三阶段、debug 体系、act-path）是否也被 LLM 训练数据覆盖（即 rick 在 G 中）？若是，则\"rick 解决 G'\"与\"方法不可训练\"自相矛盾；若否，则 rick 的方法如何被 LLM 理解并执行（LLM 必须先\"知道\"rick 的方法才能执行）？\n.rick/draft/loops/loop_2/briefs/research-report-3.md:126:2. **期望**:基于 Y1/Y3/Y5/Y6 全部澄清(pi 部署等同 claude code / registerTool 系统级但需重写 / per-prompt 模型切换原生 / subagent extension 范例存在)这一事实,你期望接入 pi 后**具体深度控制哪些行为**?请从以下新事实支持的扩展点中选 top-3:(a) `transformContext` 自定义 compaction(保留 rick act-path.md / debug/ 历史);(b) `registerTool` 把 rick skill 重写为 LLM tool schema(提升触发率);(c) `subagent` extension 把 think/research/exporter 拆为独立 pi 进程(强隔离);(d) `registerProvider` + per-prompt setModel(doing 用 Sonnet / dream 用 Haiku);(e) `beforeToolCall` hook 做 permission gate(替代 --dangerously-skip-permissions);(f) `pi.events` 事件系统做行为轨迹捕获(等价验收)。——这些期望中,哪些真需 pi 才能实现,哪些可通过 rick 端 prompt 模板/doing.md 设计达成?\n.rick/draft/loops/loop_2/briefs/research-5-N3-rick-cli职责变化.md:35:| 9. 行为轨迹捕获 | `internal/actpath/` | act-path.md 生成(基于 AgentSession.ToolCalls) |\n.rick/draft/loops/loop_2/briefs/批判门禁-S-r2.md:103:- **Q3 反例**：什么证据会让你改变判断？——若 research 发现 rick 当前长程任务失败案例的根因是 task 分解粒度过粗（doing.md 单 task 承载过多）而非 compaction，且 pi transformContext 仅能裁剪 messages 不能注入 rick 的 act-path.md / debug/ 历史，你还会认为\"自定义 compaction → 长程更好\"成立吗？\n.rick/draft/loops/loop_4/dispatch-research-E-r4.md:22:- **节点 A**：rick 的方法（doing/learning/dream、sense 5 阶段、plan-do-learn、debug 循环、act-path）是否**在 LLM 训练数据 G 中**？（即这些方法是否被通用工程实践/公开语料隐式覆盖）\n.rick/draft/loops/loop_4/briefs/research-E-r4-A.md:4:事实陈述：rick 的方法（doing/learning/dream、sense 5 阶段、plan-do-learn、debug 循环、act-path）是否在 LLM 训练数据 G 中？（即这些方法是否被通用工程实践/公开语料隐式覆盖）\n.rick/draft/loops/loop_4/briefs/research-report-E-r4.md:44:**事实陈述**：rick 的方法（doing/learning/dream、sense 5 阶段、plan-do-learn、debug 循环、act-path）是否在 G 中？\n.rick/draft/loops/loop_4/briefs/批判门禁-E-r2.md:90:- **Q2 前提**：\"rick 方法在 G 外\"成立需要什么前提？你是否假设了\"未被显式训练=不在 G\"？但 LLM 训练数据含大量通用工程实践（plan-do-learn、TDD、debug 循环、分治），rick 方法是否可能被这些通用实践隐式覆盖？你验证过 rick 方法各组成元（doing/dream/act-path）的 G 内外归属吗？\n.rick/draft/loops/loop_4/briefs/批判门禁-E-r2.md:129:2. **Y-E2 未回答的核心追问**（对应 A2）：rick 的具体方法（doing/learning/dream/act-path）是稳定元方法（G 内、可被训练）还是特殊方法（G 外、不可训练）？\"特殊性永远存在\"能否覆盖这一区分？若 rick 方法组成元在 G 内（被通用工程实践隐式覆盖），则\"方法不可训练\"前提部分失效。**需 human 回答**：doing/learning/dream 各自的 G 内外归属？是否验证过 LLM 在 zero-shot 下对这些方法的复现能力？\n.rick/domain/architecture.md:24:  actpath/                    # act-path 生成\n.rick/domain/architecture.md:71:## act-path 生成模块（internal/actpath/）\n.rick/domain/architecture.md:142:- 不生成 act-path\n.rick/domain/commands.md:8:- session 为 nil 时跳过 act-path 生成（nil guard），不 panic\n.rick/domain/commands.md:33:- 输出包含：okr_content、task_md_content、debug 记录、act_path_content 等\n.rick/domain/commands.md:58:| C：查看轨迹 | 读取 act-path.md |\n.rick/domain/README.md:9:| `architecture.md` | 技术栈、模块划分、DIP 组合根模式、act-path/agent/dream 模块设计 |\n.rick/domain/project-conventions.md:18:| `doing/tasks/{taskID}/act-path.md` | 任务执行后自动生成，含工具调用/报错次数/执行时长 |\n.rick/RFC/rick-dream.md:90:  plan → doing（产出 act-path.md）\n.rick/RFC/rick-dream.md:115:        │   ├── act-path.md  # ⭐ 新增：程序性解析的行为轨迹\n.rick/RFC/rick-dream.md:149:JSONL 解析 → 高质量 act-path\n.rick/RFC/rick-dream.md:206:j. act-path 记录\n.rick/RFC/rick-dream.md:207:   rick 程序解析 JSONL，生成 plan/act-path.md\n.rick/RFC/rick-dream.md:257:   生成 job_{n}/doing/act-path.md\n.rick