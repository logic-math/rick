t/dream_prompt.go\ninternal/prompt/easy_prompt.go\ninternal/prompt/easy_prompt_test.go\ninternal/prompt/embedded_test.go\ninternal/prompt/human_loop_prompt.go\ninternal/prompt/human_loop_prompt_test.go\ninternal/prompt/integration_rfc001_test.go\ninternal/prompt/integration_test.go\ninternal/prompt/manager.go\ninternal/prompt/manager_test.go\ninternal/prompt/plan_prompt.go\ninternal/prompt/plan_prompt_test.go\ninternal/runtime/agentdir.go\ninternal/runtime/agentdir_test.go\ninternal/runtime/cli.go\ninternal/runtime/cli_mock_test.go\ninternal/runtime/cli_test.go\ninternal/runtime/executor_e2e_test.go\ninternal/runtime/executor.go\ninternal/runtime/executor_realds_test.go\ninternal/runtime/executor_realpi_smoke_test.go\ninternal/runtime/executor_test.go\ninternal/runtime/runtime.go\ninternal/runtime/runtime_test.go\ninternal/workspace/dream.go\ninternal/workspace/dream_test.go\ninternal/workspace/paths.go\ninternal/workspace/workspace.go\ninternal/workspace/workspace_test.go\n---TASKS---\n{\n  \"version\": \"1.0\",\n  \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n  \"updated_at\": \"2026-08-17T04:24:56.119282252+08:00\",\n  \"tasks\": [\n    {\n      \"task_id\": \"task1\",\n      \"task_name\": \"定义 spec 规范与「spec → 开发计划 → 功能等价实现」验收标准\",\n      \"task_file\": \"task1.md\",\n      \"status\": \"success\",\n      \"dependencies\": null,\n      \"attempts\": 0,\n      \"commit_hash\": \"d3cbb3d67743e3e9287bce6dca6ccd61d1387fca\",\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated_at\": \"2026-08-17T01:11:01.39718317+08:00\"\n    },\n    {\n      \"task_id\": \"task2\",\n      \"task_name\": \"产出 rick 第一份 spec（四层架构 + 5 模块 + env 四职责契约）\",\n      \"task_file\": \"task2.md\",\n      \"status\": \"success\",\n      \"dependencies\": [\n        \"task1\"\n      ],\n      \"attempts\": 0,\n      \"commit_hash\": \"c58178087c0a5ae00fbad8b13e3346f83fb2340f\",\n      \"created_at\": \"2026-08-17T00:59:46.783995764+08:00\",\n      \"updated