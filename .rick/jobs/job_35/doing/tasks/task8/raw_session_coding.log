n\\tbuilder.SetVariable(\\\"spec_path\\\", specPath)\\n\\tbuilder.SetVariable(\\\"wiki_dir\\\", filepath.Join(rickDir, \\\"wiki\\\"))\\n\\tbuilder.SetVariable(\\\"tools_dir\\\", filepath.Join(rickDir, \\\"tools\\\"))\\n\\n\\tdebugContent := loadDebugContextLocal(doingDir)\\n\\tif debugContent == \\\"\\\" {\\n\\t\\tdebugContent = \\\"（本次 job 无 debug 记录）\\\"\\n\\t}\\n\\tbuilder.SetVariable(\\\"debug_content\\\", debugContent)\\n\\n\\t// easy mode has no task*.md files\\n\\tbuilder.SetVariable(\\\"task_md_files\\\", \\\"  （easy 模式无 task*.md 文件）\\\")\\n\\n\\t// easy mode has no per-task act-path.md\\n\\tbuilder.SetVariable(\\\"act_path_files\\\", \\\"  （easy 模式无 act-path.md 文件）\\\")\\n\\n\\t// tasks.json: easy session writes a single easy_session task\\n\\tbuilder.SetVariable(\\\"task_execution_results\\\", buildEasyTaskResults(doingDir))\\n\\n\\tprojectRoot, _ := os.Getwd()\\n\\tbuilder.SetVariable(\\\"rick_bin_path\\\", filepath.Join(projectRoot, \\\"bin\\\", \\\"rick\\\"))\\n\\n\\tgenSkillFile, err := WriteSkillFile(promptsDir, \\\"skill_gen_skill.md\\\", \\\"gen-skill\\\")\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"failed to write gen-skill: %w\\\", err)\\n\\t}\\n\\tbuilder.SetVariable(\\\"gen_skill_path\\\", genSkillFile)\\n\\n\\tpromptFile := filepath.Join(promptsDir, \\\"easy_learning_prompt.md\\\")\\n\\tif err := builder.SaveToFile(promptFile); err != nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"failed to save easy learning prompt: %w\\\", err)\\n\\t}\\n\\n\\treturn promptFile, nil\\n}\\n\\n// buildEasyTaskResults formats the task execution table for easy mode (single easy_session task).\\nfunc buildEasyTaskResults(doingDir string) string {\\n\\theader := \\\"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\\\n|---------|---------|------|-------------|----------|\\\\n\\\"\\n\\tdata, err := os.ReadFile(filepath.Join(doingDir, \\\"tasks.json\\\"))\\n\\tif err != nil {\\n\\t\\treturn header + \\\"| easy_session | Easy Mode Session | unknown | N/A | 1 |\\\\n\\\"\\n\\t}\\n\\t// Simple extraction: tasks.json has one task with status \\\"success\\\"\\n\\tstatus := \\\"success\\\"\\n\\tif strings.Contains(string(data), `\\\"status\\\": \\\"failed\\\"`) {\\n\\t\\tstatus = \\\"failed\\\"\\n\\t}\\n\\treturn header + fmt.Sprintf(\\\"| easy_session | Easy Mode Session | %s | N/A | 1 |\\\\n\\\", status)\\n}\\n\\n// buildCtxSection renders the easy_ctx.md template with ctxPath and localRickDir.\\n// Returns empty string when ctxPath is empty (no inheritance).\\nfunc buildCtxSection(ctxPath, localRickDir string) string {\\n\\tif ctxPath == \\\"\\\" {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tmgr := NewPromptManager()\\n\\ttmpl, err := mgr.LoadTemplate(\\\"easy_ctx\\\")\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tbuilder := NewPromptBuilder(tmpl)\\n\\tbuilder.SetVariable(\\\"ctx_path\\\", ctxPath)\\n\\tbuilder.SetVariable(\\\"local_rick_dir\\\", localRickDir)\\n\\tcontent, err := builder.Build()\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\treturn content\\n}\\n\\n// loadDebugContextLocal mirrors executor.LoadDebugContext without creating a circular import.\\n// Prefers bug*.md frontmatter summaries from doingDir/debug/; falls back to doingDir/debug.md.\\n// Returns \\\"\\\" when doingDir is empty or does not exist.\\n//\\n// TODO(2026-08): remove fallback to debug.md after full migration to debug/ dir format.\\nfunc loadDebugContextLocal(doingDir string) string {\\n\\tif doingDir == \\\"\\\" {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tdebugDir := filepath.Join(doingDir, \\\"debug\\\")\\n\\tentries, err := os.ReadDir(debugDir)\\n\\tif err == nil {\\n\\t\\tvar files []string\\n\\t\\tfor _, e := range entries {\\n\\t\\t\\tname := e.Name()\\n\\t\\t\\tif !e.IsDir() && strings.HasPrefix(name, \\\"bug\\\") && strings.HasSuffix(name, \\\".md\\\") {\\n\\t\\t\\t\\tfiles = append(files, name)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif len(files) > 0 {\\n\\t\\t\\tsort.Strings(files)\\n\\t\\t\\tvar sb strings.Builder\\n\\t\\t\\tfor _, name := range files {\\n\\t\\t\\t\\tdata, err := os.ReadFile(filepath.Join(debugDir, name))\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\tcontinue\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tsummary, status := parser.ExtractBugFrontmatter(string(data))\\n\\t\\t\\t\\tsb.WriteString(fmt.Sprintf(\\\"- [%s] summary: %s | status: %s\\\\n\\\", name, summary, status))\\n\\t\\t\\t}\\n\\t\\t\\tif result := sb.String(); result != \\\"\\\" {\\n\\t\\t\\t\\treturn result\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\t// TODO(2026-08): remove fallback after full migration\\n\\tdata, err := os.ReadFile(filepath.Join(doingDir, \\\"debug.md\\\"))\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\treturn string(data)\\n}\\n\\n// readFileOrDefault reads a file and returns its content, or the default string if absent.\\nfunc readFileOrDefault(path, defaultVal string) string {\\n\\tdata, err := os.ReadFile(path)\\n\\tif err != nil {\\n\\t\\treturn defaultVal\\n\\t}\\n\\tcontent := string(data)\\n\\tif content == \\\"\\\" {\\n\\t\\treturn defaultVal\\n\\t}\\n\\treturn content\\n}\\n\",\"structuredPatch\":[{\"oldStart\":67,\"oldLines\":6,\"newStart\":67,\"newLines\":7,\"lines\":[\"   builder.SetVariable(\\\"tdd_skill_path\\\", tddFile)\",\"   builder.SetVariable(\\\"debug_skill_path\\\", debugSkillFile)\",\"   builder.SetVariable(\\\"sense_skill_path\\\", senseFile)\",\"+  builder.SetVariable(\\\"grilling_skill_path\\\", grillingFile)\",\"   builder.SetVariable(\\\"learning_prompt_path\\\", learningPromptPath)\",\"   builder.SetVariable(\\\"rick_bin_path\\\", rickBinPath)\",\"   builder.SetVariable(\\\"job_id\\\", jobID)\"]}],\"userModified\":false,\"replaceAll\":false}}\n.rick/draft/loops/loop_2/briefs/批判门禁-E-r1.md:136:- **风险**：human 自己指出\"全知全能 LLM 是悖论——LLM 不能创造自己不知道的事\"。但 human 自身论断\"rick 解决 G' 问题\"也含潜在自指悖论：rick 的做事方法（doing/learning/dream 三阶段、debug 体系、act-path）是否也被 LLM 训练数据覆盖（即 rick 在 G 中）？若是，则\"rick 解决 G'\"与\"方法不可训练\"自相矛盾；若否，则 rick 的方法如何被 LLM 理解并执行（LLM 必须先\"知道\"rick 的方法才能执行）？\n.rick/draft/loops/loop_2/briefs/research-report-3.md:126:2. **期望**:基于 Y1/Y3/Y5/Y6 全部澄清(pi 部署等同 claude code / registerTool 系统级但需重写 / per-prompt 模型切换原生 / subagent extension 范例存在)这一事实,你期望接入 pi 后**具体深度控制哪些行为**?请从以下新事实支持的扩展点中选 top-3:(a) `transformContext` 自定义 compaction(保留 rick act-path.md / debug/ 历史);(b) `registerTool` 把 rick skill 重写为 LLM tool schema(提升触发率);(c) `subagent` extension 把 think/research/exporter 拆为独立 pi 进程(强隔离);(d) `registerProvider` + per-prompt setModel(doing 用 Sonnet / dream 用 Haiku);(e) `beforeToolCall` hook 做 permission gate(替代 --dangerously-skip-permissions);(f) `pi.events` 事件系统做行为轨迹捕获(等价验收)。——这些期望中,哪些真需 pi 才能实现,哪些可通过 rick 端 prompt 模板/doing.md 设计达成?\n.rick/draft/loops/loop_2/briefs/research-5-N3-rick-cli职责变化.md:35:| 9. 行为轨迹捕获 | `internal/actpath/` | act-path.md 生成(基于 AgentSession.ToolCalls) |\n.rick/draft/loops/loop_2/briefs/批判门禁-S-r2.md:103:- **Q3 反例**：什么证据会让你改变判断？——若 research 发现 rick 当前长程任务失败案例的根因是 task 分解粒度过粗（doing.md 单 task 承载过多）而非 compaction，且 pi transformContext 仅能裁剪 messages 不能注入 rick 的 act-path.md / debug/ 历史，你还会认为\"自定义 compaction → 长程更好\"成立吗？\n.rick/draft/loops/loop_4/dispatch-research-E-r4.md:22:- **节点 A**：rick 的方法（doing/learning/dream、sense 5 阶段、plan-do-learn、debug 循环、act-path）是否**在 LLM 训练数据 G 中**？（即这些方法是否被通用工程实践/公开语料隐式覆盖）\n.rick/draft/loops/loop_4/briefs/research-E-r4-A.md:4:事实陈述：rick 的方法（doing/learning/dream、sense 5 阶段、plan-do-learn、debug 循环、act-path）是否在 LLM 训练数据 G 中？（即这些方法是否被通用工程实践/公开语料隐式覆盖）\n.rick/draft/loops/loop_4/briefs/research-report-E-r4.md:44:**事实陈述**：rick 的方法（doing/learning/dream、sense 5 阶段、plan-do-learn、debug 循环、act-path）是否在 G 中？\n.rick/draft/loops/loop_4/briefs/批判门禁-E-r2.md:90:- **Q2 前提**：\"rick 方法在 G 外\"成立需要什么前提？你是否假设了\"未被显式训练=不在 G\"？但 LLM 训练数据含大量通用工程实践（plan-do-learn、TDD、debug 循环、分治），rick 方法是否可能被这些通用实践隐式覆盖？你验证过 rick 方法各组成元（doing/dream/act-path）的 G 内外归属吗？\n.rick/draft/loops/loop_4/briefs/批判门禁-E-r2.md:129:2. **Y-E2 未回答的核心追问**（对应 A2）：rick 的具体方法（doing/learning/dream/act-path）是稳定元方法（G 内、可被训练）还是特殊方法（G 外、不可训练）？\"特殊性永远存在\"能否覆盖这一区分？若 rick 方法组成元在 G 内（被通用工程实践隐式覆盖），则\"方法不可训练\"前提部分失效。**需 human 回答**：doing/learning/dream 各自的 G 内外归属？是否验证过 LLM 在 zero-shot 下对这些方法的复现能力？\n.rick/domain/architecture.md:24:  actpath/                    # act-path 生成\n.rick/domain/architecture.md:71:## act-path 生成模块（internal/actpath/）\n.rick/domain/architecture.md:142:- 不生成 act-path\n.rick/domain/commands.md:8:- session 为 nil 时跳过 act-path 生成（nil guard），不 panic\n.rick/domain/commands.md:33:- 输出包含：okr_content、task_md_content、debug 记录、act_path_content 等\n.rick/domain/commands.md:58:| C：查看轨迹 | 读取 act-path.md |\n.rick/domain/README.md:9:| `architecture.md` | 技术栈、模块划分、DIP 组合根模式、act-path/agent/dream 模块设计 |\n.rick/domain/project-conventions.md:18:| `doing/tasks/{taskID}/act-path.md` | 任务执行后自动生成，含工具调用/报错次数/执行时长 |\n.rick/RFC/rick-dream.md:90:  plan → doing（产出 act-path.md）\n.rick/RFC/rick-dream.md:115:        │   ├── act-path.md  # ⭐ 新增：程序性解析的行为轨迹\n.rick/RFC/rick-dream.md:149:JSONL 解析 → 高质量 act-path\n.rick/RFC/rick-dream.md:206:j. act-path 记录\n.rick/RFC/rick-dream.md:207:   rick 程序解析 JSONL，生成 plan/act-path.md\n.rick/RFC/rick-dream.md:257:   生成 job_{n}/doing/act-path.md\n.rick/RFC/rick-dream.md:284:    participant ActPath as act-path.md\n.rick/RFC/rick-dream.md:292:    Parser->>ActPath: 生成结构化 act-path```\n.rick/RFC/rick-dream.md:362:  learning agent 评估：此 act-path 是否值得沉淀为 skill？\n.rick/RFC/rick-dream.md:380:**预期效果**: 使用后 act-path 应缩短的步骤数\n.rick/RFC/rick-dream.md:397:Step 1: 读取 act-path.md\n.rick/RFC/rick-dream.md:400:Step 2: 评估更合理的 act-path\n.rick/RFC/rick-dream.md:401:        标准：能否用更短的 act-path 解决相同问题？\n.rick/RFC/rick-dream.md:405:        未来遇到类似问题时，如何用更短 act-path 解决？\n.rick/RFC/rick-dream.md:433:b. 逐一读取每个 job 的 act-path.md\n.rick/RFC/rick-dream.md:489:Skills 积累 → 执行成功率↑ → 更多高质量 act-path\n.rick/RFC/rick-dream.md:509:    B --> C[act-path.md]\n.rick/RFC/rick-dream.md:578:│   └── skill.md              # 从 act-path 生成 skill 提议\n.rick/RFC/rick-v2-upgrade-dream.md:14:Rick v2 的核心升级包括：新增 `dream` 模块（跨 job 全局进化）、程序性 JSONL 解析生成 `act-path.md`（行为轨迹）、`learning` 结构化六步 SOP、`plan` 多层 subagent 评审，以及基于错误次数与工具调用轮次的量化熵度量体系。\n.rick/RFC/rick-v2-upgrade-dream.md:55:这是 Rick v2 提出的核心洞察：**act-path 质量决定负反馈有效性，有效性才是使整个系统熵减的主要矛盾。** 当 act-path 本身质量低时，learning 无法提取有效信号，负反馈失灵，整个进化循环断裂。因此，act-path 的生成必须是程序性的、可靠的，而非依赖 LLM 自觉记录。\n.rick/RFC/rick-v2-upgrade-dream.md:88:| `doing` | 执行层 | TDD 事实完成 | 新增 JSONL 解析 → act-path.md |\n.rick/RFC/rick-v2-upgrade-dream.md:102:  plan → doing（产出 act-path.md）\n.rick/RFC/rick-v2-upgrade-dream.md:127:        │   ├── act-path.md  # ⭐ 新增：程序性解析的行为轨迹\n.rick/RFC/rick-v2-upgrade-dream.md:143:    Parser --> ActPath[\"act-path.md\\n(结构化行为轨迹)\"]\n.rick/RFC/rick-v2-upgrade-dream.md:162:JSONL 解析 → 高质量 act-path\n.rick/RFC/rick-v2-upgrade-dream.md:221:j. act-path 记录\n.rick/RFC/rick-v2-upgrade-dream.md:222:   rick 程序解析 JSONL，生成 plan/act-path.md\n.rick/RFC/rick-v2-upgrade-dream.md:267:   生成 job_{n}/doing/act-path.md\n.rick/RFC/rick-v2-upgrade-dream.md:270:### 6.2 act-path 技术方案\n.rick/RFC/rick-v2-upgrade-dream.md:272:Act-path 是执行层的关键产出，也是学习层的核心输入。**生成方式必须是程序性的**——rick 程序直接解析 Claude Code 写入的 JSONL 会话文件，而非依赖 LLM 自我记录。这是保证 act-path 质量、保证负反馈有效性的根本前提。\n.rick/RFC/rick-v2-upgrade-dream.md:294:    participant ActPath as act-path.md\n.rick/RFC/rick-v2-upgrade-dream.md:302:    Parser->>ActPath: 生成结构化 act-path\n.rick/RFC/rick-v2-upgrade-dream.md:305:**act-path.md 格式**：\n.rick/RFC/rick-v2-upgrade-dream.md:365:  learning agent 评估：此 act-path 是否值得沉淀为 skill？\n.rick/RFC/rick-v2-upgrade-dream.md:382:**预期效果**: 使用后 act-path 应缩短的步骤数\n.rick/RFC/rick-v2-upgrade-dream.md:397:Step 1: 读取 act-path.md\n.rick/RFC/rick-v2-upgrade-dream.md:400:Step 2: 评估更合理的 act-path\n.rick/RFC/rick-v2-upgrade-dream.md:401:        标准：能否用更短的 act-path 解决相同问题？\n.rick/RFC/rick-v2-upgrade-dream.md:405:        未来遇到类似问题时，如何用更短 act-path 解决？\n.rick/RFC/rick-v2-upgrade-dream.md:433:b. 逐一读取每个 job 的 act-path.md\n.rick/RFC/rick-v2-upgrade-dream.md:487:Skills 积累 → 执行成功率↑ → 更多高质量 act-path\n.rick/RFC/rick-v2-upgrade-dream.md:506:    B --> C[act-path.md]\n.rick/RFC/rick-v2-upgrade-dream.md:576:│   └── skill.md              # 从 act-path 生成 skill 提议\n.rick/RFC/rick-v2-upgrade-dream.md:597:| P0 | JSONL 解析器 | rick 程序性解析，生成 act-path.md |\n.rick/RFC/rick-v2-upgrade-dream.md:621:| ① | act-path 由 rick 程序性解析 JSONL 生成（非 LLM 自记录），可靠性有保障 | 实现后验证解析准确率 |\n.rick/RFC/rick-v2-upgrade-dream.md:634:- 应对：解析器加版本检测 + 容错处理，失败时降级到空 act-path\n.rick/RFC/rick-v2-upgrade-dream.md:636:**风险 2：act-path 数据质量**\n.rick/RFC/rick-v2-upgrade-dream.md:667:计划、执行、学习的三层分工不是终点，而是起点。每一次执行产出 act-path，让 Learning 更精准、Skills 更可靠；每一次人介入提供对齐信号，让 Dream 优化全局上下文，减少未来干预。这个螺旋的驱动力是人与 AI 对齐度的持续提升。\n.rick/RFC/rick-v2-upgrade-dream.md:684:| **act-path** | rick 程序性解析 JSONL 生成的结构化行为轨迹，学习层核心输入 |\n.rick/RFC/rick-v2-upgrade-dream.md:704:| AgentErrorTaxonomy | 62% 错误在记忆和反思阶段 | act-path 程序性解析保障数据质量 |\n.rick/dream/dream_run_job_19_log.md:15:1. **job_19 是纯 RFC 任务**：没有 tasks.json 和 act-path，说明本 job 是 human-loop 会话或纯文档类任务，不涉及代码执行。此类任务天然零报错，不产生可提炼的 loop/skill 信号。\n.rick/dream/dream_run_job_19_log.md:16:2. **RFC 文档的后续价值**：job_19 的 RFC 产出（推测为架构设计类文档）在 job_22 的 act-path 中被读取（`RFC-001-context-architecture.md`），说明 RFC 对后续 doing 任务有指导价值。\n.rick/dream/prompts/dream_prompt.md:152:4. **nil guard 缺失导致 panic**（task6）：actpath.Generate(nil, ...) panic；SPEC \"session 为 nil 时跳过 act-path 生成（nil guard）\"条目已覆盖\n.rick/dream/prompts/dream_prompt.md:172:1. act-path 机制现已稳定（task1/2/6 全部通过），建议关注后续 job 中 act-path.md 内容质量\n.rick/dream/prompts/dream_prompt.md:189:1. **ctrl prompt 模板内容不足（debug2）**：初版 ctrl.md 只写了路径，未说明 NDJSON 格式、目录结构、act-path.md 内容、干预场景。根因：模板编写时未充分阅读 `executor.go` 和 `actpath/generator.go` 源码。修复：重写 ctrl.md，补全四个干预场景（A/B/C/D）和文件结构说明。\n.rick/dream/prompts/dream_prompt.md:234:- **数据来源**: debug.md（1 条目 + SUMMARY.md 3 问题）+ tasks.json（4 tasks, all success）+ act-path（task1/task4）\n.rick/dream/prompts/dream_prompt.md:240:3. **commit_hash 缺失导致 doing_check 失败（SUMMARY 问题3）**：act-path task1 显示 2 次 doing_check 错误均为 commit_hash 字段缺失；已有 wiki/tasks_json_commit_hash.md 覆盖\n.rick