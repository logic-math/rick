t.Errorf(\"Expected task ID task1, got %s\", task.ID)\n\t}\n\n\tif task.Name != \"Test Task\" {\n\t\tt.Errorf(\"Expected task name 'Test Task', got %s\", task.Name)\n\t}\n\n\tif len(task.KeyResults) != 2 {\n\t\tt.Errorf(\"Expected 2 key results, got %d\", len(task.KeyResults))\n\t}\n}\n\nfunc TestExecutionJobResultDuration(t *testing.T) {\n\tnow := time.Now()\n\tresult := &executor.ExecutionJobResult{\n\t\tStartTime: now,\n\t\tEndTime:   now.Add(5 * time.Second),\n\t}\n\n\tduration := result.Duration()\n\tif duration.Seconds() != 5.0 {\n\t\tt.Errorf(\"Expected duration 5s, got %v\", duration)\n\t}\n}\n"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":396,"output":1771,"cacheRead":110592,"cacheWrite":0,"reasoning":960,"totalTokens":112759,"cost":{"input":0.00017226,"output":0.0015407700000000001,"cacheRead":0.00040089600000000003,"cacheWrite":0,"total":0.0021139260000000003}},"stopReason":"toolUse","timestamp":1786907315501,"responseId":"6045f1e4-96c0-4d9b-9c5c-3a5d28768385","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_00_H5DDdxmYLqcQcUG7iE3v3940","toolName":"write","content":[{"type":"text","text":"Successfully wrote 2424 bytes to /workdir/sunquan20/AI_CODING/rick/internal/cmd/doing_test.go"}],"isError":false,"timestamp":1786907333317}]}
