ing='utf-8', errors='replace', timeout=timeout,\n    )\n\n\ndef combined(proc):\n    return (proc.stdout or '') + (proc.stderr or '')\n\n\ndef main():\n    errors = []\n    project_root = find_project_root()\n    bin_path = os.path.join(project_root, 'bin', 'rick')\n    ctx_path = os.path.join(project_root, '.rick')\n\n    # ---- Test 1: 正常路径 - go build ----\n    try:\n        proc = run(['go', 'build', '-o', 'bin/rick', './cmd/rick'], project_root, timeout=300)\n        if proc.returncode != 0:\n            errors.append('go build failed:\\n' + combined(proc)[-2000:])\n    except Exception as e:\n        errors.append('go build error: %s' % str(e))\n\n    # ---- Test 2: 正常路径 - go test cmd + handler ----\n    try:\n        proc = run(['go', 'test', './internal/cmd/...', './internal/handler/...', '-timeout', '60s', '-v'], project_root, timeout=300)\n        if proc.returncode != 0:\n            errors.append('go test ./internal/cmd/... ./internal/handler/... failed:\\n' + combined(proc)[-2000:])\n    except Exception as e:\n        errors.append('go test error: %s' % str(e))\n\n    # 二进制不存在则后续 CLI 检查无法进行\n    if not os.path.exists(bin_path):\n        errors.append('binary not found: %s (build step must have failed)' % bin_path)\n        result = {'pass': False, 'errors': errors}\n        print(json.dumps(result))\n        sys.exit(1)\n\n    # ---- Test 3: 边界 - plan --dry-run 无未替换变量 '{{' ----\n    try:\n        proc = run([bin_path, 'plan', '--dry-run'], project_root, timeout=120)\n        count = (proc.stdout or '').count('{{')\n        if count != 0:\n            errors.append(\"plan --dry-run 输出含 %d 处未替换的 '{{' 模板变量\" % count)\n    except Exception as e:\n        errors.append('plan --dry-run error: %s' % str(e))\n\n    # ---- Test 4: 边界 - easy --dry-run -r \"\" 报 requirement cannot be empty ----\n    try:\n        proc = run([bin_path, 'easy', '--dry-run', '-r', ''], project_root, timeout=120)\n        if 'requirement cannot be empty' not in combined(proc):\n            errors.append(\"easy --dry-run -r \\\"\\\" 未报 'requirement cannot be empty'（rc=%d）\" % proc.returncode)\n        elif proc.returncode == 0:\n            errors.append(\"easy --dry-run -r \\\"\\\" 报了空 requirement 但退出码为 0，应为非 0\")\n    except Exception as e:\n        errors.append('easy --dry-run -r \"\" error: %s' % str(e))\n\n    # ---- Test 5: 异常 - doing job_nonexistent 报 job directory not found ----\n    try:\n        proc = run([bin_path, 'doing', 'job_nonexistent'], project_root, timeout=120)\n        if 'job directory not found' not in combined(proc):\n            errors.append(\"doing job_nonexistent 未报 'job directory not found'（rc=%d）\" % proc.returncode)\n        elif proc.returncode == 0:\n            errors.append(\"doing job_nonexistent 退出码为 0，应为非 0\")\n    except Exception as e:\n        errors.append('doing job_nonexistent error: %s' % str(e))\n\n    # ---- Test 6: 异常 - plan --job job_nonexistent 报 plan directory does not exist ----\n    try:\n        proc = run([bin_path, 'plan', '--job', 'job_nonexistent'], project_root, timeout=120)\n        if 'plan directory does not exist' not in combined(proc):\n            errors.append(\"plan --job job_nonexistent 未报 'plan directory does not exist'（rc=%d）\" % proc.returncode)\n        elif proc.returncode == 0:\n            errors.append(\"plan --job job_nonexistent 退出码为 0，应为非 0\")\n    except Exception as e:\n        errors.append('plan --job job_nonexistent error: %s' % str(e))\n\n    # ---- Test 7: 异常 - easy --ctx 冲突报 local context already exists ----\n    try:\n        proc = run([bin_path, 'easy', '--ctx', ctx_path, '-r', 'test requirement'], project_root, timeout=120)\n        if 'local context already exists' not in combined(proc):\n            errors.append(\"easy --ctx 未报 'local context already exists'（rc=%d）\" % proc.returncode)\n        elif proc.returncode == 0:\n            errors.append(\"easy --ctx 退出码为 0，应为非 0\")\n    except Exception as e:\n        errors.append('easy --ctx error: %s' % s