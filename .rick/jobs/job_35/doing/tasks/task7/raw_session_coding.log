ead-only (ReadDir), so skipping it in dry-run doesn't change observable behavior. But MkdirAll IS a side effect. Let me preserve MkdirAll in dry-run too, to be safe (the test TestHumanLoopCmdDryRun might implicitly rely on dirs being created? No, it just checks no error).\n\nHmm, actually, let me simplify. Let me extract the common setup (GetDraftDir + rfcDir + NextLoopID + mkdir) into a helper, and use it in both HumanLoop and HumanLoopDryRun.\n\nActually, wait. Let me reconsider whether HumanLoopDryRun should create dirs. The current cmd does create dirs in dry-run. But it's arguably a bug (dry-run shouldn't create dirs). However, \"行为不变\" (behavior unchanged) suggests I keep it.\n\nBut actually, there's a subtle issue: the test `TestHumanLoopDryRunContainsDraftDir` does:\n```go\nos.Chdir(workDir)\nos.MkdirAll(workDir/.rick)\ndryRun = true\ncmd.SetArgs([\"测试主题\"])\ncmd.SetOut(&buf)\ncmd.Execute()\n// check output contains \"draft\", not \"{{draft_dir}}\"\n```\n\nIt creates workDir/.rick, so GetDraftDir = workDir/.rick/draft. The dry-run mkdir would create workDir/.rick/draft, workDir/.rick/draft/rfc, etc. And BuildHumanLoop outputs content with draftDir path. So output contains \"draft\" (the path). This test would pass.\n\nOK, let me now finalize the design and write the code.\n\nLet me also check the human_loop_test.go's `TestHumanLoopCreatesDraftDirs` — it checks the dirs are created after running (non-dry-run). handler.HumanLoop creates dirs via MkdirAll. Good.\n\nNow, one more consideration: the human-loop non-dry-run currently does NOT call env.Ensure. If I follow \"行为不变\", I keep it that way.\n\nLet me also reconsider: should handler.HumanLoop return the sessionID persistence? The current code doesn't persist sessionID for human-loop. The task detail mentions \"持久化 sessionID\" but the current code doesn't. And CallCLI returns only error (no sessionID). So I CANNOT persist sessionID from CallCLI (it doesn't return one). So \"持久化 sessionID\" is aspirational and not implementable with the current CallCLI signature.\n\nThis confirms: I should follow \"行为不变\" (behavior unchanged) and NOT add sessionID persistence (impossible with current CallCLI).\n\nSo my final design for handler.HumanLoop:\n```go\nfunc HumanLoop(topic string, opts Options) error {\n    draftDir, rfcDir, loopDir, err := prepareHumanLoopDirs()\n    if err != nil { return err }\n    cfg, err := config.LoadConfig()\n    if err != nil { return fmt.Errorf(\"failed to load config: %w\", err) }\n    pb := builder.NewPIBuilder()\n    mainFile, _, _, _, _, err := pb.SaveHumanLoopPrompt(topic, rfcDir, draftDir, loopDir)\n    if err != nil { return fmt.Errorf(\"failed to generate human-loop prompt: %w\", err) }\n    if opts.Verbose {\n        fmt.Printf(\"[INFO] Loop directory: %s\\n\", loopDir)\n        fmt.Printf(\"[INFO] Human-loop prompt saved to: %s\\n\", mainFile)\n        fmt.Printf(\"[INFO] rfc directory: %s\\n\", rfcDir)\n    }\n    if err := runtime.CallCLI(opts.Verbose, cfg, mainFile, runtime.ModeInteractive); err != nil {\n        return fmt.Errorf(\"failed to start pi CLI: %w\", err)\n    }\n    fmt.Printf(\"思考记录已保存到 %s\\n\", loopDir)\n    return nil\n}\n```\n\nAnd HumanLoopDryRun:\n```go\nfunc HumanLoopDryRun(topic string) error {\n    draftDir, rfcDir, _, err := prepareHumanLoopDirs()\n    if err != nil { return err }\n    _, content, err := builder.NewPIBuilder().BuildHumanLoop(topic, map[string]string{\"rfc_dir\": rfcDir, \"draft_dir\": draftDir})\n    if err != nil { return fmt.Errorf(\"failed to generate human-loop prompt: %w\", err) }\n    fmt.Print(content)\n    return nil\n}\n```\n\nWhere prepareHumanLoopDirs does:\n```go\nfunc prepareHumanLoopDirs() (draftDir, rfcDir, loopDir string, err error) {\n    draftDir, err = workspace.GetDraftDir()\n    if err != nil { return \"\", \"\", \"\", fmt.Errorf(\"failed to get draft directory: %w\", err) }\n    rfcDir = filepath.Join(draftDir, \"rfc\")\n    loopID, err := workspace.NextLoopID(draftDir)\n    if err != nil { return \"\", \"\", \"\", fmt.Errorf(\"failed to allocate loop id: %w\", err) }\n    loopDir = filepath.Join(draftDir, \"loops\", loopID)\n    for _, sub := range []string{draftDir, rfcDir, filepath.Join(draftDir, \"concepts\"), filepath.Join(draftDir, \"human-learning\"), filepath.Join(draftDir, \"loops\")} {\n        if err := os.MkdirAll(sub, 0755); err != nil { return \"\", \"\", \"\", fmt.Errorf(\"failed to create directory %s: %w\", sub, err) }\n    }\n    return draftDir, rfcDir, loopDir, nil\n}\n```\n\nWait, but the current code uses `rfcDir := draftDir + \"/rfc\"` (string concat). I'll use filepath.Join for cleanliness (equivalent on Linux).\n\nNow, the topic validation: the current cli does `if len(args) == 0 || args[0] == \"\"`. The task says \"cli 保留 NewHumanLoopCmd（topic 校验：空则报「topic is required」）\". So topic validation stays in the cli. Good.\n\nNow for the ctrl handler:\n```go\nfunc Ctrl(opts Options) error {\n    jID := opts.JobID\n    if jID == \"\" { return fmt.Errorf(\"--job flag is required (e.g. rick ctrl --job job_1)\") }\n    rickDir, err := workspace.GetRickDir()\n    ...\n    promptFile, _, err := builder.NewPIBuilder().SaveCtrlPrompt(jID, rickDir)\n    ...\n    cfg, err := config.LoadConfig()\n    ...\n    fmt.Printf(\"Job: %s\\n\", jID)\n    fmt.Println(\"🎮 Starting ctrl interactive session...\")\n    if err := runtime.CallCLI(opts.Verbose, cfg, promptFile, runtime.ModeInteractive); err != nil {\n        return fmt.Errorf(\"ctrl session failed: %w\", err)\n    }\n    return nil\n}\n\nfunc CtrlDryRun(opts Options) error {\n    jID := opts.JobID\n    if jID == \"\" { return fmt.Errorf(\"--job flag is required (e.g. rick ctrl --dry-run --job job_1)\") }\n    rickDir, err := workspace.GetRickDir()\n    ...\n    promptFile, _, err := builder.NewPIBuilder().SaveCtrlPrompt(jID, rickDir)\n    ...\n    data, err := os.ReadFile(promptFile)\n    ...\n    fmt.Printf(\"[DRY-RUN] ctrl prompt for %s:\\n\\n\", jID)\n    fmt.Print(string(data))\n    return nil\n}\n```\n\nWait, but the current ctrl dry-run does `SaveCtrlPrompt` which WRITES the prompt file AND returns the path, then reads it back. Hmm, that's a bit odd (writes then reads). Let me preserve it (behavior unchanged). Actually, I could use BuildCtrl + write, but to preserve behavior, I'll keep SaveCtrlPrompt + ReadFile.\n\nActually wait, there's a subtlety: `SaveCtrlPrompt` (in builder/pibuilder.go) calls `prompt.GenerateCtrlPromptFile` which:\n1. Stats doingDir → error \"doing directory not found for job %s: %s\" if not exists.\n2. Reads tasks.json, generates prompt, writes to doing/prompts/ctrl_prompt.md.\n\nSo SaveCtrlPrompt WRITES the file. Then handler reads it back. The test \"ctrl --dry-run --job job_N (doing dir doesn't exist)\" expects \"doing directory not found\" — this comes from SaveCtrlPrompt. Good.\n\nSo CtrlDryRun preserves the \"doing directory not found\" behavior via SaveCtrlPrompt. \n\nBut wait — the task says ctrl dry-run should report \"doing directory not found\" when doing dir doesn't exist. The current `runCtrlDryRun` returns the error from SaveCtrlPrompt (which is \"doing directory not found for job %s\"). So the handler should return this error (not swallow it). Let me make sure CtrlDryRun returns the error.\n\nActually, looking at the current runCtrlDryRun:\n```go\nfunc runCtrlDryRun() error {\n    jID := GetJobID()\n    if jID == \"\" { return fmt.Errorf(\"--job flag is required ...\") }\n    rickDir, err := workspace.GetRickDir()\n    if err != nil { return fmt.Errorf(\"failed to get rick directory: %w\", err) }\n    promptFile, _, err := builder.NewPIBuilder().SaveCtrlPrompt(jID, rickDir)\n    if err != nil { return fmt.Errorf(\"failed to generate ctrl prompt: %w\", err) }\n    data, err := os.ReadFile(promptFile)\n    ...\n}\n```\n\nSo SaveCtrlPrompt error (\"doing directory not found...\") is wrapped as \"failed to generate ctrl prompt: doing directory not found...\". The test checks for \"doing directory not found\" substring, which is still present in the wrapped error. Good.\n\nOK. Now for the dream handler:\n```go\nfunc Dream(jobNum int, background bool, opts Options) error {\n    // migrate dreamWorkflow\n}\nfunc DreamDryRun(jobNum int) error {\n    // migrate runDreamDryRun, using workspace.SelectPendingJobs\n}\n```\n\nThe dream scan functions move to workspace. So handler.Dream calls `workspace.SelectPendingJobs(rickDir, jobNum)`.\n\nLet me write the dream handler:\n\n```go\nfunc DreamDryRun(jobNum int) error {\n    rickDir, err := workspace.GetRickDir()\n    if err != nil {\n        fmt.Printf(\"[DRY-RUN] failed to get rick dir: %v\\n\", err)\n        return nil\n    }\n    jobIDs := workspace.SelectPendingJobs(rickDir, jobNum)\n    fmt.Printf(\"[DRY-RUN] Pending jobs (%d): %v\\n\", len(jobIDs), jobIDs)\n    _, content, err := builder.NewPIBuilder().BuildDream(map[string]string{\n        \"rick_dir\": rickDir,\n        \"job_ids\":  strings.Join(jobIDs, \",\"),\n    })\n    if err != nil {\n        fmt.Printf(\"[DRY-RUN] failed to generate dream prompt: %v\\n\", err)\n        return nil\n    }\n    fmt.Printf(\"[DRY-RUN] Dream prompt:\\n\\n\")\n    fmt.Print(content)\n    return nil\n}\n```\n\n```go\nfunc Dream(jobNum int, background bool, opts Options) error {\n    fmt.Println(\"\\n=== Dream Workflow ===\")\n    rickDir, err := workspace.GetRickDir()\n    if err != nil { return fmt.Errorf(\"failed to get rick directory: %w\", err) }\n    dreamDir := filepath.Join(rickDir, workspace.DreamDirName)\n    if err := os.MkdirAll(dreamDir, 0755); err != nil { return fmt.Errorf(\"failed to create dream directory: %w\", err) }\n    jobIDs := workspace.SelectPendingJobs(rickDir, jobNum)\n    if len(jobIDs) == 0 {\n        fmt.Println(\"No new completed jobs to process.\")\n        fmt.Println(\"All jobs have already been dreamed, or no jobs are fully completed yet.\")\n        return nil\n    }\n    fmt.Printf(\"Processing %d job(s): %s\\n\", len(jobIDs), strings.Join(jobIDs, \", \"))\n    promptFile, _, err := builder.NewPIBuilder().SaveDreamPrompt(jobIDs, rickDir)\n    if err != nil { return fmt.Errorf(\"failed to generate dream prompt: %w\", err) }\n    cfg, err := config.LoadConfig()\n    if err != nil { return fmt.Errorf(\"failed to load config: %w\", err) }\n    if background {\n        fmt.Println(\"🤖 Starting pi (background mode)...\")\n        if err := runtime.CallCLI(opts.Verbose, cfg, promptFile, runtime.ModePrint); err != nil { return fmt.Errorf(\"pi failed: %w\", err) }\n    } else {\n        fmt.Println(\"🤖 Starting pi (interactive mode)...\")\n        if err := runtime.CallCLI(opts.Verbose, cfg, promptFile, runtime.ModeInteractive); err != nil { return fmt.Errorf(\"pi failed: %w\", err) }\n    }\n    fmt.Println(\"\\n✅ Dream phase completed!\")\n    fmt.Println(\"Agent should have written dream_run_{job_id}_log.md for each processed job.\")\n    return nil\n}\n```\n\nNote: the current dreamWorkflow uses `GetVerbose()` for CallCLI. I'll use `opts.Verbose`.\n\nNow for the learning handler:\n```go\ntype ExecutionData struct {\n    JobID        string\n    DebugContent string\n    TasksJSON    *executor.TasksJSON\n    TaskMDPaths  []string\n    RickDir      string\n    ActPathFiles []string\n}\n\nfunc Learning(jobID string, opts Options) error {\n    // migrate executeLearningWorkflow\n}\n\nfunc LearningDryRun(jobID string) error {\n    // migrate runLearningDryRun\n}\n\nfunc collectExecutionData(jobID string) (*ExecutionData, error) { ... }\nfunc callAgentForAnalysis(data *ExecutionData, opts Options) error { ... }  // needs verbose\nfunc buildLearningPrompt(data *ExecutionData, learningDir, promptsDir string) (string, error) { ... }\n```\n\nWait, `callAgentForAnalysis` currently uses `GetVerbose()` in `runtime.CallCLI`. So I need to pass opts to it, OR make callAgentForAnalysis a method... Let me pass verbose bool.\n\nActually, let me look at the current `callAgentForAnalysis`:\n```go\nfunc callAgentForAnalysis(data *ExecutionData) error {\n    ...\n    if err := runtime.CallCLI(GetVerbose(), cfg, promptFile, runtime.ModeInteractive); err != nil {\n```\n\nSo it uses GetVerbose(). In handler, I'll pass `opts.Verbose` (or a verbose bool param).\n\nAnd `executeLearningWorkflow` uses `callAgentForAnalysis(data)`. And `collectExecutionData` uses `executor.LoadDebugContext` and `executor.LoadTasksJSON`.\n\nFor `runLearningDryRun`:\n```go\nfunc runLearningDryRun(jobID string) error {\n    if jobID == \"\" { jobID = GetJobID() }\n    if jobID == \"\" { jobID = \"job_N\" }\n    ...\n}\n```\n\nIn handler, `LearningDryRun(jobID string)` — the cli will resolve jobID (from args or --job flag) before calling. So handler.LearningDryRun receives a resolved jobID, but it still needs the \"job_N\" fallback for when jobID is empty.\n\nLet me look at how the cli resolves jobID for learning:\n```go\nRunE: func(cmd, args) error {\n    if len(args) > 0 { jobID = args[0] }\n    if jobID == \"\" { jobID = GetJobID() }\n    if GetDryRun() { return runLearningDryRun(jobID) }\n    if jobID == \"\" { return fmt.Errorf(\"job ID is required...\") }\n    if err := validateJobID(jobID); err != nil { return err }\n    if err := executeLearningWorkflow(jobID); err != nil { return err }\n}\n```\n\nSo in the thin cli, I'll keep:\n```go\nRunE: func(cmd, args) error {\n    if GetVerbose() { fmt.Println(\"[INFO] Starting learning phase...\") }\n    if len(args) > 0 { jobID = args[0] }\n    if jobID == \"\" { jobID = GetJobID() }\n    opts := handler.Options{Verbose: GetVerbose(), DryRun: GetDryRun(), JobID: GetJobID()}\n    if GetDryRun() { return handler.LearningDryRun(jobID) }\n    if jobID == \"\" { return fmt.Errorf(\"job ID is required. Usage: rick learning [job_id] or rick learning --job job_id\") }\n    if err := validateJobID(jobID); err != nil { return err }\n    if GetVerbose() { fmt.Printf(\"[INFO] Analyzing learnings for job: %s\\n\", jobID) }\n    if err := handler.Learning(jobID, opts); err != nil { return err }\n    fmt.Printf(\"✅ Learning phase completed for job %s!\\n\", jobID)\n    return nil\n}\n```\n\nAnd handler.LearningDryRun(jobID):\n```go\nfunc LearningDryRun(jobID string) error {\n    if jobID == \"\" { jobID = \"job_N\" }\n    rickDir, err := workspace.GetRickDir()\n    if err != nil { fmt.Printf(\"[DRY-RUN] failed to get rick dir: %v\\n\", err); return nil }\n    jobDir := filepath.Join(rickDir, \"jobs\", jobID)\n    learningDir := filepath.Join(jobDir, \"learning\")\n    data := &ExecutionData{JobID: jobID, RickDir: rickDir, TaskMDPaths: []string{}, ActPathFiles: []string{}}\n    doingDir := filepath.Join(jobDir, \"doing\")\n    data.DebugContent = executor.LoadDebugContext(doingDir)\n    promptsDir := \"\"\n    promptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n    if err != nil { fmt.Printf(\"[DRY-RUN] failed to generate learning prompt: %v\\n\", err); return nil }\n    content, err := os.ReadFile(promptFile)\n    if err != nil { fmt.Printf(\"[DRY-RUN] failed to read prompt file: %v\\n\", err); return nil }\n    loopsDir := filepath.Join(rickDir, \"loops\")\n    skillsDir := filepath.Join(rickDir, \"skills\")\n    fmt.Printf(\"[DRY-RUN] Learning prompt (saved to: %s):\\n\", promptFile)\n    fmt.Printf(\"[DRY-RUN] loops_dir=%s\\n\", loopsDir)\n    fmt.Printf(\"[DRY-RUN] skills_dir=%s\\n\\n\", skillsDir)\n    fmt.Println(string(content))\n    return nil\n}\n```\n\nWait, but `runLearningDryRun` currently does `if jobID == \"\" { jobID = GetJobID() }` first, then `if jobID == \"\" { jobID = \"job_N\" }`. Since the cli already resolved jobID from args/flag, the handler only needs the \"job_N\" fallback (when neither args nor flag provided). Actually, the cli passes the resolved jobID (which could be \"\" if neither args nor --job). So handler.LearningDryRun needs: `if jobID == \"\" { jobID = \"job_N\" }`. Good.\n\nNow for `buildLearningPrompt`, it's unexported in handler, and `callAgentForAnalysis` also unexported. Tests for these move to handler package.\n\nNow, let me also double check: the `buildLearningPrompt` uses `data.TasksJSON.Tasks` (direct field access) and `data.TasksJSON` is `*executor.TasksJSON`. So handler imports executor. Fine.\n\nNow, let me also handle the learning handler's use of `GetVerbose` inside `executeLearningWorkflow`/`callAgentForAnalysis`/`collectExecutionData`. Looking at current code:\n\n`executeLearningWorkflow` prints:\n```go\nfmt.Println(\"\\n=== Learning Workflow ===\")\nfmt.Println()\nfmt.Println(\"=== Step 1: Collecting execution data ===\")\ndata, err := collectExecutionData(jobID)\n...\nfmt.Println(\"\\n=== Step 2: Analyzing with pi ===\")\nfmt.Println(\"Calling pi for analysis...\")\nif err := callAgentForAnalysis(data); err != nil { ... }\nfmt.Println(\"\\n✅ Learning workflow completed!\")\n```\n\n`collectExecutionData` prints:\n```go\nfmt.Printf(\"✅ Loaded debug context (%d bytes)\\n\", ...)\nfmt.Printf(\"✅ Loaded tasks.json (%d tasks)\\n\", ...)\nfmt.Printf(\"✅ Found %d task*.md files\\n\", ...)\nfmt.Println(\"⚠ No task*.md files found in plan directory\")\nfmt.Printf(\"✅ Found %d act-path.md files\\n\", ...)\n```\n\n`callAgentForAnalysis` prints and uses GetVerbose() for CallCLI.\n\nSo in handler:\n- `Learning(jobID, opts)` → calls collectExecutionData + callAgentForAnalysis(data, opts.Verbose).\n- `collectExecutionData` unchanged (no opts needed).\n- `callAgentForAnalysis(data *ExecutionData, verbose bool)` — replaces GetVerbose() with verbose param.\n\nNow, the error messages must match for tests:\n- `TestExecuteLearningWorkflow_NoDoingDir` (moves to handler) expects `executeLearningWorkflow(\"job_test\")` to return error when doing dir missing. In handler, `Learning(\"job_test\", opts)` → collectExecutionData returns error \"doing directory not found: ...\". So `Learning` returns error. Test checks `err != nil`. Good.\n\n- `TestCollectExecutionData_NoDoingDir` (moves to handler) → `collectExecutionData(\"job_test\")` returns error. Good.\n\n- The task test method: \"learning job_N（doing/tasks.json 不存在）→ 报 tasks.json not found exit 非 0 不 panic\". Current collectExecutionData:\n```go\nif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n    return nil, fmt.Errorf(\"doing directory not found: %s (has the job been executed?)\", doingDir)\n}\n...\ntasksJSONPath := filepath.Join(doingDir, \"tasks.json\")\nif _, err := os.Stat(tasksJSONPath); err == nil {\n    ... load ...\n} else {\n    return nil, fmt.Errorf(\"tasks.json not found: %s\", tasksJSONPath)\n}\n```\n\nSo if doing dir exists but tasks.json doesn't → \"tasks.json not found\". Good. If doing dir doesn't exist → \"doing directory not found\". The task test says \"learning job_N（doing/tasks.json 不存在）\" → expects \"tasks.json not found\". This means the doing dir exists but tasks.json doesn't. So I need to preserve this exact behavior. My migration preserves it exactly.\n\nNow, let me think about the tests that need to MOVE to handler package and what imports they need.\n\nLet me plan the handler test files:\n\n`internal/handler/learning_test.go` (package handler):\n- TestBuildLearningPrompt (migrated from cmd/learning_test.go)\n- TestExecutionDataStruct\n- TestExecuteLearningWorkflow_NoDoingDir → rename to TestLearning_NoDoingDir (calls Learning)\n- TestBuildLearningPromptInjectsDraftDir\n- TestExecuteLearningWorkflow_WithMockPi → rename to TestLearning_WithMockPi (calls Learning)\n- TestCollectExecutionData_NoDoingDir (moved from tools_test.go)\n- TestCollectExecutionData_WithData (moved from tools_test.go)\n- TestCollectExecutionData_NoDebugMD (moved from tools_test.go)\n\nThese tests reference `ExecutionData`, `buildLearningPrompt`, `Learning` (formerly executeLearningWorkflow), `collectExecutionData`. All in handler package (same package, unexported accessible).\n\nThey also need `executor.TaskState`, `executor.TasksJSON`, `prompt.NewPromptManager`.\n\nFor the moved collectExecutionData tests from tools_test.go, they use `makeTasksJSON` helper which is defined in tools_test.go (package cmd). I'll need to re-create a similar helper in handler test OR inline it. Let me create a helper in handler test.\n\nActually, `makeTasksJSON` is defined in cmd/tools_test.go. When I move the collectExecutionData tests to handler, I need a helper. I'll add a `writeTasksJSON` helper in handler/learning_test.go.\n\nLet me now also check: does `internal/handler/doing_test.go` already have a makeTasksJSON or similar? Let me check to avoid name collision.\n\nActually, let me check what's in handler/doing_test.go and handler/plan_test.go and handler/easy.go to understand existing test patterns and helpers.\n\nLet me read handler tests.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_00_qHbwNspLnCGGefOTW1Dg0774","name":"read","arguments":{"path":"/workdir/sunquan20/AI_CODING/rick/internal/handler/doing_test.go"}},{"type":"toolCall","id":"call_01_VcbXuISEKieQt7hTOc751271","name":"read","arguments":{"path":"/workdir/sunquan20/AI_CODING/rick/internal/handler/plan_test.go"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":1399,"output":12207,"cacheRead":109824,"cacheWrite":0,"reasoning":12093,"totalTokens":123430,"cost":{"input":0.000608565,"output":0.01062009,"cacheRead":0.000398112,"cacheWrite":0,"total":0.011626767000000001}},"stopReason":"toolUse","timestamp":1786910504248,"responseId":"ca7a3dfb-3bd0-46d2-b015-b9290ce63d59","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_00_qHbwNspLnCGGefOTW1Dg0774","toolName":"read","content":[{"type":"text","text":"package handler\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/sunquan/rick/internal/executor\"\n\t\"github.com/sunquan/rick/internal/parser\"\n)\n\nfunc TestExtractTaskNumber(t *testing.T) {\n\ttests := []struct {\n\t\tfilename string\n\t\texpected int\n\t}{\n\t\t{\"task1.md\", 1},\n\t\t{\"task2.md\", 2},\n\t\t{\"task10.md\", 10},\n\t\t{\"task99.md\", 99},\n\t\t{\"task.md\", 0},\n\t\t{\"notask.md\", 0},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.filename, func(t *testing.T) {\n\t\t\tresult := extractTaskNumber(tt.filename)\n\t\t\tif result != tt.expected {\n\t\t\t\tt.Errorf(\"extractTaskNumber(%q) = %d, want %d\", tt.filename, result, tt.expected)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestSortTaskFiles(t *testing.T) {\n\ttests := []struct {\n\t\tname     string\n\t\tinput    []string\n\t\texpected []string\n\t}{\n\t\t{\n\t\t\tname:     \"unsorted files\",\n\t\t\tinput:    []string{\"task3.md\", \"task1.md\", \"task2.md\"},\n\t\t\texpected: []string{\"task1.md\", \"task2.md\", \"task3.md\"},\n\t\t},\n\t\t{\n\t\t\tname:     \"already sorted\",\n\t\t\tinput:    []string{\"task1.md\", \"task2.md\", \"task3.md\"},\n\t\t\texpected: []string{\"task1.md\", \"task2.md\", \"task3.md\"},\n\t\t},\n\t\t{\n\t\t\tname:     \"reverse order\",\n\t\t\tinput:    []string{\"task5.md\", \"task4.md\", \"task3.md\", \"task2.md\", \"task1.md\"},\n\t\t\texpected: []string{\"task1.md\", \"task2.md\", \"task3.md\", \"task4.md\", \"task5.md\"},\n\t\t},\n\t\t{\n\t\t\tname:     \"single file\",\n\t\t\tinput:    []string{\"task1.md\"},\n\t\t\texpected: []string{\"task1.md\"},\n\t\t},\n\t\t{\n\t\t\tname:     \"empty list\",\n\t\t\tinput:    []string{},\n\t\t\texpected: []string{},\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tsortTaskFiles(tt.input)\n\t\t\tif len(tt.input) != len(tt.expected) {\n\t\t\t\tt.Errorf(\"Length mismatch: got %d, want %d\", len(tt.input), len(tt.expected))\n\t\t\t}\n\t\t\tfor i, v := range tt.input {\n\t\t\t\tif v != tt.expected[i] {\n\t\t\t\t\tt.Errorf(\"Element %d: got %q, want %q\", i, v, tt.expected[i])\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestLoadTasksFromPlan(t *testing.T) {\n\ttmpDir := t.TempDir()\n\tplanDir := filepath.Join(tmpDir, \"plan\")\n\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\tt.Fatalf(\"Failed to create plan directory: %v\", err)\n\t}\n\n\ttask1Content := `# 依赖关系\n\n\n# 任务名称\nTask 1\n\n# 任务目标\nComplete task 1\n\n# 关键结果\n1. Result 1\n2. Result 2\n\n# 测试方法\n1. Test 1\n2. Test 2\n`\n\n\ttask2Content := `# 依赖关系\ntask1\n\n# 任务名称\nTask 2\n\n# 任务目标\nComplete task 2\n\n# 关键结果\n1. Result 1\n\n# 测试方法\n1. Test 1\n`\n\n\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1Content), 0644); err != nil {\n\t\tt.Fatalf(\"Failed to write task1.md: %v\", err)\n\t}\n\n\tif err := os.WriteFile(filepath.Join(planDir, \"task2.md\"), []byte(task2Content), 0644); err != nil {\n\t\tt.Fatalf(\"Failed to write task2.md: %v\", err)\n\t}\n\n\ttasks, err := loadTasksFromPlan(planDir)\n\tif err != nil {\n\t\tt.Fatalf(\"loadTasksFromPlan failed: %v\", err)\n\t}\n\n\tif len(tasks) != 2 {\n\t\tt.Errorf(\"Expected 2 tasks, got %d\", len(tasks))\n\t}\n\n\tif tasks[0].ID != \"task1\" {\n\t\tt.Errorf(\"Expected task1 ID, got %s\", tasks[0].ID)\n\t}\n\tif tasks[0].Name != \"Task 1\" {\n\t\tt.Errorf(\"Expected 'Task 1', got %s\", tasks[0].Name)\n\t}\n\tif len(tasks[0].Dependencies) != 0 {\n\t\tt.Errorf(\"Expected no dependencies for task1, got %v\", tasks[0].Dependencies)\n\t}\n\n\tif tasks[1].ID != \"task2\" {\n\t\tt.Errorf(\"Expected task2 ID, got %s\", tasks[1].ID)\n\t}\n\tif tasks[1].Name != \"Task 2\" {\n\t\tt.Errorf(\"Expected 'Task 2', got %s\", tasks[1].Name)\n\t}\n\tif len(tasks[1].Dependencies) != 1 || tasks[1].Dependencies[0] != \"task1\" {\n\t\tt.Errorf(\"Expected task1 dependency for task2, got %v\", tasks[1].Dependencies)\n\t}\n}\n\nfunc TestLoadTasksFromPlanNoFiles(t *testing.T) {\n\ttmpDir := t.TempDir()\n\tplanDir := filepath.Join(tmpDir, \"plan\")\n\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\tt.Fatalf(\"Failed to create plan directory: %v\", err)\n\t}\n\n\ttasks, err := loadTasksFromPlan(planDir)\n\tif err == nil {\n\t\tt.Error(\"Expected error for empty plan directory\")\n\t}\n\tif tasks != nil {\n\t\tt.Errorf(\"Expected nil tasks for empty directory, got %v\", tasks)\n\t}\n}\n\nfunc TestLoadTasksFromPlanNotFound(t *testing.T) {\n\tnonexistentDir := filepath.Join(t.TempDir(), \"nonexistent\")\n\n\ttasks, err := loadTasksFromPlan(nonexistentDir)\n\tif err == nil {\n\t\tt.Error(\"Expected error for nonexistent plan directory\")\n\t}\n\tif tasks != nil {\n\t\tt.Errorf(\"Expected nil tasks, got %v\", tasks)\n\t}\n}\n\nfunc TestPrintExecutionSummary(t *testing.T) {\n\tresult := &executor.ExecutionJobResult{\n\t\tJobID:           \"job1\",\n\t\tStatus:          \"completed\",\n\t\tTotalTasks:      3,\n\t\tSuccessfulTasks: 3,\n\t\tFailedTasks:     0,\n\t\tTaskResults: []*executor.RetryResult{\n\t\t\t{\n\t\t\t\tTaskID:        \"task1\",\n\t\t\t\tTaskName:      \"Task 1\",\n\t\t\t\tStatus:        \"success\",\n\t\t\t\tTotalAttempts: 1,\n\t\t\t},\n\t\t\t{\n\t\t\t\tTaskID:        \"task2\",\n\t\t\t\tTaskName:      \"Task 2\",\n\t\t\t\tStatus:        \"success\",\n\t\t\t\tTotalAttempts: 1,\n\t\t\t},\n\t\t\t{\n\t\t\t\tTaskID:        \"task3\",\n\t\t\t\tTaskName:      \"Task 3\",\n\t\t\t\tStatus:        \"success\",\n\t\t\t\tTotalAttempts: 1,\n\t\t\t},\n\t\t},\n\t}\n\n\t// This should not panic\n\tprintExecutionSummary(result)\n}\n\nfunc TestPrintExecutionSummaryWithFailures(t *testing.T) {\n\tresult := &executor.ExecutionJobResult{\n\t\tJobID:           \"job1\",\n\t\tStatus:          \"partial\",\n\t\tTotalTasks:      3,\n\t\tSuccessfulTasks: 2,\n\t\tFailedTasks:     1,\n\t\tTaskResults: []*executor.RetryResult{\n\t\t\t{\n\t\t\t\tTaskID:        \"task1\",\n\t\t\t\tTaskName:      \"Task 1\",\n\t\t\t\tStatus:        \"success\",\n\t\t\t\tTotalAttempts: 1,\n\t\t\t},\n\t\t\t{\n\t\t\t\tTaskID:        \"task2\",\n\t\t\t\tTaskName:      \"Task 2\",\n\t\t\t\tStatus:        \"failed\",\n\t\t\t\tTotalAttempts: 3,\n\t\t\t\tLastError:     \"Connection timeout\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tTaskID:        \"task3\",\n\t\t\t\tTaskName:      \"Task 3\",\n\t\t\t\tStatus:        \"success\",\n\t\t\t\tTotalAttempts: 1,\n\t\t\t},\n\t\t},\n\t}\n\n\t// This should not panic\n\tprintExecutionSummary(result)\n}\n\nfunc TestTaskStruct(t *testing.T) {\n\ttask := &parser.Task{\n\t\tID:           \"task1\",\n\t\tName:         \"Test Task\",\n\t\tGoal:         \"Complete the test\",\n\t\tKeyResults:   []string{\"Result 1\", \"Result 2\"},\n\t\tTestMethod:   \"Run tests\",\n\t\tDependencies: []string{},\n\t}\n\n\tif task.ID != \"task1\" {\n\t\tt.Errorf(\"Expected task ID task1, got %s\", task.ID)\n\t}\n\n\tif task.Name != \"Test Task\" {\n\t\tt.Errorf(\"Expected task name 'Test Task', got %s\", task.Name)\n\t}\n\n\tif len(task.KeyResults) != 2 {\n\t\tt.Errorf(\"Expected 2 key results, got %d\", len(task.KeyResults))\n\t}\n}\n\nfunc TestExecutionJobResultDuration(t *testing.T) {\n\tnow := time.Now()\n\tresult := &executor.ExecutionJobResult{\n\t\tStartTime: now,\n\t\tEndTime:   now.Add(5 * time.Second),\n\t}\n\n\tduration := result.Duration()\n\tif duration.Seconds() != 5.0 {\n\t\tt.Errorf(\"Expected duration 5s, got %v\", duration)\n\t}\n}\n\n// TestDoing_NoJobDir tests Doing with missing job dir.\nfunc TestDoing_NoJobDir(t *testing.T) {\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\tif err := os.MkdirAll(filepath.Join(dir, \".rick\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\terr = Doing(\"job_test\", Options{})\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing job dir\")\n\t}\n}\n\n// TestDoing_NoPlanDir tests Doing with missing plan dir.\nfunc TestDoing_NoPlanDir(t *testing.T) {\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\tif err := os.MkdirAll(filepath.Join(dir, \".rick\", \"jobs\", \"job_test\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\terr = Doing(\"job_test\", Options{})\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing plan dir\")\n\t}\n}\n\n// TestDoing_NoTasks tests Doing with empty plan dir.\nfunc TestDoing_NoTasks(t *testing.T) {\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\tif err := os.MkdirAll(filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\terr = Doing(\"job_test\", Options{})\n\tif err == nil {\n\t\tt.Fatal(\"expected error for no tasks\")\n\t}\n}\n\n// TestDoing_ResumesFromTasksJSON verifies that when doing/tasks.json already\n// exists with task1=success, Doing loads it and skips task1.\nfunc TestDoing_ResumesFromTasksJSON(t *testing.T) {\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\t// Override HOME so LoadConfig reads from temp dir (MaxRetries=2 avoids long sleeps).\n\tt.Setenv(\"HOME\", dir)\n\trickCfgDir := filepath.Join(dir, \".rick\")\n\tif err := os.MkdirAll(rickCfgDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(rickCfgDir, \"config.json\"), []byte(`{\"max_retries\":2}`), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// Set up plan directory with two tasks\n\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_resume\", \"plan\")\n\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttask1 := \"# 依赖关系\\n\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal1\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest1\\n\"\n\ttask2 := \"# 依赖关系\\ntask1\\n# 任务名称\\nTask2\\n# 任务目标\\nGoal2\\n# 关键结果\\n1. KR2\\n# 测试方法\\nTest2\\n\"\n\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(planDir, \"task2.md\"), []byte(task2), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// Pre-create doing/tasks.json with task1 already succeeded\n\tdoingDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_resume\", \"doing\")\n\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\texistingJSON := `{\n  \"version\": \"1.0\",\n  \"created_at\": \"2024-01-01T00:00:00Z\",\n  \"updated_at\": \"2024-01-01T00:00:00Z\",\n  \"tasks\": [\n    {\"task_id\": \"task1\", \"task_name\": \"Task1\", \"status\": \"success\",\n     \"dependencies\": [], \"attempts\": 1,\n     \"created_at\": \"2024-01-01T00:00:00Z\", \"updated_at\": \"2024-01-01T00:00:00Z\"},\n    {\"task_id\": \"task2\", \"task_name\": \"Task2\", \"status\": \"pending\",\n     \"dependencies\": [\"task1\"], \"attempts\": 0,\n     \"created_at\": \"2024-01-01T00:00:00Z\", \"updated_at\": \"2024-01-01T00:00:00Z\"}\n  ]\n}`\n\tif err := os.WriteFile(filepath.Join(doingDir, \"tasks.json\"), []byte(existingJSON), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// Use a mock pi that exits 0 but never creates a test script,\n\t// so task2 will fail — but task1 must be skipped entirely.\n\tmockDir := t.TempDir()\n\tmockScript := \"#!/bin/sh\\nexit 0\\n\"\n\tmockPath := filepath.Join(mockDir, \"pi\")\n\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\torigPath := os.Getenv(\"PATH\")\n\t_ = os.Setenv(\"PATH\", mockDir+\":\"+origPath)\n\tdefer os.Setenv(\"PATH\", origPath)\n\n\t// Run the workflow — it will fail on task2 (mock claude doesn't create test script),\n\t// but the key assertion is about task1 being skipped.\n\t_ = Doing(\"job_resume\", Options{})\n\n\t// Read the persisted tasks.json and verify task1 is still \"success\"\n\tloaded, err := executor.LoadTasksJSON(filepath.Join(doingDir, \"tasks.json\"))\n\tif err != nil {\n\t\tt.Fatalf(\"failed to load tasks.json after workflow: %v\", err)\n\t}\n\tstatus, err := loaded.GetTaskStatus(\"task1\")\n\tif err != nil {\n\t\tt.Fatalf(\"GetTaskStatus task1 failed: %v\", err)\n\t}\n\tif status != \"success\" {\n\t\tt.Errorf(\"expected task1 to remain 'success' after resume, got '%s'\", status)\n\t}\n}\n\n// TestDoing_WithMockPi tests Doing with mock pi.\nfunc TestDoing_WithMockPi(t *testing.T) {\n\t// Create mock pi that exits 0 but creates no test script\n\tmockDir := t.TempDir()\n\tmockScript := \"#!/bin/sh\\nexit 0\\n\"\n\tmockPath := filepath.Join(mockDir, \"pi\")\n\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\t// Override HOME so LoadConfig reads from temp dir (MaxRetries=2 avoids long sleeps).\n\tt.Setenv(\"HOME\", dir)\n\trickCfgDir := filepath.Join(dir, \".rick\")\n\tif err := os.MkdirAll(rickCfgDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(rickCfgDir, \"config.json\"), []byte(`{\"max_retries\":2}`), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// Set up workspace\n\tplanDir := filepath.Join(dir, \".rick\", \"jobs\", \"job_test\", \"plan\")\n\tif err := os.MkdirAll(planDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\ttask1 := \"# 依赖关系\\n无\\n# 任务名称\\nTask1\\n# 任务目标\\nGoal\\n# 关键结果\\n1. KR1\\n# 测试方法\\nTest\\n\"\n\tif err := os.WriteFile(filepath.Join(planDir, \"task1.md\"), []byte(task1), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\torigPath := os.Getenv(\"PATH\")\n\t_ = os.Setenv(\"PATH\", mockDir+\":\"+origPath)\n\tdefer os.Setenv(\"PATH\", origPath)\n\n\t// Doing will fail when ExecuteJob tries to run claude, but it should reach\n\t// that point (covering the workflow setup code).\n\terr = Doing(\"job_test\", Options{})\n\tt.Logf(\"Doing returned: %v\", err)\n}\n"}],"isError":false,"timestamp":1786910618669},{"role":"toolResult","toolCallId":"call_01_VcbXuISEKieQt7hTOc751271","toolName":"read","content":[{"type":"text","text":"package handler\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\n// TestReEnterPlan_NonExistentJob tests error when job plan dir does not exist.\nfunc TestReEnterPlan_NonExistentJob(t *testing.T) {\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\tif err := os.MkdirAll(filepath.Join(dir, \".rick\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\terr = ReEnterPlan(\"job_999\", \"test requirement\", Options{})\n\tif err == nil {\n\t\tt.Fatal(\"expected error for non-existent job plan directory\")\n\t}\n\tif !strings.Contains(err.Error(), \"job job_999 plan directory does not exist\") {\n\t\tt.Errorf(\"unexpected error message: %v\", err)\n\t}\n}\n\n// TestPlan_WithMockPi tests Plan with mock pi binary.\nfunc TestPlan_WithMockPi(t *testing.T) {\n\tmockDir := t.TempDir()\n\tmockScript := \"#!/bin/sh\\nexit 0\\n\"\n\tmockPath := filepath.Join(mockDir, \"pi\")\n\tif err := os.WriteFile(mockPath, []byte(mockScript), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\torig, err := os.Getwd()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdir := t.TempDir()\n\tif err := os.Chdir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer func() { _ = os.Chdir(orig) }()\n\n\tif err := os.MkdirAll(filepath.Join(dir, \".rick\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// Isolate HOME so LoadConfig reads this test's config (never the real\n\t// ~/.rick/config.json), and point pi_path at the mock pi so the workflow\n\t// resolves the mock directly — not the real managed runtime or PATH pi.\n\thome := t.TempDir()\n\tt.Setenv(\"HOME\", home)\n\n\t// Write a config with mock pi path\n\tcfgContent := fmt.Sprintf(`{\"pi_path\": \"%s\"}`, mockPath)\n\tcfgDir := filepath.Join(home, \".rick\")\n\tif err := os.MkdirAll(cfgDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(cfgDir, \"config.json\"), []byte(cfgContent), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\torigPath := os.Getenv(\"PATH\")\n\t_ = os.Setenv(\"PATH\", mockDir+\":\"+origPath)\n\tdefer os.Setenv(\"PATH\", origPath)\n\n\terr = Plan(\"test requirement\", Options{})\n\tt.Logf(\"Plan returned: %v\", err)\n}\n"}],"isError":false,"timestamp":1786910618669}]}
