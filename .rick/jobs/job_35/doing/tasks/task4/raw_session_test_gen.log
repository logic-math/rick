.\nfunc contains(s, sub string) bool {\n\treturn len(sub) == 0 || (len(s) >= len(sub) && indexOf(s, sub) >= 0)\n}\n\nfunc indexOf(s, sub string) int {\n\tfor i := 0; i+len(sub) <= len(s); i++ {\n\t\tif s[i:i+len(sub)] == sub {\n\t\t\treturn i\n\t\t}\n"}],"isError":false,"timestamp":1786901827497}}
