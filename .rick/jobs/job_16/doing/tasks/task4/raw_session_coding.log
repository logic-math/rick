{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WNXeYQgJkGPQSuBHRq2SVy","type":"tool_result","content":"1\tpackage cmd\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"os/exec\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/spf13/cobra\"\n11\t\t\"github.com/sunquan/rick/internal/config\"\n12\t\t\"github.com/sunquan/rick/internal/executor\"\n13\t\t\"github.com/sunquan/rick/internal/prompt\"\n14\t\t\"github.com/sunquan/rick/internal/workspace\"\n15\t)\n16\t\n17\tfunc NewLearningCmd() *cobra.Command {\n18\t\tvar jobID string\n19\t\n20\t\tlearningCmd := &cobra.Command{\n21\t\t\tUse:   \"learning [job_id]\",\n22\t\t\tShort: \"Analyze and document learnings from job execution\",\n23\t\t\tLong:  `Analyze execution results and update documentation (OKR, SPEC, wiki, skills).`,\n24\t\t\tArgs:  cobra.MaximumNArgs(1),\n25\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n26\t\t\t\tif GetVerbose() {\n27\t\t\t\t\tfmt.Println(\"[INFO] Starting learning phase...\")\n28\t\t\t\t}\n29\t\n30\t\t\t\tif GetDryRun() {\n31\t\t\t\t\treturn runLearningDryRun(jobID)\n32\t\t\t\t}\n33\t\n34\t\t\t\tif len(args) > 0 {\n35\t\t\t\t\tjobID = args[0]\n36\t\t\t\t} else if jobID == \"\" {\n37\t\t\t\t\tjobID = GetJobID()\n38\t\t\t\t}\n39\t\n40\t\t\t\tif jobID == \"\" {\n41\t\t\t\t\treturn fmt.Errorf(\"job ID is required. Usage: rick learning [job_id] or rick learning --job job_id\")\n42\t\t\t\t}\n43\t\n44\t\t\t\tif err := validateJobID(jobID); err != nil {\n45\t\t\t\t\treturn err\n46\t\t\t\t}\n47\t\n48\t\t\t\tif GetVerbose() {\n49\t\t\t\t\tfmt.Printf(\"[INFO] Analyzing learnings for job: %s\\n\", jobID)\n50\t\t\t\t}\n51\t\n52\t\t\t\tif err := executeLearningWorkflow(jobID); err != nil {\n53\t\t\t\t\treturn err\n54\t\t\t\t}\n55\t\n56\t\t\t\tfmt.Printf(\"✅ Learning phase completed for job %s!\\n\", jobID)\n57\t\t\t\treturn nil\n58\t\t\t},\n59\t\t}\n60\t\n61\t\tlearningCmd.Flags().StringVar(&jobID, \"job\", \"\", \"Job ID to analyze\")\n62\t\n63\t\treturn learningCmd\n64\t}\n65\t\n66\t// ExecutionData holds all execution information for learning\n67\ttype ExecutionData struct {\n68\t\tJobID        string\n69\t\tDebugContent string // raw content of debug.md, embedded directly in prompt\n70\t\tTasksJSON    *executor.TasksJSON\n71\t\tOKRContent   string\n72\t\tTaskMDPaths  []string\n73\t\tSpecPath     string\n74\t\tActPathFiles []string\n75\t}\n76\t\n77\t// runLearningDryRun generates and prints the learning prompt without executing it.\n78\tfunc runLearningDryRun(jobID string) error {\n79\t\tif jobID == \"\" {\n80\t\t\tjobID = \"job_N\"\n81\t\t}\n82\t\n83\t\trickDir, err := workspace.GetRickDir()\n84\t\tif err != nil {\n85\t\t\tfmt.Printf(\"[DRY-RUN] failed to get rick dir: %v\\n\", err)\n86\t\t\treturn nil\n87\t\t}\n88\t\n89\t\tjobDir := filepath.Join(rickDir, \"jobs\", jobID)\n90\t\tlearningDir := filepath.Join(jobDir, \"learning\")\n91\t\n92\t\tdata := &ExecutionData{\n93\t\t\tJobID:        jobID,\n94\t\t\tSpecPath:     filepath.Join(rickDir, \"SPEC.md\"),\n95\t\t\tTaskMDPaths:  []string{},\n96\t\t\tActPathFiles: []string{},\n97\t\t}\n98\t\n99\t\tif content, err := os.ReadFile(filepath.Join(jobDir, \"plan\", \"OKR.md\")); err == nil {\n100\t\t\tdata.OKRContent = string(content)\n101\t\t}\n102\t\tif content, err := os.ReadFile(filepath.Join(jobDir, \"doing\", \"debug.md\")); err == nil {\n103\t\t\tdata.DebugContent = string(content)\n104\t\t}\n105\t\n106\t\tpromptsDir, _ := prompt.EnsurePromptsDir(learningDir)\n107\t\tpromptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n108\t\tif err != nil {\n109\t\t\tfmt.Printf(\"[DRY-RUN] failed to generate learning prompt: %v\\n\", err)\n110\t\t\treturn nil\n111\t\t}\n112\t\n113\t\tcontent, err := os.ReadFile(promptFile)\n114\t\tif err != nil {\n115\t\t\tfmt.Printf(\"[DRY-RUN] failed to read prompt file: %v\\n\", err)\n116\t\t\treturn nil\n117\t\t}\n118\t\tfmt.Printf(\"[DRY-RUN] Learning prompt (saved to: %s):\\n\\n\", promptFile)\n119\t\tfmt.Println(string(content))\n120\t\treturn nil\n121\t}\n122\t\n123\t// executeLearningWorkflow executes the complete learning workflow\n124\tfunc executeLearningWorkflow(jobID string) error {\n125\t\tfmt.Println(\"\\n=== Learning Workflow ===\")\n126\t\tfmt.Println()\n127\t\n128\t\tfmt.Println(\"=== Step 1: Collecting execution data ===\")\n129\t\tdata, err := collectExecutionData(jobID)\n130\t\tif err != nil {\n131\t\t\treturn fmt.Errorf(\"failed to collect execution data: %w\", err)\n132\t\t}\n133\t\n134\t\tfmt.Println(\"\\n=== Step 2: Analyzing with Claude ===\")\n135\t\tfmt.Println(\"Calling Claude Code CLI for analysis...\")\n136\t\n137\t\tif err := callClaudeForAnalysis(data); err != nil {\n138\t\t\treturn fmt.Errorf(\"Claude analysis failed: %w\", err)\n139\t\t}\n140\t\n141\t\tfmt.Println(\"\\n✅ Learning workflow completed!\")\n142\t\treturn nil\n143\t}\n144\t\n145\t// collectExecutionData collects execution data paths for learning\n146\tfunc collectExecutionData(jobID string) (*ExecutionData, error) {\n147\t\trickDir, err := workspace.GetRickDir()\n148\t\tif err != nil {\n149\t\t\treturn nil, fmt.Errorf(\"failed to get rick directory: %w\", err)\n150\t\t}\n151\t\n152\t\tjobDir := filepath.Join(rickDir, \"jobs\", jobID)\n153\t\tdoingDir := filepath.Join(jobDir, \"doing\")\n154\t\n155\t\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n156\t\t\treturn nil, fmt.Errorf(\"doing directory not found: %s (has the job been executed?)\", doingDir)\n157\t\t}\n158\t\n159\t\tdata := &ExecutionData{\n160\t\t\tJobID:    jobID,\n161\t\t\tSpecPath: filepath.Join(rickDir, \"SPEC.md\"),\n162\t\t}\n163\t\n164\t\t// debug.md — embed content directly\n165\t\tdebugPath := filepath.Join(doingDir, \"debug.md\")\n166\t\tif content, err := os.ReadFile(debugPath); err == nil {\n167\t\t\tdata.DebugContent = string(content)\n168\t\t\tfmt.Printf(\"✅ Read debug.md (%d bytes)\\n\", len(content))\n169\t\t} else {\n170\t\t\tfmt.Println(\"⚠ debug.md not found\")\n171\t\t}\n172\t\n173\t\t// tasks.json\n174\t\ttasksJSONPath := filepath.Join(doingDir, \"tasks.json\")\n175\t\tif _, err := os.Stat(tasksJSONPath); err == nil {\n176\t\t\ttasksJSON, err := executor.LoadTasksJSON(tasksJSONPath)\n177\t\t\tif err != nil {\n178\t\t\t\treturn nil, fmt.Errorf(\"failed to load tasks.json: %w\", err)\n179\t\t\t}\n180\t\t\tdata.TasksJSON = tasksJSON\n181\t\t\tfmt.Printf(\"✅ Loaded tasks.json (%d tasks)\\n\", len(tasksJSON.Tasks))\n182\t\t} else {\n183\t\t\treturn nil, fmt.Errorf(\"tasks.json not found: %s\", tasksJSONPath)\n184\t\t}\n185\t\n186\t\t// OKR.md — full content load\n187\t\tplanDir := filepath.Join(jobDir, \"plan\")\n188\t\tif content, err := os.ReadFile(filepath.Join(planDir, \"OKR.md\")); err == nil {\n189\t\t\tdata.OKRContent = string(content)\n190\t\t\tfmt.Printf(\"✅ Read OKR.md (%d bytes)\\n\", len(content))\n191\t\t} else {\n192\t\t\tfmt.Println(\"⚠ OKR.md not found (skipping)\")\n193\t\t}\n194\t\n195\t\t// task*.md paths\n196\t\ttaskFiles, err := filepath.Glob(filepath.Join(planDir, \"task*.md\"))\n197\t\tif err != nil {\n198\t\t\treturn nil, fmt.Errorf(\"failed to glob task files: %w\", err)\n199\t\t}\n200\t\tdata.TaskMDPaths = taskFiles\n201\t\tif len(taskFiles) > 0 {\n202\t\t\tfmt.Printf(\"✅ Found %d task*.md files\\n\", len(taskFiles))\n203\t\t} else {\n204\t\t\tfmt.Println(\"⚠ No task*.md files found in plan directory\")\n205\t\t}\n206\t\n207\t\t// act-path.md paths\n208\t\tactPathPattern := filepath.Join(doingDir, \"tasks\", \"*\", \"act-path.md\")\n209\t\tactPathFiles, err := filepath.Glob(actPathPattern)\n210\t\tif err == nil {\n211\t\t\tdata.ActPathFiles = actPathFiles\n212\t\t\tfmt.Printf(\"✅ Found %d act-path.md files\\n\", len(actPathFiles))\n213\t\t}\n214\t\n215\t\treturn data, nil\n216\t}\n217\t\n218\t// callClaudeForAnalysis calls Claude Code CLI for analysis\n219\tfunc callClaudeForAnalysis(data *ExecutionData) error {\n220\t\trickDir, err := workspace.GetRickDir()\n221\t\tif err != nil {\n222\t\t\treturn fmt.Errorf(\"failed to get rick directory: %w\", err)\n223\t\t}\n224\t\n225\t\tlearningDir := filepath.Join(rickDir, \"jobs\", data.JobID, \"learning\")\n226\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n227\t\t\treturn fmt.Errorf(\"failed to create learning directory: %w\", err)\n228\t\t}\n229\t\n230\t\tfmt.Printf(\"✅ Created learning directory: %s\\n\\n\", learningDir)\n231\t\n232\t\tpromptsDir, err := prompt.EnsurePromptsDir(learningDir)\n233\t\tif err != nil {\n234\t\t\treturn fmt.Errorf(\"failed to create prompts dir: %w\", err)\n235\t\t}\n236\t\n237\t\tpromptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n238\t\tif err != nil {\n239\t\t\treturn fmt.Errorf(\"failed to build learning prompt: %w\", err)\n240\t\t}\n241\t\n242\t\tcfg, err := config.LoadConfig()\n243\t\tif err != nil {\n244\t\t\treturn fmt.Errorf(\"failed to load config: %w\", err)\n245\t\t}\n246\t\n247\t\tclaudePath := cfg.ClaudeCodePath\n248\t\tif claudePath == \"\" {\n249\t\t\tclaudePath = \"claude\"\n250\t\t}\n251\t\n252\t\tfmt.Printf(\"📝 提示词已保存到: %s\\n\", promptFile)\n253\t\tfmt.Println(\"🤖 启动 Claude Code CLI 交互模式...\")\n254\t\tfmt.Println(\"📌 Claude 将在 learning 目录下生成文档（等待人工审核后合并）\")\n255\t\tfmt.Println()\n256\t\n257\t\tcmd := exec.Command(claudePath, promptFile)\n258\t\tcmd.Stdin = os.Stdin\n259\t\tcmd.Stdout = os.Stdout\n260\t\tcmd.Stderr = os.Stderr\n261\t\n262\t\tif err := cmd.Run(); err != nil {\n263\t\t\treturn fmt.Errorf(\"Claude Code CLI 执行失败: %w\", err)\n264\t\t}\n265\t\n266\t\tfmt.Println()\n267\t\tfmt.Println(\"✅ Learning 阶段完成！\")\n268\t\tfmt.Printf(\"📁 执行摘要: %s/SUMMARY.md\\n\", learningDir)\n269\t\tfmt.Println()\n270\t\n271\t\treturn nil\n272\t}\n273\t\n274\t// buildLearningPrompt builds learning prompt and saves to promptsDir/learning_prompt.md.\n275\t// Returns the prompt file path; all files are persistent, no cleanup needed.\n276\tfunc buildLearningPrompt(data *ExecutionData, learningDir, promptsDir string) (string, error) {\n277\t\tpromptMgr := prompt.NewPromptManager(\"\")\n278\t\n279\t\ttemplate, err := promptMgr.LoadTemplate(\"learning\")\n280\t\tif err != nil {\n281\t\t\treturn \"\", fmt.Errorf(\"failed to load learning template: %w\", err)\n282\t\t}\n283\t\n284\t\tbuilder := prompt.NewPromptBuilder(template)\n285\t\n286\t\tbuilder.SetVariable(\"job_id\", data.JobID)\n287\t\tbuilder.SetVariable(\"learning_dir\", learningDir)\n288\t\n289\t\t// OKR — full content\n290\t\tif data.OKRContent != \"\" {\n291\t\t\tbuilder.SetVariable(\"okr_content\", data.OKRContent)\n292\t\t} else {\n293\t\t\tbuilder.SetVariable(\"okr_content\", \"（本 job 无 OKR.md）\")\n294\t\t}\n295\t\n296\t\t// SPEC path and .rick/ sub-directories (learning writes directly here)\n297\t\tbuilder.SetVariable(\"spec_path\", data.SpecPath)\n298\t\trickDir := filepath.Dir(data.SpecPath) // .rick/SPEC.md → .rick/\n299\t\tbuilder.SetVariable(\"wiki_dir\", filepath.Join(rickDir, \"wiki\"))\n300\t\tbuilder.SetVariable(\"tools_dir\", filepath.Join(rickDir, \"tools\"))\n301\t\n302\t\t// debug.md — embed content directly\n303\t\tif data.DebugContent != \"\" {\n304\t\t\tbuilder.SetVariable(\"debug_content\", data.DebugContent)\n305\t\t} else {\n306\t\t\tbuilder.SetVariable(\"debug_content\", \"（本次 job 无 debug.md 记录）\")\n307\t\t}\n308\t\n309\t\t// task*.md paths\n310\t\tif len(data.TaskMDPaths) > 0 {\n311\t\t\tvar sb strings.Builder\n312\t\t\tfor _, p := range data.TaskMDPaths {\n313\t\t\t\tsb.WriteString(fmt.Sprintf(\"  - `%s`\\n\", p))\n314\t\t\t}\n315\t\t\tbuilder.SetVariable(\"task_md_files\", strings.TrimRight(sb.String(), \"\\n\"))\n316\t\t} else {\n317\t\t\tbuilder.SetVariable(\"task_md_files\", \"  （无 task*.md 文件）\")\n318\t\t}\n319\t\n320\t\t// act-path.md paths\n321\t\tif len(data.ActPathFiles) > 0 {\n322\t\t\tvar sb strings.Builder\n323\t\t\tfor _, p := range data.ActPathFiles {\n324\t\t\t\tsb.WriteString(fmt.Sprintf(\"  - `%s`\\n\", p))\n325\t\t\t}\n326\t\t\tbuilder.SetVariable(\"act_path_files\", strings.TrimRight(sb.String(), \"\\n\"))\n327\t\t} else {\n328\t\t\tbuilder.SetVariable(\"act_path_files\", \"  （无 act-path.md 文件）\")\n329\t\t}\n330\t\n331\t\t// task execution results table\n332\t\tvar taskResults strings.Builder\n333\t\tif data.TasksJSON != nil {\n334\t\t\ttaskResults.WriteString(\"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\n\")\n335\t\t\ttaskResults.WriteString(\"|---------|---------|------|-------------|----------|\\n\")\n336\t\t\tfor _, task := range data.TasksJSON.Tasks {\n337\t\t\t\tcommitHash := task.CommitHash\n338\t\t\t\tif commitHash == \"\" {\n339\t\t\t\t\tcommitHash = \"N/A\"\n340\t\t\t\t} else if len(commitHash) > 8 {\n341\t\t\t\t\tcommitHash = commitHash[:8]\n342\t\t\t\t}\n343\t\t\t\ttaskResults.WriteString(fmt.Sprintf(\"| %s | %s | %s | %s | %d |\\n\",\n344\t\t\t\t\ttask.TaskID, task.TaskName, task.Status, commitHash, task.Attempts))\n345\t\t\t}\n346\t\t} else {\n347\t\t\ttaskResults.WriteString(\"无任务元信息\\n\")\n348\t\t}\n349\t\tbuilder.SetVariable(\"task_execution_results\", taskResults.String())\n350\t\n351\t\t// rick_bin_path\n352\t\tprojectRoot, err := os.Getwd()\n353\t\tif err != nil {\n354\t\t\tprojectRoot = \".\"\n355\t\t}\n356\t\tbuilder.SetVariable(\"rick_bin_path\", filepath.Join(projectRoot, \"bin\", \"rick\"))\n357\t\n358\t\t// Write gen-skill to prompts/ dir, inject path\n359\t\tgenSkillFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_skill.md\", \"gen-skill\")\n360\t\tif err != nil {\n361\t\t\treturn \"\", fmt.Errorf(\"failed to write gen-skill: %w\", err)\n362\t\t}\n363\t\tbuilder.SetVariable(\"gen_skill_path\", genSkillFile)\n364\t\n365\t\tpromptFile := filepath.Join(promptsDir, \"learning_prompt.md\")\n366\t\tif err := builder.SaveToFile(promptFile); err != nil {\n367\t\t\treturn \"\", fmt.Errorf(\"failed to save learning prompt: %w\", err)\n368\t\t}\n369\t\n370\t\treturn promptFile, nil\n371\t}\n372\t"}]},"parent_tool_use_id":"toolu_bdrk_01L5nTEF1fMYkhwE9CYSC68k","session_id":"9c7b55b1-09d3-48f4-9913-da4bfa9fb3a8","uuid":"a5bf1bc1-180b-43e2-b812-3e9e31808395","timestamp":"2026-06-11T08:03:30.524Z"}
