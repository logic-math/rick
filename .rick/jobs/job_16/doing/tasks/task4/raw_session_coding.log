{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Y1T5N4C13aMfiP3EyCPMLC","type":"tool_result","content":"1\tpackage executor\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"strings\"\n7\t\t\"time\"\n8\t\n9\t\t\"github.com/sunquan/rick/internal/parser\"\n10\t)\n11\t\n12\t// RetryResult represents the result of a retry operation\n13\ttype RetryResult struct {\n14\t\tTaskID         string\n15\t\tTaskName       string\n16\t\tStatus         string    // success, failed, max_retries_exceeded\n17\t\tTotalAttempts  int\n18\t\tLastError      string\n19\t\tOutput         string\n20\t\tDebugLogsAdded []string // List of debug entries added\n21\t\tStartTime      time.Time\n22\t\tEndTime        time.Time\n23\t}\n24\t\n25\t// Duration returns the total execution duration\n26\tfunc (rr *RetryResult) Duration() time.Duration {\n27\t\treturn rr.EndTime.Sub(rr.StartTime)\n28\t}\n29\t\n30\t// TaskRetryManager manages task retries with debug logging\n31\ttype TaskRetryManager struct {\n32\t\trunner    *TaskRunner\n33\t\tconfig    *ExecutionConfig\n34\t\tdebugFile string\n35\t}\n36\t\n37\t// NewTaskRetryManager creates a new TaskRetryManager instance\n38\tfunc NewTaskRetryManager(runner *TaskRunner, config *ExecutionConfig, debugFile string) *TaskRetryManager {\n39\t\treturn &TaskRetryManager{\n40\t\t\trunner:    runner,\n41\t\t\tconfig:    config,\n42\t\t\tdebugFile: debugFile,\n43\t\t}\n44\t}\n45\t\n46\t// RetryTask executes a task with retry logic following the new workflow:\n47\t// 1. Generate test script once (outside retry loop)\n48\t// 2. Retry loop: load debug context -> execute task -> run test -> update debug.md if failed\n49\tfunc (trm *TaskRetryManager) RetryTask(task *parser.Task) (*RetryResult, error) {\n50\t\tif task == nil {\n51\t\t\treturn nil, fmt.Errorf(\"task cannot be nil\")\n52\t\t}\n53\t\n54\t\tif trm.config == nil {\n55\t\t\treturn nil, fmt.Errorf(\"execution config is required\")\n56\t\t}\n57\t\n58\t\tresult := &RetryResult{\n59\t\t\tTaskID:        task.ID,\n60\t\t\tTaskName:      task.Name,\n61\t\t\tStatus:        \"running\",\n62\t\t\tTotalAttempts: 0,\n63\t\t\tStartTime:     time.Now(),\n64\t\t}\n65\t\n66\t\tmaxRetries := trm.config.MaxRetries\n67\t\tif maxRetries <= 0 {\n68\t\t\tmaxRetries = 5 // Default to 5 retries\n69\t\t}\n70\t\n71\t\tvar lastExecResult *TaskExecutionResult\n72\t\tvar testErrorFeedback string // Accumulate test errors for feedback\n73\t\n74\t\t// Retry loop - this implements the \"while not pass\" logic\n75\t\tfor attempt := 1; attempt <= maxRetries; attempt++ {\n76\t\t\tresult.TotalAttempts = attempt\n77\t\n78\t\t\t// Load debug context from debug.md if it exists\n79\t\t\tdebugContext := trm.loadDebugContext(trm.debugFile)\n80\t\n81\t\t\t// Execute the task with debug context and test error feedback\n82\t\t\t// This will:\n83\t\t\t// 1. Generate doing prompt with task.md + debug.md + test errors + OKR.md + SPEC.md\n84\t\t\t// 2. Call Claude to execute the task (may fix test script if needed)\n85\t\t\t// 3. Run the test script\n86\t\t\t// 4. Return pass/fail result\n87\t\t\texecResult, err := trm.runner.RunTask(task, debugContext, testErrorFeedback)\n88\t\t\tif err != nil {\n89\t\t\t\tlastExecResult = execResult\n90\t\t\t\t// Accumulate test error for next retry\n91\t\t\t\tif execResult != nil && execResult.Error != \"\" {\n92\t\t\t\t\tnewEntry := fmt.Sprintf(\"=== Attempt %d ===\\n%s\\n\", attempt, execResult.Error)\n93\t\t\t\t\ttestErrorFeedback = appendFailureFeedback(testErrorFeedback, newEntry, 2, 3000)\n94\t\t\t\t}\n95\t\t\t\t// Continue to next retry\n96\t\t\t\tcontinue\n97\t\t\t}\n98\t\n99\t\t\tlastExecResult = execResult\n100\t\n101\t\t\t// Check if task succeeded\n102\t\t\tif execResult.Status == \"success\" {\n103\t\t\t\tresult.Status = \"success\"\n104\t\t\t\tresult.Output = execResult.Output\n105\t\t\t\tresult.EndTime = time.Now()\n106\t\t\t\treturn result, nil\n107\t\t\t}\n108\t\n109\t\t\t// Task failed, record error\n110\t\t\tresult.LastError = execResult.Error\n111\t\t\t// Note: debug.md is now managed by Claude, not by the program\n112\t\n113\t\t\t// Accumulate test error feedback for next retry (keep last 2 attempts only)\n114\t\t\t// execResult.Error already contains the full test output (including stderr/traceback)\n115\t\t\tif execResult.Error != \"\" {\n116\t\t\t\tnewEntry := fmt.Sprintf(\"=== Attempt %d ===\\n%s\\n\", attempt, execResult.Error)\n117\t\t\t\ttestErrorFeedback = appendFailureFeedback(testErrorFeedback, newEntry, 2, 3000)\n118\t\t\t}\n119\t\n120\t\t\t// If this is not the last attempt, continue to next retry\n121\t\t\tif attempt < maxRetries {\n122\t\t\t\t// Optional: add delay between retries\n123\t\t\t\ttime.Sleep(time.Duration(attempt) * time.Second)\n124\t\t\t\tcontinue\n125\t\t\t}\n126\t\t}\n127\t\n128\t\t// Max retries exceeded\n129\t\tresult.Status = \"max_retries_exceeded\"\n130\t\tresult.Output = lastExecResult.Output\n131\t\tresult.LastError = fmt.Sprintf(\"task failed after %d attempts: %s\", maxRetries, result.LastError)\n132\t\tresult.EndTime = time.Now()\n133\t\n134\t\treturn result, nil\n135\t}\n136\t\n137\t// loadDebugContext reads the debug.md file and returns its content\n138\t// This provides context for retry decisions\n139\tfunc (trm *TaskRetryManager) loadDebugContext(debugFile string) string {\n140\t\tif debugFile == \"\" {\n141\t\t\treturn \"\"\n142\t\t}\n143\t\n144\t\tcontent, err := os.ReadFile(debugFile)\n145\t\tif err != nil {\n146\t\t\t// File might not exist yet, which is okay\n147\t\t\treturn \"\"\n148\t\t}\n149\t\n150\t\treturn string(content)\n151\t}\n152\t\n153\t// Note: Debug logging is now handled by Claude, not by the program\n154\t// The program only loads debug.md and passes it as context\n155\t\n156\t// RetryTaskSimple is a convenience function that creates a TaskRetryManager and retries a task\n157\t// It's useful for simple retry operations without managing a separate manager instance\n158\tfunc RetryTaskSimple(task *parser.Task, runner *TaskRunner, config *ExecutionConfig, debugFile string) (*RetryResult, error) {\n159\t\tmanager := NewTaskRetryManager(runner, config, debugFile)\n160\t\treturn manager.RetryTask(task)\n161\t}\n162\t\n163\t// appendFailureFeedback adds a new failure entry to the accumulated feedback,\n164\t// keeping only the most recent maxEntries entries and capping total length at maxBytes.\n165\t// Each entry is expected to start with \"=== Attempt \".\n166\tfunc appendFailureFeedback(existing, newEntry string, maxEntries int, maxBytes int) string {\n167\t\tconst separator = \"=== Attempt \"\n168\t\n169\t\t// Split existing into individual entries by the separator\n170\t\tvar entries []string\n171\t\tif existing != \"\" {\n172\t\t\tparts := strings.Split(existing, separator)\n173\t\t\tfor _, p := range parts {\n174\t\t\t\tif p != \"\" {\n175\t\t\t\t\tentries = append(entries, separator+p)\n176\t\t\t\t}\n177\t\t\t}\n178\t\t}\n179\t\n180\t\t// Append new entry\n181\t\tentries = append(entries, newEntry)\n182\t\n183\t\t// Keep only last maxEntries\n184\t\tif len(entries) > maxEntries {\n185\t\t\tentries = entries[len(entries)-maxEntries:]\n186\t\t}\n187\t\n188\t\t// Join and cap at maxBytes (keep the tail to preserve most recent content)\n189\t\tresult := strings.Join(entries, \"\")\n190\t\tif len(result) > maxBytes {\n191\t\t\tresult = result[len(result)-maxBytes:]\n192\t\t\t// Trim to a clean line boundary to avoid partial lines\n193\t\t\tif idx := strings.Index(result, \"\\n\"); idx >= 0 {\n194\t\t\t\tresult = result[idx+1:]\n195\t\t\t}\n196\t\t}\n197\t\treturn result\n198\t}\n199\t"}]},"parent_tool_use_id":"toolu_bdrk_01L5nTEF1fMYkhwE9CYSC68k","session_id":"9c7b55b1-09d3-48f4-9913-da4bfa9fb3a8","uuid":"077c3983-b1a8-4fed-b8de-1d9c2a91edbb","timestamp":"2026-06-11T08:03:30.213Z"}
