nfig not set correctly\")\n54\t\t}\n55\t}\n56\t\n57\t// TestExecuteTestScript tests script execution with a Python script returning JSON\n58\tfunc TestExecuteTestScript(t *testing.T) {\n59\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n60\t\n61\t\ttmpDir := os.TempDir()\n62\t\tscriptPath := filepath.Join(tmpDir, \"test_script_pass.py\")\n63\t\tscriptContent := `import json\n64\tprint(json.dumps({\"pass\": True, \"errors\": []}))\n65\t`\n66\t\terr := os.WriteFile(scriptPath, []byte(scriptContent), 0644)\n67\t\tif err != nil {\n68\t\t\tt.Fatalf(\"Failed to create test script: %v\", err)\n69\t\t}\n70\t\tdefer os.Remove(scriptPath)\n71\t\n72\t\tresult, output, err := runner.ExecuteTestScript(scriptPath)\n73\t\tif err != nil {\n74\t\t\tt.Fatalf(\"ExecuteTestScript failed: %v\", err)\n75\t\t}\n76\t\n77\t\tif result == nil {\n78\t\t\tt.Fatal(\"Expected non-nil result\")\n79\t\t}\n80\t\n81\t\tif !result.Pass {\n82\t\t\tt.Errorf(\"Expected pass=true, got false. Output: %s\", output)\n83\t\t}\n84\t}\n85\t\n86\t// TestExecuteTestScript_EmptyPath tests with empty script path\n87\tfunc TestExecuteTestScript_EmptyPath(t *testing.T) {\n88\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n89\t\n90\t\t_, _, err := runner.ExecuteTestScript(\"\")\n91\t\tif err == nil {\n92\t\t\tt.Fatal(\"Expected error for empty script path\")\n93\t\t}\n94\t}\n95\t\n96\t// TestExecuteTestScript_NonexistentFile tests with nonexistent file\n97\tfunc TestExecuteTestScript_NonexistentFile(t *testing.T) {\n98\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n99\t\n100\t\t_, _, err := runner.ExecuteTestScript(\"/nonexistent/path/script.py\")\n101\t\tif err == nil {\n102\t\t\tt.Fatal(\"Expected error for nonexistent file\")\n103\t\t}\n104\t}\n105\t\n106\t// TestExecuteTestScript_WithTimeout tests timeout handling\n107\tfunc TestExecuteTestScript_WithTimeout(t *testing.T) {\n108\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 1}, &mockAgentExecutor{})\n109\t\n110\t\ttmpDir := os.TempDir()\n111\t\tscriptPath := filepath.Join(tmpDir, \"timeout_script.py\")\n112\t\tscriptContent := `import time\n113\ttime.sleep(5)\n114\tprint(\"This should not execute\")\n115\t`\n116\t\terr := os.WriteFile(scriptPath, []byte(scriptContent), 0644)\n117\t\tif err != nil {\n118\t\t\tt.Fatalf(\"Failed to create test script: %v\", err)\n119\t\t}\n120\t\tdefer os.Remove(scriptPath)\n121\t\n122\t\t_, _, err = runner.ExecuteTestScript(scriptPath)\n123\t\tif err == nil {\n124\t\t\tt.Fatal(\"Expected timeout error\")\n125\t\t}\n126\t\tif !strings.Contains(err.Error(), \"timeout\") {\n127\t\t\tt.Errorf(\"Expected timeout error, got: %v\", err)\n128\t\t}\n129\t}\n130\t\n131\t// TestExecuteTestScript_FailResult tests script that returns fail JSON\n132\tfunc TestExecuteTestScript_FailResult(t *testing.T) {\n133\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n134\t\n135\t\ttmpDir := os.TempDir()\n136\t\tscriptPath := filepath.Join(tmpDir, \"fail_script.py\")\n137\t\tscriptContent := `import json\n138\tprint(json.dumps({\"pass\": False, \"errors\": [\"assertion failed\"]}))\n139\t`\n140\t\terr := os.WriteFile(scriptPath, []byte(scriptContent), 0644)\n141\t\tif err != nil {\n142\t\t\tt.Fatalf(\"Failed to create test script: %v\", err)\n143\t\t}\n144\t\tdefer os.Remove(scriptPath)\n145\t\n146\t\tresult, _, err := runner.ExecuteTestScript(scriptPath)\n147\t\tif err != nil {\n148\t\t\tt.Fatalf(\"ExecuteTestScript failed: %v\", err)\n149\t\t}\n150\t\n151\t\tif result == nil {\n152\t\t\tt.Fatal(\"Expected non-nil result\")\n153\t\t}\n154\t\n155\t\tif result.Pass {\n156\t\t\tt.Error(\"Expected pass=false\")\n157\t\t}\n158\t\n159\t\tif len(result.Errors) == 0 {\n160\t\t\tt.Error(\"Expected errors in result\")\n161\t\t}\n162\t}\n163\t\n164\t// TestRunTask_NilTask tests with nil task\n165\tfunc TestRunTask_NilTask(t *testing.T) {\n166\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n167\t\n168\t\t_, err := runner.RunTask(nil, \"\", \"\")\n169\t\tif err == nil {\n170\t\t\tt.Fatal(\"Expected error for nil task\")\n171\t\t}\n172\t}\n173\t\n174\t// TestTaskExecutionResult_Duration tests duration calculation\n175\tfunc TestTaskExecutionResult_Duration(t *testing.T) {\n176\t\tresult := &TaskExecutionResult{\n177\t\t\tTaskID:    \"task1\",\n178\t\t\tStartTime: time.Now(),\n179\t\t}\n180\t\n181\t\ttime.Sleep(10 * time.Millisecond)\n182\t\tresult.EndTime = time.Now()\n183\t\n184\t\tduration := result.Duration()\n185\t\tif duration < 10*time.Millisecond {\n186\t\t\tt.Errorf(\"Duration too short: %v\", duration)\n187\t\t}\n188\t}\n189\t\n190\t// TestTaskExecutionResult_Fields tests all fields are set correctly\n191\tfunc TestTaskExecutionResult_Fields(t *testing.T) {\n192\t\tstartTime := time.Now()\n193\t\tendTime := startTime.Add(5 * time.Second)\n194\t\n195\t\tresult := &TaskExecutionResult{\n196\t\t\tTaskID:    \"test_task\",\n197\t\t\tTaskName:  \"Test Task\",\n198\t\t\tStatus:    \"success\",\n199\t\t\tError:     \"\",\n200\t\t\tOutput:    \"Test output\",\n201\t\t\tStartTime: startTime,\n202\t\t\tEndTime:   endTime,\n203\t\t}\n204\t\n205\t\tif result.TaskID != \"test_task\" {\n206\t\t\tt.Error(\"TaskID not set correctly\")\n207\t\t}\n208\t\tif result.TaskName != \"Test Task\" {\n209\t\t\tt.Error(\"TaskName not set correctly\")\n210\t\t}\n211\t\tif result.Status != \"success\" {\n212\t\t\tt.Error(\"Status not set correctly\")\n213\t\t}\n214\t\tif result.Output != \"Test output\" {\n215\t\t\tt.Error(\"Output not set correctly\")\n216\t\t}\n217\t\n218\t\tduration := result.Duration()\n219\t\tif duration != 5*time.Second {\n220\t\t\tt.Errorf(\"Duration calculation incorrect: expected 5s, got %v\", duration)\n221\t\t}\n222\t}\n223\t\n224\t// TestGenerateDoingPromptFile_NilTask tests with nil task\n225\tfunc TestGenerateDoingPromptFile_NilTask(t *testing.T) {\n226\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n227\t\n228\t\t_, _, err := runner.GenerateDoingPromptFile(nil, \"\", \"\")\n229\t\tif err == nil {\n230\t\t\tt.Fatal(\"Expected error for nil task\")\n231\t\t}\n232\t}\n233\t\n234\t// TestGenerateDoingPromptFile_ValidTask tests prompt file generation\n235\tfunc TestGenerateDoingPromptFile_ValidTask(t *testing.T) {\n236\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n237\t\n238\t\ttask := &parser.Task{\n239\t\t\tID:         \"task1\",\n240\t\t\tName:       \"Test Task\",\n241\t\t\tGoal:       \"Test goal\",\n242\t\t\tTestMethod: \"- Step 1\\n- Step 2\",\n243\t\t}\n244\t\n245\t\tpromptFile, _, err := runner.GenerateDoingPromptFile(task, \"\", \"\")\n246\t\tif err != nil {\n247\t\t\tt.Fatalf(\"GenerateDoingPromptFile failed: %v\", err)\n248\t\t}\n249\t\tdefer os.Remove(promptFile)\n250\t\n251\t\tif _, err := os.Stat(promptFile); err != nil {\n252\t\t\tt.Fatalf(\"Prompt file not created: %v\", err)\n253\t\t}\n254\t\n255\t\tcontent, err := os.ReadFile(promptFile)\n256\t\tif err != nil {\n257\t\t\tt.Fatalf(\"Failed to read prompt file: %v\", err)\n258\t\t}\n259\t\n260\t\tif len(content) == 0 {\n261\t\t\tt.Error(\"Prompt file is empty\")\n262\t\t}\n263\t}\n264\t\n265\t// TestGenerateDoingPromptFile_WithDebugContext tests that debug.md content is embedded in prompt\n266\tfunc TestGenerateDoingPromptFile_WithDebugContext(t *testing.T) {\n267\t\ttmpDir := t.TempDir()\n268\t\t// Simulate .rick/jobs/job_1/doing structure\n269\t\tworkspaceDir := filepath.Join(tmpDir, \".rick\", \"jobs\", \"job_1\", \"doing\")\n270\t\tif err := os.MkdirAll(workspaceDir, 0755); err != nil {\n271\t\t\tt.Fatal(err)\n272\t\t}\n273\t\tdebugContent := \"## debug1: Previous error\\nSome debug info\"\n274\t\tif err := os.WriteFile(filepath.Join(workspaceDir, \"debug.md\"), []byte(debugContent), 0644); err != nil {\n275\t\t\tt.Fatal(err)\n276\t\t}\n277\t\n278\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30, WorkspaceDir: workspaceDir}, &mockAgentExecutor{})\n279\t\ttask := &parser.Task{ID: \"task1\", Name: \"Test Task\", Goal: \"Test goal\"}\n280\t\n281\t\tpromptFile, _, err := runner.GenerateDoingPromptFile(task, \"\", \"\")\n282\t\tif err != nil {\n283\t\t\tt.Fatalf(\"GenerateDoingPromptFile failed: %v\", err)\n284\t\t}\n285\t\tdefer os.Remove(promptFile)\n286\t\n287\t\tcontent, err := os.ReadFile(promptFile)\n288\t\tif err != nil {\n289\t\t\tt.Fatalf(\"Failed to read prompt file: %v\", err)\n290\t\t}\n291\t\n292\t\tif !strings.Contains(string(content), \"Previous error\") {\n293\t\t\tt.Error(\"Prompt file should contain debug.md content\")\n294\t\t}\n295\t}\n296\t\n297\t// TestGenerateDoingPromptFile_WithTestErrorFeedback tests prompt with test error feedback\n298\tfunc TestGenerateDoingPromptFile_WithTestErrorFeedback(t *testing.T) {\n299\t\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n300\t\n301\t\ttask := &parser.Task{\n302\t\t\tID:   \"task1\",\n303\t\t\tName: \"Test Task\",\n304\t\t\tGoal: \"Test goal\",\n305\t\t}\n306\t\n307\t\ttestFeedback := \"Attempt 1: test did not pass: assertion error\"\n308\t\tpromptFile, _, err := runner.GenerateDoingPromptFile(task, \"\", testFeedback)\n309\t\tif err != nil {\n310\t\t\tt.Fatalf(\"GenerateDoingPromptFile failed: %v\", err)\n311\t\t}\n312\t\tdefer os.Remove(promptFile)\n313\t\n314\t\tcontent, err := os.ReadFile(promptFile)\n315\t\tif err != nil {\n316\t\t\tt.Fatalf(\"Failed to read prompt file: %v\", err)\n317\t\t}\n318\t\n319\t\tif !strings.Contains(string(content), testFeedback) {\n320\t\t\tt.Error(\"Prompt file should contain test error feedback\")\n321\t\t}\n322\t}\n323\t\n324\t// TestBuildTestGenerationPromptFile tests the test prompt file generation\n325\tfunc TestBuildTestGenerationPromptFile(t *testing.T) {\n326\t\tconfig := &ExecutionConfig{TimeoutSeconds: 30}\n327\t\trunner := NewTaskRunner(config, &mockAgentExecutor{})\n328\t\n329\t\ttask := &parser.Task{\n330\t\t\tID:         \"task1\",\n331\t\t\tName:       \"Test Task\",\n332\t\t\tGoal:       \"Test goal\",\n333\t\t\tTestMethod: \"Run the test\",\n334\t\t}\n335\t\n336\t\tpromptFile, _, err := runner.buildTestGenerationPromptFile(task, \"/tmp/test_task1.py\", TestGenContext{})\n337\t\tif err != nil {\n338\t\t\tt.Fatalf(\"buildTestGenerationPromptFile failed: %v\", err)\n339\t\t}\n340\t\tdefer os.Remove(promptFile)\n341\t\n342\t\tif _, err := os.Stat(promptFile); err != nil {\n343\t\t\tt.Fatalf(\"prompt file not created: %v\", err)\n344\t\t}\n345\t\n346\t\tcontent, err := os.ReadFile(promptFile)\n347\t\tif err != nil {\n348\t\t\tt.Fatal(err)\n349\t\t}\n350\t\tif !strings.Contains(string(content), \"task1\") {\n351\t\t\tt.Error(\"prompt file should contain task ID\")\n352\t\t}\n353\t}\n354\t\n355\tfunc TestBuildTestGenerationPromptFile_NilTask(t *testing.T) {\n356\t\tconfig := &ExecutionConfig{TimeoutSeconds: 30}\n357\t\trunner := NewTaskRunner(config, &mockAgentExecutor{})\n358\t\n359\t\t// nil task should be handled gracefully by the caller (RunTask checks for nil)\n360\t\t// buildTestGenerationPromptFile itself may panic or error on nil task\n361\t\t// We just verify it doesn't silently succeed with bad data\n362\t\ttask := &parser.Task{ID: \"t1\", Name: \"T\", Goal: \"G\", TestMethod: \"test\"}\n363\t\tpromptFile, _, err := runner.buildTestGenerationPromptFile(task, \"/tmp/test.py\", TestGenContext{})\n364\t\tif err != nil {\n365\t\t\tt.Logf(\"buildTestGenerationPromptFile returned error (acceptable): %v\", err)\n366\t\t\treturn\n367\t\t}\n368\t\tdefer os.Remove(promptFile)\n369\t}\n370\t\n371\t// TestRunTask_ActPathGeneration validates KR1: act-path.md is generated after Execute.\n372\tfunc TestRunTask_ActPathGeneration(t *testing.T) {\n373\t\ttmpDir := t.TempDir()\n374\t\n375\t\t// Pre-create test script so GenerateTestWithAgent skips claude invocation.\n376\t\ttestsDir := filepath.Join(tmpDir, \"tests\")\n377\t\tif err := os.MkdirAll(testsDir, 0755); err != nil {\n378\t\t\tt.Fatalf(\"failed to create tests dir: %v\", err)\n379\t\t}\n380\t\tscriptContent := \"import json\\nprint(json.dumps({\\\"pass\\\": True, \\\"errors\\\": []}))\\n\"\n381\t\tif err := os.WriteFile(filepath.Join(testsDir, \"task1.py\"), []byte(scriptContent), 0644); err != nil {\n382\t\t\tt.Fatalf(\"failed to write test script: %v\", err)\n383\t\t}\n384\t\n385\t\t// Create a temp raw log file as the session's RawLogPath.\n386\t\trawLog, err := os.CreateTemp(tmpDir, \"raw_session_*.log\")\n387\t\tif err != nil {\n388\t\t\tt.Fatalf(\"failed to create raw log: %v\", err)\n389\t\t}\n390\t\trawLog.Close()\n391\t\n392\t\tsess := &mockAgentSession{\n393\t\t\tid:   \"sess-1\",\n394\t\t\ttoolCalls: []agent.ToolCall{\n395\t\t\t\t{Name: \"bash\", Input: \"echo hi\", IsError: false, Line: 1},\n396\t\t\t},\n397\t\t\tfinalMessage:     \"done\",\n398\t\t\tfinalMessageLine: 5,\n399\t\t\trawLogPath:       rawLog.Name(),\n400\t\t}\n401\t\tmock := &mockAgentExecutorWithSession{session: sess}\n402\t\n403\t\tconfig := &ExecutionConfig{\n404\t\t\tTimeoutSeconds: 30,\n405\t\t\tWorkspaceDir:   tmpDir,\n406\t\t}\n407\t\trunner := NewTaskRunner(config, mock)\n408\t\n409\t\ttask := &parser.Task{\n410\t\t\tID:   \"task1\",\n411\t\t\tName: \"Test Task\",\n412\t\t\tGoal: \"Test goal\",\n413\t\t}\n414\t\n415\t\tresult, err := runner.RunTask(task, \"\", \"\")\n416\t\tif err != nil {\n417\t\t\tt.Fatalf(\"RunTask returned unexpected error: %v\", err)\n418\t\t}\n419\t\t_ = result\n420\t\n421\t\tactPathFile := filepath.Join(tmpDir, \"tasks\", \"task1\", \"act-path.md\")\n422\t\tif _, err := os.Stat(actPathFile); err != nil {\n423\t\t\tt.Fatalf(\"act-path.md not created at %s: %v\", actPathFile, err)\n424\t\t}\n425\t\n426\t\tcontent, err := os.ReadFile(actPathFile)\n427\t\tif err != nil {\n428\t\t\tt.Fatalf(\"failed to read act-path.md: %v\", err)\n429\t\t}\n430\t\ts := string(content)\n431\t\tfor _, want := range []string{\"## 执行摘要\", \"## 行为轨迹\", \"报错次数: 0\"} {\n432\t\t\tif !strings.Contains(s, want) {\n433\t\t\t\tt.Errorf(\"act-path.md missing %q\", want)\n434\t\t\t}\n435\t\t}\n436\t}\n437\t\n438\t"}]},"parent_tool_use_id":null,"session_id":"9c7b55b1-09d3-48f4-9913-da4bfa9fb3a8","uuid":"4a20d936-0522-45ab-a94c-d94344d78715","timestamp":"2026-06-11T08:06:57.664Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/executor/runner_test.go","content":"package executor\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/sunquan/rick/internal/agent\"\n\t\"github.com/sunquan/rick/internal/parser\"\n)\n\n// mockAgentSession is a test double for agent.AgentSession.\ntype mockAgentSession struct {\n\tid               string\n\ttoolCalls        []agent.ToolCall\n\tfinalMessage     string\n\tfinalMessageLine int\n\trawLogPath       string\n}\n\nfunc (m *mockAgentSession) ID() string                  { return m.id }\nfunc (m *mockAgentSession) Duration() time.Duration     { return 0 }\nfunc (m *mockAgentSession) ToolCalls() []agent.ToolCall { return m.toolCalls }\nfunc (m *mockAgentSession) FinalMessage() string        { return m.finalMessage }\nfunc (m *mockAgentSession) FinalMessageLine() int       { return m.finalMessageLine }\nfunc (m *mockAgentSession) RawLogPath() string          { return m.rawLogPath }\n\n// mockAgentExecutorWithSession extends mockAgentExecutor to return a specific session.\ntype mockAgentExecutorWithSession struct {\n\tsession agent.AgentSession\n\terr     error\n}\n\nfunc (m *mockAgentExecutorWithSession) Execute(promptFile, taskID, workspaceDir, logFileName string) (agent.AgentSession, error) {\n\treturn m.session, m.err\n}\n\n// TestNewTaskRunner tests TaskRunner creation\nfunc TestNewTaskRunner(t *testing.T) {\n\tconfig := &ExecutionConfig{\n\t\tMaxRetries:     5,\n\t\tTimeoutSeconds: 30,\n\t\tLogFile:        \"/tmp/test.log\",\n\t}\n\n\trunner := NewTaskRunner(config, &mockAgentExecutor{})\n\tif runner == nil {\n\t\tt.Fatal(\"NewTaskRunner returned nil\")\n\t}\n\tif runner.config != config {\n\t\tt.Fatal(\"config not set correctly\")\n\t}\n}\n\n// TestExecuteTestScript tests script execution with a Python script returning JSON\nfunc TestExecuteTestScript(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\ttmpDir := os.TempDir()\n\tscriptPath := filepath.Join(tmpDir, \"test_script_pass.py\")\n\tscriptContent := `import json\nprint(json.dumps({\"pass\": True, \"errors\": []}))\n`\n\terr := os.WriteFile(scriptPath, []byte(scriptContent), 0644)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to create test script: %v\", err)\n\t}\n\tdefer os.Remove(scriptPath)\n\n\tresult, output, err := runner.ExecuteTestScript(scriptPath)\n\tif err != nil {\n\t\tt.Fatalf(\"ExecuteTestScript failed: %v\", err)\n\t}\n\n\tif result == nil {\n\t\tt.Fatal(\"Expected non-nil result\")\n\t}\n\n\tif !result.Pass {\n\t\tt.Errorf(\"Expected pass=true, got false. Output: %s\", output)\n\t}\n}\n\n// TestExecuteTestScript_EmptyPath tests with empty script path\nfunc TestExecuteTestScript_EmptyPath(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\t_, _, err := runner.ExecuteTestScript(\"\")\n\tif err == nil {\n\t\tt.Fatal(\"Expected error for empty script path\")\n\t}\n}\n\n// TestExecuteTestScript_NonexistentFile tests with nonexistent file\nfunc TestExecuteTestScript_NonexistentFile(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\t_, _, err := runner.ExecuteTestScript(\"/nonexistent/path/script.py\")\n\tif err == nil {\n\t\tt.Fatal(\"Expected error for nonexistent file\")\n\t}\n}\n\n// TestExecuteTestScript_WithTimeout tests timeout handling\nfunc TestExecuteTestScript_WithTimeout(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 1}, &mockAgentExecutor{})\n\n\ttmpDir := os.TempDir()\n\tscriptPath := filepath.Join(tmpDir, \"timeout_script.py\")\n\tscriptContent := `import time\ntime.sleep(5)\nprint(\"This should not execute\")\n`\n\terr := os.WriteFile(scriptPath, []byte(scriptContent), 0644)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to create test script: %v\", err)\n\t}\n\tdefer os.Remove(scriptPath)\n\n\t_, _, err = runner.ExecuteTestScript(scriptPath)\n\tif err == nil {\n\t\tt.Fatal(\"Expected timeout error\")\n\t}\n\tif !strings.Contains(err.Error(), \"timeout\") {\n\t\tt.Errorf(\"Expected timeout error, got: %v\", err)\n\t}\n}\n\n// TestExecuteTestScript_FailResult tests script that returns fail JSON\nfunc TestExecuteTestScript_FailResult(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\ttmpDir := os.TempDir()\n\tscriptPath := filepath.Join(tmpDir, \"fail_script.py\")\n\tscriptContent := `import json\nprint(json.dumps({\"pass\": False, \"errors\": [\"assertion failed\"]}))\n`\n\terr := os.WriteFile(scriptPath, []byte(scriptContent), 0644)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to create test script: %v\", err)\n\t}\n\tdefer os.Remove(scriptPath)\n\n\tresult, _, err := runner.ExecuteTestScript(scriptPath)\n\tif err != nil {\n\t\tt.Fatalf(\"ExecuteTestScript failed: %v\", err)\n\t}\n\n\tif result == nil {\n\t\tt.Fatal(\"Expected non-nil result\")\n\t}\n\n\tif result.Pass {\n\t\tt.Error(\"Expected pass=false\")\n\t}\n\n\tif len(result.Errors) == 0 {\n\t\tt.Error(\"Expected errors in result\")\n\t}\n}\n\n// TestRunTask_NilTask tests with nil task\nfunc TestRunTask_NilTask(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\t_, err := runner.RunTask(nil, \"\", \"\")\n\tif err == nil {\n\t\tt.Fatal(\"Expected error for nil task\")\n\t}\n}\n\n// TestTaskExecutionResult_Duration tests duration calculation\nfunc TestTaskExecutionResult_Duration(t *testing.T) {\n\tresult := &TaskExecutionResult{\n\t\tTaskID:    \"task1\",\n\t\tStartTime: time.Now(),\n\t}\n\n\ttime.Sleep(10 * time.Millisecond)\n\tresult.EndTime = time.Now()\n\n\tduration := result.Duration()\n\tif duration < 10*time.Millisecond {\n\t\tt.Errorf(\"Duration too short: %v\", duration)\n\t}\n}\n\n// TestTaskExecutionResult_Fields tests all fields are set correctly\nfunc TestTaskExecutionResult_Fields(t *testing.T) {\n\tstartTime := time.Now()\n\tendTime := startTime.Add(5 * time.Second)\n\n\tresult := &TaskExecutionResult{\n\t\tTaskID:    \"test_task\",\n\t\tTaskName:  \"Test Task\",\n\t\tStatus:    \"success\",\n\t\tError:     \"\",\n\t\tOutput:    \"Test output\",\n\t\tStartTime: startTime,\n\t\tEndTime:   endTime,\n\t}\n\n\tif result.TaskID != \"test_task\" {\n\t\tt.Error(\"TaskID not set correctly\")\n\t}\n\tif result.TaskName != \"Test Task\" {\n\t\tt.Error(\"TaskName not set correctly\")\n\t}\n\tif result.Status != \"success\" {\n\t\tt.Error(\"Status not set correctly\")\n\t}\n\tif result.Output != \"Test output\" {\n\t\tt.Error(\"Output not set correctly\")\n\t}\n\n\tduration := result.Duration()\n\tif duration != 5*time.Second {\n\t\tt.Errorf(\"Duration calculation incorrect: expected 5s, got %v\", duration)\n\t}\n}\n\n// TestGenerateDoingPromptFile_NilTask tests with nil task\nfunc TestGenerateDoingPromptFile_NilTask(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\t_, _, err := runner.GenerateDoingPromptFile(nil, \"\", \"\")\n\tif err == nil {\n\t\tt.Fatal(\"Expected error for nil task\")\n\t}\n}\n\n// TestGenerateDoingPromptFile_ValidTask tests prompt file generation\nfunc TestGenerateDoingPromptFile_ValidTask(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\ttask := &parser.Task{\n\t\tID:         \"task1\",\n\t\tName:       \"Test Task\",\n\t\tGoal:       \"Test goal\",\n\t\tTestMethod: \"- Step 1\\n- Step 2\",\n\t}\n\n\tpromptFile, _, err := runner.GenerateDoingPromptFile(task, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"GenerateDoingPromptFile failed: %v\", err)\n\t}\n\tdefer os.Remove(promptFile)\n\n\tif _, err := os.Stat(promptFile); err != nil {\n\t\tt.Fatalf(\"Prompt file not created: %v\", err)\n\t}\n\n\tcontent, err := os.ReadFile(promptFile)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to read prompt file: %v\", err)\n\t}\n\n\tif len(content) == 0 {\n\t\tt.Error(\"Prompt file is empty\")\n\t}\n}\n\n// TestGenerateDoingPromptFile_WithDebugContext tests that debug.md content is embedded in prompt\nfunc TestGenerateDoingPromptFile_WithDebugContext(t *testing.T) {\n\ttmpDir := t.TempDir()\n\t// Simulate .rick/jobs/job_1/doing structure\n\tworkspaceDir := filepath.Join(tmpDir, \".rick\", \"jobs\", \"job_1\", \"doing\")\n\tif err := os.MkdirAll(workspaceDir, 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdebugContent := \"## debug1: Previous error\\nSome debug info\"\n\tif err := os.WriteFile(filepath.Join(workspaceDir, \"debug.md\"), []byte(debugContent), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30, WorkspaceDir: workspaceDir}, &mockAgentExecutor{})\n\ttask := &parser.Task{ID: \"task1\", Name: \"Test Task\", Goal: \"Test goal\"}\n\n\tpromptFile, _, err := runner.GenerateDoingPromptFile(task, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"GenerateDoingPromptFile failed: %v\", err)\n\t}\n\tdefer os.Remove(promptFile)\n\n\tcontent, err := os.ReadFile(promptFile)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to read prompt file: %v\", err)\n\t}\n\n\tif !strings.Contains(string(content), \"Previous error\") {\n\t\tt.Error(\"Prompt file should contain debug.md content\")\n\t}\n}\n\n// TestGenerateDoingPromptFile_WithTestErrorFeedback tests prompt with test error feedback\nfunc TestGenerateDoingPromptFile_WithTestErrorFeedback(t *testing.T) {\n\trunner := NewTaskRunner(&ExecutionConfig{TimeoutSeconds: 30}, &mockAgentExecutor{})\n\n\ttask := &parser.Task{\n\t\tID:   \"task1\",\n\t\tName: \"Test Task\",\n\t\tGoal: \"Test goal\",\n\t}\n\n\ttestFeedback := \"Attempt 1: test did not pass: assertion error\"\n\tpromptFile, _, err := runner.GenerateDoingPromptFile(task, \"\", testFeedback)\n\tif err != nil {\n\t\tt.Fatalf(\"GenerateDoingPromptFile failed: %v\", err)\n\t}\n\tdefer os.Remove(promptFile)\n\n\tcontent, err := os.ReadFile(promptFile)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to read prompt file: %v\", err)\n\t}\n\n\tif !strings.Contains(string(content), testFeedback) {\n\t\tt.Error(\"Prompt file should contain test error feedback\")\n\t}\n}\n\n// TestBuildTestGenerationPromptFile tests the test prompt file generation\nfunc TestBuildTestGenerationPromptFile(t *testing.T) {\n\tconfig := &ExecutionConfig{TimeoutSeconds: 30}\n\trunner := NewTaskRunner(config, &mockAgentExecutor{})\n\n\ttask := &parser.Task{\n\t\tID:         \"task1\",\n\t\tName:       \"Test Task\",\n\t\tGoal:       \"Test goal\",\n\t\tTestMethod: \"Run the test\",\n\t}\n\n\tpromptFile, _, err := runner.buildTestGenerationPromptFile(task, \"/tmp/test_task1.py\", TestGenContext{})\n\tif err != nil {\n\t\tt.Fatalf(\"buildTestGenerationPromptFile failed: %v\", err)\n\t}\n\tdefer os.Remove(promptFile)\n\n\tif _, err := os.Stat(promptFile); err != nil {\n\t\tt.Fatalf(\"prompt file not created: %v\", err)\n\t}\n\n\tcontent, err := os.ReadFile(promptFile)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !strings.Contains(string(content), \"task1\") {\n\t\tt.Error(\"prompt file should contain task ID\")\n\t}\n}\n\nfunc TestBuildTestGenerationPromptFile_NilTask(t *testing.T) {\n\tconfig := &ExecutionConfig{TimeoutSeconds: 30}\n\trunner := NewTaskRunner(config, &mockAgentExecutor{})\n\n\t// nil task should be handled gracefully by the caller (RunTask checks for nil)\n\t// buildTestGenerationPromptFile itself may panic or error on nil task\n\t// We just verify it doesn't silently succeed with bad data\n\ttask := &parser.Task{ID: \"t1\", Name: \"T\", Goal: \"G\", TestMethod: \"test\"}\n\tpromptFile, _, err := runner.buildTestGenerationPromptFile(task, \"/tmp/test.py\", TestGenContext{})\n\tif err != nil {\n\t\tt.Logf(\"buildTestGenerationPromptFile returned error (acceptable): %v\", err)\n\t\treturn\n\t}\n\tdefer os.Remove(promptFile)\n}\n\n// TestRunTask_ActPathGeneration validates KR1: act-path.md is generated after Execute.\nfunc TestRunTask_ActPathGeneration(t *testing.T) {\n\ttmpDir := t.TempDir()\n\n\t// Pre-create test script so GenerateTestWithAgent skips claude invocation.\n\ttestsDir := filepath.Join(tmpDir, \"tests\")\n\tif err := os.MkdirAll(testsDir, 0755); err != nil {\n\t\tt.Fatalf(\"failed to create tests dir: %v\", err)\n\t}\n\tscriptContent := \"import json\\nprint(json.dumps({\\\"pass\\\": True, \\\"errors\\\": []}))\\n\"\n\tif err := os.WriteFile(filepath.Join(testsDir, \"task1.py\"), []byte(scriptContent), 0644); err != nil {\n\t\tt.Fatalf(\"failed to write test script: %v\", err)\n\t}\n\n\t// Create a temp raw log file as the session's RawLogPath.\n\trawLog, err := os.CreateTemp(tmpDir, \"raw_session_*.log\")\n\tif err != nil {\n\t\tt.Fatalf(\"failed to create raw log: %v\", err)\n\t}\n\trawLog.Close()\n\n\tsess := &mockAgentSession{\n\t\tid:   \"sess-1\",\n\t\ttoolCalls: []agent.ToolCall{\n\t\t\t{Name: \"bash\", Input: \"echo hi\", IsError: false, Line: 1},\n\t\t},\n\t\tfinalMessage:     \"done\",\n\t\tfinalMessageLine: 5,\n\t\trawLogPath:       rawLog.Name(),\n\t}\n\tmock := &mockAgentExecutorWithSession{session: sess}\n\n\tconfig := &ExecutionConfig{\n\t\tTimeoutSeconds: 30,\n\t\tWorkspaceDir:   tmpDir,\n\t}\n\trunner := NewTaskRunner(config, mock)\n\n\ttask := &parser.Task{\n\t\tID:   \"task1\",\n\t\tName: \"Test Task\",\n\t\tGoal: \"Test goal\",\n\t}\n\n\tresult, err := runner.RunTask(task, \"\", \"\")\n\tif err != nil {\n\t\tt.Fatalf(\"RunTask returned unexpected error: %v\", err)\n\t}\n\t_ = result\n\n\tactPathFile := filepath.Join(tmpDir, \"tasks\", \"task1\", \"act-path.md\")\n\tif _, err := os.Stat(actPathFile); err != nil {\n\t\tt.Fatalf(\"act-path.md not created at %s: %v\", actPathFile, err)\n\t}\n\n\tcontent, err := os.ReadFile(actPathFile)\n\tif err != nil {\n\t\tt.Fatalf(\"failed to read act-path.md: %v\", err)\n\t}\n\ts := string(content)\n\tfor _, want := range []string{\"## 执行摘要\", \"## 行为轨迹\", \"报错次数: 0\"} {\n\t\tif !strings.Contains(s, want) {\n\t\t\tt.Errorf(\"act-path.md missing %q\", want)\n\t\t}\n\t}\n}\n\n","numLines":438,"startLine":1,"totalLines":438}}}
