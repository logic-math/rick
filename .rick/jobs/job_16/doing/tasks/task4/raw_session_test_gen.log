{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YRgtwHqkkjfjcTVbWmzJGA","type":"tool_result","content":"1\tpackage executor\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/sunquan/rick/internal/actpath\"\n14\t\t\"github.com/sunquan/rick/internal/agent\"\n15\t\t\"github.com/sunquan/rick/internal/parser\"\n16\t\t\"github.com/sunquan/rick/internal/prompt\"\n17\t)\n18\t\n19\t// ExecutionConfig holds the configuration for task execution\n20\ttype ExecutionConfig struct {\n21\t\tMaxRetries      int\n22\t\tTimeoutSeconds  int\n23\t\tLogFile         string\n24\t\tClaudeCodePath  string\n25\t\tWorkspaceDir    string\n26\t}\n27\t\n28\t// TaskRunner manages the execution of individual tasks\n29\ttype TaskRunner struct {\n30\t\tconfig        *ExecutionConfig\n31\t\tagentExecutor agent.AgentExecutor\n32\t}\n33\t\n34\t// NewTaskRunner creates a new TaskRunner instance\n35\tfunc NewTaskRunner(config *ExecutionConfig, agentExecutor agent.AgentExecutor) *TaskRunner {\n36\t\treturn &TaskRunner{\n37\t\t\tconfig:        config,\n38\t\t\tagentExecutor: agentExecutor,\n39\t\t}\n40\t}\n41\t\n42\t// TestResult represents the JSON result from a test script\n43\ttype TestResult struct {\n44\t\tPass   bool     `json:\"pass\"`\n45\t\tErrors []string `json:\"errors\"`\n46\t}\n47\t\n48\t// TestGenContext provides optional additional context for test generation prompts.\n49\ttype TestGenContext struct {\n50\t\tOKRContent   string\n51\t\tSPECContent  string\n52\t\tDebugContent string\n53\t}\n54\t\n55\t// RunTask executes a single task following the new workflow:\n56\t// 1. Generate test script using Agent (test generation phase)\n57\t// 2. Execute task -> run test\n58\t// Parameters:\n59\t//   - task: The task to execute\n60\t//   - debugContext: Content from debug.md (managed by Claude)\n61\t//   - testErrorFeedback: Previous test execution errors (for test script correction)\n62\tfunc (tr *TaskRunner) RunTask(task *parser.Task, debugContext string, testErrorFeedback string) (*TaskExecutionResult, error) {\n63\t\tif task == nil {\n64\t\t\treturn nil, fmt.Errorf(\"task cannot be nil\")\n65\t\t}\n66\t\n67\t\tresult := &TaskExecutionResult{\n68\t\t\tTaskID:    task.ID,\n69\t\t\tTaskName:  task.Name,\n70\t\t\tStatus:    \"running\",\n71\t\t\tStartTime: time.Now(),\n72\t\t}\n73\t\n74\t\t// Step 1: Generate test script using Agent (test generation phase)\n75\t\ttestScriptPath, err := tr.GenerateTestWithAgent(task)\n76\t\tif err != nil {\n77\t\t\tresult.Status = \"failed\"\n78\t\t\tresult.Error = fmt.Sprintf(\"failed to generate test script: %v\", err)\n79\t\t\tresult.EndTime = time.Now()\n80\t\t\treturn result, nil\n81\t\t}\n82\t\n83\t\t// Step 2: Execute task with context (debug.md + test error feedback)\n84\t\tvar lastOutput string\n85\t\n86\t\t// Execute once and test\n87\t\tdoingPromptFile, _, err := tr.GenerateDoingPromptFile(task, debugContext, testErrorFeedback)\n88\t\tif err != nil {\n89\t\t\tresult.Status = \"failed\"\n90\t\t\tresult.Error = fmt.Sprintf(\"failed to generate doing prompt: %v\", err)\n91\t\t\tresult.EndTime = time.Now()\n92\t\t\treturn result, nil\n93\t\t}\n94\t\n95\t\tsession, err := tr.agentExecutor.Execute(doingPromptFile, task.ID, tr.config.WorkspaceDir, \"raw_session_coding.log\")\n96\t\tif err != nil {\n97\t\t\tresult.Status = \"failed\"\n98\t\t\tresult.Error = fmt.Sprintf(\"agent execution failed: %v\", err)\n99\t\t\tresult.EndTime = time.Now()\n100\t\t\treturn result, nil\n101\t\t}\n102\t\n103\t\tif session != nil {\n104\t\t\tactPathFile := filepath.Join(tr.config.WorkspaceDir, \"tasks\", task.ID, \"act-path.md\")\n105\t\t\tif genErr := actpath.Generate(session, actPathFile); genErr != nil {\n106\t\t\t\tfmt.Printf(\"[WARN] failed to generate act-path: %v\\n\", genErr)\n107\t\t\t}\n108\t\t\tlastOutput = session.FinalMessage()\n109\t\t}\n110\t\n111\t\t// Run test to validate\n112\t\ttestResult, testOutput, err := tr.ExecuteTestScript(testScriptPath)\n113\t\tif err != nil {\n114\t\t\tresult.Status = \"failed\"\n115\t\t\tresult.Error = fmt.Sprintf(\"test execution failed: %v\\n\\nFull test output:\\n%s\", err, testOutput)\n116\t\t\tresult.Output = fmt.Sprintf(\"Claude output:\\n%s\\n\\nTest output:\\n%s\", lastOutput, testOutput)\n117\t\t\tresult.EndTime = time.Now()\n118\t\t\treturn result, nil\n119\t\t}\n120\t\n121\t\t// Check if test passed\n122\t\tif testResult.Pass {\n123\t\t\tresult.Status = \"success\"\n124\t\t\tresult.Output = fmt.Sprintf(\"Claude output:\\n%s\\n\\nTest output:\\n%s\", lastOutput, testOutput)\n125\t\t} else {\n126\t\t\tresult.Status = \"failed\"\n127\t\t\tresult.Error = fmt.Sprintf(\"test did not pass: %s\\n\\nFull test output:\\n%s\", strings.Join(testResult.Errors, \"; \"), testOutput)\n128\t\t\tresult.Output = fmt.Sprintf(\"Claude output:\\n%s\\n\\nTest output:\\n%s\", lastOutput, testOutput)\n129\t\t}\n130\t\n131\t\tresult.EndTime = time.Now()\n132\t\treturn result, nil\n133\t}\n134\t\n135\t// GenerateTestWithAgent generates a Python test script using Claude Agent.\n136\tfunc (tr *TaskRunner) GenerateTestWithAgent(task *parser.Task) (string, error) {\n137\t\tif task == nil {\n138\t\t\treturn \"\", fmt.Errorf(\"task cannot be nil\")\n139\t\t}\n140\t\n141\t\ttestsDir := filepath.Join(tr.config.WorkspaceDir, \"tests\")\n142\t\tif err := os.MkdirAll(testsDir, 0755); err != nil {\n143\t\t\treturn \"\", fmt.Errorf(\"failed to create tests directory: %w\", err)\n144\t\t}\n145\t\n146\t\ttestScriptPath := filepath.Join(testsDir, fmt.Sprintf(\"%s.py\", task.ID))\n147\t\n148\t\tif _, err := os.Stat(testScriptPath); err == nil {\n149\t\t\treturn testScriptPath, nil\n150\t\t}\n151\t\n152\t\t// Load OKR / SPEC / debug content from workspace files\n153\t\tjobDir := filepath.Dir(tr.config.WorkspaceDir)\n154\t\trickDir := filepath.Dir(filepath.Dir(jobDir))\n155\t\tgenCtx := TestGenContext{\n156\t\t\tOKRContent:   loadFileContent(filepath.Join(jobDir, \"plan\", \"OKR.md\")),\n157\t\t\tSPECContent:  loadFileContent(filepath.Join(rickDir, \"SPEC.md\")),\n158\t\t\tDebugContent: loadFileContent(filepath.Join(tr.config.WorkspaceDir, \"debug.md\")),\n159\t\t}\n160\t\n161\t\ttestPromptFile, _, err := tr.buildTestGenerationPromptFile(task, testScriptPath, genCtx)\n162\t\tif err != nil {\n163\t\t\treturn \"\", fmt.Errorf(\"failed to build test prompt: %w\", err)\n164\t\t}\n165\t\n166\t\tif _, err := tr.agentExecutor.Execute(testPromptFile, task.ID, tr.config.WorkspaceDir, \"raw_session_test_gen.log\"); err != nil {\n167\t\t\treturn \"\", fmt.Errorf(\"test generation agent failed: %w\", err)\n168\t\t}\n169\t\n170\t\tif _, err := os.Stat(testScriptPath); os.IsNotExist(err) {\n171\t\t\treturn \"\", fmt.Errorf(\"test script was not created at %s\", testScriptPath)\n172\t\t}\n173\t\n174\t\treturn testScriptPath, nil\n175\t}\n176\t\n177\t// buildTestGenerationPromptFile builds a prompt file for test generation.\n178\t// Saves to doing/prompts/; files are persistent, no cleanup needed.\n179\tfunc (tr *TaskRunner) buildTestGenerationPromptFile(task *parser.Task, testScriptPath string, genCtx TestGenContext) (string, []string, error) {\n180\t\tpromptsDir, err := prompt.EnsurePromptsDir(tr.config.WorkspaceDir)\n181\t\tif err != nil {\n182\t\t\treturn \"\", nil, fmt.Errorf(\"failed to create prompts dir: %w\", err)\n183\t\t}\n184\t\n185\t\ttddZhFile, err := prompt.WriteSkillFile(promptsDir, \"skill_tdd_zh.md\", \"tdd-zh\")\n186\t\tif err != nil {\n187\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write tdd-zh skill: %w\", err)\n188\t\t}\n189\t\ttestingAntiPatternsFile, err := prompt.WriteSkillFile(promptsDir, \"skill_testing_anti_patterns_zh.md\", \"testing-anti-patterns-zh\")\n190\t\tif err != nil {\n191\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write testing-anti-patterns-zh skill: %w\", err)\n192\t\t}\n193\t\n194\t\tpromptMgr := prompt.NewPromptManager(\"\")\n195\t\ttmpl, err := promptMgr.LoadTemplate(\"test_python\")\n196\t\tif err != nil {\n197\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load test_python template: %w\", err)\n198\t\t}\n199\t\n200\t\tbuilder := prompt.NewPromptBuilder(tmpl)\n201\t\tbuilder.SetVariable(\"task_id\", task.ID)\n202\t\tbuilder.SetVariable(\"task_name\", task.Name)\n203\t\tbuilder.SetVariable(\"task_goal\", task.Goal)\n204\t\tbuilder.SetVariable(\"test_method\", task.TestMethod)\n205\t\tbuilder.SetVariable(\"test_script_path\", testScriptPath)\n206\t\tbuilder.SetVariable(\"okr_content\", genCtx.OKRContent)\n207\t\tbuilder.SetVariable(\"spec_content\", genCtx.SPECContent)\n208\t\tbuilder.SetVariable(\"debug_content\", genCtx.DebugContent)\n209\t\tbuilder.SetVariable(\"tdd_skill_path\", tddZhFile)\n210\t\tbuilder.SetVariable(\"testing_anti_patterns_path\", testingAntiPatternsFile)\n211\t\n212\t\tpromptFile := filepath.Join(promptsDir, fmt.Sprintf(\"%s_testgen_prompt.md\", task.ID))\n213\t\tif err := builder.SaveToFile(promptFile); err != nil {\n214\t\t\treturn \"\", nil, fmt.Errorf(\"failed to save test generation prompt: %w\", err)\n215\t\t}\n216\t\n217\t\treturn promptFile, []string{tddZhFile, testingAntiPatternsFile}, nil\n218\t}\n219\t\n220\t// GenerateDoingPromptFile generates the doing prompt file for Claude Code CLI.\n221\t// Returns the prompt file path, skill tmp files (caller must remove all), and any error.\n222\tfunc (tr *TaskRunner) GenerateDoingPromptFile(task *parser.Task, debugContext string, testErrorFeedback string) (string, []string, error) {\n223\t\tif task == nil {\n224\t\t\treturn \"\", nil, fmt.Errorf(\"task cannot be nil\")\n225\t\t}\n226\t\n227\t\t// Extract jobID from WorkspaceDir (.rick/jobs/job_X/doing → job_X)\n228\t\tjobID := extractJobIDFromPath(tr.config.WorkspaceDir)\n229\t\n230\t\t// Create context manager with actual job ID\n231\t\tcontextMgr := prompt.NewContextManager(jobID)\n232\t\n233\t\t// Compute rickDir and jobDir from workspaceDir (.rick/jobs/job_X/doing → .rick)\n234\t\trickDir := \"\"\n235\t\tif tr.config.WorkspaceDir != \"\" {\n236\t\t\tjobDir := filepath.Dir(tr.config.WorkspaceDir) // .rick/jobs/job_X\n237\t\t\trickDir = filepath.Dir(filepath.Dir(jobDir))   // .rick\n238\t\n239\t\t\t// OKR: from job_N/plan/OKR.md\n240\t\t\tjobOKRPath := filepath.Join(jobDir, \"plan\", \"OKR.md\")\n241\t\t\tif _, err := os.Stat(jobOKRPath); err == nil {\n242\t\t\t\tcontextMgr.LoadOKRFromFile(jobOKRPath)\n243\t\t\t}\n244\t\n245\t\t\t// SPEC: from .rick/SPEC.md\n246\t\t\tspecPath := filepath.Join(rickDir, \"SPEC.md\")\n247\t\t\tif _, err := os.Stat(specPath); err == nil {\n248\t\t\t\tcontextMgr.LoadSPECFromFile(specPath)\n249\t\t\t}\n250\t\n251\t\t\t// Debug: from doing/debug.md (always load; errors silently ignored)\n252\t\t\tdebugMdPath := filepath.Join(tr.config.WorkspaceDir, \"debug.md\")\n253\t\t\tcontextMgr.LoadDebugFromFile(debugMdPath) // nolint: ignore error when file absent\n254\t\t}\n255\t\n256\t\t// Create prompt manager (use embedded templates)\n257\t\tpromptMgr := prompt.NewPromptManager(\"\")\n258\t\n259\t\t// Generate doing prompt file (pass doingDir for prompts/, rickDir for skills injection)\n260\t\tdoingPromptFile, skillFiles, err := prompt.GenerateDoingPromptFile(task, 0, contextMgr, promptMgr, tr.config.WorkspaceDir, rickDir)\n261\t\tif err != nil {\n262\t\t\treturn \"\", nil, fmt.Errorf(\"failed to generate doing prompt: %w\", err)\n263\t\t}\n264\t\n265\t\t// Append test error feedback if available (not part of normal context; retry-specific)\n266\t\tif testErrorFeedback != \"\" {\n267\t\t\tcontent, err := os.ReadFile(doingPromptFile)\n268\t\t\tif err != nil {\n269\t\t\t\treturn \"\", nil, fmt.Errorf(\"failed to read prompt file: %w\", err)\n270\t\t\t}\n271\t\t\tvar fb strings.Builder\n272\t\t\tfb.WriteString(\"\\n\\n## Test Execution Feedback\\n\\n\")\n273\t\t\tfb.WriteString(\"**Previous test execution encountered errors. You may need to fix the test script.**\\n\\n\")\n274\t\t\tfb.WriteString(\"```\\n\")\n275\t\t\tfb.WriteString(testErrorFeedback)\n276\t\t\tfb.WriteString(\"\\n```\\n\")\n277\t\t\tif err := os.WriteFile(doingPromptFile, append(content, []byte(fb.String())...), 0644); err != nil {\n278\t\t\t\treturn \"\", nil, fmt.Errorf(\"failed to append test feedback: %w\", err)\n279\t\t\t}\n280\t\t}\n281\t\n282\t\treturn doingPromptFile, skillFiles, nil\n283\t}\n284\t\n285\t// loadFileContent reads a file and returns its content, or \"暂无\" if the file is absent.\n286\tfunc loadFileContent(path string) string {\n287\t\tcontent, err := os.ReadFile(path)\n288\t\tif err != nil {\n289\t\t\treturn \"暂无\"\n290\t\t}\n291\t\treturn string(content)\n292\t}\n293\t\n294\t// extractJobIDFromPath extracts the job ID (e.g. \"job_1\") from a workspace directory path.\n295\t// Expected format: .rick/jobs/job_N/doing\n296\tfunc extractJobIDFromPath(dirPath string) string {\n297\t\tparts := strings.Split(filepath.ToSlash(dirPath), \"/\")\n298\t\tfor i := len(parts) - 1; i >= 0; i-- {\n299\t\t\tif strings.HasPrefix(parts[i], \"job_\") {\n300\t\t\t\treturn parts[i]\n301\t\t\t}\n302\t\t}\n303\t\treturn \"job_N\"\n304\t}\n305\t\n306\t// CallClaudeCodeCLI calls Claude Code CLI in non-interactive mode\n307\t// promptFile is the path to the prompt file to be loaded by Claude\n308\tfunc (tr *TaskRunner) CallClaudeCodeCLI(promptFile string) (string, error) {\n309\t\tif promptFile == \"\" {\n310\t\t\treturn \"\", fmt.Errorf(\"prompt file cannot be empty\")\n311\t\t}\n312\t\n313\t\t// Get Claude CLI path\n314\t\tclaudePath := tr.config.ClaudeCodePath\n315\t\tif claudePath == \"\" {\n316\t\t\tclaudePath = \"claude\"\n317\t\t}\n318\t\n319\t\t// Create command: claude --dangerously-skip-permissions <promptFile>\n320\t\tcmd := exec.Command(claudePath, \"--dangerously-skip-permissions\", promptFile)\n321\t\n322\t\t// Capture output\n323\t\tvar stdout, stderr bytes.Buffer\n324\t\tcmd.Stdout = &stdout\n325\t\tcmd.Stderr = &stderr\n326\t\n327\t\t// Wait for completion with timeout\n328\t\tdone := make(chan error, 1)\n329\t\tgo func() {\n330\t\t\tdone <- cmd.Run()\n331\t\t}()\n332\t\n333\t\ttimeout := time.Duration(tr.config.TimeoutSeconds) * time.Second\n334\t\tif tr.config.TimeoutSeconds == 0 {\n335\t\t\ttimeout = 600 * time.Second // Default 10 minutes for Claude\n336\t\t}\n337\t\n338\t\tselect {\n339\t\tcase err := <-done:\n340\t\t\toutput := stdout.String()\n341\t\t\tif stderr.String() != \"\" {\n342\t\t\t\toutput += \"\\n\\nSTDERR:\\n\" + stderr.String()\n343\t\t\t}\n344\t\t\tif err != nil {\n345\t\t\t\treturn output, fmt.Errorf(\"Claude Code CLI execution failed: %w\", err)\n346\t\t\t}\n347\t\t\treturn output, nil\n348\t\tcase <-time.After(timeout):\n349\t\t\tcmd.Process.Kill()\n350\t\t\treturn stdout.String(), fmt.Errorf(\"Claude Code CLI timeout after %d seconds\", tr.config.TimeoutSeconds)\n351\t\t}\n352\t}\n353\t\n354\t// ExecuteTestScript executes a Python test script and parses JSON result\n355\t// Returns TestResult, raw output, and any error\n356\tfunc (tr *TaskRunner) ExecuteTestScript(scriptPath string) (*TestResult, string, error) {\n357\t\tif scriptPath == \"\" {\n358\t\t\treturn nil, \"\", fmt.Errorf(\"script path cannot be empty\")\n359\t\t}\n360\t\n361\t\t// Verify script exists\n362\t\tif _, err := os.Stat(scriptPath); err != nil {\n363\t\t\treturn nil, \"\", fmt.Errorf(\"script file not found: %w\", err)\n364\t\t}\n365\t\n366\t\t// Create command with timeout\n367\t\tcmd := exec.Command(\"python3\", scriptPath)\n368\t\n369\t\t// Capture output\n370\t\tvar stdout, stderr bytes.Buffer\n371\t\tcmd.Stdout = &stdout\n372\t\tcmd.Stderr = &stderr\n373\t\n374\t\t// Set timeout if configured\n375\t\tdone := make(chan error, 1)\n376\t\tgo func() {\n377\t\t\tdone <- cmd.Run()\n378\t\t}()\n379\t\n380\t\t// Wait for completion or timeout\n381\t\ttimeout := time.Duration(tr.config.TimeoutSeconds) * time.Second\n382\t\tif tr.config.TimeoutSeconds == 0 {\n383\t\t\ttimeout = 30 * time.Second // Default timeout\n384\t\t}\n385\t\n386\t\tselect {\n387\t\tcase err := <-done:\n388\t\t\toutput := stdout.String()\n389\t\t\tif stderr.String() != \"\" {\n390\t\t\t\toutput += \"\\nSTDERR:\\n\" + stderr.String()\n391\t\t\t}\n392\t\n393\t\t\t// Parse JSON result from stdout\n394\t\t\ttestResult, parseErr := tr.parseTestResult(stdout.String())\n395\t\t\tif parseErr != nil {\n396\t\t\t\treturn nil, output, fmt.Errorf(\"failed to parse test result: %w\\nOutput: %s\", parseErr, output)\n397\t\t\t}\n398\t\n399\t\t\t// If script exited with error but we got valid JSON, use JSON result\n400\t\t\tif err != nil && testResult == nil {\n401\t\t\t\treturn nil, output, fmt.Errorf(\"script execution failed: %w\", err)\n402\t\t\t}\n403\t\n404\t\t\treturn testResult, output, nil\n405\t\n406\t\tcase <-time.After(timeout):\n407\t\t\tcmd.Process.Kill()\n408\t\t\treturn nil, stdout.String(), fmt.Errorf(\"script execution timeout after %d seconds\", tr.config.TimeoutSeconds)\n409\t\t}\n410\t}\n411\t\n412\t// parseTestResult parses JSON test result from script output\n413\tfunc (tr *TaskRunner) parseTestResult(output string) (*TestResult, error) {\n414\t\tif output == \"\" {\n415\t\t\treturn nil, fmt.Errorf(\"test output is empty\")\n416\t\t}\n417\t\n418\t\t// Try to find JSON in the output\n419\t\tlines := strings.Split(output, \"\\n\")\n420\t\tfor _, line := range lines {\n421\t\t\ttrimmed := strings.TrimSpace(line)\n422\t\t\tif strings.HasPrefix(trimmed, \"{\") {\n423\t\t\t\t// Try to parse as JSON\n424\t\t\t\tvar result TestResult\n425\t\t\t\tif err := json.Unmarshal([]byte(trimmed), &result); err == nil {\n426\t\t\t\t\treturn &result, nil\n427\t\t\t\t}\n428\t\t\t}\n429\t\t}\n430\t\n431\t\treturn nil, fmt.Errorf(\"no valid JSON result found in output\")\n432\t}\n433\t\n434\t\n435\t// TaskExecutionResult represents the result of a task execution\n436\ttype TaskExecutionResult struct {\n437\t\tTaskID    string\n438\t\tTaskName  string\n439\t\tStatus    string    // running, success, failed\n440\t\tError     string\n441\t\tOutput    string\n442\t\tStartTime time.Time\n443\t\tEndTime   time.Time\n444\t}\n445\t\n446\t// Duration returns the execution duration\n447\tfunc (ter *TaskExecutionResult) Duration() time.Duration {\n448\t\treturn ter.EndTime.Sub(ter.StartTime)\n449\t}\n450\t"}]},"parent_tool_use_id":"toolu_bdrk_019i8LjvMbnS9zsSv9ozU5hf","session_id":"1c5aaf03-90f2-4219-9379-2cb2abeac3b7","uuid":"a4d2ab5a-a63a-4ab8-af76-75d3a3a1b780","timestamp":"2026-06-11T07:43:19.618Z"}
