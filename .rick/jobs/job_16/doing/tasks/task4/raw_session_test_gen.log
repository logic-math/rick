{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MXKJKbzpyBgoA1hLMYzYH1","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"strings\"\n6\t\n7\t\t\"github.com/sunquan/rick/internal/parser\"\n8\t)\n9\t\n10\tfunc formatOKRContent(okrInfo *parser.ContextInfo) string {\n11\t\tif okrInfo == nil || (len(okrInfo.Objectives) == 0 && len(okrInfo.KeyResults) == 0) {\n12\t\t\treturn \"暂无项目 OKR 信息\"\n13\t\t}\n14\t\tvar b strings.Builder\n15\t\tif len(okrInfo.Objectives) > 0 {\n16\t\t\tb.WriteString(\"**Objectives**:\\n\")\n17\t\t\tfor _, obj := range okrInfo.Objectives {\n18\t\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", obj))\n19\t\t\t}\n20\t\t\tb.WriteString(\"\\n\")\n21\t\t}\n22\t\tif len(okrInfo.KeyResults) > 0 {\n23\t\t\tb.WriteString(\"**Key Results**:\\n\")\n24\t\t\tfor _, kr := range okrInfo.KeyResults {\n25\t\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", kr))\n26\t\t\t}\n27\t\t}\n28\t\treturn b.String()\n29\t}\n30\t\n31\tfunc formatSPECContent(specInfo *parser.ContextInfo) string {\n32\t\tif specInfo == nil || len(specInfo.Specifications) == 0 {\n33\t\t\treturn \"暂无项目 SPEC 信息\"\n34\t\t}\n35\t\tvar b strings.Builder\n36\t\tb.WriteString(\"**Specifications**:\\n\")\n37\t\tfor _, spec := range specInfo.Specifications {\n38\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", spec))\n39\t\t}\n40\t\treturn b.String()\n41\t}\n42\t\n43\tfunc formatCompletedWork(history []string) string {\n44\t\tif len(history) == 0 {\n45\t\t\treturn \"这是项目的第一阶段规划\"\n46\t\t}\n47\t\tvar b strings.Builder\n48\t\tb.WriteString(\"**已完成的工作:**\\n\")\n49\t\tfor _, item := range history {\n50\t\t\tb.WriteString(fmt.Sprintf(\"- %s\\n\", item))\n51\t\t}\n52\t\treturn b.String()\n53\t}\n54\t"}]},"parent_tool_use_id":"toolu_bdrk_019i8LjvMbnS9zsSv9ozU5hf","session_id":"1c5aaf03-90f2-4219-9379-2cb2abeac3b7","uuid":"87c77d3f-429e-4ee0-bbdf-a17301fef40c","timestamp":"2026-06-11T07:43:32.475Z"}
