{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012QvSYR9JE8N7bVfK3sYVaT","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"strings\"\n7\t\t\"sync\"\n8\t\n9\t\t\"github.com/sunquan/rick/internal/parser\"\n10\t)\n11\t\n12\t// ContextManager manages execution context from various sources (task, debug, OKR, SPEC, history)\n13\ttype ContextManager struct {\n14\t\tjobID       string\n15\t\tTask        *parser.Task\n16\t\tDebug       *parser.DebugInfo\n17\t\tOKRInfo     *parser.ContextInfo\n18\t\tSPECInfo    *parser.ContextInfo\n19\t\tOKRRaw      string // raw file content, used as fallback when parsing yields no data\n20\t\tSPECRaw     string // raw file content, used as fallback when parsing yields no data\n21\t\tHistory     []string\n22\t\tmu          sync.RWMutex\n23\t}\n24\t\n25\t// NewContextManager creates a new ContextManager instance for the given jobID\n26\tfunc NewContextManager(jobID string) *ContextManager {\n27\t\treturn &ContextManager{\n28\t\t\tjobID:    jobID,\n29\t\t\tTask:     nil,\n30\t\t\tDebug:    &parser.DebugInfo{Entries: []parser.DebugEntry{}},\n31\t\t\tOKRInfo:  &parser.ContextInfo{},\n32\t\t\tSPECInfo: &parser.ContextInfo{},\n33\t\t\tHistory:  []string{},\n34\t\t}\n35\t}\n36\t\n37\t// LoadTask loads task information from a Task struct\n38\tfunc (cm *ContextManager) LoadTask(task *parser.Task) error {\n39\t\tif task == nil {\n40\t\t\treturn fmt.Errorf(\"task cannot be nil\")\n41\t\t}\n42\t\n43\t\tcm.mu.Lock()\n44\t\tdefer cm.mu.Unlock()\n45\t\n46\t\tcm.Task = task\n47\t\treturn nil\n48\t}\n49\t\n50\t// LoadDebugFromContent loads debug information from debug.md content\n51\tfunc (cm *ContextManager) LoadDebugFromContent(debugContent string) error {\n52\t\tdebugInfo, err := parser.ParseDebug(debugContent)\n53\t\tif err != nil {\n54\t\t\treturn fmt.Errorf(\"failed to parse debug content: %w\", err)\n55\t\t}\n56\t\n57\t\tcm.mu.Lock()\n58\t\tdefer cm.mu.Unlock()\n59\t\n60\t\tcm.Debug = debugInfo\n61\t\treturn nil\n62\t}\n63\t\n64\t// LoadDebugFromFile loads debug information from a debug.md file\n65\tfunc (cm *ContextManager) LoadDebugFromFile(filePath string) error {\n66\t\tcontent, err := os.ReadFile(filePath)\n67\t\tif err != nil {\n68\t\t\treturn fmt.Errorf(\"failed to read debug file: %w\", err)\n69\t\t}\n70\t\n71\t\treturn cm.LoadDebugFromContent(string(content))\n72\t}\n73\t\n74\t// LoadOKRFromContent loads OKR information from OKR.md content\n75\tfunc (cm *ContextManager) LoadOKRFromContent(okrContent string) error {\n76\t\tokrInfo, err := parser.ParseOKR(okrContent)\n77\t\tif err != nil {\n78\t\t\treturn fmt.Errorf(\"failed to parse OKR content: %w\", err)\n79\t\t}\n80\t\n81\t\tcm.mu.Lock()\n82\t\tdefer cm.mu.Unlock()\n83\t\n84\t\tcm.OKRInfo = okrInfo\n85\t\tcm.OKRRaw = okrContent\n86\t\treturn nil\n87\t}\n88\t\n89\t// LoadOKRFromFile loads OKR information from an OKR.md file\n90\tfunc (cm *ContextManager) LoadOKRFromFile(filePath string) error {\n91\t\tcontent, err := os.ReadFile(filePath)\n92\t\tif err != nil {\n93\t\t\treturn fmt.Errorf(\"failed to read OKR file: %w\", err)\n94\t\t}\n95\t\n96\t\treturn cm.LoadOKRFromContent(string(content))\n97\t}\n98\t\n99\t// LoadSPECFromContent loads SPEC information from SPEC.md content\n100\tfunc (cm *ContextManager) LoadSPECFromContent(specContent string) error {\n101\t\tspecInfo, err := parser.ParseSPEC(specContent)\n102\t\tif err != nil {\n103\t\t\treturn fmt.Errorf(\"failed to parse SPEC content: %w\", err)\n104\t\t}\n105\t\n106\t\tcm.mu.Lock()\n107\t\tdefer cm.mu.Unlock()\n108\t\n109\t\tcm.SPECInfo = specInfo\n110\t\tcm.SPECRaw = specContent\n111\t\treturn nil\n112\t}\n113\t\n114\t// LoadSPECFromFile loads SPEC information from a SPEC.md file\n115\tfunc (cm *ContextManager) LoadSPECFromFile(filePath string) error {\n116\t\tcontent, err := os.ReadFile(filePath)\n117\t\tif err != nil {\n118\t\t\treturn fmt.Errorf(\"failed to read SPEC file: %w\", err)\n119\t\t}\n120\t\n121\t\treturn cm.LoadSPECFromContent(string(content))\n122\t}\n123\t\n124\t// LoadHistory loads execution history from git or other sources\n125\t// For now, it accepts a slice of history strings\n126\tfunc (cm *ContextManager) LoadHistory(historyItems []string) error {\n127\t\tif historyItems == nil {\n128\t\t\thistoryItems = []string{}\n129\t\t}\n130\t\n131\t\tcm.mu.Lock()\n132\t\tdefer cm.mu.Unlock()\n133\t\n134\t\tcm.History = historyItems\n135\t\treturn nil\n136\t}\n137\t\n138\t// LoadHistoryFromFile loads execution history from a file\n139\tfunc (cm *ContextManager) LoadHistoryFromFile(filePath string) error {\n140\t\tcontent, err := os.ReadFile(filePath)\n141\t\tif err != nil {\n142\t\t\treturn fmt.Errorf(\"failed to read history file: %w\", err)\n143\t\t}\n144\t\n145\t\t// Parse history file - one line per history item\n146\t\thistoryItems := []string{}\n147\t\tif len(content) > 0 {\n148\t\t\t// Split by newlines and filter empty lines\n149\t\t\tlines := strings.Split(string(content), \"\\n\")\n150\t\t\tfor _, line := range lines {\n151\t\t\t\ttrimmed := strings.TrimSpace(line)\n152\t\t\t\tif trimmed != \"\" {\n153\t\t\t\t\thistoryItems = append(historyItems, trimmed)\n154\t\t\t\t}\n155\t\t\t}\n156\t\t}\n157\t\n158\t\treturn cm.LoadHistory(historyItems)\n159\t}\n160\t\n161\t// GetTask returns the loaded task information\n162\tfunc (cm *ContextManager) GetTask() *parser.Task {\n163\t\tcm.mu.RLock()\n164\t\tdefer cm.mu.RUnlock()\n165\t\n166\t\treturn cm.Task\n167\t}\n168\t\n169\t// GetDebug returns the loaded debug information\n170\tfunc (cm *ContextManager) GetDebug() *parser.DebugInfo {\n171\t\tcm.mu.RLock()\n172\t\tdefer cm.mu.RUnlock()\n173\t\n174\t\treturn cm.Debug\n175\t}\n176\t\n177\t// GetOKRInfo returns the loaded OKR information\n178\tfunc (cm *ContextManager) GetOKRInfo() *parser.ContextInfo {\n179\t\tcm.mu.RLock()\n180\t\tdefer cm.mu.RUnlock()\n181\t\n182\t\treturn cm.OKRInfo\n183\t}\n184\t\n185\t// GetSPECInfo returns the loaded SPEC information\n186\tfunc (cm *ContextManager) GetSPECInfo() *parser.ContextInfo {\n187\t\tcm.mu.RLock()\n188\t\tdefer cm.mu.RUnlock()\n189\t\n190\t\treturn cm.SPECInfo\n191\t}\n192\t\n193\t// GetOKRRaw returns the raw OKR file content\n194\tfunc (cm *ContextManager) GetOKRRaw() string {\n195\t\tcm.mu.RLock()\n196\t\tdefer cm.mu.RUnlock()\n197\t\n198\t\treturn cm.OKRRaw\n199\t}\n200\t\n201\t// GetSPECRaw returns the raw SPEC file content\n202\tfunc (cm *ContextManager) GetSPECRaw() string {\n203\t\tcm.mu.RLock()\n204\t\tdefer cm.mu.RUnlock()\n205\t\n206\t\treturn cm.SPECRaw\n207\t}\n208\t\n209\t// GetHistory returns the loaded history items\n210\tfunc (cm *ContextManager) GetHistory() []string {\n211\t\tcm.mu.RLock()\n212\t\tdefer cm.mu.RUnlock()\n213\t\n214\t\t// Return a copy to prevent external modification\n215\t\tresult := make([]string, len(cm.History))\n216\t\tcopy(result, cm.History)\n217\t\treturn result\n218\t}\n219\t\n220\t// GetJobID returns the job ID\n221\tfunc (cm *ContextManager) GetJobID() string {\n222\t\tcm.mu.RLock()\n223\t\tdefer cm.mu.RUnlock()\n224\t\n225\t\treturn cm.jobID\n226\t}\n227\t\n228\t// IsTaskLoaded returns true if task information has been loaded\n229\tfunc (cm *ContextManager) IsTaskLoaded() bool {\n230\t\tcm.mu.RLock()\n231\t\tdefer cm.mu.RUnlock()\n232\t\n233\t\treturn cm.Task != nil\n234\t}\n235\t\n236\t// HasDebugEntries returns true if there are debug entries\n237\tfunc (cm *ContextManager) HasDebugEntries() bool {\n238\t\tcm.mu.RLock()\n239\t\tdefer cm.mu.RUnlock()\n240\t\n241\t\treturn len(cm.Debug.Entries) > 0\n242\t}\n243\t\n244\t// HasOKRInfo returns true if OKR information has been loaded\n245\tfunc (cm *ContextManager) HasOKRInfo() bool {\n246\t\tcm.mu.RLock()\n247\t\tdefer cm.mu.RUnlock()\n248\t\n249\t\treturn len(cm.OKRInfo.Objectives) > 0 || len(cm.OKRInfo.KeyResults) > 0\n250\t}\n251\t\n252\t// HasSPECInfo returns true if SPEC information has been loaded\n253\tfunc (cm *ContextManager) HasSPECInfo() bool {\n254\t\tcm.mu.RLock()\n255\t\tdefer cm.mu.RUnlock()\n256\t\n257\t\treturn len(cm.SPECInfo.Specifications) > 0\n258\t}\n259\t\n260\t// HasHistory returns true if history has been loaded\n261\tfunc (cm *ContextManager) HasHistory() bool {\n262\t\tcm.mu.RLock()\n263\t\tdefer cm.mu.RUnlock()\n264\t\n265\t\treturn len(cm.History) > 0\n266\t}\n267\t"}]},"parent_tool_use_id":"toolu_bdrk_019i8LjvMbnS9zsSv9ozU5hf","session_id":"1c5aaf03-90f2-4219-9379-2cb2abeac3b7","uuid":"6afd1a94-cb57-4117-b26d-91fb1ec33bfa","timestamp":"2026-06-11T07:43:28.976Z"}
