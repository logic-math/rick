{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01H3HRyNYHaTfQxYh4aDyUi3","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t)\n8\t\n9\t// GenerateEasyPromptFile generates the easy mode interactive prompt and learning prompt.\n10\t// Both files are persisted to doingDir (not tmp) so they survive session exits.\n11\t// ctxPath is optional; when non-empty the prompt includes ctx-inheritance instructions.\n12\t// Returns mainFile (easy_prompt.md), learningFile (learning_prompt.md), skill tmp files, error.\n13\tfunc GenerateEasyPromptFile(jobID, requirement, rickDir, ctxPath string) (string, string, []string, error) {\n14\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n15\t\n16\t\t// Write skill files to doing/prompts/ (persistent)\n17\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n18\t\tif err != nil {\n19\t\t\treturn \"\", \"\", nil, fmt.Errorf(\"failed to create prompts dir: %w\", err)\n20\t\t}\n21\t\ttddFile, err := WriteSkillFile(promptsDir, \"skill_tdd_zh.md\", \"tdd-zh\")\n22\t\tif err != nil {\n23\t\t\treturn \"\", \"\", nil, err\n24\t\t}\n25\t\tdebuggingFile, err := WriteSkillFile(promptsDir, \"skill_super_debugging_zh.md\", \"super-debugging-zh\")\n26\t\tif err != nil {\n27\t\t\treturn \"\", \"\", nil, err\n28\t\t}\n29\t\tskillFiles := []string{tddFile, debuggingFile}\n30\t\n31\t\t// Load context (embedded in main prompt, read latest at session start)\n32\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"暂无 OKR\")\n33\t\tspecContent := readFileOrDefault(filepath.Join(rickDir, \"SPEC.md\"), \"暂无 SPEC\")\n34\t\tdebugContent := readFileOrDefault(filepath.Join(doingDir, \"debug.md\"), \"暂无（首次会话）\")\n35\t\n36\t\t// Build main easy prompt\n37\t\tmgr := NewPromptManager()\n38\t\ttmpl, err := mgr.LoadTemplate(\"easy\")\n39\t\tif err != nil {\n40\t\t\treturn \"\", \"\", nil, fmt.Errorf(\"failed to load easy template: %w\", err)\n41\t\t}\n42\t\n43\t\tprojectRoot, _ := os.Getwd()\n44\t\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n45\t\tlearningPromptPath := filepath.Join(promptsDir, \"easy_learning_prompt.md\")\n46\t\n47\t\tbuilder := NewPromptBuilder(tmpl)\n48\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n49\t\tbuilder.SetVariable(\"spec_content\", specContent)\n50\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n51\t\tbuilder.SetVariable(\"requirement\", requirement)\n52\t\tbuilder.SetVariable(\"doing_dir\", doingDir)\n53\t\tbuilder.SetVariable(\"tdd_skill_path\", tddFile)\n54\t\tbuilder.SetVariable(\"super_debugging_path\", debuggingFile)\n55\t\tbuilder.SetVariable(\"learning_prompt_path\", learningPromptPath)\n56\t\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n57\t\tbuilder.SetVariable(\"job_id\", jobID)\n58\t\tbuilder.SetVariable(\"ctx_section\", buildCtxSection(ctxPath, rickDir))\n59\t\n60\t\tmainContent, err := builder.Build()\n61\t\tif err != nil {\n62\t\t\treturn \"\", \"\", nil, fmt.Errorf(\"failed to build easy prompt: %w\", err)\n63\t\t}\n64\t\n65\t\t// Persist main prompt to doingDir/prompts/easy_prompt.md\n66\t\tmainFile := filepath.Join(promptsDir, \"easy_prompt.md\")\n67\t\tif err := os.WriteFile(mainFile, []byte(mainContent), 0644); err != nil {\n68\t\t\treturn \"\", \"\", nil, fmt.Errorf(\"failed to write easy prompt: %w\", err)\n69\t\t}\n70\t\n71\t\t// Generate and persist learning prompt\n72\t\tlearningContent := buildEasyLearningPrompt(jobID, rickDir, doingDir, rickBinPath)\n73\t\tif err := os.WriteFile(learningPromptPath, []byte(learningContent), 0644); err != nil {\n74\t\t\treturn \"\", \"\", nil, fmt.Errorf(\"failed to write learning prompt: %w\", err)\n75\t\t}\n76\t\n77\t\treturn mainFile, learningPromptPath, skillFiles, nil\n78\t}\n79\t\n80\t// buildEasyLearningPrompt creates the learning prompt content for easy mode.\n81\t// Uses file path references so it reads fresh data when executed.\n82\t// Writes directly to .rick/wiki/, .rick/tools/, .rick/SPEC.md — no merge step.\n83\tfunc buildEasyLearningPrompt(jobID, rickDir, doingDir, rickBinPath string) string {\n84\t\tlearningDir := filepath.Join(filepath.Dir(doingDir), \"learning\")\n85\t\tdebugPath := filepath.Join(doingDir, \"debug.md\")\n86\t\tspecPath := filepath.Join(rickDir, \"SPEC.md\")\n87\t\tokrPath := filepath.Join(rickDir, \"OKR.md\")\n88\t\twikiDir := filepath.Join(rickDir, \"wiki\")\n89\t\ttoolsDir := filepath.Join(rickDir, \"tools\")\n90\t\tq := \"`\"\n91\t\n92\t\tlines := []string{\n93\t\t\t\"# Rick Easy Mode Learning\",\n94\t\t\t\"\",\n95\t\t\t\"你是一个资深技术专家，对本次 easy 会话的执行过程进行学习和知识沉淀。\",\n96\t\t\t\"\",\n97\t\t\t\"## 执行上下文\",\n98\t\t\t\"\",\n99\t\t\tfmt.Sprintf(\"**Job**: %s（easy 模式）\", jobID),\n100\t\t\t\"\",\n101\t\t\t\"### 数据来源（请读取以下文件）\",\n102\t\t\t\"\",\n103\t\t\tfmt.Sprintf(\"- **debug.md（行为轨迹与问题记录）**: %s%s%s\", q, debugPath, q),\n104\t\t\tfmt.Sprintf(\"- **OKR**: %s%s%s\", q, okrPath, q),\n105\t\t\tfmt.Sprintf(\"- **SPEC.md**: %s%s%s\", q, specPath, q),\n106\t\t\t\"\",\n107\t\t\t\"---\",\n108\t\t\t\"\",\n109\t\t\t\"## ⚠️ 执行 SOP\",\n110\t\t\t\"\",\n111\t\t\t\"### Step 1：读取并分析 debug.md\",\n112\t\t\t\"\",\n113\t\t\t\"读取 debug.md 文件，分析：\",\n114\t\t\t\"- 每个 debug 条目的根因与解决方案\",\n115\t\t\t\"- 跨问题的共性模式\",\n116\t\t\t\"- 未解决的问题\",\n117\t\t\t\"\",\n118\t\t\t\"### Step 2：提取可复用 Tools\",\n119\t\t\t\"\",\n120\t\t\t\"**YOU MUST declare: \\\"I will use skill:gen-skill.\\\" Before writing any tool.**\",\n121\t\t\t\"\",\n122\t\t\t\"从 debug.md 中识别可复用模式，提取为 Python 工具：\",\n123\t\t\t\"- ✅ 纯函数，确定性输入输出\",\n124\t\t\t\"- ✅ 跨场景通用\",\n125\t\t\t\"- ✅ 支持 --test 自验证\",\n126\t\t\t\"\",\n127\t\t\tfmt.Sprintf(\"直接写入：%s%s/*.py%s\", q, toolsDir, q),\n128\t\t\t\"\",\n129\t\t\t\"### Step 3：沉淀 Skills（wiki 文档）\",\n130\t\t\t\"\",\n131\t\t\t\"为每个可复用模式生成 wiki 文档（触发场景/预期效果/使用方法）。\",\n132\t\t\t\"\",\n133\t\t\tfmt.Sprintf(\"直接写入：%s%s/*.md%s\", q, wikiDir, q),\n134\t\t\t\"\",\n135\t\t\t\"### Step 4：更新 SPEC.md\",\n136\t\t\t\"\",\n137\t\t\tfmt.Sprintf(\"直接更新 %s%s%s（in-place），将新 wiki 文档注册到技能列表，SPEC ≤ 512 行。\", q, specPath, q),\n138\t\t\t\"\",\n139\t\t\t\"### Step 5：生成 SUMMARY.md\",\n140\t\t\t\"\",\n141\t\t\tfmt.Sprintf(\"在 %s%s%s 下生成 SUMMARY.md：\", q, learningDir, q),\n142\t\t\t\"\",\n143\t\t\t\"`APPROVED: true` 开头，包含执行概述、关键成就、问题教训、知识沉淀清单。\",\n144\t\t\t\"\",\n145\t\t\t\"### Step 6：运行 learning_check\",\n146\t\t\t\"\",\n147\t\t\t\"```bash\",\n148\t\t\tfmt.Sprintf(\"%s tools learning_check %s\", rickBinPath, jobID),\n149\t\t\t\"```\",\n150\t\t\t\"\",\n151\t\t\t\"失败则修复后重新运行。\",\n152\t\t\t\"\",\n153\t\t\t\"---\",\n154\t\t\t\"\",\n155\t\t\t\"## ⚠️ 约束\",\n156\t\t\t\"\",\n157\t\t\t\"1. 必须先读取 debug.md 再生成 SUMMARY.md\",\n158\t\t\t\"2. Step 2 必须声明使用 gen-skill\",\n159\t\t\tfmt.Sprintf(\"3. wiki/tools/SPEC 直接写入 .rick/：%s%s%s、%s%s%s、%s%s%s\", q, wikiDir, q, q, toolsDir, q, q, specPath, q),\n160\t\t\tfmt.Sprintf(\"4. SUMMARY.md 写入 learning 目录：%s%s%s\", q, learningDir, q),\n161\t\t}\n162\t\n163\t\tresult := \"\"\n164\t\tfor _, l := range lines {\n165\t\t\tresult += l + \"\\n\"\n166\t\t}\n167\t\treturn result\n168\t}\n169\t\n170\t// buildCtxSection renders the easy_ctx.md template with ctxPath and localRickDir.\n171\t// Returns empty string when ctxPath is empty (no inheritance).\n172\tfunc buildCtxSection(ctxPath, localRickDir string) string {\n173\t\tif ctxPath == \"\" {\n174\t\t\treturn \"\"\n175\t\t}\n176\t\tmgr := NewPromptManager()\n177\t\ttmpl, err := mgr.LoadTemplate(\"easy_ctx\")\n178\t\tif err != nil {\n179\t\t\treturn \"\"\n180\t\t}\n181\t\tbuilder := NewPromptBuilder(tmpl)\n182\t\tbuilder.SetVariable(\"ctx_path\", ctxPath)\n183\t\tbuilder.SetVariable(\"local_rick_dir\", localRickDir)\n184\t\tcontent, err := builder.Build()\n185\t\tif err != nil {\n186\t\t\treturn \"\"\n187\t\t}\n188\t\treturn content\n189\t}\n190\t\n191\t// readFileOrDefault reads a file and returns its content, or the default string if absent.\n192\tfunc readFileOrDefault(path, defaultVal string) string {\n193\t\tdata, err := os.ReadFile(path)\n194\t\tif err != nil {\n195\t\t\treturn defaultVal\n196\t\t}\n197\t\tcontent := string(data)\n198\t\tif content == \"\" {\n199\t\t\treturn defaultVal\n200\t\t}\n201\t\treturn content\n202\t}\n203\t"}]},"parent_tool_use_id":"toolu_bdrk_019i8LjvMbnS9zsSv9ozU5hf","session_id":"1c5aaf03-90f2-4219-9379-2cb2abeac3b7","uuid":"929e397c-0876-4d16-adba-5c6a6431af51","timestamp":"2026-06-11T07:43:20.050Z"}
