t\t\tt.Fatalf(\"Failed to create temp directory: %v\", err)\n59\t\t}\n60\t\tdefer os.RemoveAll(tmpDir)\n61\t\n62\t\ttemplateContent := \"Cached template content\"\n63\t\ttemplatePath := filepath.Join(tmpDir, \"cached.md\")\n64\t\terr = os.WriteFile(templatePath, []byte(templateContent), 0644)\n65\t\tif err != nil {\n66\t\t\tt.Fatalf(\"Failed to create test template: %v\", err)\n67\t\t}\n68\t\n69\t\tmanager := NewPromptManager(tmpDir)\n70\t\n71\t\t// Load template first time\n72\t\ttemplate1, err := manager.LoadTemplate(\"cached\")\n73\t\tif err != nil {\n74\t\t\tt.Fatalf(\"Failed to load template: %v\", err)\n75\t\t}\n76\t\n77\t\t// Check cache size\n78\t\tif manager.GetCacheSize() != 1 {\n79\t\t\tt.Errorf(\"Expected cache size 1, got %d\", manager.GetCacheSize())\n80\t\t}\n81\t\n82\t\t// Load template second time (should come from cache)\n83\t\ttemplate2, err := manager.LoadTemplate(\"cached\")\n84\t\tif err != nil {\n85\t\t\tt.Fatalf(\"Failed to load template: %v\", err)\n86\t\t}\n87\t\n88\t\t// Both should point to the same object (from cache)\n89\t\tif template1 != template2 {\n90\t\t\tt.Error(\"Expected same template object from cache\")\n91\t\t}\n92\t\n93\t\t// Cache size should still be 1\n94\t\tif manager.GetCacheSize() != 1 {\n95\t\t\tt.Errorf(\"Expected cache size 1, got %d\", manager.GetCacheSize())\n96\t\t}\n97\t}\n98\t\n99\tfunc TestPromptManager_LoadNonExistentTemplate(t *testing.T) {\n100\t\ttmpDir, err := os.MkdirTemp(\"\", \"rick_prompt_test\")\n101\t\tif err != nil {\n102\t\t\tt.Fatalf(\"Failed to create temp directory: %v\", err)\n103\t\t}\n104\t\tdefer os.RemoveAll(tmpDir)\n105\t\n106\t\tmanager := NewPromptManager(tmpDir)\n107\t\n108\t\t_, err = manager.LoadTemplate(\"nonexistent\")\n109\t\tif err == nil {\n110\t\t\tt.Error(\"Expected error when loading non-existent template\")\n111\t\t}\n112\t}\n113\t\n114\tfunc TestPromptManager_ClearCache(t *testing.T) {\n115\t\ttmpDir, err := os.MkdirTemp(\"\", \"rick_prompt_test\")\n116\t\tif err != nil {\n