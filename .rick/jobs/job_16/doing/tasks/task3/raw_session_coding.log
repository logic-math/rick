{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PipbBB9BSevL8HzKjU5p8i","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/sunquan/rick/internal/parser\"\n10\t\t\"github.com/sunquan/rick/internal/workspace\"\n11\t)\n12\t\n13\t\n14\t// GenerateDoingPrompt generates the execution phase prompt from a task\n15\t// It includes task information, test methods, and debug context\n16\tfunc GenerateDoingPrompt(task *parser.Task, retryCount int, contextMgr *ContextManager, manager *PromptManager) (string, error) {\n17\t\tif task == nil {\n18\t\t\treturn \"\", fmt.Errorf(\"task cannot be nil\")\n19\t\t}\n20\t\n21\t\tif contextMgr == nil {\n22\t\t\treturn \"\", fmt.Errorf(\"context manager cannot be nil\")\n23\t\t}\n24\t\n25\t\tif manager == nil {\n26\t\t\treturn \"\", fmt.Errorf(\"prompt manager cannot be nil\")\n27\t\t}\n28\t\n29\t\t// Load doing template\n30\t\ttemplate, err := manager.LoadTemplate(\"doing\")\n31\t\tif err != nil {\n32\t\t\treturn \"\", fmt.Errorf(\"failed to load doing template: %w\", err)\n33\t\t}\n34\t\n35\t\t// Create prompt builder\n36\t\tbuilder := NewPromptBuilder(template)\n37\t\n38\t\t// Set task information\n39\t\tbuilder.SetVariable(\"task_id\", task.ID)\n40\t\tbuilder.SetVariable(\"task_name\", task.Name)\n41\t\n42\t\t// Set task details\n43\t\tbuilder.SetVariable(\"task_objective\", task.Goal)\n44\t\tbuilder.SetVariable(\"key_results\", formatKeyResults(task.KeyResults))\n45\t\tbuilder.SetVariable(\"test_methods\", task.TestMethod)\n46\t\n47\t\t// Set project information\n48\t\tprojectName, _ := workspace.GetProjectName()\n49\t\tbuilder.SetVariable(\"project_name\", projectName)\n50\t\tbuilder.SetVariable(\"project_description\", \"Context-First AI Coding Framework\")\n51\t\n52\t\t// Set job OKR content (from job_N/plan/OKR.md)\n53\t\tjobOKRContent := contextMgr.GetOKRRaw()\n54\t\tif jobOKRContent == \"\" {