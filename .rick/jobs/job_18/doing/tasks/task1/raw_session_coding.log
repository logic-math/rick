{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S9rKmbQpjZtsoBe9tKwpZr","type":"tool_result","content":"200\t\t}\n201\t\n202\t\treturn s[start:end]\n203\t}\n204\t\n205\t// ClearCache clears the template cache\n206\tfunc (pm *PromptManager) ClearCache() {\n207\t\tpm.mu.Lock()\n208\t\tpm.cache = make(map[string]*PromptTemplate)\n209\t\tpm.mu.Unlock()\n210\t}\n211\t\n212\t// GetCacheSize returns the number of cached templates\n213\tfunc (pm *PromptManager) GetCacheSize() int {\n214\t\tpm.mu.RLock()\n215\t\tdefer pm.mu.RUnlock()\n216\t\treturn len(pm.cache)\n217\t}\n218\t\n219\t// LoadCoreSkills reads embedded skill files by name and returns their concatenated content.\n220\t// Names like \"tdd/testing-anti-patterns\" map to templates/skills/tdd/testing-anti-patterns.md.\n221\t// All other names map to templates/skills/{name}.md.\n222\t// Missing files are logged as warnings and skipped — no panic.\n223\tfunc LoadCoreSkills(names []string) string {\n224\t\tvar parts []string\n225\t\tfor _, name := range names {\n226\t\t\tpath := \"templates/skills/\" + name + \".md\"\n227\t\t\tcontent, err := skillsFS.ReadFile(path)\n228\t\t\tif err != nil {\n229\t\t\t\tlog.Printf(\"warn: core skill not found: %s (%v)\", path, err)\n230\t\t\t\tcontinue\n231\t\t\t}\n232\t\t\tif len(content) > 0 {\n233\t\t\t\tparts = append(parts, string(content))\n234\t\t\t}\n235\t\t}\n236\t\treturn strings.Join(parts, \"\\n\\n---\\n\\n\")\n237\t}\n238\t\n239\t// WriteSkillTmpFile writes a core skill's content to a named tmp file and returns its path.\n240\t// Caller is responsible for cleanup via os.Remove.\n241\tfunc WriteSkillTmpFile(pattern string, skillName string) (string, error) {\n242\t\tcontent := LoadCoreSkills([]string{skillName})\n243\t\tf, err := os.CreateTemp(\"\", pattern)\n244\t\tif err != nil {\n245\t\t\treturn \"\", fmt.Errorf(\"failed to create skill tmp file: %w\", err)\n246\t\t}\n247\t\tdefer f.Close()\n248\t\tif _, err := f.WriteString(content); err != nil {\n249\t\t\tos.Remove(f.Name())\n250\t\t\treturn \"\", fmt.Errorf(\"failed to write skill tmp file: %w\", err)\n251\t\t}\n252\t\treturn f.Name(), nil\n253\t}\n254\t\n255\t// EnsurePromptsDir creates and returns the prompts/ subdirectory inside baseDir.\n256\tfunc EnsurePromptsDir(baseDir string) (string, error) {\n257\t\tdir := filepath.Join(baseDir, \"prompts\")\n258\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n259\t\t\treturn \"\", fmt.Errorf(\"failed to create prompts directory: %w\", err)"}]},"parent_tool_use_id":null,"session_id":"3b3dd0ec-57ea-4bb4-8d53-5c6f29fd71fa","uuid":"140ce92c-6e31-45c8-b24e-9c68ff82188c","timestamp":"2026-06-26T12:40:30.136Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/prompt/manager.go","content":"\t}\n\n\treturn s[start:end]\n}\n\n// ClearCache clears the template cache\nfunc (pm *PromptManager) ClearCache() {\n\tpm.mu.Lock()\n\tpm.cache = make(map[string]*PromptTemplate)\n\tpm.mu.Unlock()\n}\n\n// GetCacheSize returns the number of cached templates\nfunc (pm *PromptManager) GetCacheSize() int {\n\tpm.mu.RLock()\n\tdefer pm.mu.RUnlock()\n\treturn len(pm.cache)\n}\n\n// LoadCoreSkills reads embedded skill files by name and returns their concatenated content.\n// Names like \"tdd/testing-anti-patterns\" map to templates/skills/tdd/testing-anti-patterns.md.\n// All other names map to templates/skills/{name}.md.\n// Missing files are logged as warnings and skipped — no panic.\nfunc LoadCoreSkills(names []string) string {\n\tvar parts []string\n\tfor _, name := range names {\n\t\tpath := \"templates/skills/\" + name + \".md\"\n\t\tcontent, err := skillsFS.ReadFile(path)\n\t\tif err != nil {\n\t\t\tlog.Printf(\"warn: core skill not found: %s (%v)\", path, err)\n\t\t\tcontinue\n\t\t}\n\t\tif len(content) > 0 {\n\t\t\tparts = append(parts, string(content))\n\t\t}\n\t}\n\treturn strings.Join(parts, \"\\n\\n---\\n\\n\")\n}\n\n// WriteSkillTmpFile writes a core skill's content to a named tmp file and returns its path.\n// Caller is responsible for cleanup via os.Remove.\nfunc WriteSkillTmpFile(pattern string, skillName string) (string, error) {\n\tcontent := LoadCoreSkills([]string{skillName})\n\tf, err := os.CreateTemp(\"\", pattern)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to create skill tmp file: %w\", err)\n\t}\n\tdefer f.Close()\n\tif _, err := f.WriteString(content); err != nil {\n\t\tos.Remove(f.Name())\n\t\treturn \"\", fmt.Errorf(\"failed to write skill tmp file: %w\", err)\n\t}\n\treturn f.Name(), nil\n}\n\n// EnsurePromptsDir creates and returns the prompts/ subdirectory inside baseDir.\nfunc EnsurePromptsDir(baseDir string) (string, error) {\n\tdir := filepath.Join(baseDir, \"prompts\")\n\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to create prompts directory: %w\", err)","numLines":60,"startLine":200,"totalLines":284}}}
