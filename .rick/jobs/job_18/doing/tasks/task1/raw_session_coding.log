{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018SjdLDafkRQnb9fcRmUT82","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"embed\"\n5\t\t\"fmt\"\n6\t\t\"log\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"sync\"\n11\t)\n12\t\n13\t// PromptTemplate represents a prompt template with variables\n14\ttype PromptTemplate struct {\n15\t\tName      string\n16\t\tContent   string\n17\t\tVariables []string\n18\t}\n19\t\n20\t// Embedded templates\n21\tvar (\n22\t\t//go:embed templates/plan.md\n23\t\tplanTemplate string\n24\t\n25\t\t//go:embed templates/doing.md\n26\t\tdoingTemplate string\n27\t\n28\t\t//go:embed templates/learning.md\n29\t\tlearningTemplate string\n30\t\n31\t\t//go:embed templates/test_python.md\n32\t\ttestPythonTemplate string\n33\t\n34\t\t//go:embed templates/human_loop.md\n35\t\thumanLoopTemplate string\n36\t\n37\t\t//go:embed templates/human_loop_think.md\n38\t\thumanLoopThinkTemplate string\n39\t\n40\t\t//go:embed templates/human_loop_learn.md\n41\t\thumanLoopLearnTemplate string\n42\t\n43\t\t//go:embed templates/human_loop_express.md\n44\t\thumanLoopExpressTemplate string\n45\t\n46\t\t//go:embed templates/dream.md\n47\t\tdreamTemplate string\n48\t\n49\t\t//go:embed templates/easy.md\n50\t\teasyTemplate string\n51\t\n52\t\t//go:embed templates/easy_ctx.md\n53\t\teasyCtxTemplate string\n54\t\n55\t\t//go:embed templates/ctrl.md\n56\t\tctrlTemplate string\n57\t\n58\t\t//go:embed templates/skills\n59\t\tskillsFS embed.FS\n60\t)\n61\t\n62\t// PromptManager manages prompt templates with caching\n63\ttype PromptManager struct {\n64\t\ttemplateDir string\n65\t\tcache       map[string]*PromptTemplate\n66\t\tmu          sync.RWMutex\n67\t}\n68\t\n69\t// NewPromptManager creates a new PromptManager instance.\n70\t// An optional templateDir can be provided; if omitted or empty, embedded templates are used.\n71\tfunc NewPromptManager(templateDir ...string) *PromptManager {\n72\t\tdir := \"\"\n73\t\tif len(templateDir) > 0 {\n74\t\t\tdir = templateDir[0]\n75\t\t}\n76\t\treturn &PromptManager{\n77\t\t\ttemplateDir: dir,\n78\t\t\tcache:       make(map[string]*PromptTemplate),\n79\t\t}\n80\t}\n81\t\n82\t// LoadTemplate loads a template from file with caching\n83\tfunc (pm *PromptManager) LoadTemplate(name string) (*PromptTemplate, error) {\n84\t\t// Check cache first\n85\t\tpm.mu.RLock()\n86\t\tif template, exists := pm.cache[name]; exists {\n87\t\t\tpm.mu.RUnlock()\n88\t\t\treturn template, nil\n89\t\t}\n90\t\tpm.mu.RUnlock()\n91\t\n92\t\tvar content string\n93\t\n94\t\t// If templateDir is empty or file doesn't exist, use embedded templates\n95\t\tif pm.templateDir == \"\" {\n96\t\t\tcontent = pm.getEmbeddedTemplate(name)\n97\t\t\tif content == \"\" {\n98\t\t\t\treturn nil, fmt.Errorf(\"embedded template %s not found\", name)\n99\t\t\t}\n100\t\t} else {\n101\t\t\t// Try to load from file\n102\t\t\ttemplatePath := filepath.Join(pm.templateDir, name+\".md\")\n103\t\t\tfileContent, err := os.ReadFile(templatePath)\n104\t\t\tif err != nil {\n105\t\t\t\t// Fallback to embedded template\n106\t\t\t\tcontent = pm.getEmbeddedTemplate(name)\n107\t\t\t\tif content == \"\" {\n108\t\t\t\t\treturn nil, fmt.Errorf(\"failed to load template %s: %w\", name, err)\n109\t\t\t\t}\n110\t\t\t} else {\n111\t\t\t\tcontent = string(fileContent)\n112\t\t\t}\n113\t\t}\n114\t\n115\t\ttemplate := &PromptTemplate{\n116\t\t\tName:      name,\n117\t\t\tContent:   content,\n118\t\t\tVariables: extractVariables(content),\n119\t\t}\n120\t\n121\t\t// Store in cache\n122\t\tpm.mu.Lock()\n123\t\tpm.cache[name] = template\n124\t\tpm.mu.Unlock()\n125\t\n126\t\treturn template, nil\n127\t}\n128\t\n129\t// getEmbeddedTemplate returns the embedded template content by name\n130\tfunc (pm *PromptManager) getEmbeddedTemplate(name string) string {\n131\t\tswitch name {\n132\t\tcase \"plan\":\n133\t\t\treturn planTemplate\n134\t\tcase \"doing\":\n135\t\t\treturn doingTemplate\n136\t\tcase \"learning\":\n137\t\t\treturn learningTemplate\n138\t\tcase \"test_python\":\n139\t\t\treturn testPythonTemplate\n140\t\tcase \"human_loop\":\n141\t\t\treturn humanLoopTemplate\n142\t\tcase \"human_loop_think\":\n143\t\t\treturn humanLoopThinkTemplate\n144\t\tcase \"human_loop_learn\":\n145\t\t\treturn humanLoopLearnTemplate\n146\t\tcase \"human_loop_express\":\n147\t\t\treturn humanLoopExpressTemplate\n148\t\tcase \"dream\":\n149\t\t\treturn dreamTemplate\n150\t\tcase \"easy\":\n151\t\t\treturn easyTemplate\n152\t\tcase \"easy_ctx\":\n153\t\t\treturn easyCtxTemplate\n154\t\tcase \"ctrl\":\n155\t\t\treturn ctrlTemplate\n156\t\tdefault:\n157\t\t\treturn \"\"\n158\t\t}\n159\t}\n160\t\n161\t// extractVariables extracts {{variable}} placeholders from template content\n162\tfunc extractVariables(content string) []string {\n163\t\tvar variables []string\n164\t\tseen := make(map[string]bool)\n165\t\n166\t\t// Simple regex-free extraction of {{variable}} patterns\n167\t\tfor i := 0; i < len(content)-3; i++ {\n168\t\t\tif content[i:i+2] == \"{{\" {\n169\t\t\t\t// Find closing }}\n170\t\t\t\tfor j := i + 2; j < len(content)-1; j++ {\n171\t\t\t\t\tif content[j:j+2] == \"}}\" {\n172\t\t\t\t\t\tvariable := content[i+2 : j]\n173\t\t\t\t\t\t// Trim whitespace\n174\t\t\t\t\t\tvariable = trimSpace(variable)\n175\t\t\t\t\t\tif variable != \"\" && !seen[variable] {\n176\t\t\t\t\t\t\tvariables = append(variables, variable)\n177\t\t\t\t\t\t\tseen[variable] = true\n178\t\t\t\t\t\t}\n179\t\t\t\t\t\ti = j + 1\n180\t\t\t\t\t\tbreak\n181\t\t\t\t\t}\n182\t\t\t\t}\n183\t\t\t}\n184\t\t}\n185\t\n186\t\treturn variables\n187\t}\n188\t\n189\t// trimSpace removes leading and trailing whitespace\n190\tfunc trimSpace(s string) string {\n191\t\tstart := 0\n192\t\tend := len(s)\n193\t\n194\t\tfor start < end && (s[start] == ' ' || s[start] == '\\t' || s[start] == '\\n' || s[start] == '\\r') {\n195\t\t\tstart++\n196\t\t}\n197\t\n198\t\tfor end > start && (s[end-1] == ' ' || s[end-1] == '\\t' || s[end-1] == '\\n' || s[end-1] == '\\r') {\n199\t\t\tend--\n200\t\t}\n201\t\n202\t\treturn s[start:end]\n203\t}\n204\t\n205\t// ClearCache clears the template cache\n206\tfunc (pm *PromptManager) ClearCache() {\n207\t\tpm.mu.Lock()\n208\t\tpm.cache = make(map[string]*PromptTemplate)\n209\t\tpm.mu.Unlock()\n210\t}\n211\t\n212\t// GetCacheSize returns the number of cached templates\n213\tfunc (pm *PromptManager) GetCacheSize() int {\n214\t\tpm.mu.RLock()\n215\t\tdefer pm.mu.RUnlock()\n216\t\treturn len(pm.cache)\n217\t}\n218\t\n219\t// LoadCoreSkills reads embedded skill files by name and returns their concatenated content.\n220\t// Names like \"tdd/testing-anti-patterns\" map to templates/skills/tdd/testing-anti-patterns.md.\n221\t// All other names map to templates/skills/{name}.md.\n222\t// Missing files are logged as warnings and skipped — no panic.\n223\tfunc LoadCoreSkills(names []string) string {\n224\t\tvar parts []string\n225\t\tfor _, name := range names {\n226\t\t\tpath := \"templates/skills/\" + name + \".md\"\n227\t\t\tcontent, err := skillsFS.ReadFile(path)\n228\t\t\tif err != nil {\n229\t\t\t\tlog.Printf(\"warn: core skill not found: %s (%v)\", path, err)\n230\t\t\t\tcontinue\n231\t\t\t}\n232\t\t\tif len(content) > 0 {\n233\t\t\t\tparts = append(parts, string(content))\n234\t\t\t}\n235\t\t}\n236\t\treturn strings.Join(parts, \"\\n\\n---\\n\\n\")\n237\t}\n238\t\n239\t// WriteSkillTmpFile writes a core skill's content to a named tmp file and returns its path.\n240\t// Caller is responsible for cleanup via os.Remove.\n241\tfunc WriteSkillTmpFile(pattern string, skillName string) (string, error) {\n242\t\tcontent := LoadCoreSkills([]string{skillName})\n243\t\tf, err := os.CreateTemp(\"\", pattern)\n244\t\tif err != nil {\n245\t\t\treturn \"\", fmt.Errorf(\"failed to create skill tmp file: %w\", err)\n246\t\t}\n247\t\tdefer f.Close()\n248\t\tif _, err := f.WriteString(content); err != nil {\n249\t\t\tos.Remove(f.Name())\n250\t\t\treturn \"\", fmt.Errorf(\"failed to write skill tmp file: %w\", err)\n251\t\t}\n252\t\treturn f.Name(), nil\n253\t}\n254\t\n255\t// EnsurePromptsDir creates and returns the prompts/ subdirectory inside baseDir.\n256\tfunc EnsurePromptsDir(baseDir string) (string, error) {\n257\t\tdir := filepath.Join(baseDir, \"prompts\")\n258\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n259\t\t\treturn \"\", fmt.Errorf(\"failed to create prompts directory: %w\", err)\n260\t\t}\n261\t\treturn dir, nil\n262\t}\n263\t\n264\t// WriteSkillFile writes an embedded skill to dir/filename (persistent, no cleanup needed).\n265\tfunc WriteSkillFile(dir, filename, skillName string) (string, error) {\n266\t\treturn WriteSkillFileWithVars(dir, filename, skillName, nil)\n267\t}\n268\t\n269\t// WriteSkillFileWithVars writes an embedded skill with {{key}} variable substitution.\n270\tfunc WriteSkillFileWithVars(dir, filename, skillName string, vars map[string]string) (string, error) {\n271\t\tcontent := LoadCoreSkills([]string{skillName})\n272\t\tif content == \"\" {\n273\t\t\treturn \"\", fmt.Errorf(\"embedded skill %q not found\", skillName)\n274\t\t}\n275\t\tfor k, v := range vars {\n276\t\t\tcontent = strings.ReplaceAll(content, \"{{\"+k+\"}}\", v)\n277\t\t}\n278\t\tpath := filepath.Join(dir, filename)\n279\t\tif err := os.WriteFile(path, []byte(content), 0644); err != nil {\n280\t\t\treturn \"\", fmt.Errorf(\"failed to write skill file: %w\", err)\n281\t\t}\n282\t\treturn path, nil\n283\t}\n284\t"}]},"parent_tool_use_id":"toolu_bdrk_015xzZpNnnJmDQRPkuVWkyJc","session_id":"3b3dd0ec-57ea-4bb4-8d53-5c6f29fd71fa","uuid":"78e3062e-2bbf-48f8-bf64-1dc2fe47423a","timestamp":"2026-06-26T12:40:01.926Z"}
