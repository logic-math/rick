{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01RUBRyagoKc3GCDtQ7SX6Pj","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/sunquan/rick/internal/workspace\"\n10\t)\n11\t\n12\t// resolveRickBinPath returns the path to the rick binary.\n13\tfunc resolveRickBinPath() string {\n14\t\tprojectRoot, err := os.Getwd()\n15\t\tif err != nil {\n16\t\t\treturn \"rick\"\n17\t\t}\n18\t\tlocalBin := filepath.Join(projectRoot, \"bin\", \"rick\")\n19\t\tif _, err := os.Stat(localBin); err == nil {\n20\t\t\treturn localBin\n21\t\t}\n22\t\treturn \"rick\"\n23\t}\n24\t\n25\t// extractJobID extracts the job ID (e.g. \"job_1\") from a plan or doing directory path.\n26\tfunc extractJobID(dirPath string) string {\n27\t\tparts := strings.Split(filepath.ToSlash(dirPath), \"/\")\n28\t\tfor i := len(parts) - 1; i >= 0; i-- {\n29\t\t\tif strings.HasPrefix(parts[i], \"job_\") {\n30\t\t\t\treturn parts[i]\n31\t\t\t}\n32\t\t}\n33\t\treturn \"job_N\"\n34\t}\n35\t\n36\t// GeneratePlanPrompt generates the plan prompt content with placeholder paths (for dry-run).\n37\tfunc GeneratePlanPrompt(requirement string, jobPlanDir string, rickDir string) (string, error) {\n38\t\tif requirement == \"\" {\n39\t\t\treturn \"\", fmt.Errorf(\"requirement cannot be empty\")\n40\t\t}\n41\t\n42\t\tmgr := NewPromptManager()\n43\t\ttmpl, err := mgr.LoadTemplate(\"plan\")\n44\t\tif err != nil {\n45\t\t\treturn \"\", fmt.Errorf(\"failed to load plan template: %w\", err)\n46\t\t}\n47\t\n48\t\tbuilder := NewPromptBuilder(tmpl)\n49\t\tbuilder.SetVariable(\"okr_path\", loadOKRPath(rickDir))\n50\t\tbuilder.SetVariable(\"spec_path\", loadSpecPath(rickDir))\n51\t\tbuilder.SetVariable(\"rfc_dir\", loadRFCDir(rickDir))\n52\t\tbuilder.SetVariable(\"rfc_paths\", loadRFCPaths(rickDir))\n53\t\tbuilder.SetVariable(\"user_requirement\", requirement)\n54\t\tbuilder.SetVariable(\"job_plan_dir\", job