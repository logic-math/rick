{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_015VgyUenJQ8igQECEpYnCQ2","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/sunquan/rick/internal/parser\"\n11\t)\n12\t\n13\t// GenerateEasyPromptFile generates the easy mode interactive prompt.\n14\t// Persisted to doingDir/prompts/ so it survives session exits.\n15\t// ctxPath is optional; when non-empty the prompt includes ctx-inheritance instructions.\n16\t// Returns mainFile (easy_prompt.md), skill tmp files, error.\n17\tfunc GenerateEasyPromptFile(jobID, requirement, rickDir, ctxPath string) (string, []string, error) {\n18\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n19\t\n20\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n21\t\tif err != nil {\n22\t\t\treturn \"\", nil, fmt.Errorf(\"failed to create prompts dir: %w\", err)\n23\t\t}\n24\t\ttddFile, err := WriteSkillFile(promptsDir, \"skill_tdd_zh.md\", \"tdd-zh\")\n25\t\tif err != nil {\n26\t\t\treturn \"\", nil, err\n27\t\t}\n28\t\tsenseFile, err := WriteSkillFile(promptsDir, \"skill_sense.md\", \"sense\")\n29\t\tif err != nil {\n30\t\t\treturn \"\", nil, err\n31\t\t}\n32\t\tdebugSkillFile, err := WriteSkillFileWithVars(promptsDir, \"skill_debug_skill.md\", \"debug_skill\", map[string]string{\n33\t\t\t\"sense_skill_path\": senseFile,\n34\t\t})\n35\t\tif err != nil {\n36\t\t\treturn \"\", nil, err\n37\t\t}\n38\t\tskillFiles := []string{tddFile, debugSkillFile, senseFile}\n39\t\n40\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"暂无 OKR\")\n41\t\tspecContent := readFileOrDefault(filepath.Join(rickDir, \"SPEC.md\"), \"暂无 SPEC\")\n42\t\tdebugContent := loadDebugContextLocal(doingDir)\n43\t\tif debugContent == \"\" {\n44\t\t\tdebugContent = \"暂无（首次会话）\"\n45\t\t}\n46\t\n47\t\tmgr := NewPromptManager()\n48\t\ttmpl, err := mgr.LoadTemplate(\"easy\")\n49\t\tif err != nil {\n50\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load easy template: %w\", err)\n51\t\t}\n52\t\n53\t\tprojectRoot, _ := os.Getwd()\n54\t\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n55\t\tlearningPromptPath := filepath.Join(promptsDir, \"easy_learning_prompt.md\")\n56\t\n57\t\tbuilder := NewPromptBuilder(tmpl)\n58\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n59\t\tbuilder.SetVariable(\"spec_content\", specContent)\n60\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n61\t\tbuilder.SetVariable(\"requirement\", requirement)\n62\t\tbuilder.SetVariable(\"doing_dir\", doingDir)\n63\t\tbuilder.SetVariable(\"tdd_skill_path\", tddFile)\n64\t\tbuilder.SetVariable(\"debug_skill_path\", debugSkillFile)\n65\t\tbuilder.SetVariable(\"sense_skill_path\", senseFile)\n66\t\tbuilder.SetVariable(\"learning_prompt_path\", learningPromptPath)\n67\t\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n68\t\tbuilder.SetVariable(\"job_id\", jobID)\n69\t\tbuilder.SetVariable(\"ctx_section\", buildCtxSection(ctxPath, rickDir))\n70\t\n71\t\tmainContent, err := builder.Build()\n72\t\tif err != nil {\n73\t\t\treturn \"\", nil, fmt.Errorf(\"failed to build easy prompt: %w\", err)\n74\t\t}\n75\t\n76\t\tmainFile := filepath.Join(promptsDir, \"easy_prompt.md\")\n77\t\tif err := os.WriteFile(mainFile, []byte(mainContent), 0644); err != nil {\n78\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write easy prompt: %w\", err)\n79\t\t}\n80\t\n81\t\treturn mainFile, skillFiles, nil\n82\t}\n83\t\n84\t// GenerateEasyLearningPromptFile generates the learning prompt after a session ends.\n85\t// Called after the easy session completes so doingDir is fully populated (debug/, tasks.json, etc.).\n86\t// Reuses the same learning.md template as the standard learning phase.\n87\t// Returns the path to the generated prompt file.\n88\tfunc GenerateEasyLearningPromptFile(jobID, rickDir string) (string, error) {\n89\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n90\t\tlearningDir := filepath.Join(rickDir, \"jobs\", jobID, \"learning\")\n91\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n92\t\t\treturn \"\", fmt.Errorf(\"failed to create learning dir: %w\", err)\n93\t\t}\n94\t\n95\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n96\t\tif err != nil {\n97\t\t\treturn \"\", fmt.Errorf(\"failed to create prompts dir: %w\", err)\n98\t\t}\n99\t\n100\t\tmgr := NewPromptManager()\n101\t\ttmpl, err := mgr.LoadTemplate(\"learning\")\n102\t\tif err != nil {\n103\t\t\treturn \"\", fmt.Errorf(\"failed to load learning template: %w\", err)\n104\t\t}\n105\t\n106\t\tbuilder := NewPromptBuilder(tmpl)\n107\t\tbuilder.SetVariable(\"job_id\", jobID)\n108\t\tbuilder.SetVariable(\"learning_dir\", learningDir)\n109\t\n110\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"（本 job 无 OKR.md）\")\n111\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n112\t\n113\t\tspecPath := filepath.Join(rickDir, \"SPEC.md\")\n114\t\tbuilder.SetVariable(\"spec_path\", specPath)\n115\t\tbuilder.SetVariable(\"wiki_dir\", filepath.Join(rickDir, \"wiki\"))\n116\t\tbuilder.SetVariable(\"tools_dir\", filepath.Join(rickDir, \"tools\"))\n117\t\n118\t\tdebugContent := loadDebugContextLocal(doingDir)\n119\t\tif debugContent == \"\" {\n120\t\t\tdebugContent = \"（本次 job 无 debug 记录）\"\n121\t\t}\n122\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n123\t\n124\t\t// easy mode has no task*.md files\n125\t\tbuilder.SetVariable(\"task_md_files\", \"  （easy 模式无 task*.md 文件）\")\n126\t\n127\t\t// easy mode has no per-task act-path.md\n128\t\tbuilder.SetVariable(\"act_path_files\", \"  （easy 模式无 act-path.md 文件）\")\n129\t\n130\t\t// tasks.json: easy session writes a single easy_session task\n131\t\tbuilder.SetVariable(\"task_execution_results\", buildEasyTaskResults(doingDir))\n132\t\n133\t\tprojectRoot, _ := os.Getwd()\n134\t\tbuilder.SetVariable(\"rick_bin_path\", filepath.Join(projectRoot, \"bin\", \"rick\"))\n135\t\n136\t\tgenSkillFile, err := WriteSkillFile(promptsDir, \"skill_gen_skill.md\", \"gen-skill\")\n137\t\tif err != nil {\n138\t\t\treturn \"\", fmt.Errorf(\"failed to write gen-skill: %w\", err)\n139\t\t}\n140\t\tbuilder.SetVariable(\"gen_skill_path\", genSkillFile)\n141\t\n142\t\tpromptFile := filepath.Join(promptsDir, \"easy_learning_prompt.md\")\n143\t\tif err := builder.SaveToFile(promptFile); err != nil {\n144\t\t\treturn \"\", fmt.Errorf(\"failed to save easy learning prompt: %w\", err)\n145\t\t}\n146\t\n147\t\treturn promptFile, nil\n148\t}\n149\t\n150\t// buildEasyTaskResults formats the task execution table for easy mode (single easy_session task).\n151\tfunc buildEasyTaskResults(doingDir string) string {\n152\t\theader := \"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\n|---------|---------|------|-------------|----------|\\n\"\n153\t\tdata, err := os.ReadFile(filepath.Join(doingDir, \"tasks.json\"))\n154\t\tif err != nil {\n155\t\t\treturn header + \"| easy_session | Easy Mode Session | unknown | N/A | 1 |\\n\"\n156\t\t}\n157\t\t// Simple extraction: tasks.json has one task with status \"success\"\n158\t\tstatus := \"success\"\n159\t\tif strings.Contains(string(data), `\"status\": \"failed\"`) {\n160\t\t\tstatus = \"failed\"\n161\t\t}\n162\t\treturn header + fmt.Sprintf(\"| easy_session | Easy Mode Session | %s | N/A | 1 |\\n\", status)\n163\t}\n164\t\n165\t// buildCtxSection renders the easy_ctx.md template with ctxPath and localRickDir.\n166\t// Returns empty string when ctxPath is empty (no inheritance).\n167\tfunc buildCtxSection(ctxPath, localRickDir string) string {\n168\t\tif ctxPath == \"\" {\n169\t\t\treturn \"\"\n170\t\t}\n171\t\tmgr := NewPromptManager()\n172\t\ttmpl, err := mgr.LoadTemplate(\"easy_ctx\")\n173\t\tif err != nil {\n174\t\t\treturn \"\"\n175\t\t}\n176\t\tbuilder := NewPromptBuilder(tmpl)\n177\t\tbuilder.SetVariable(\"ctx_path\", ctxPath)\n178\t\tbuilder.SetVariable(\"local_rick_dir\", localRickDir)\n179\t\tcontent, err := builder.Build()\n180\t\tif err != nil {\n181\t\t\treturn \"\"\n182\t\t}\n183\t\treturn content\n184\t}\n185\t\n186\t// loadDebugContextLocal mirrors executor.LoadDebugContext without creating a circular import.\n187\t// Prefers bug*.md frontmatter summaries from doingDir/debug/; falls back to doingDir/debug.md.\n188\t// Returns \"\" when doingDir is empty or does not exist.\n189\t//\n190\t// TODO(2026-08): remove fallback to debug.md after full migration to debug/ dir format.\n191\tfunc loadDebugContextLocal(doingDir string) string {\n192\t\tif doingDir == \"\" {\n193\t\t\treturn \"\"\n194\t\t}\n195\t\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n196\t\t\treturn \"\"\n197\t\t}\n198\t\tdebugDir := filepath.Join(doingDir, \"debug\")\n199\t\tentries, err := os.ReadDir(debugDir)\n200\t\tif err == nil {\n201\t\t\tvar files []string\n202\t\t\tfor _, e := range entries {\n203\t\t\t\tname := e.Name()\n204\t\t\t\tif !e.IsDir() && strings.HasPrefix(name, \"bug\") && strings.HasSuffix(name, \".md\") {\n205\t\t\t\t\tfiles = append(files, name)\n206\t\t\t\t}\n207\t\t\t}\n208\t\t\tif len(files) > 0 {\n209\t\t\t\tsort.Strings(files)\n210\t\t\t\tvar sb strings.Builder\n211\t\t\t\tfor _, name := range files {\n212\t\t\t\t\tdata, err := os.ReadFile(filepath.Join(debugDir, name))\n213\t\t\t\t\tif err != nil {\n214\t\t\t\t\t\tcontinue\n215\t\t\t\t\t}\n216\t\t\t\t\tsummary, status := parser.ExtractBugFrontmatter(string(data))\n217\t\t\t\t\tsb.WriteString(fmt.Sprintf(\"- [%s] summary: %s | status: %s\\n\", name, summary, status))\n218\t\t\t\t}\n219\t\t\t\tif result := sb.String(); result != \"\" {\n220\t\t\t\t\treturn result\n221\t\t\t\t}\n222\t\t\t}\n223\t\t}\n224\t\t// TODO(2026-08): remove fallback after full migration\n225\t\tdata, err := os.ReadFile(filepath.Join(doingDir, \"debug.md\"))\n226\t\tif err != nil {\n227\t\t\treturn \"\"\n228\t\t}\n229\t\treturn string(data)\n230\t}\n231\t\n232\t// readFileOrDefault reads a file and returns its content, or the default string if absent.\n233\tfunc readFileOrDefaul