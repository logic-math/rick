{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01YcHaewXRdVHhKUaE25R7AB","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t)\n7\t\n8\t// GenerateHumanLoopPrompt generates the human-loop prompt string (for dry-run).\n9\t// Sub-agent paths are replaced with placeholder descriptions.\n10\tfunc GenerateHumanLoopPrompt(topic string, rfcDir string, draftDir string, manager *PromptManager) (string, error) {\n11\t\tif manager == nil {\n12\t\t\treturn \"\", fmt.Errorf(\"prompt manager cannot be nil\")\n13\t\t}\n14\t\n15\t\tthinkTmpl, err := manager.LoadTemplate(\"human_loop_think\")\n16\t\tif err != nil {\n17\t\t\treturn \"\", fmt.Errorf(\"failed to load human_loop_think template: %w\", err)\n18\t\t}\n19\t\tlearnTmpl, err := manager.LoadTemplate(\"human_loop_learn\")\n20\t\tif err != nil {\n21\t\t\treturn \"\", fmt.Errorf(\"failed to load human_loop_learn template: %w\", err)\n22\t\t}\n23\t\texpressTmpl, err := manager.LoadTemplate(\"human_loop_express\")\n24\t\tif err != nil {\n25\t\t\treturn \"\", fmt.Errorf(\"failed to load human_loop_express template: %w\", err)\n26\t\t}\n27\t\n28\t\t_ = thinkTmpl\n29\t\t_ = learnTmpl\n30\t\t_ = expressTmpl\n31\t\n32\t\tmainTmpl, err := manager.LoadTemplate(\"human_loop\")\n33\t\tif err != nil {\n34\t\t\treturn \"\", fmt.Errorf(\"failed to load human_loop template: %w\", err)\n35\t\t}\n36\t\n37\t\tbuilder := NewPromptBuilder(mainTmpl)\n38\t\tbuilder.SetVariable(\"topic\", topic)\n39\t\tbuilder.SetVariable(\"rfc_dir\", rfcDir)\n40\t\tbuilder.SetVariable(\"draft_dir\", draftDir)\n41\t\tbuilder.SetVariable(\"think_agent_path\", \"<tmp>/human_loop_think_*.md\")\n42\t\tbuilder.SetVariable(\"learn_agent_path\", \"<tmp>/human_loop_learn_*.md\")\n43\t\tbuilder.SetVariable(\"express_agent_path\", \"<tmp>/human_loop_express_*.md\")\n44\t\n45\t\tcontent, err := builder.Build()\n46\t\tif err != nil {\n47\t\t\treturn \"\", fmt.Errorf(\"failed to build human_loop prompt: %w\", err)\n48\t\t}\n49\t\n50\t\treturn content, nil\n51\t}\n52\t\n53\t// GenerateHumanLoopPromptFile generates the human-loop prompt and saves it to a temporary file.\n54\t// It also writes the three sub-agent templates to tmp files and injects their paths.\n55\t// Returns mainFile, subAgentFiles (think, learn, express), and any error.\n56\t// The caller is responsible for cleaning up all returned files.\n57\tfunc GenerateHumanLoopPromptFile(topic string, rfcDir string, draftDir string, manager *PromptManager) (string, []string, error) {\n58\t\tif manager == nil {\n59\t\t\treturn \"\", nil, fmt.Errorf(\"prompt manager cannot be nil\")\n60\t\t}\n61\t\n62\t\t// Build and save each sub-agent template\n63\t\tthinkTmpl, err := manager.LoadTemplate(\"human_loop_think\")\n64\t\tif err != nil {\n65\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_think template: %w\", err)\n66\t\t}\n67\t\tthinkBuilder := NewPromptBuilder(thinkTmpl)\n68\t\tthinkBuilder.SetVariable(\"draft_dir\", draftDir)\n69\t\tthinkFile, err := thinkBuilder.BuildAndSave(\"human_loop_think\")\n70\t\tif err != nil {\n71\t\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_think: %w\", err)\n72\t\t}\n73\t\n74\t\tlearnTmpl, err := manager.LoadTemplate(\"human_loop_learn\")\n75\t\tif err != nil {\n76\t\t\tcleanupFiles([]string{thinkFile})\n77\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_learn template: %w\", err)\n78\t\t}\n79\t\tlearnBuilder := NewPromptBuilder(learnTmpl)\n80\t\tlearnBuilder.SetVariable(\"draft_dir\", draftDir)\n81\t\tlearnFile, err := learnBuilder.BuildAndSave(\"human_loop_learn\")\n82\t\tif err != nil {\n83\t\t\tcleanupFiles([]string{thinkFile})\n84\t\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_learn: %w\", err)\n85\t\t}\n86\t\n87\t\texpressTmpl, err := manager.LoadTemplate(\"human_loop_express\")\n88\t\tif err != nil {\n89\t\t\tcleanupFiles([]string{thinkFile, learnFile})\n90\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_express template: %w\", err)\n91\t\t}\n92\t\texpressBuilder := NewPromptBuilder(expressTmpl)\n93\t\texpressBuilder.SetVariable(\"draft_dir\", draftDir)\n94\t\texpressFile, err := expressBuilder.BuildAndSave(\"human_loop_express\")\n95\t\tif err != nil {\n96\t\t\tcleanupFiles([]string{thinkFile, learnFile})\n97\t\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_express: %w\", err)\n98\t\t}\n99\t\n100\t\tsubAgentFiles := []string{thinkFile, learnFile, expressFile}\n101\t\n102\t\t// Build main prompt with sub-agent paths injected\n103\t\tmainTmpl, err := manager.LoadTemplate(\"human_loop\")\n104\t\tif err != nil {\n105\t\t\tcleanupFiles(subAgentFiles)\n106\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop template: %w\", err)\n107\t\t}\n108\t\n109\t\tbuilder := NewPromptBuilder(mainTmpl)\n110\t\tbuilder.SetVariable(\"topic\", topic)\n111\t\tbuilder.SetVariable(\"rfc_dir\", rfcDir)\n112\t\tbuilder.SetVariable(\"draft_dir\", draftDir)\n113\t\tbuilder.SetVariable(\"think_agent_path\", thinkFile)\n114\t\tbuilder.SetVariable(\"learn_agent_path\", learnFile)\n115\t\tbuilder.SetVariable(\"express_agent_path\", expressFile)\n116\t\n117\t\tmainFile, err := builder.BuildAndSave(\"human_loop\")\n118\t\tif err != nil {\n119\t\t\tcleanupFiles(subAgentFiles)\n120\t\t\treturn \"\", nil, fmt.Errorf(\"failed to build and save human_loop prompt: %w\", err)\n121\t\t}\n122\t\n123\t\treturn mainFile, subAgentFiles, nil\n124\t}\n125\t\n126\tfunc cleanupFiles(files []string) {\n127\t\tfor _, f := range files {\n128\t\t\tif f != \"\" {\n129\t\t\t\t_ = os.Remove(f)\n130\t\t\t}\n131\t\t}\n132\t}\n133\t"}]},"parent_tool_use_id":null,"session_id":"484eb51e-62a3-42be-b628-65310b0a28c6","uuid":"1f4306c5-90d8-4044-9c1d-c6304851535a","timestamp":"2026-07-04T17:27:48.719Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/prompt/human_loop_prompt.go","content":"package prompt\n\nimport (\n\t\"fmt\"\n\t\"os\"\n)\n\n// GenerateHumanLoopPrompt generates the human-loop prompt string (for dry-run).\n// Sub-agent paths are replaced with placeholder descriptions.\nfunc GenerateHumanLoopPrompt(topic string, rfcDir string, draftDir string, manager *PromptManager) (string, error) {\n\tif manager == nil {\n\t\treturn \"\", fmt.Errorf(\"prompt manager cannot be nil\")\n\t}\n\n\tthinkTmpl, err := manager.LoadTemplate(\"human_loop_think\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to load human_loop_think template: %w\", err)\n\t}\n\tlearnTmpl, err := manager.LoadTemplate(\"human_loop_learn\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to load human_loop_learn template: %w\", err)\n\t}\n\texpressTmpl, err := manager.LoadTemplate(\"human_loop_express\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to load human_loop_express template: %w\", err)\n\t}\n\n\t_ = thinkTmpl\n\t_ = learnTmpl\n\t_ = expressTmpl\n\n\tmainTmpl, err := manager.LoadTemplate(\"human_loop\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to load human_loop template: %w\", err)\n\t}\n\n\tbuilder := NewPromptBuilder(mainTmpl)\n\tbuilder.SetVariable(\"topic\", topic)\n\tbuilder.SetVariable(\"rfc_dir\", rfcDir)\n\tbuilder.SetVariable(\"draft_dir\", draftDir)\n\tbuilder.SetVariable(\"think_agent_path\", \"<tmp>/human_loop_think_*.md\")\n\tbuilder.SetVariable(\"learn_agent_path\", \"<tmp>/human_loop_learn_*.md\")\n\tbuilder.SetVariable(\"express_agent_path\", \"<tmp>/human_loop_express_*.md\")\n\n\tcontent, err := builder.Build()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to build human_loop prompt: %w\", err)\n\t}\n\n\treturn content, nil\n}\n\n// GenerateHumanLoopPromptFile generates the human-loop prompt and saves it to a temporary file.\n// It also writes the three sub-agent templates to tmp files and injects their paths.\n// Returns mainFile, subAgentFiles (think, learn, express), and any error.\n// The caller is responsible for cleaning up all returned files.\nfunc GenerateHumanLoopPromptFile(topic string, rfcDir string, draftDir string, manager *PromptManager) (string, []string, error) {\n\tif manager == nil {\n\t\treturn \"\", nil, fmt.Errorf(\"prompt manager cannot be nil\")\n\t}\n\n\t// Build and save each sub-agent template\n\tthinkTmpl, err := manager.LoadTemplate(\"human_loop_think\")\n\tif err != nil {\n\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_think template: %w\", err)\n\t}\n\tthinkBuilder := NewPromptBuilder(thinkTmpl)\n\tthinkBuilder.SetVariable(\"draft_dir\", draftDir)\n\tthinkFile, err := thinkBuilder.BuildAndSave(\"human_loop_think\")\n\tif err != nil {\n\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_think: %w\", err)\n\t}\n\n\tlearnTmpl, err := manager.LoadTemplate(\"human_loop_learn\")\n\tif err != nil {\n\t\tcleanupFiles([]string{thinkFile})\n\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_learn template: %w\", err)\n\t}\n\tlearnBuilder := NewPromptBuilder(learnTmpl)\n\tlearnBuilder.SetVariable(\"draft_dir\", draftDir)\n\tlearnFile, err := learnBuilder.BuildAndSave(\"human_loop_learn\")\n\tif err != nil {\n\t\tcleanupFiles([]string{thinkFile})\n\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_learn: %w\", err)\n\t}\n\n\texpressTmpl, err := manager.LoadTemplate(\"human_loop_express\")\n\tif err != nil {\n\t\tcleanupFiles([]string{thinkFile, learnFile})\n\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_express template: %w\", err)\n\t}\n\texpressBuilder := NewPromptBuilder(expressTmpl)\n\texpressBuilder.SetVariable(\"draft_dir\", draftDir)\n\texpressFile, err := expressBuilder.BuildAndSave(\"human_loop_express\")\n\tif err != nil {\n\t\tcleanupFiles([]string{thinkFile, learnFile})\n\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_express: %w\", err)\n\t}\n\n\tsubAgentFiles := []string{thinkFile, learnFile, expressFile}\n\n\t// Build main prompt with sub-agent paths injected\n\tmainTmpl, err := manager.LoadTemplate(\"human_loop\")\n\tif err != nil {\n\t\tcleanupFiles(subAgentFiles)\n\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop template: %w\", err)\n\t}\n\n\tbuilder := NewPromptBuilder(mainTmpl)\n\tbuilder.SetVariable(\"topic\", topic)\n\tbuilder.SetVariable(\"rfc_dir\", rfcDir)\n\tbuilder.SetVariable(\"draft_dir\", draftDir)\n\tbuilder.SetVariable(\"think_agent_path\", thinkFile)\n\tbuilder.SetVariable(\"learn_agent_path\", learnFile)\n\tbuilder.SetVariable(\"express_agent_path\", expressFile)\n\n\tmainFile, err := builder.BuildAndSave(\"human_loop\")\n\tif err != nil {\n\t\tcleanupFiles(subAgentFiles)\n\t\treturn \"\", nil, fmt.Errorf(\"failed to build and save human_loop prompt: %w\", err)\n\t}\n\n\treturn mainFile, subAgentFiles, nil\n}\n\nfunc cleanupFiles(files []string) {\n\tfor _, f := range files {\n\t\tif f != \"\" {\n\t\t\t_ = os.Remove(f)\n\t\t}\n\t}\n}\n","numLines":133,"startLine":1,"totalLines":133}}}
