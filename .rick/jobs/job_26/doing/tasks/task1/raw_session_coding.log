, err := os.Stat(p); os.IsNotExist(err) {\n58\t\t\t\tt.Errorf(\"expected directory %s to exist\", p)\n59\t\t\t}\n60\t\t}\n61\t}\n62\t\n63\t// TestHumanLoopDryRunContainsDraftDir tests dry-run output has draft path, no unreplaced {{draft_dir}}\n64\tfunc TestHumanLoopDryRunContainsDraftDir(t *testing.T) {\n65\t\torig, err := os.Getwd()\n66\t\tif err != nil {\n67\t\t\tt.Fatal(err)\n68\t\t}\n69\t\tworkDir := t.TempDir()\n70\t\tif err := os.Chdir(workDir); err != nil {\n71\t\t\tt.Fatal(err)\n72\t\t}\n73\t\tdefer func() { _ = os.Chdir(orig) }()\n74\t\n75\t\tif err := os.MkdirAll(filepath.Join(workDir, \".rick\"), 0755); err != nil {\n76\t\t\tt.Fatal(err)\n77\t\t}\n78\t\n79\t\torigDryRun := dryRun\n80\t\tdefer func() { dryRun = origDryRun }()\n81\t\tdryRun = true\n82\t\n83\t\tvar buf strings.Builder\n84\t\tcmd := NewHumanLoopCmd()\n85\t\tcmd.SetArgs([]string{\"测试主题\"})\n86\t\tcmd.SetOut(&buf)\n87\t\n88\t\tif err := cmd.Execute(); err != nil {\n89\t\t\tt.Fatalf(\"human-loop dry-run failed: %v\", err)\n90\t\t}\n91\t\n92\t\toutput := buf.String()\n93\t\tif strings.Contains(output, \"{{draft_dir}}\") {\n94\t\t\tt.Error(\"dry-run output contains unreplaced {{draft_dir}}\")\n95\t\t}\n96\t\tif !strings.Contains(output, \"draft\") {\n97\t\t\tt.Error(\"dry-run output does not contain 'draft'\")\n98\t\t}\n99\t}\n100\t\n101\t// TestHumanLoopCmdCreation tests that NewHumanLoopCmd creates a valid command\n102\tfunc TestHumanLoopCmdCreation(t *testing.T) {\n103\t\tcmd := NewHumanLoopCmd()\n104\t\tif cmd == nil {\n105\t\t\tt.Fatal(\"NewHumanLoopCmd returned nil\")\n106\t\t}\n107\t\tif cmd.Use != \"human-loop [topic]\" {\n108\t\t\tt.Errorf(\"expected Use to be 'human-loop [topic]', got %s\", cmd.Use)\n109\t\t}\n110\t\tif cmd.Short == \"\" {\n111\t\t\tt.Error(\"expected Short to be non-empty\")\n112\t\t}\n113\t}\n114\t\n115\t// TestHumanLoopCmdNoArgs tests that human-loop without args returns \"topic is required\"\n116\tfunc TestHumanLoopCmdNoArgs(t *testing.T) {\n117\t\tcmd := NewHumanLoo