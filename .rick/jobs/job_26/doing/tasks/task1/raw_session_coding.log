208\t\tif err != nil {\n209\t\t\tt.Fatalf(\"Failed to get current directory: %v\", err)\n210\t\t}\n211\t\tdefer os.Chdir(originalDir)\n212\t\n213\t\t// Create temp directory and change to it\n214\t\ttempDir := t.TempDir()\n215\t\tif err := os.Chdir(tempDir); err != nil {\n216\t\t\tt.Fatalf(\"Failed to change to temp directory: %v\", err)\n217\t\t}\n218\t\n219\t\tws, err := New()\n220\t\tif err != nil {\n221\t\t\tt.Fatalf(\"New() failed: %v\", err)\n222\t\t}\n223\t\n224\t\trickDir := ws.GetRickDir()\n225\t\tif rickDir == \"\" {\n226\t\t\tt.Error(\"GetRickDir() returned empty string\")\n227\t\t}\n228\t\n229\t\t// Should be .rick in current directory (tempDir)\n230\t\texpectedDir := filepath.Join(tempDir, RickDirName)\n231\t\n232\t\t// Resolve symlinks for comparison (macOS /var -> /private/var)\n233\t\trickDirResolved, _ := filepath.EvalSymlinks(rickDir)\n234\t\texpectedDirResolved, _ := filepath.EvalSymlinks(expectedDir)\n235\t\n236\t\tif rickDirResolved != expectedDirResolved {\n237\t\t\tt.Errorf(\"GetRickDir() = %s, want %s\", rickDirResolved, expectedDirResolved)\n238\t\t}\n239\t}\n240\t\n241\tfunc TestPathConstants(t *testing.T) {\n242\t\t// Verify path constants are not empty\n243\t\tconstants := map[string]string{\n244\t\t\t\"RickDirName\":     RickDirName,\n245\t\t\t\"LoopsDirName\":    LoopsDirName,\n246\t\t\t\"SkillsDirName\":   SkillsDirName,\n247\t\t\t\"JobsDirName\":     JobsDirName,\n248\t\t\t\"PlanDirName\":     PlanDirName,\n249\t\t\t\"DoingDirName\":    DoingDirName,\n250\t\t\t\"LearningDirName\": LearningDirName,\n251\t\t}\n252\t\n253\t\tfor name, value := range constants {\n254\t\t\tif value == \"\" {\n255\t\t\t\tt.Errorf(\"Path constant %s is empty\", name)\n256\t\t\t}\n257\t\t}\n258\t}\n259\t\n260\tfunc TestPathFunctions(t *testing.T) {\n261\t\t// Save current directory\n262\t\toriginalDir, err := os.Getwd()\n263\t\tif err != nil {\n264\t\t\tt.Fatalf(\"Failed to get current directory: %v\", err)\n265\t\t}\n266\t\tdefer os.Chdir(originalDir)\n267\t