k'\", rfcDir)\n\t}\n\tif !strings.Contains(rfcDir, \"RFC\") {\n\t\tt.Errorf(\"GetRFCDir() = %s, expected to contain 'RFC'\", rfcDir)\n\t}\n}\n","structuredPatch":[{"oldStart":563,"oldLines":11,"newStart":563,"newLines":12,"lines":["     t.Fatalf(\"GetDraftDir() error: %v\", err)","   }"," ","-  gotResolved, _ := filepath.EvalSymlinks(got)","-  wantDir, _ := filepath.EvalSymlinks(tmpDir)","-  want := filepath.Join(wantDir, \".rick\", \"draft\")","-  if gotResolved != want {","-    t.Errorf(\"GetDraftDir() = %q, want %q\", gotResolved, want)","+  tmpResolved, _ := filepath.EvalSymlinks(tmpDir)","+  want := filepath.Join(tmpResolved, \".rick\", \"draft\")","+  gotBase, _ := filepath.EvalSymlinks(filepath.Dir(filepath.Dir(got)))","+  gotNormalized := filepath.Join(gotBase, \".rick\", \"draft\")","+  if gotNormalized != want {","+    t.Errorf(\"GetDraftDir() = %q, want %q\", got, want)","   }","   if !strings.Contains(got, \"draft\") {","     t.Errorf(\"GetDraftDir() = %q, expected to contain 'draft'\", got)"]}],"userModified":false,"replaceAll":false}}
