, err)\n\t}\n\n\tif strings.Contains(content, \"{{draft_dir}}\") {\n\t\tt.Error(\"dry-run output contains unreplaced {{draft_dir}}\")\n\t}\n\tif !strings.Contains(content, draftDir) {\n\t\tt.Errorf(\"dry-run output does not contain draftDir %q\", draftDir)\n\t}\n}\n"}}],"usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e813224e-e44b-4651-b29f-574035918f81","uuid":"3ccddbe2-29fc-4859-86ab-57116624b550"}
