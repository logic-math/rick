t// GenerateHumanLoopPromptFile generates the human-loop prompt and saves it to a temporary file.\n53\t// It also writes the three sub-agent templates to tmp files and injects their paths.\n54\t// Returns mainFile, subAgentFiles (think, learn, express), and any error.\n55\t// The caller is responsible for cleaning up all returned files.\n56\tfunc GenerateHumanLoopPromptFile(topic string, rfcDir string, manager *PromptManager) (string, []string, error) {\n57\t\tif manager == nil {\n58\t\t\treturn \"\", nil, fmt.Errorf(\"prompt manager cannot be nil\")\n59\t\t}\n60\t\n61\t\t// Build and save each sub-agent template\n62\t\tthinkTmpl, err := manager.LoadTemplate(\"human_loop_think\")\n63\t\tif err != nil {\n64\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_think template: %w\", err)\n65\t\t}\n66\t\tthinkBuilder := NewPromptBuilder(thinkTmpl)\n67\t\tthinkFile, err := thinkBuilder.BuildAndSave(\"human_loop_think\")\n68\t\tif err != nil {\n69\t\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_think: %w\", err)\n70\t\t}\n71\t\n72\t\tlearnTmpl, err := manager.LoadTemplate(\"human_loop_learn\")\n73\t\tif err != nil {\n74\t\t\tcleanupFiles([]string{thinkFile})\n75\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_learn template: %w\", err)\n76\t\t}\n77\t\tlearnBuilder := NewPromptBuilder(learnTmpl)\n78\t\tlearnFile, err := learnBuilder.BuildAndSave(\"human_loop_learn\")\n79\t\tif err != nil {\n80\t\t\tcleanupFiles([]string{thinkFile})\n81\t\t\treturn \"\", nil, fmt.Errorf(\"failed to save human_loop_learn: %w\", err)\n82\t\t}\n83\t\n84\t\texpressTmpl, err := manager.LoadTemplate(\"human_loop_express\")\n85\t\tif err != nil {\n86\t\t\tcleanupFiles([]string{thinkFile, learnFile})\n87\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load human_loop_express template: %w\", err)\n88\t\t}\n89\t\texpressBuilder := NewPromptBuilder(expressTmpl)\n90\t\texpressFile, err := expressBuilder.BuildAndSave(\"human_loop_express\")\n91\t\tif err != nil {\n92\t