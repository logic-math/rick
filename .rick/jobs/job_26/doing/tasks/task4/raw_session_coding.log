{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Hf7EDfVzitu5YZuUrVNLGG","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t)\n9\t\n10\t// PromptBuilder builds prompts by substituting variables and context into templates\n11\ttype PromptBuilder struct {\n12\t\tTemplate  *PromptTemplate\n13\t\tVariables map[string]string\n14\t\tContext   map[string]interface{}\n15\t}\n16\t\n17\t// NewPromptBuilder creates a new PromptBuilder instance with the given template\n18\tfunc NewPromptBuilder(template *PromptTemplate) *PromptBuilder {\n19\t\treturn &PromptBuilder{\n20\t\t\tTemplate:  template,\n21\t\t\tVariables: make(map[string]string),\n22\t\t\tContext:   make(map[string]interface{}),\n23\t\t}\n24\t}\n25\t\n26\t// SetVariable sets a template variable\n27\tfunc (pb *PromptBuilder) SetVariable(key, value string) *PromptBuilder {\n28\t\tpb.Variables[key] = value\n29\t\treturn pb\n30\t}\n31\t\n32\t// SetContext sets a context value\n33\tfunc (pb *PromptBuilder) SetContext(key string, value interface{}) *PromptBuilder {\n34\t\tpb.Context[key] = value\n35\t\treturn pb\n36\t}\n37\t\n38\t// Build constructs the final prompt by replacing variables and injecting context\n39\tfunc (pb *PromptBuilder) Build() (string, error) {\n40\t\tif pb.Template == nil {\n41\t\t\treturn \"\", fmt.Errorf(\"template is not set\")\n42\t\t}\n43\t\n44\t\tresult := pb.Template.Content\n45\t\n46\t\t// Replace variables first\n47\t\tresult = pb.replaceVariables(result)\n48\t\n49\t\t// Inject context\n50\t\tresult = pb.injectContext(result)\n51\t\n52\t\treturn result, nil\n53\t}\n54\t\n55\t// replaceVariables replaces {{variable}} placeholders with their values\n56\tfunc (pb *PromptBuilder) replaceVariables(content string) string {\n57\t\tresult := content\n58\t\n59\t\t// Replace each variable\n60\t\tfor key, value := range pb.Variables {\n61\t\t\tplaceholder := \"{{\" + key + \"}}\"\n62\t\t\tresult = strings.ReplaceAll(result, placeholder, value)\n63\t\t}\n64\t\n65\t\treturn result\n66\t}\n67\t\n68\t// injectContext injects context values into the prompt\n69\t// Context values are converted to strings and injected into the prompt\n70\tfunc (pb *PromptBuilder) injectContext(content string) string {\n71\t\tresult := content\n72\t\n73\t\t// Inject each context value\n74\t\tfor key, value := range pb.Context {\n75\t\t\tplaceholder := \"{{\" + key + \"}}\"\n76\t\t\tvalueStr := fmt.Sprintf(\"%v\", value)\n77\t\t\tresult = strings.ReplaceAll(result, placeholder, valueStr)\n78\t\t}\n79\t\n80\t\treturn result\n81\t}\n82\t\n83\t// GetVariables returns the list of variables that need to be set\n84\tfunc (pb *PromptBuilder) GetVariables() []string {\n85\t\tif pb.Template == nil {\n86\t\t\treturn []string{}\n87\t\t}\n88\t\treturn pb.Template.Variables\n89\t}\n90\t\n91\t// GetMissingVariables returns variables that haven't been set\n92\tfunc (pb *PromptBuilder) GetMissingVariables() []string {\n93\t\tvar missing []string\n94\t\tfor _, variable := range pb.GetVariables() {\n95\t\t\tif _, exists := pb.Variables[variable]; !exists {\n96\t\t\t\tif _, existsInContext := pb.Context[variable]; !existsInContext {\n97\t\t\t\t\tmissing = append(missing, variable)\n98\t\t\t\t}\n99\t\t\t}\n100\t\t}\n101\t\treturn missing\n102\t}\n103\t\n104\t// BuildAndSave builds the prompt and saves it to a temporary file\n105\t// Returns the file path and any error\n106\t// The caller is responsible for cleaning up the temporary file\n107\tfunc (pb *PromptBuilder) BuildAndSave(prefix string) (string, error) {\n108\t\t// Build the prompt content\n109\t\tcontent, err := pb.Build()\n110\t\tif err != nil {\n111\t\t\treturn \"\", fmt.Errorf(\"failed to build prompt: %w\", err)\n112\t\t}\n113\t\n114\t\t// Create temporary file with .md extension\n115\t\ttmpFile, err := os.CreateTemp(\"\", fmt.Sprintf(\"rick-%s-*.md\", prefix))\n116\t\tif err != nil {\n117\t\t\treturn \"\", fmt.Errorf(\"failed to create temporary file: %w\", err)\n118\t\t}\n119\t\tdefer tmpFile.Close()\n120\t\n121\t\t// Write content to file\n122\t\tif _, err := tmpFile.WriteString(content); err != nil {\n123\t\t\tos.Remove(tmpFile.Name())\n124\t\t\treturn \"\", fmt.Errorf(\"failed to write prompt to file: %w\", err)\n125\t\t}\n126\t\n127\t\treturn tmpFile.Name(), nil\n128\t}\n129\t\n130\t// SaveToFile builds the prompt and saves it to a specific file path\n131\tfunc (pb *PromptBuilder) SaveToFile(filePath string) error {\n132\t\t// Build the prompt content\n133\t\tcontent, err := pb.Build()\n134\t\tif err != nil {\n135\t\t\treturn fmt.Errorf(\"failed to build prompt: %w\", err)\n136\t\t}\n137\t\n138\t\t// Ensure directory exists\n139\t\tdir := filepath.Dir(filePath)\n140\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n141\t\t\treturn fmt.Errorf(\"failed to create directory: %w\", err)\n142\t\t}\n143\t\n144\t\t// Write content to file\n145\t\tif err := os.WriteFile(filePath, []byte(content), 0644); err != nil {\n146\t\t\treturn fmt.Errorf(\"failed to write file: %w\", err)\n147\t\t}\n148\t\n149\t\treturn nil\n150\t}\n151\t"}]},"parent_tool_use_id":"toolu_vrtx_01NaD4V4Y6rxo8eZHRs758Ph","session_id":"f37511af-7116-437b-8854-4e59c8ee8455","uuid":"cc1a88bd-8051-41cf-ad09-b0b2fb541dcf","timestamp":"2026-07-04T17:37:35.680Z"}
