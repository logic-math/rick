{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01RshBjNzhBAiXyHNHGtw7NU","type":"tool_result","content":"1\tpackage cmd\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"os/exec\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/spf13/cobra\"\n11\t\t\"github.com/sunquan/rick/internal/config\"\n12\t\t\"github.com/sunquan/rick/internal/executor\"\n13\t\t\"github.com/sunquan/rick/internal/prompt\"\n14\t\t\"github.com/sunquan/rick/internal/workspace\"\n15\t)\n16\t\n17\tfunc NewLearningCmd() *cobra.Command {\n18\t\tvar jobID string\n19\t\n20\t\tlearningCmd := &cobra.Command{\n21\t\t\tUse:   \"learning [job_id]\",\n22\t\t\tShort: \"Analyze and document learnings from job execution\",\n23\t\t\tLong:  `Analyze execution results and update loops, skills, and SUMMARY.md.`,\n24\t\t\tArgs:  cobra.MaximumNArgs(1),\n25\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n26\t\t\t\tif GetVerbose() {\n27\t\t\t\t\tfmt.Println(\"[INFO] Starting learning phase...\")\n28\t\t\t\t}\n29\t\n30\t\t\t\tif len(args) > 0 {\n31\t\t\t\t\tjobID = args[0]\n32\t\t\t\t}\n33\t\t\t\tif jobID == \"\" {\n34\t\t\t\t\tjobID = GetJobID()\n35\t\t\t\t}\n36\t\n37\t\t\t\tif GetDryRun() {\n38\t\t\t\t\treturn runLearningDryRun(jobID)\n39\t\t\t\t}\n40\t\n41\t\t\t\tif jobID == \"\" {\n42\t\t\t\t\treturn fmt.Errorf(\"job ID is required. Usage: rick learning [job_id] or rick learning --job job_id\")\n43\t\t\t\t}\n44\t\n45\t\t\t\tif err := validateJobID(jobID); err != nil {\n46\t\t\t\t\treturn err\n47\t\t\t\t}\n48\t\n49\t\t\t\tif GetVerbose() {\n50\t\t\t\t\tfmt.Printf(\"[INFO] Analyzing learnings for job: %s\\n\", jobID)\n51\t\t\t\t}\n52\t\n53\t\t\t\tif err := executeLearningWorkflow(jobID); err != nil {\n54\t\t\t\t\treturn err\n55\t\t\t\t}\n56\t\n57\t\t\t\tfmt.Printf(\"✅ Learning phase completed for job %s!\\n\", jobID)\n58\t\t\t\treturn nil\n59\t\t\t},\n60\t\t}\n61\t\n62\t\tlearningCmd.Flags().StringVar(&jobID, \"job\", \"\", \"Job ID to analyze\")\n63\t\n64\t\treturn learningCmd\n65\t}\n66\t\n67\t// ExecutionData holds all execution information for learning\n68\ttype ExecutionData struct {\n69\t\tJobID        string\n70\t\tDebugContent string // raw content of debug.md, embedded directly in prompt\n71\t\tTasksJSON    *executor.TasksJSON\n72\t\tTaskMDPaths  []string\n73\t\tRickDir      string\n74\t\tActPathFiles []string\n75\t}\n76\t\n77\t// runLearningDryRun generates and prints the learning prompt without executing it.\n78\tfunc runLearningDryRun(jobID string) error {\n79\t\tif jobID == \"\" {\n80\t\t\tjobID = GetJobID()\n81\t\t}\n82\t\tif jobID == \"\" {\n83\t\t\tjobID = \"job_N\"\n84\t\t}\n85\t\n86\t\trickDir, err := workspace.GetRickDir()\n87\t\tif err != nil {\n88\t\t\tfmt.Printf(\"[DRY-RUN] failed to get rick dir: %v\\n\", err)\n89\t\t\treturn nil\n90\t\t}\n91\t\n92\t\tjobDir := filepath.Join(rickDir, \"jobs\", jobID)\n93\t\tlearningDir := filepath.Join(jobDir, \"learning\")\n94\t\n95\t\tdata := &ExecutionData{\n96\t\t\tJobID:        jobID,\n97\t\t\tRickDir:      rickDir,\n98\t\t\tTaskMDPaths:  []string{},\n99\t\t\tActPathFiles: []string{},\n100\t\t}\n101\t\n102\t\tdoingDir := filepath.Join(jobDir, \"doing\")\n103\t\tdata.DebugContent = executor.LoadDebugContext(doingDir)\n104\t\n105\t\tpromptsDir, _ := prompt.EnsurePromptsDir(learningDir)\n106\t\tpromptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n107\t\tif err != nil {\n108\t\t\tfmt.Printf(\"[DRY-RUN] failed to generate learning prompt: %v\\n\", err)\n109\t\t\treturn nil\n110\t\t}\n111\t\n112\t\tcontent, err := os.ReadFile(promptFile)\n113\t\tif err != nil {\n114\t\t\tfmt.Printf(\"[DRY-RUN] failed to read prompt file: %v\\n\", err)\n115\t\t\treturn nil\n116\t\t}\n117\t\tloopsDir := filepath.Join(rickDir, \"loops\")\n118\t\tskillsDir := filepath.Join(rickDir, \"skills\")\n119\t\tfmt.Printf(\"[DRY-RUN] Learning prompt (saved to: %s):\\n\", promptFile)\n120\t\tfmt.Printf(\"[DRY-RUN] loops_dir=%s\\n\", loopsDir)\n121\t\tfmt.Printf(\"[DRY-RUN] skills_dir=%s\\n\\n\", skillsDir)\n122\t\tfmt.Println(string(content))\n123\t\treturn nil\n124\t}\n125\t\n126\t// executeLearningWorkflow executes the complete learning workflow\n127\tfunc executeLearningWorkflow(jobID string) error {\n128\t\tfmt.Println(\"\\n=== Learning Workflow ===\")\n129\t\tfmt.Println()\n130\t\n131\t\tfmt.Println(\"=== Step 1: Collecting execution data ===\")\n132\t\tdata, err := collectExecutionData(jobID)\n133\t\tif err != nil {\n134\t\t\treturn fmt.Errorf(\"failed to collect execution data: %w\", err)\n135\t\t}\n136\t\n137\t\tfmt.Println(\"\\n=== Step 2: Analyzing with Claude ===\")\n138\t\tfmt.Println(\"Calling Claude Code CLI for analysis...\")\n139\t\n140\t\tif err := callClaudeForAnalysis(data); err != nil {\n141\t\t\treturn fmt.Errorf(\"Claude analysis failed: %w\", err)\n142\t\t}\n143\t\n144\t\tfmt.Println(\"\\n✅ Learning workflow completed!\")\n145\t\treturn nil\n146\t}\n147\t\n148\t// collectExecutionData collects execution data paths for learning\n149\tfunc collectExecutionData(jobID string) (*ExecutionData, error) {\n150\t\trickDir, err := workspace.GetRickDir()\n151\t\tif err != nil {\n152\t\t\treturn nil, fmt.Errorf(\"failed to get rick directory: %w\", err)\n153\t\t}\n154\t\n155\t\tjobDir := filepath.Join(rickDir, \"jobs\", jobID)\n156\t\tdoingDir := filepath.Join(jobDir, \"doing\")\n157\t\n158\t\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n159\t\t\treturn nil, fmt.Errorf(\"doing directory not found: %s (has the job been executed?)\", doingDir)\n160\t\t}\n161\t\n162\t\tdata := &ExecutionData{\n163\t\t\tJobID:   jobID,\n164\t\t\tRickDir: rickDir,\n165\t\t}\n166\t\n167\t\t// Load debug context: prefers debug/ summaries, falls back to debug.md\n168\t\tdata.DebugContent = executor.LoadDebugContext(doingDir)\n169\t\tfmt.Printf(\"✅ Loaded debug context (%d bytes)\\n\", len(data.DebugContent))\n170\t\n171\t\t// tasks.json\n172\t\ttasksJSONPath := filepath.Join(doingDir, \"tasks.json\")\n173\t\tif _, err := os.Stat(tasksJSONPath); err == nil {\n174\t\t\ttasksJSON, err := executor.LoadTasksJSON(tasksJSONPath)\n175\t\t\tif err != nil {\n176\t\t\t\treturn nil, fmt.Errorf(\"failed to load tasks.json: %w\", err)\n177\t\t\t}\n178\t\t\tdata.TasksJSON = tasksJSON\n179\t\t\tfmt.Printf(\"✅ Loaded tasks.json (%d tasks)\\n\", len(tasksJSON.Tasks))\n180\t\t} else {\n181\t\t\treturn nil, fmt.Errorf(\"tasks.json not found: %s\", tasksJSONPath)\n182\t\t}\n183\t\n184\t\t// task*.md paths\n185\t\tplanDir := filepath.Join(jobDir, \"plan\")\n186\t\ttaskFiles, err := filepath.Glob(filepath.Join(planDir, \"task*.md\"))\n187\t\tif err != nil {\n188\t\t\treturn nil, fmt.Errorf(\"failed to glob task files: %w\", err)\n189\t\t}\n190\t\tdata.TaskMDPaths = taskFiles\n191\t\tif len(taskFiles) > 0 {\n192\t\t\tfmt.Printf(\"✅ Found %d task*.md files\\n\", len(taskFiles))\n193\t\t} else {\n194\t\t\tfmt.Println(\"⚠ No task*.md files found in plan directory\")\n195\t\t}\n196\t\n197\t\t// act-path.md paths\n198\t\tactPathPattern := filepath.Join(doingDir, \"tasks\", \"*\", \"act-path.md\")\n199\t\tactPathFiles, err := filepath.Glob(actPathPattern)\n200\t\tif err == nil {\n201\t\t\tdata.ActPathFiles = actPathFiles\n202\t\t\tfmt.Printf(\"✅ Found %d act-path.md files\\n\", len(actPathFiles))\n203\t\t}\n204\t\n205\t\treturn data, nil\n206\t}\n207\t\n208\t// callClaudeForAnalysis calls Claude Code CLI for analysis\n209\tfunc callClaudeForAnalysis(data *ExecutionData) error {\n210\t\trickDir, err := workspace.GetRickDir()\n211\t\tif err != nil {\n212\t\t\treturn fmt.Errorf(\"failed to get rick directory: %w\", err)\n213\t\t}\n214\t\n215\t\tlearningDir := filepath.Join(rickDir, \"jobs\", data.JobID, \"learning\")\n216\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n217\t\t\treturn fmt.Errorf(\"failed to create learning directory: %w\", err)\n218\t\t}\n219\t\n220\t\tfmt.Printf(\"✅ Created learning directory: %s\\n\\n\", learningDir)\n221\t\n222\t\tpromptsDir, err := prompt.EnsurePromptsDir(learningDir)\n223\t\tif err != nil {\n224\t\t\treturn fmt.Errorf(\"failed to create prompts dir: %w\", err)\n225\t\t}\n226\t\n227\t\tpromptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n228\t\tif err != nil {\n229\t\t\treturn fmt.Errorf(\"failed to build learning prompt: %w\", err)\n230\t\t}\n231\t\n232\t\tcfg, err := config.LoadConfig()\n233\t\tif err != nil {\n234\t\t\treturn fmt.Errorf(\"failed to load config: %w\", err)\n235\t\t}\n236\t\n237\t\tclaudePath := cfg.ClaudeCodePath\n238\t\tif claudePath == \"\" {\n239\t\t\tclaudePath = \"claude\"\n240\t\t}\n241\t\n242\t\tfmt.Printf(\"📝 提示词已保存到: %s\\n\", promptFile)\n243\t\tfmt.Println(\"🤖 启动 Claude Code CLI 交互模式...\")\n244\t\tfmt.Println(\"📌 Claude 将在 learning 目录下生成文档（等待人工审核后合并）\")\n245\t\tfmt.Println()\n246\t\n247\t\tcmd := exec.Command(claudePath, promptFile)\n248\t\tcmd.Stdin = os.Stdin\n249\t\tcmd.Stdout = os.Stdout\n250\t\tcmd.Stderr = os.Stderr\n251\t\n252\t\tif err := cmd.Run(); err != nil {\n253\t\t\treturn fmt.Errorf(\"Claude Code CLI 执行失败: %w\", err)\n254\t\t}\n255\t\n256\t\tfmt.Println()\n257\t\tfmt.Println(\"✅ Learning 阶段完成！\")\n258\t\tfmt.Printf(\"📁 执行摘要: %s/SUMMARY.md\\n\", learningDir)\n259\t\tfmt.Println()\n260\t\n261\t\treturn nil\n262\t}\n263\t\n264\t// buildLearningPrompt builds learning prompt and saves to promptsDir/learning_prompt.md.\n265\t// Returns the prompt file path; all files are persistent, no cleanup needed.\n266\tfunc buildLearningPrompt(data *ExecutionData, learningDir, promptsDir string) (string, error) {\n267\t\tpromptMgr := prompt.NewPromptManager(\"\")\n268\t\n269\t\ttemplate, err := promptMgr.LoadTemplate(\"learning\")\n270\t\tif err != nil {\n271\t\t\treturn \"\", fmt.Errorf(\"failed to load learning template: %w\", err)\n272\t\t}\n273\t\n274\t\t// Resolve paths for skill variable substitution\n275\t\tloopsDir := filepath.Join(data.RickDir, \"loops\")\n276\t\tskillsDir := filepath.Join(data.RickDir, \"skills\")\n277\t\tprojectRoot, _ := os.Getwd()\n278\t\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n279\t\n280\t\tgenSkillFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_skill.md\", \"gen-skill\")\n281\t\tif err != nil {\n282\t\t\treturn \"\", fmt.Errorf(\"failed to write gen-skill: %w\", err)\n283\t\t}\n284\t\tgenLoopFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_loop.md\", \"gen-loop\")\n285\t\tif err != nil {\n286\t\t\treturn \"\", fmt.Errorf(\"failed to write gen-loop: %w\", err)\n287\t\t}\n288\t\tgenDomainFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_domain.md\", \"gen-domain\")\n289\t\tif err != nil {\n290\t\t\treturn \"\", fmt.Errorf(\"failed to write gen-domain: %w\", err)\n291\t\t}\n292\t\n293\t\tdomainDir := filepath.Join(data.RickDir, \"domain\")\n294\t\tlearningLoopFile, err := prompt.WriteSkillFileWithVars(promptsDir, \"learning_loop.md\", \"learning_loop\", map[string]string{\n295\t\t\t\"job_id\":          data.JobID,\n296\t\t\t\"learning_dir\":    learningDir,\n297\t\t\t\"loops_dir\":       loopsDir,\n298\t\t\t\"skills_dir\":      skillsDir,\n299\t\t\t\"domain_dir\":      domainDir,\n300\t\t\t\"rick_bin_path\":   rickBinPath,\n301\t\t\t\"gen_skill_path\":  genSkillFile,\n302\t\t\t\"gen_loop_path\":   genLoopFile,\n303\t\t\t\"gen_domain_path\": genDomainFile,\n304\t\t})\n305\t\tif err != nil {\n306\t\t\treturn \"\", fmt.Errorf(\"failed to write learning_loop skill: %w\", err)\n307\t\t}\n308\t\n309\t\tbuilder := prompt.NewPromptBuilder(template)\n310\t\n311\t\tbuilder.SetVariable(\"job_id\", data.JobID)\n312\t\tbuilder.SetVariable(\"loops_context\", prompt.LoadLoopsContext(loopsDir))\n313\t\tbuilder.SetVariable(\"learning_loop_path\", learningLoopFile)\n314\t\n315\t\t// debug.md — embed content directly\n316\t\tif data.DebugContent != \"\" {\n317\t\t\tbuilder.SetVariable(\"debug_content\", data.DebugContent)\n318\t\t} else {\n319\t\t\tbuilder.SetVariable(\"debug_content\", \"（本次 job 无 debug.md 记录）\")\n320\t\t}\n321\t\n322\t\t// task*.md paths\n323\t\tif len(data.TaskMDPaths) > 0 {\n324\t\t\tvar sb strings.Builder\n325\t\t\tfor _, p := range data.TaskMDPaths {\n326\t\t\t\tsb.WriteString(fmt.Sprintf(\"  - `%s`\\n\", p))\n327\t\t\t}\n328\t\t\tbuilder.SetVariable(\"task_md_files\", strings.TrimRight(sb.String(), \"\\n\"))\n329\t\t} else {\n330\t\t\tbuilder.SetVariable(\"task_md_files\", \"  （无 task*.md 文件）\")\n331\t\t}\n332\t\n333\t\t// act-path.md paths\n334\t\tif len(data.ActPathFiles) > 0 {\n335\t\t\tvar sb strings.Builder\n336\t\t\tfor _, p := range data.ActPathFiles {\n337\t\t\t\tsb.WriteString(fmt.Sprintf(\"  - `%s`\\n\", p))\n338\t\t\t}\n339\t\t\tbuilder.SetVariable(\"act_path_files\", strings.TrimRight(sb.String(), \"\\n\"))\n340\t\t} else {\n341\t\t\tbuilder.SetVariable(\"act_path_files\", \"  （无 act-path.md 文件）\")\n342\t\t}\n343\t\n344\t\t// task execution results table\n345\t\tvar taskResults strings.Builder\n346\t\tif data.TasksJSON != nil {\n347\t\t\ttaskResults.WriteString(\"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\n\")\n348\t\t\ttaskResults.WriteString(\"|---------|---------|------|-------------|----------|\\n\")\n349\t\t\tfor _, task := range data.TasksJSON.Tasks {\n350\t\t\t\tcommitHash := task.CommitHash\n351\t\t\t\tif commitHash == \"\" {\n352\t\t\t\t\tcommitHash = \"N/A\"\n353\t\t\t\t} else if len(commitHash) > 8 {\n354\t\t\t\t\tcommitHash = commitHash[:8]\n355\t\t\t\t}\n356\t\t\t\ttaskResults.WriteString(fmt.Sprintf(\"| %s | %s | %s | %s | %d |\\n\",\n357\t\t\t\t\ttask.TaskID, task.TaskName, task.Status, commitHash, task.Attempts))\n358\t\t\t}\n359\t\t} else {\n360\t\t\ttaskResults.WriteString(\"无任务元信息\\n\")\n361\t\t}\n362\t\tbuilder.SetVariable(\"task_execution_results\", taskResults.String())\n363\t\n364\t\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n365\t\n366\t\tpromptFile := filepath.Join(promptsDir, \"learning_prompt.md\")\n367\t\tif err := builder.SaveToFile(promptFile); err != nil {\n368\t\t\treturn \"\", fmt.Errorf(\"failed to save learning prompt: %w\", err)\n369\t\t}\n370\t\n371\t\treturn promptFile, nil\n372\t}\n373\t"}]},"parent_tool_use_id":null,"session_id":"f37511af-7116-437b-8854-4e59c8ee8455","uuid":"d76c9182-990c-413e-be89-71cd2a204a16","timestamp":"2026-07-04T17:38:05.781Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/cmd/learning.go","content":"package cmd\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\t\"github.com/sunquan/rick/internal/config\"\n\t\"github.com/sunquan/rick/internal/executor\"\n\t\"github.com/sunquan/rick/internal/prompt\"\n\t\"github.com/sunquan/rick/internal/workspace\"\n)\n\nfunc NewLearningCmd() *cobra.Command {\n\tvar jobID string\n\n\tlearningCmd := &cobra.Command{\n\t\tUse:   \"learning [job_id]\",\n\t\tShort: \"Analyze and document learnings from job execution\",\n\t\tLong:  `Analyze execution results and update loops, skills, and SUMMARY.md.`,\n\t\tArgs:  cobra.MaximumNArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\tif GetVerbose() {\n\t\t\t\tfmt.Println(\"[INFO] Starting learning phase...\")\n\t\t\t}\n\n\t\t\tif len(args) > 0 {\n\t\t\t\tjobID = args[0]\n\t\t\t}\n\t\t\tif jobID == \"\" {\n\t\t\t\tjobID = GetJobID()\n\t\t\t}\n\n\t\t\tif GetDryRun() {\n\t\t\t\treturn runLearningDryRun(jobID)\n\t\t\t}\n\n\t\t\tif jobID == \"\" {\n\t\t\t\treturn fmt.Errorf(\"job ID is required. Usage: rick learning [job_id] or rick learning --job job_id\")\n\t\t\t}\n\n\t\t\tif err := validateJobID(jobID); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\n\t\t\tif GetVerbose() {\n\t\t\t\tfmt.Printf(\"[INFO] Analyzing learnings for job: %s\\n\", jobID)\n\t\t\t}\n\n\t\t\tif err := executeLearningWorkflow(jobID); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\n\t\t\tfmt.Printf(\"✅ Learning phase completed for job %s!\\n\", jobID)\n\t\t\treturn nil\n\t\t},\n\t}\n\n\tlearningCmd.Flags().StringVar(&jobID, \"job\", \"\", \"Job ID to analyze\")\n\n\treturn learningCmd\n}\n\n// ExecutionData holds all execution information for learning\ntype ExecutionData struct {\n\tJobID        string\n\tDebugContent string // raw content of debug.md, embedded directly in prompt\n\tTasksJSON    *executor.TasksJSON\n\tTaskMDPaths  []string\n\tRickDir      string\n\tActPathFiles []string\n}\n\n// runLearningDryRun generates and prints the learning prompt without executing it.\nfunc runLearningDryRun(jobID string) error {\n\tif jobID == \"\" {\n\t\tjobID = GetJobID()\n\t}\n\tif jobID == \"\" {\n\t\tjobID = \"job_N\"\n\t}\n\n\trickDir, err := workspace.GetRickDir()\n\tif err != nil {\n\t\tfmt.Printf(\"[DRY-RUN] failed to get rick dir: %v\\n\", err)\n\t\treturn nil\n\t}\n\n\tjobDir := filepath.Join(rickDir, \"jobs\", jobID)\n\tlearningDir := filepath.Join(jobDir, \"learning\")\n\n\tdata := &ExecutionData{\n\t\tJobID:        jobID,\n\t\tRickDir:      rickDir,\n\t\tTaskMDPaths:  []string{},\n\t\tActPathFiles: []string{},\n\t}\n\n\tdoingDir := filepath.Join(jobDir, \"doing\")\n\tdata.DebugContent = executor.LoadDebugContext(doingDir)\n\n\tpromptsDir, _ := prompt.EnsurePromptsDir(learningDir)\n\tpromptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n\tif err != nil {\n\t\tfmt.Printf(\"[DRY-RUN] failed to generate learning prompt: %v\\n\", err)\n\t\treturn nil\n\t}\n\n\tcontent, err := os.ReadFile(promptFile)\n\tif err != nil {\n\t\tfmt.Printf(\"[DRY-RUN] failed to read prompt file: %v\\n\", err)\n\t\treturn nil\n\t}\n\tloopsDir := filepath.Join(rickDir, \"loops\")\n\tskillsDir := filepath.Join(rickDir, \"skills\")\n\tfmt.Printf(\"[DRY-RUN] Learning prompt (saved to: %s):\\n\", promptFile)\n\tfmt.Printf(\"[DRY-RUN] loops_dir=%s\\n\", loopsDir)\n\tfmt.Printf(\"[DRY-RUN] skills_dir=%s\\n\\n\", skillsDir)\n\tfmt.Println(string(content))\n\treturn nil\n}\n\n// executeLearningWorkflow executes the complete learning workflow\nfunc executeLearningWorkflow(jobID string) error {\n\tfmt.Println(\"\\n=== Learning Workflow ===\")\n\tfmt.Println()\n\n\tfmt.Println(\"=== Step 1: Collecting execution data ===\")\n\tdata, err := collectExecutionData(jobID)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to collect execution data: %w\", err)\n\t}\n\n\tfmt.Println(\"\\n=== Step 2: Analyzing with Claude ===\")\n\tfmt.Println(\"Calling Claude Code CLI for analysis...\")\n\n\tif err := callClaudeForAnalysis(data); err != nil {\n\t\treturn fmt.Errorf(\"Claude analysis failed: %w\", err)\n\t}\n\n\tfmt.Println(\"\\n✅ Learning workflow completed!\")\n\treturn nil\n}\n\n// collectExecutionData collects execution data paths for learning\nfunc collectExecutionData(jobID string) (*ExecutionData, error) {\n\trickDir, err := workspace.GetRickDir()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get rick directory: %w\", err)\n\t}\n\n\tjobDir := filepath.Join(rickDir, \"jobs\", jobID)\n\tdoingDir := filepath.Join(jobDir, \"doing\")\n\n\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n\t\treturn nil, fmt.Errorf(\"doing directory not found: %s (has the job been executed?)\", doingDir)\n\t}\n\n\tdata := &ExecutionData{\n\t\tJobID:   jobID,\n\t\tRickDir: rickDir,\n\t}\n\n\t// Load debug context: prefers debug/ summaries, falls back to debug.md\n\tdata.DebugContent = executor.LoadDebugContext(doingDir)\n\tfmt.Printf(\"✅ Loaded debug context (%d bytes)\\n\", len(data.DebugContent))\n\n\t// tasks.json\n\ttasksJSONPath := filepath.Join(doingDir, \"tasks.json\")\n\tif _, err := os.Stat(tasksJSONPath); err == nil {\n\t\ttasksJSON, err := executor.LoadTasksJSON(tasksJSONPath)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"failed to load tasks.json: %w\", err)\n\t\t}\n\t\tdata.TasksJSON = tasksJSON\n\t\tfmt.Printf(\"✅ Loaded tasks.json (%d tasks)\\n\", len(tasksJSON.Tasks))\n\t} else {\n\t\treturn nil, fmt.Errorf(\"tasks.json not found: %s\", tasksJSONPath)\n\t}\n\n\t// task*.md paths\n\tplanDir := filepath.Join(jobDir, \"plan\")\n\ttaskFiles, err := filepath.Glob(filepath.Join(planDir, \"task*.md\"))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to glob task files: %w\", err)\n\t}\n\tdata.TaskMDPaths = taskFiles\n\tif len(taskFiles) > 0 {\n\t\tfmt.Printf(\"✅ Found %d task*.md files\\n\", len(taskFiles))\n\t} else {\n\t\tfmt.Println(\"⚠ No task*.md files found in plan directory\")\n\t}\n\n\t// act-path.md paths\n\tactPathPattern := filepath.Join(doingDir, \"tasks\", \"*\", \"act-path.md\")\n\tactPathFiles, err := filepath.Glob(actPathPattern)\n\tif err == nil {\n\t\tdata.ActPathFiles = actPathFiles\n\t\tfmt.Printf(\"✅ Found %d act-path.md files\\n\", len(actPathFiles))\n\t}\n\n\treturn data, nil\n}\n\n// callClaudeForAnalysis calls Claude Code CLI for analysis\nfunc callClaudeForAnalysis(data *ExecutionData) error {\n\trickDir, err := workspace.GetRickDir()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get rick directory: %w\", err)\n\t}\n\n\tlearningDir := filepath.Join(rickDir, \"jobs\", data.JobID, \"learning\")\n\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n\t\treturn fmt.Errorf(\"failed to create learning directory: %w\", err)\n\t}\n\n\tfmt.Printf(\"✅ Created learning directory: %s\\n\\n\", learningDir)\n\n\tpromptsDir, err := prompt.EnsurePromptsDir(learningDir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to create prompts dir: %w\", err)\n\t}\n\n\tpromptFile, err := buildLearningPrompt(data, learningDir, promptsDir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to build learning prompt: %w\", err)\n\t}\n\n\tcfg, err := config.LoadConfig()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to load config: %w\", err)\n\t}\n\n\tclaudePath := cfg.ClaudeCodePath\n\tif claudePath == \"\" {\n\t\tclaudePath = \"claude\"\n\t}\n\n\tfmt.Printf(\"📝 提示词已保存到: %s\\n\", promptFile)\n\tfmt.Println(\"🤖 启动 Claude Code CLI 交互模式...\")\n\tfmt.Println(\"📌 Claude 将在 learning 目录下生成文档（等待人工审核后合并）\")\n\tfmt.Println()\n\n\tcmd := exec.Command(claudePath, promptFile)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\n\tif err := cmd.Run(); err != nil {\n\t\treturn fmt.Errorf(\"Claude Code CLI 执行失败: %w\", err)\n\t}\n\n\tfmt.Println()\n\tfmt.Println(\"✅ Learning 阶段完成！\")\n\tfmt.Printf(\"📁 执行摘要: %s/SUMMARY.md\\n\", learningDir)\n\tfmt.Println()\n\n\treturn nil\n}\n\n// buildLearningPrompt builds learning prompt and saves to promptsDir/learning_prompt.md.\n// Returns the prompt file path; all files are persistent, no cleanup needed.\nfunc buildLearningPrompt(data *ExecutionData, learningDir, promptsDir string) (string, error) {\n\tpromptMgr := prompt.NewPromptManager(\"\")\n\n\ttemplate, err := promptMgr.LoadTemplate(\"learning\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to load learning template: %w\", err)\n\t}\n\n\t// Resolve paths for skill variable substitution\n\tloopsDir := filepath.Join(data.RickDir, \"loops\")\n\tskillsDir := filepath.Join(data.RickDir, \"skills\")\n\tprojectRoot, _ := os.Getwd()\n\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n\n\tgenSkillFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_skill.md\", \"gen-skill\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to write gen-skill: %w\", err)\n\t}\n\tgenLoopFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_loop.md\", \"gen-loop\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to write gen-loop: %w\", err)\n\t}\n\tgenDomainFile, err := prompt.WriteSkillFile(promptsDir, \"skill_gen_domain.md\", \"gen-domain\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to write gen-domain: %w\", err)\n\t}\n\n\tdomainDir := filepath.Join(data.RickDir, \"domain\")\n\tlearningLoopFile, err := prompt.WriteSkillFileWithVars(promptsDir, \"learning_loop.md\", \"learning_loop\", map[string]string{\n\t\t\"job_id\":          data.JobID,\n\t\t\"learning_dir\":    learningDir,\n\t\t\"loops_dir\":       loopsDir,\n\t\t\"skills_dir\":      skillsDir,\n\t\t\"domain_dir\":      domainDir,\n\t\t\"rick_bin_path\":   rickBinPath,\n\t\t\"gen_skill_path\":  genSkillFile,\n\t\t\"gen_loop_path\":   genLoopFile,\n\t\t\"gen_domain_path\": genDomainFile,\n\t})\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to write learning_loop skill: %w\", err)\n\t}\n\n\tbuilder := prompt.NewPromptBuilder(template)\n\n\tbuilder.SetVariable(\"job_id\", data.JobID)\n\tbuilder.SetVariable(\"loops_context\", prompt.LoadLoopsContext(loopsDir))\n\tbuilder.SetVariable(\"learning_loop_path\", learningLoopFile)\n\n\t// debug.md — embed content directly\n\tif data.DebugContent != \"\" {\n\t\tbuilder.SetVariable(\"debug_content\", data.DebugContent)\n\t} else {\n\t\tbuilder.SetVariable(\"debug_content\", \"（本次 job 无 debug.md 记录）\")\n\t}\n\n\t// task*.md paths\n\tif len(data.TaskMDPaths) > 0 {\n\t\tvar sb strings.Builder\n\t\tfor _, p := range data.TaskMDPaths {\n\t\t\tsb.WriteString(fmt.Sprintf(\"  - `%s`\\n\", p))\n\t\t}\n\t\tbuilder.SetVariable(\"task_md_files\", strings.TrimRight(sb.String(), \"\\n\"))\n\t} else {\n\t\tbuilder.SetVariable(\"task_md_files\", \"  （无 task*.md 文件）\")\n\t}\n\n\t// act-path.md paths\n\tif len(data.ActPathFiles) > 0 {\n\t\tvar sb strings.Builder\n\t\tfor _, p := range data.ActPathFiles {\n\t\t\tsb.WriteString(fmt.Sprintf(\"  - `%s`\\n\", p))\n\t\t}\n\t\tbuilder.SetVariable(\"act_path_files\", strings.TrimRight(sb.String(), \"\\n\"))\n\t} else {\n\t\tbuilder.SetVariable(\"act_path_files\", \"  （无 act-path.md 文件）\")\n\t}\n\n\t// task execution results table\n\tvar taskResults strings.Builder\n\tif data.TasksJSON != nil {\n\t\ttaskResults.WriteString(\"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\n\")\n\t\ttaskResults.WriteString(\"|---------|---------|------|-------------|----------|\\n\")\n\t\tfor _, task := range data.TasksJSON.Tasks {\n\t\t\tcommitHash := task.CommitHash\n\t\t\tif commitHash == \"\" {\n\t\t\t\tcommitHash = \"N/A\"\n\t\t\t} else if len(commitHash) > 8 {\n\t\t\t\tcommitHash = commitHash[:8]\n\t\t\t}\n\t\t\ttaskResults.WriteString(fmt.Sprintf(\"| %s | %s | %s | %s | %d |\\n\",\n\t\t\t\ttask.TaskID, task.TaskName, task.Status, commitHash, task.Attempts))\n\t\t}\n\t} else {\n\t\ttaskResults.WriteString(\"无任务元信息\\n\")\n\t}\n\tbuilder.SetVariable(\"task_execution_results\", taskResults.String())\n\n\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n\n\tpromptFile := filepath.Join(promptsDir, \"learning_prompt.md\")\n\tif err := builder.SaveToFile(promptFile); err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to save learning prompt: %w\", err)\n\t}\n\n\treturn promptFile, nil\n}\n","numLines":373,"startLine":1,"totalLines":373}}}
