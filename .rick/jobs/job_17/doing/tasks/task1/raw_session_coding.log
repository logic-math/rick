{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QT6nUTPojjR6NpZRZoHuVq","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\tfunc TestPromptManager_LoadTemplate(t *testing.T) {\n11\t\t// Create a temporary directory for templates\n12\t\ttmpDir, err := os.MkdirTemp(\"\", \"rick_prompt_test\")\n13\t\tif err != nil {\n14\t\t\tt.Fatalf(\"Failed to create temp directory: %v\", err)\n15\t\t}\n16\t\tdefer os.RemoveAll(tmpDir)\n17\t\n18\t\t// Create a test template file\n19\t\ttemplateContent := \"This is a test template with {{variable1}} and {{variable2}}\"\n20\t\ttemplatePath := filepath.Join(tmpDir, \"test.md\")\n21\t\terr = os.WriteFile(templatePath, []byte(templateContent), 0644)\n22\t\tif err != nil {\n23\t\t\tt.Fatalf(\"Failed to create test template: %v\", err)\n24\t\t}\n25\t\n26\t\tmanager := NewPromptManager(tmpDir)\n27\t\n28\t\t// Test loading template\n29\t\ttemplate, err := manager.LoadTemplate(\"test\")\n30\t\tif err != nil {\n31\t\t\tt.Fatalf(\"Failed to load template: %v\", err)\n32\t\t}\n33\t\n34\t\tif template.Name != \"test\" {\n35\t\t\tt.Errorf(\"Expected template name 'test', got '%s'\", template.Name)\n36\t\t}\n37\t\n38\t\tif template.Content != templateContent {\n39\t\t\tt.Errorf(\"Expected content '%s', got '%s'\", templateContent, template.Content)\n40\t\t}\n41\t\n42\t\t// Check variables extraction\n43\t\tif len(template.Variables) != 2 {\n44\t\t\tt.Errorf(\"Expected 2 variables, got %d\", len(template.Variables))\n45\t\t}\n46\t\n47\t\texpectedVars := map[string]bool{\"variable1\": true, \"variable2\": true}\n48\t\tfor _, v := range template.Variables {\n49\t\t\tif !expectedVars[v] {\n50\t\t\t\tt.Errorf(\"Unexpected variable: %s\", v)\n51\t\t\t}\n52\t\t}\n53\t}\n54\t\n55\tfunc TestPromptManager_CacheMechanism(t *testing.T) {\n56\t\ttmpDir, err := os.MkdirTemp(\"\", \"rick_prompt_test\")\n57\t\tif err != nil {\n58\t\t\tt.Fatalf(\"Failed to create temp directory: %v\", err)\n59\t\t}\n60\t\tdefer os.RemoveAll(tmpDir)\n61\t\n62\t\ttemplateContent := \"Cached template content\"\n63\t\ttemplatePath := filepath.Join(tmpDir, \"cached.md\")\n64\t\terr = os.WriteFile(templatePath, []byte(templateContent), 0644)\n65\t\tif err != nil {\n66\t\t\tt.Fatalf(\"Failed to create test template: %v\", err)\n67\t\t}\n68\t\n69\t\tmanager := NewPromptManager(tmpDir)\n70\t\n71\t\t// Load template first time\n72\t\ttemplate1, err := manager.LoadTemplate(\"cached\")\n73\t\tif err != nil {\n74\t\t\tt.Fatalf(\"Failed to load template: %v\", err)\n75\t\t}\n76\t\n77\t\t// Check cache size\n78\t\tif manager.GetCacheSize() != 1 {\n79\t\t\tt.Errorf(\"Expected cache size 1, got %d\", manager.GetCacheSize())\n80\t\t}\n81\t\n82\t\t// Load template second time (should come from cache)\n83\t\ttemplate2, err := manager.LoadTemplate(\"cached\")\n84\t\tif err != nil {\n85\t\t\tt.Fatalf(\"Failed to load template: %v\", err)\n86\t\t}\n87\t\n88\t\t// Both should point to the same object (from cache)\n89\t\tif template1 != template2 {\n90\t\t\tt.Error(\"Expected same template object from cache\")\n91\t\t}\n92\t\n93\t\t// Cache size should still be 1\n94\t\tif manager.GetCacheSize() != 1 {\n95\t\t\tt.Errorf(\"Expected cache size 1, got %d\", manager.GetCacheSize())\n96\t\t}\n97\t}\n98\t\n99\tfunc TestPromptManager_LoadNonExistentTemplate(t *testing.T) {\n100\t\ttmpDir, err := os.MkdirTemp(\"\", \"rick_prompt_test\")\n101\t\tif err != nil {\n102\t\t\tt.Fatalf(\"Failed to create temp directory: %v\", err)\n103\t\t}\n104\t\tdefer os.RemoveAll(tmpDir)\n105\t\n106\t\tmanager := NewPromptManager(tmpDir)\n107\t\n108\t\t_, err = manager.LoadTemplate(\"nonexistent\")\n109\t\tif err == nil {\n110\t\t\tt.Error(\"Expected error when loading non-existent template\")\n111\t\t}\n112\t}\n113\t\n114\tfunc TestPromptManager_ClearCache(t *testing.T) {\n115\t\ttmpDir, err := os.MkdirTemp(\"\", \"rick_prompt_test\")\n116\t\tif err != nil {\n117\t\t\tt.Fatalf(\"Failed to create temp directory: %v\", err)\n118\t\t}\n119\t\tdefer os.RemoveAll(tmpDir)\n120\t\n121\t\ttemplateContent := \"Template for cache clear test\"\n122\t\ttemplatePath := filepath.Join(tmpDir, \"clear.md\")\n123\t\terr = os.WriteFile(templatePath, []byte(templateContent), 0644)\n124\t\tif err != nil {\n125\t\t\tt.Fatalf(\"Failed to create test template: %v\", err)\n126\t\t}\n127\t\n128\t\tmanager := NewPromptManager(tmpDir)\n129\t\n130\t\t// Load template\n131\t\t_, err = manager.LoadTemplate(\"clear\")\n132\t\tif err != nil {\n133\t\t\tt.Fatalf(\"Failed to load template: %v\", err)\n134\t\t}\n135\t\n136\t\tif manager.GetCacheSize() != 1 {\n137\t\t\tt.Errorf(\"Expected cache size 1, got %d\", manager.GetCacheSize())\n138\t\t}\n139\t\n140\t\t// Clear cache\n141\t\tmanager.ClearCache()\n142\t\n143\t\tif manager.GetCacheSize() != 0 {\n144\t\t\tt.Errorf(\"Expected cache size 0 after clear, got %d\", manager.GetCacheSize())\n145\t\t}\n146\t}\n147\t\n148\tfunc TestExtractVariables(t *testing.T) {\n149\t\ttests := []struct {\n150\t\t\tname      string\n151\t\t\tcontent   string\n152\t\t\texpected  []string\n153\t\t\twantCount int\n154\t\t}{\n155\t\t\t{\n156\t\t\t\tname:      \"no_variables\",\n157\t\t\t\tcontent:   \"No variables here\",\n158\t\t\t\texpected:  []string{},\n159\t\t\t\twantCount: 0,\n160\t\t\t},\n161\t\t\t{\n162\t\t\t\tname:      \"single_variable\",\n163\t\t\t\tcontent:   \"Single {{variable}} placeholder\",\n164\t\t\t\texpected:  []string{\"variable\"},\n165\t\t\t\twantCount: 1,\n166\t\t\t},\n167\t\t\t{\n168\t\t\t\tname:      \"multiple_variables\",\n169\t\t\t\tcontent:   \"Multiple {{var1}} and {{var2}} placeholders\",\n170\t\t\t\texpected:  []string{\"var1\", \"var2\"},\n171\t\t\t\twantCount: 2,\n172\t\t\t},\n173\t\t\t{\n174\t\t\t\tname:      \"duplicate_variables\",\n175\t\t\t\tcontent:   \"Duplicate {{var}} and {{var}} should be deduplicated\",\n176\t\t\t\texpected:  []string{\"var\"},\n177\t\t\t\twantCount: 1,\n178\t\t\t}