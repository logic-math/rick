ctx path exists\n60\t\tif _, err := os.Stat(ctxPath); os.IsNotExist(err) {\n61\t\t\treturn fmt.Errorf(\"--ctx path does not exist: %s\", ctxPath)\n62\t\t}\n63\t\t// Verify local .rick has no existing OKR.md / SPEC.md\n64\t\tfor _, name := range []string{\"OKR.md\", \"SPEC.md\"} {\n65\t\t\tp := filepath.Join(localRickDir, name)\n66\t\t\tif _, err := os.Stat(p); err == nil {\n67\t\t\t\treturn fmt.Errorf(\"local context already exists (%s). Remove it first or omit --ctx\", p)\n68\t\t\t}\n69\t\t}\n70\t\treturn nil\n71\t}\n72\t\n73\t// resumeEasyMode resumes an existing easy session by job ID.\n74\tfunc resumeEasyMode(jobID string) error {\n75\t\trickDir, err := workspace.GetRickDir()\n76\t\tif err != nil {\n77\t\t\treturn fmt.Errorf(\"failed to get rick directory: %w\", err)\n78\t\t}\n79\t\n80\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n81\t\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n82\t\t\treturn fmt.Errorf(\"job %s does not exist or has no doing directory\", jobID)\n83\t\t}\n84\t\n85\t\tsessionID, err := loadSessionID(doingDir)\n86\t\tif err != nil {\n87\t\t\treturn fmt.Errorf(\"no session found for job %s: %w\", jobID, err)\n88\t\t}\n89\t\n90\t\tcfg, err := config.LoadConfig()\n91\t\tif err != nil {\n92\t\t\treturn fmt.Errorf(\"failed to load config: %w\", err)\n93\t\t}\n94\t\n95\t\tfmt.Printf(\"Job ID: %s\\n\", jobID)\n96\t\tfmt.Printf(\"Resuming session: %s\\n\", sessionID)\n97\t\n98\t\tif err := callClaudeCodeCLIResume(cfg, sessionID); err != nil {\n99\t\t\treturn fmt.Errorf(\"session resume failed: %w\", err)\n100\t\t}\n101\t\n102\t\t// Update tasks.json timestamp on resume so dream sees the latest run\n103\t\tif err := writeEasyTasksJSON(doingDir); err != nil {\n104\t\t\tfmt.Printf(\"[WARN] failed to write tasks.json: %v\\n\", err)\n105\t\t}\n106\t\n107\t\t// Generate fresh learning prompt (doingDir now fully populated after resume)\n108\t\tlearningFile, err := prompt.GenerateEasyLearningPromptFile(jobID, rickDir)\n109\t\tif err != nil {\n110\t\t\tfmt.Printf(\"[WARN] failed to generate learning prompt: %v\\n\", err)\n111\t\t}\n112\t\n113\t\t// Auto-trigger learning on exit\n114\t\tfmt.Println(\"\\n✅ Easy 会话结束，开始自动 learning...\")\n115\t\tif err := triggerAutoLearning(cfg, learningFile); err != nil {\n116\t\t\tfmt.Printf(\"[WARN] auto learning failed: %v\\n\", err)\n117\t\t} else {\n118\t\t\tfmt.Println(\"✅ Learning + Merge 完成！\")\n119\t\t}\n120\t\n121\t\treturn nil\n122\t}\n123\t\n124\t// startEasySession runs the full easy session flow for a new job.\n125\tfunc startEasySession(jobID, requirement, rickDir string, cfg *config.Config, ctxPath string) error {\n126\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n127\t\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n128\t\t\treturn fmt.Errorf(\"failed to create doing directory: %w\", err)\n129\t\t}\n130\t\n131\t\t// Write requirement\n132\t\tif err := os.WriteFile(filepath.Join(doingDir, \"requirement.md\"), []byte(requirement), 0644); err != nil {\n133\t\t\treturn fmt.Errorf(\"failed to write requirement: %w\", err)\n134\t\t}\n135\t\n136\t\t// Generate session UUID and persist\n137\t\tsessionID, err := generateUUID()\n138\t\tif err != nil {\n139\t\t\treturn fmt.Errorf(\"failed to generate session ID: %w\", err)\n140\t\t}\n141\t\tif err := saveSessionID(doingDir, sessionID); err != nil {\n142\t\t\treturn fmt.Errorf(\"failed to save session ID: %w\", err)\n143\t\t}\n144\t\n145\t\tmainFile, _, err := prompt.GenerateEasyPromptFile(jobID, requirement, rickDir, ctxPath)\n146\t\tif err != nil {\n147\t\t\treturn fmt.Errorf(\"failed to generate easy prompt: %w\", err)\n148\t\t}\n149\t\n150\t\tfmt.Printf(\"Job ID: %s\\n\", jobID)\n151\t\tfmt.Printf(\"Session ID: %s\\n\", sessionID)\n152\t\tfmt.Println(\"🤖 Starting Easy interactive session...\")\n153\t\n154\t\tif err := callClaudeCodeCLIEasy(cfg, sessionID, mainFile); err != nil {\n155\t\t\treturn fmt.Errorf(\"easy session failed: %w\", err)\n156\t\t}\n157\t\n158\t\t// Write synthetic tasks.json so dream can discover this job\n159\t\tif err := writeEasyTasksJSON(doingDir); err != nil {\n160\t\t\tfmt.Printf(\"[WARN] failed to write tasks.json: %v\\n\", err)\n161\t\t}\n162\t\n163\t\t// Generate learning prompt now that doingDir is fully populated\n164\t\tlearningFile, err := prompt.GenerateEasyLearningPromptFile(jobID, rickDir)\n165\t\tif err != nil {\n166\t\t\tfmt.Printf(\"[WARN] failed to generate learning prompt: %v\\n\", err)\n167\t\t}\n168\t\n169\t\t// Auto-trigger learning on exit\n170\t\tfmt.Println(\"\\n✅ Easy 会话结束，开始自动 learning...\")\n171\t\tif err := triggerAutoLearning(cfg, learningFile); err != nil {\n172\t\t\tfmt.Printf(\"[WARN] auto learning failed: %v\\n\", err)\n173\t\t} else {\n174\t\t\tfmt.Println(\"✅ Learning + Merge 完成！\")\n175\t\t}\n176\t\n177\t\treturn nil\n178\t}\n179\t\n180\t// callClaudeCodeCLIEasy starts an interactive session with a pre-set session ID.\n181\tfunc callClaudeCodeCLIEasy(cfg *config.Config, sessionID, promptFile string) error {\n182\t\tclaudePath := cfg.ClaudeCodePath\n183\t\tif claudePath == \"\" {\n184\t\t\tclaudePath = \"claude\"\n185\t\t}\n186\t\tcmd := exec.Command(claudePath, \"--session-id\", sessionID, promptFile)\n187\t\tcmd.Stdin = os.Stdin\n188\t\tcmd.Stdout = os.Stdout\n189\t\tcmd.Stderr = os.Stderr\n190\t\tif err := cmd.Run(); err != nil {\n191\t\t\treturn fmt.Errorf(\"Claude Code CLI failed: %w\", err)\n192\t\t}\n193\t\treturn nil\n194\t}\n195\t\n196\t// callClaudeCodeCLIResume resumes an existing Claude session interactively.\n197\tfunc callClaudeCodeCLIResume(cfg *config.Config, sessionID string) error {\n198\t\tclaudePath := cfg.ClaudeCodePath\n199\t\tif claudePath == \"\" {\n200\t\t\tclaudePath = \"claude\"\n201\t\t}\n202\t\tcmd := exec.Command(claudePath, \"--resume\", sessionID)\n203\t\tcmd.Stdin = os.Stdin\n204\t\tcmd.Stdout = os.Stdout\n205\t\tcmd.Stderr = os.Stderr\n206\t\tif err := cmd.Run(); err != nil {\n207\t\t\treturn fmt.Errorf(\"Claude Code CLI failed: %w\", err)\n208\t\t}\n209\t\treturn nil\n210\t}\n211\t\n212\t// triggerAutoLearning runs the learning prompt in background (non-interactive) mode.\n213\tfunc triggerAutoLearning(cfg *config.Config, learningPromptFile string) error {\n214\t\treturn callClaudeCodeCLIBackground(cfg, learningPromptFile)\n215\t}\n216\t\n217\t// saveSessionID persists the session UUID to doingDir/session_id.\n218\tfunc saveSessionID(doingDir, sessionID string) error {\n219\t\treturn os.WriteFile(filepath.Join(doingDir, \"session_id\"), []byte(sessionID), 0644)\n220\t}\n221\t\n222\t// loadSessionID reads the session UUID from doingDir/session_id.\n223\tfunc loadSessionID(doingDir string) (string, error) {\n224\t\tdata, err := os.ReadFile(filepath.Join(doingDir, \"session_id\"))\n225\t\tif err != nil {\n226\t\t\treturn \"\", err\n227\t\t}\n228\t\treturn string(data), nil\n229\t}\n230\t\n231\t// writeEasyTasksJSON writes a synthetic tasks.json so dream can discover this easy job.\n232\t// Easy mode has no task breakdown, so we write a single \"easy_session\" task as success.\n233\tfunc writeEasyTasksJSON(doingDir string) error {\n234\t\tnow := time.Now()\n235\t\ttasksJSON := map[string]interface{}{\n236\t\t\t\"version\":    \"1.0\",\n237\t\t\t\"created_at\": now,\n238\t\t\t\"updated_at\": now,\n239\t\t\t\"tasks\": []map[string]interface{}{\n240\t\t\t\t{\n241\t\t\t\t\t\"task_id\":      \"easy_session\",\n242\t\t\t\t\t\"task_name\":    \"Easy Mode Session\",\n243\t\t\t\t\t\"task_file\":    \"\",\n244\t\t\t\t\t\"status\":       \"success\",\n245\t\t\t\t\t\"dependencies\": []string{},\n246\t\t\t\t\t\"attempts\":     1,\n247\t\t\t\t\t\"created_at\":   now,\n248\t\t\t\t\t\"updated_at\":   now,\n249\t\t\t\t},\n250\t\t\t},\n251\t\t}\n252\t\tdata, err := json.MarshalIndent(tasksJSON, \"\", \"  \")\n253\t\tif err != nil {\n254\t\t\treturn err\n255\t\t}\n256\t\treturn os.WriteFile(filepath.Join(doingDir, \"tasks.json\"), data, 0644)\n257\t}\n258\t\n259\t// generateUUID generates a random UUID (v4).\n260\tfunc generateUUID() (string, error) {\n261\t\tvar b [16]byte\n262\t\tif _, err := rand.Read(b[:]); err != nil {\n263\t\t\treturn \"\", err\n264\t\t}\n265\t\tb[6] = (b[6] & 0x0f) | 0x40 // version 4\n266\t\tb[8] = (b[8] & 0x3f) | 0x80 // variant bits\n267\t\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%012x\",\n268\t\t\tb[0:4], b[4:6], b[6:8], b[8:10], b[10:16]), nil\n269\t}\n270\t"}]},"parent_tool_use_id":null,"session_id":"eb860699-73a9-44c3-beb2-6a6d3337003b","uuid":"f8a6c160-fe14-4364-b83b-b523e36a7c01","timestamp":"2026-06-12T15:31:32.271Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sunquan/ai_coding/CODING/rick/internal/cmd/easy.go","content":"package cmd\n\nimport (\n\t\"crypto/rand\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/sunquan/rick/internal/config\"\n\t\"github.com/sunquan/rick/internal/prompt\"\n\t\"github.com/sunquan/rick/internal/workspace\"\n)\n\n// runEasyMode creates a new job and starts an easy interactive session.\nfunc runEasyMode(requirement, ctxPath string) error {\n\tif requirement == \"\" {\n\t\tvar err error\n\t\trequirement, err = promptForRequirement()\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"failed to get requirement: %w\", err)\n\t\t}\n\t}\n\tif requirement == \"\" {\n\t\treturn fmt.Errorf(\"requirement cannot be empty\")\n\t}\n\n\trickDir, err := workspace.GetRickDir()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get rick directory: %w\", err)\n\t}\n\n\t// --ctx: guard against overwriting existing context\n\tif ctxPath != \"\" {\n\t\tif err := validateCtxInheritance(rickDir, ctxPath); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\tjobID, err := workspace.NextJobID()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to determine next job ID: %w\", err)\n\t}\n\n\tcfg, err := config.LoadConfig()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to load config: %w\", err)\n\t}\n\n\treturn startEasySession(jobID, requirement, rickDir, cfg, ctxPath)\n}\n\n// validateCtxInheritance checks that:\n// 1. The target ctxPath exists and looks like a .rick directory.\n// 2. The local .rick does NOT already have OKR.md or SPEC.md (to prevent accidental overwrite).\nfunc validateCtxInheritance(localRickDir, ctxPath string) error {\n\t// Verify the source ctx path exists\n\tif _, err := os.Stat(ctxPath); os.IsNotExist(err) {\n\t\treturn fmt.Errorf(\"--ctx path does not exist: %s\", ctxPath)\n\t}\n\t// Verify local .rick has no existing OKR.md / SPEC.md\n\tfor _, name := range []string{\"OKR.md\", \"SPEC.md\"} {\n\t\tp := filepath.Join(localRickDir, name)\n\t\tif _, err := os.Stat(p); err == nil {\n\t\t\treturn fmt.Errorf(\"local context already exists (%s). Remove it first or omit --ctx\", p)\n\t\t}\n\t}\n\treturn nil\n}\n\n// resumeEasyMode resumes an existing easy session by job ID.\nfunc resumeEasyMode(jobID string) error {\n\trickDir, err := workspace.GetRickDir()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to get rick directory: %w\", err)\n\t}\n\n\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n\t\treturn fmt.Errorf(\"job %s does not exist or has no doing directory\", jobID)\n\t}\n\n\tsessionID, err := loadSessionID(doingDir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"no session found for job %s: %w\", jobID, err)\n\t}\n\n\tcfg, err := config.LoadConfig()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to load config: %w\", err)\n\t}\n\n\tfmt.Printf(\"Job ID: %s\\n\", jobID)\n\tfmt.Printf(\"Resuming session: %s\\n\", sessionID)\n\n\tif err := callClaudeCodeCLIResume(cfg, sessionID); err != nil {\n\t\treturn fmt.Errorf(\"session resume failed: %w\", err)\n\t}\n\n\t// Update tasks.json timestamp on resume so dream sees the latest run\n\tif err := writeEasyTasksJSON(doingDir); err != nil {\n\t\tfmt.Printf(\"[WARN] failed to write tasks.json: %v\\n\", err)\n\t}\n\n\t// Generate fresh learning prompt (doingDir now fully populated after resume)\n\tlearningFile, err := prompt.GenerateEasyLearningPromptFile(jobID, rickDir)\n\tif err != nil {\n\t\tfmt.Printf(\"[WARN] failed to generate learning prompt: %v\\n\", err)\n\t}\n\n\t// Auto-trigger learning on exit\n\tfmt.Println(\"\\n✅ Easy 会话结束，开始自动 learning...\")\n\tif err := triggerAutoLearning(cfg, learningFile); err != nil {\n\t\tfmt.Printf(\"[WARN] auto learning failed: %v\\n\", err)\n\t} else {\n\t\tfmt.Println(\"✅ Learning + Merge 完成！\")\n\t}\n\n\treturn nil\n}\n\n// startEasySession runs the full easy session flow for a new job.\nfunc startEasySession(jobID, requirement, rickDir string, cfg *config.Config, ctxPath string) error {\n\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n\tif err := os.MkdirAll(doingDir, 0755); err != nil {\n\t\treturn fmt.Errorf(\"failed to create doing directory: %w\", err)\n\t}\n\n\t// Write requirement\n\tif err := os.WriteFile(filepath.Join(doingDir, \"requirement.md\"), []byte(requirement), 0644); err != nil {\n\t\treturn fmt.Errorf(\"failed to write requirement: %w\", err)\n\t}\n\n\t// Generate session UUID and persist\n\tsessionID, err := generateUUID()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to generate session ID: %w\", err)\n\t}\n\tif err := saveSessionID(doingDir, sessionID); err != nil {\n\t\treturn fmt.Errorf(\"failed to save session ID: %w\", err)\n\t}\n\n\tmainFile, _, err := prompt.GenerateEasyPromptFile(jobID, requirement, rickDir, ctxPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to generate easy prompt: %w\", err)\n\t}\n\n\tfmt.Printf(\"Job ID: %s\\n\", jobID)\n\tfmt.Printf(\"Session ID: %s\\n\", sessionID)\n\tfmt.Println(\"🤖 Starting Easy interactive session...\")\n\n\tif err := callClaudeCodeCLIEasy(cfg, sessionID, mainFile); err != nil {\n\t\treturn fmt.Errorf(\"easy session failed: %w\", err)\n\t}\n\n\t// Write synthetic tasks.json so dream can discover this job\n\tif err := writeEasyTasksJSON(doingDir); err != nil {\n\t\tfmt.Printf(\"[WARN] failed to write tasks.json: %v\\n\", err)\n\t}\n\n\t// Generate learning prompt now that doingDir is fully populated\n\tlearningFile, err := prompt.GenerateEasyLearningPromptFile(jobID, rickDir)\n\tif err != nil {\n\t\tfmt.Printf(\"[WARN] failed to generate learning prompt: %v\\n\", err)\n\t}\n\n\t// Auto-trigger learning on exit\n\tfmt.Println(\"\\n✅ Easy 会话结束，开始自动 learning...\")\n\tif err := triggerAutoLearning(cfg, learningFile); err != nil {\n\t\tfmt.Printf(\"[WARN] auto learning failed: %v\\n\", err)\n\t} else {\n\t\tfmt.Println(\"✅ Learning + Merge 完成！\")\n\t}\n\n\treturn nil\n}\n\n// callClaudeCodeCLIEasy starts an interactive session with a pre-set session ID.\nfunc callClaudeCodeCLIEasy(cfg *config.Config, sessionID, promptFile string) error {\n\tclaudePath := cfg.ClaudeCodePath\n\tif claudePath == \"\" {\n\t\tclaudePath = \"claude\"\n\t}\n\tcmd := exec.Command(claudePath, \"--session-id\", sessionID, promptFile)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tif err := cmd.Run(); err != nil {\n\t\treturn fmt.Errorf(\"Claude Code CLI failed: %w\", err)\n\t}\n\treturn nil\n}\n\n// callClaudeCodeCLIResume resumes an existing Claude session interactively.\nfunc callClaudeCodeCLIResume(cfg *config.Config, sessionID string) error {\n\tclaudePath := cfg.ClaudeCodePath\n\tif claudePath == \"\" {\n\t\tclaudePath = \"claude\"\n\t}\n\tcmd := exec.Command(claudePath, \"--resume\", sessionID)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tif err := cmd.Run(); err != nil {\n\t\treturn fmt.Errorf(\"Claude Code CLI failed: %w\", err)\n\t}\n\treturn nil\n}\n\n// triggerAutoLearning runs the learning prompt in background (non-interactive) mode.\nfunc triggerAutoLearning(cfg *config.Config, learningPromptFile string) error {\n\treturn callClaudeCodeCLIBackground(cfg, learningPromptFile)\n}\n\n// saveSessionID persists the session UUID to doingDir/session_id.\nfunc saveSessionID(doingDir, sessionID string) error {\n\treturn os.WriteFile(filepath.Join(doingDir, \"session_id\"), []byte(sessionID), 0644)\n}\n\n// loadSessionID reads the session UUID from doingDir/session_id.\nfunc loadSessionID(doingDir string) (string, error) {\n\tdata, err := os.ReadFile(filepath.Join(doingDir, \"session_id\"))\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn string(data), nil\n}\n\n// writeEasyTasksJSON writes a synthetic tasks.json so dream can discover this easy job.\n// Easy mode has no task breakdown, so we write a single \"easy_session\" task as success.\nfunc writeEasyTasksJSON(doingDir string) error {\n\tnow := time.Now()\n\ttasksJSON := map[string]interface{}{\n\t\t\"version\":    \"1.0\",\n\t\t\"created_at\": now,\n\t\t\"updated_at\": now,\n\t\t\"tasks\": []map[string]interface{}{\n\t\t\t{\n\t\t\t\t\"task_id\":      \"easy_session\",\n\t\t\t\t\"task_name\":    \"Easy Mode Session\",\n\t\t\t\t\"task_file\":    \"\",\n\t\t\t\t\"status\":       \"success\",\n\t\t\t\t\"dependencies\": []string{},\n\t\t\t\t\"attempts\":     1,\n\t\t\t\t\"created_at\":   now,\n\t\t\t\t\"updated_at\":   now,\n\t\t\t},\n\t\t},\n\t}\n\tdata, err := json.MarshalIndent(tasksJSON, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(filepath.Join(doingDir, \"tasks.json\"), data, 0644)\n}\n\n// generateUUID generates a random UUID (v4).\nfunc generateUUID() (string, error) {\n\tvar b [16]byte\n\tif _, err := rand.Read(b[:]); err != nil {\n\t\treturn \"\", err\n\t}\n\tb[6] = (b[6] & 0x0f) | 0x40 // version 4\n\tb[8] = (b[8] & 0x3f) | 0x80 // variant bits\n\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%012x\",\n\t\tb[0:4], b[4:6], b[6:8], b[8:10], b[10:16]), nil\n}\n","numLines":270,"startLine":1,"totalLines":270}}}
