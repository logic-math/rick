{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JucZKfUxcbrafJDLLxdFaW","type":"tool_result","content":"1\tpackage prompt\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t)\n10\t\n11\t// GenerateEasyPromptFile generates the easy mode interactive prompt.\n12\t// Persisted to doingDir/prompts/ so it survives session exits.\n13\t// ctxPath is optional; when non-empty the prompt includes ctx-inheritance instructions.\n14\t// Returns mainFile (easy_prompt.md), skill tmp files, error.\n15\tfunc GenerateEasyPromptFile(jobID, requirement, rickDir, ctxPath string) (string, []string, error) {\n16\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n17\t\n18\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n19\t\tif err != nil {\n20\t\t\treturn \"\", nil, fmt.Errorf(\"failed to create prompts dir: %w\", err)\n21\t\t}\n22\t\ttddFile, err := WriteSkillFile(promptsDir, \"skill_tdd_zh.md\", \"tdd-zh\")\n23\t\tif err != nil {\n24\t\t\treturn \"\", nil, err\n25\t\t}\n26\t\tsenseFile, err := WriteSkillFile(promptsDir, \"skill_sense.md\", \"sense\")\n27\t\tif err != nil {\n28\t\t\treturn \"\", nil, err\n29\t\t}\n30\t\tdebugSkillFile, err := WriteSkillFileWithVars(promptsDir, \"skill_debug_skill.md\", \"debug_skill\", map[string]string{\n31\t\t\t\"sense_skill_path\": senseFile,\n32\t\t})\n33\t\tif err != nil {\n34\t\t\treturn \"\", nil, err\n35\t\t}\n36\t\tskillFiles := []string{tddFile, debugSkillFile, senseFile}\n37\t\n38\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"暂无 OKR\")\n39\t\tspecContent := readFileOrDefault(filepath.Join(rickDir, \"SPEC.md\"), \"暂无 SPEC\")\n40\t\tdebugContent := loadDebugContextLocal(doingDir)\n41\t\tif debugContent == \"\" {\n42\t\t\tdebugContent = \"暂无（首次会话）\"\n43\t\t}\n44\t\n45\t\tmgr := NewPromptManager()\n46\t\ttmpl, err := mgr.LoadTemplate(\"easy\")\n47\t\tif err != nil {\n48\t\t\treturn \"\", nil, fmt.Errorf(\"failed to load easy template: %w\", err)\n49\t\t}\n50\t\n51\t\tprojectRoot, _ := os.Getwd()\n52\t\trickBinPath := filepath.Join(projectRoot, \"bin\", \"rick\")\n53\t\tlearningPromptPath := filepath.Join(promptsDir, \"easy_learning_prompt.md\")\n54\t\n55\t\tbuilder := NewPromptBuilder(tmpl)\n56\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n57\t\tbuilder.SetVariable(\"spec_content\", specContent)\n58\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n59\t\tbuilder.SetVariable(\"requirement\", requirement)\n60\t\tbuilder.SetVariable(\"doing_dir\", doingDir)\n61\t\tbuilder.SetVariable(\"tdd_skill_path\", tddFile)\n62\t\tbuilder.SetVariable(\"debug_skill_path\", debugSkillFile)\n63\t\tbuilder.SetVariable(\"sense_skill_path\", senseFile)\n64\t\tbuilder.SetVariable(\"learning_prompt_path\", learningPromptPath)\n65\t\tbuilder.SetVariable(\"rick_bin_path\", rickBinPath)\n66\t\tbuilder.SetVariable(\"job_id\", jobID)\n67\t\tbuilder.SetVariable(\"ctx_section\", buildCtxSection(ctxPath, rickDir))\n68\t\n69\t\tmainContent, err := builder.Build()\n70\t\tif err != nil {\n71\t\t\treturn \"\", nil, fmt.Errorf(\"failed to build easy prompt: %w\", err)\n72\t\t}\n73\t\n74\t\tmainFile := filepath.Join(promptsDir, \"easy_prompt.md\")\n75\t\tif err := os.WriteFile(mainFile, []byte(mainContent), 0644); err != nil {\n76\t\t\treturn \"\", nil, fmt.Errorf(\"failed to write easy prompt: %w\", err)\n77\t\t}\n78\t\n79\t\treturn mainFile, skillFiles, nil\n80\t}\n81\t\n82\t// GenerateEasyLearningPromptFile generates the learning prompt after a session ends.\n83\t// Called after the easy session completes so doingDir is fully populated (debug/, tasks.json, etc.).\n84\t// Reuses the same learning.md template as the standard learning phase.\n85\t// Returns the path to the generated prompt file.\n86\tfunc GenerateEasyLearningPromptFile(jobID, rickDir string) (string, error) {\n87\t\tdoingDir := filepath.Join(rickDir, \"jobs\", jobID, \"doing\")\n88\t\tlearningDir := filepath.Join(rickDir, \"jobs\", jobID, \"learning\")\n89\t\tif err := os.MkdirAll(learningDir, 0755); err != nil {\n90\t\t\treturn \"\", fmt.Errorf(\"failed to create learning dir: %w\", err)\n91\t\t}\n92\t\n93\t\tpromptsDir, err := EnsurePromptsDir(doingDir)\n94\t\tif err != nil {\n95\t\t\treturn \"\", fmt.Errorf(\"failed to create prompts dir: %w\", err)\n96\t\t}\n97\t\n98\t\tmgr := NewPromptManager()\n99\t\ttmpl, err := mgr.LoadTemplate(\"learning\")\n100\t\tif err != nil {\n101\t\t\treturn \"\", fmt.Errorf(\"failed to load learning template: %w\", err)\n102\t\t}\n103\t\n104\t\tbuilder := NewPromptBuilder(tmpl)\n105\t\tbuilder.SetVariable(\"job_id\", jobID)\n106\t\tbuilder.SetVariable(\"learning_dir\", learningDir)\n107\t\n108\t\tokrContent := readFileOrDefault(filepath.Join(rickDir, \"OKR.md\"), \"（本 job 无 OKR.md）\")\n109\t\tbuilder.SetVariable(\"okr_content\", okrContent)\n110\t\n111\t\tspecPath := filepath.Join(rickDir, \"SPEC.md\")\n112\t\tbuilder.SetVariable(\"spec_path\", specPath)\n113\t\tbuilder.SetVariable(\"wiki_dir\", filepath.Join(rickDir, \"wiki\"))\n114\t\tbuilder.SetVariable(\"tools_dir\", filepath.Join(rickDir, \"tools\"))\n115\t\n116\t\tdebugContent := loadDebugContextLocal(doingDir)\n117\t\tif debugContent == \"\" {\n118\t\t\tdebugContent = \"（本次 job 无 debug 记录）\"\n119\t\t}\n120\t\tbuilder.SetVariable(\"debug_content\", debugContent)\n121\t\n122\t\t// easy mode has no task*.md files\n123\t\tbuilder.SetVariable(\"task_md_files\", \"  （easy 模式无 task*.md 文件）\")\n124\t\n125\t\t// easy mode has no per-task act-path.md\n126\t\tbuilder.SetVariable(\"act_path_files\", \"  （easy 模式无 act-path.md 文件）\")\n127\t\n128\t\t// tasks.json: easy session writes a single easy_session task\n129\t\tbuilder.SetVariable(\"task_execution_results\", buildEasyTaskResults(doingDir))\n130\t\n131\t\tprojectRoot, _ := os.Getwd()\n132\t\tbuilder.SetVariable(\"rick_bin_path\", filepath.Join(projectRoot, \"bin\", \"rick\"))\n133\t\n134\t\tgenSkillFile, err := WriteSkillFile(promptsDir, \"skill_gen_skill.md\", \"gen-skill\")\n135\t\tif err != nil {\n136\t\t\treturn \"\", fmt.Errorf(\"failed to write gen-skill: %w\", err)\n137\t\t}\n138\t\tbuilder.SetVariable(\"gen_skill_path\", genSkillFile)\n139\t\n140\t\tpromptFile := filepath.Join(promptsDir, \"easy_learning_prompt.md\")\n141\t\tif err := builder.SaveToFile(promptFile); err != nil {\n142\t\t\treturn \"\", fmt.Errorf(\"failed to save easy learning prompt: %w\", err)\n143\t\t}\n144\t\n145\t\treturn promptFile, nil\n146\t}\n147\t\n148\t// buildEasyTaskResults formats the task execution table for easy mode (single easy_session task).\n149\tfunc buildEasyTaskResults(doingDir string) string {\n150\t\theader := \"| Task ID | 任务名称 | 状态 | Commit Hash | 重试次数 |\\n|---------|---------|------|-------------|----------|\\n\"\n151\t\tdata, err := os.ReadFile(filepath.Join(doingDir, \"tasks.json\"))\n152\t\tif err != nil {\n153\t\t\treturn header + \"| easy_session | Easy Mode Session | unknown | N/A | 1 |\\n\"\n154\t\t}\n155\t\t// Simple extraction: tasks.json has one task with status \"success\"\n156\t\tstatus := \"success\"\n157\t\tif strings.Contains(string(data), `\"status\": \"failed\"`) {\n158\t\t\tstatus = \"failed\"\n159\t\t}\n160\t\treturn header + fmt.Sprintf(\"| easy_session | Easy Mode Session | %s | N/A | 1 |\\n\", status)\n161\t}\n162\t\n163\t// buildCtxSection renders the easy_ctx.md template with ctxPath and localRickDir.\n164\t// Returns empty string when ctxPath is empty (no inheritance).\n165\tfunc buildCtxSection(ctxPath, localRickDir string) string {\n166\t\tif ctxPath == \"\" {\n167\t\t\treturn \"\"\n168\t\t}\n169\t\tmgr := NewPromptManager()\n170\t\ttmpl, err := mgr.LoadTemplate(\"easy_ctx\")\n171\t\tif err != nil {\n172\t\t\treturn \"\"\n173\t\t}\n174\t\tbuilder := NewPromptBuilder(tmpl)\n175\t\tbuilder.SetVariable(\"ctx_path\", ctxPath)\n176\t\tbuilder.SetVariable(\"local_rick_dir\", localRickDir)\n177\t\tcontent, err := builder.Build()\n178\t\tif err != nil {\n179\t\t\treturn \"\"\n180\t\t}\n181\t\treturn content\n182\t}\n183\t\n184\t// loadDebugContextLocal mirrors executor.LoadDebugContext without creating a circular import.\n185\t// Prefers bug*.md frontmatter summaries from doingDir/debug/; falls back to doingDir/debug.md.\n186\t// Returns \"\" when doingDir is empty or does not exist.\n187\t//\n188\t// TODO(2026-08): remove fallback to debug.md after full migration to debug/ dir format.\n189\tfunc loadDebugContextLocal(doingDir string) string {\n190\t\tif doingDir == \"\" {\n191\t\t\treturn \"\"\n192\t\t}\n193\t\tif _, err := os.Stat(doingDir); os.IsNotExist(err) {\n194\t\t\treturn \"\"\n195\t\t}\n196\t\tdebugDir := filepath.Join(doingDir, \"debug\")\n197\t\tentries, err := os.ReadDir(debugDir)\n198\t\tif err == nil {\n199\t\t\tvar files []string\n200\t\t\tfor _, e := range entries {\n201\t\t\t\tname := e.Name()\n202\t\t\t\tif !e.IsDir() && strings.HasPrefix(name, \"bug\") && strings.HasSuffix(name, \".md\") {\n203\t\t\t\t\tfiles = append(files, name)\n204\t\t\t\t}\n205\t\t\t}\n206\t\t\tif len(files) > 0 {\n207\t\t\t\tsort.Strings(files)\n208\t\t\t\tvar sb strings.Builder\n209\t\t\t\tfor _, name := range files {\n210\t\t\t\t\tdata, err := os.ReadFile(filepath.Join(debugDir, name))\n211\t\t\t\t\tif err != nil {\n212\t\t\t\t\t\tcontinue\n213\t\t\t\t\t}\n214\t\t\t\t\t// parse YAML frontmatter for summary and status\n215\t\t\t\t\tvar summary, status string\n216\t\t\t\t\tlines := strings.Split(string(data), \"\\n\")\n217\t\t\t\t\tinFM, started := false, false\n218\t\t\t\t\tfor _, line := range lines {\n219\t\t\t\t\t\tt := strings.TrimSpace(line)\n220\t\t\t\t\t\tif t == \"---\" {\n221\t\t\t\t\t\t\tif !started {\n222\t\t\t\t\t\t\t\tinFM, started = true, true\n223\t\t\t\t\t\t\t\tcontinue\n224\t\t\t\t\t\t\t}\n225\t\t\t\t\t\t\tif inFM {\n226\t\t\t\t\t\t\t\tbreak\n227\t\t\t\t\t\t\t}\n228\t\t\t\t\t\t}\n229\t\t\t\t\t\tif !inFM {\n230\t\t\t\t\t\t\tcontinue\n231\t\t\t\t\t\t}\n232\t\t\t\t\t\tif strings.HasPrefix(t, \"summary:\") {\n233\t\t\t\t\t\t\tv := strings.TrimSpace(strings.TrimP