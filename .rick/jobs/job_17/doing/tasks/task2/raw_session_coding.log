ary != \"only summary\" {\n\t\t\tt.Errorf(\"expected 'only summary', got %q\", summary)\n\t\t}\n\t\tif status != \"\" {\n\t\t\tt.Errorf(\"expected empty status, got %q\", status)\n\t\t}\n\t})\n}\n"}}],"usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"75c92664-b821-4b43-b782-f9b072302997","uuid":"e3d8526e-8099-43a7-9833-30bd222d052e"}
